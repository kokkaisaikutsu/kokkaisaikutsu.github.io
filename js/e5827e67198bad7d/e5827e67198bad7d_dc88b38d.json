[{"date": "2020-03-17", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X00420200317/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00420200317/3", "sentence": ["○委員長（若松謙維君）次に、補足説明を聴取いたします。長谷川総務副大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00420200317/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00420200317/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00420200317/8", "sentence": ["…の聴取は終わりました。なお、地方税法等の一部を改正する法律案に対する補足説明につきましては、理事会で協議いたしました結果、説明の聴取は行わず…"]}]}]}]