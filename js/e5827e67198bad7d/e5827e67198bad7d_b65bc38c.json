[{"date": "2020-06-03", "meeting": [{"meeting_name": "参議院 東日本大震災復興特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/9", "sentence": ["…ただきたいと思います。それでは、復興・創生期間後の災害公営住宅の特別家賃低減事業につきまして、横山復興副大臣にお尋ねをいたします。特に、この…", "…た方々が住んでいる公営住宅でありますけれども、特に低所得者向けの特別家賃低減事業、これにつきましては、復興交付金というハード事業、これが廃止…", "…すので、この公営住宅に住まれる方、支援がなくなるのではないかと、又は家賃が高騰するんではないかと、そういう心配の声が多数寄せられます。そこで…", "…ます。そして、制度的には、入居から十年間は復興・創生期間後もこの特別家賃低減事業による低所得者に対する支援継続はされるものと理解しているんで…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/27", "sentence": []}]}]}]