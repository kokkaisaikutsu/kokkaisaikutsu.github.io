[{"date": "2021-11-12", "meeting": [{"meeting_name": "衆議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120605206X00120211112/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605206X00120211112/2", "sentence": ["…、議院運営委員会決定の基準に従いましてその数を八名とし、先例により、委員長において指名するに御異議ありませんか。〔「異議なし」と呼ぶ者あり〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120605206X00120211112/3", "sentence": ["…と認めます。それでは、理事に稲田朋美君奥野信亮君宮崎政久君山田賢司君稲富修二君階猛君守島正君大口善徳君を指名いたします。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120605206X00120211112/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605206X00120211112/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605206X00120211112/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605206X00120211112/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605206X00120211112/8", "sentence": []}]}]}, {"date": "2021-12-21", "meeting": [{"meeting_name": "衆議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705206X00120211221/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705206X00120211221/2", "sentence": ["…が五名欠員となっております。その補欠選任につきましては、先例により、委員長において指名するに御異議ありませんか。〔「異議なし」と呼ぶ者あり〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705206X00120211221/3", "sentence": ["○鈴木委員長御異議なしと認めます。それでは、理事に井出庸生君熊田裕通君葉梨康弘君山田美樹君鎌田さゆり君を指名いたします。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705206X00120211221/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705206X00120211221/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705206X00120211221/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705206X00120211221/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705206X00120211221/8", "sentence": []}]}]}]