[{"date": "2020-07-09", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/41", "sentence": ["…任務及び能力を絶えず再評価する必要があることを確認しつつ、米国として防衛力を強化するための日本の積極的な措置を歓迎する旨を表明をしております…", "…す。そして、二〇一九年の五月の訪日の際には、トランプ大統領が、米国は防衛能力を向上するための日本の取組を支援する旨を発言しているところであり…", "…を発言しているところであります。このように、米国として、これまで我が国による防衛力強化の取組を支持そして歓迎をしていると認識をしております。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/43", "sentence": ["…として、核そして通常戦力を含むあらゆる種類の米国の軍事力による日本の防衛に対するコミットメントを改めて表明をしていると認識をしております。こ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/74", "sentence": ["…関係の答弁ということでさせていただきますが、今申し上げましたように、私どもとして、発表前に防衛省から連絡を受けているということでございます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/173", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/176", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/178", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/180", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/182", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/184", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/186", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/188", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00120200709/200", "sentence": []}]}]}]