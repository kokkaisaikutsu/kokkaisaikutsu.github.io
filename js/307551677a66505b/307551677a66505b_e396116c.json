[{"date": "2020-07-09", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/120", "sentence": ["…願いします。そしてもう一つ、日本は、こういう技能実習生以外も、例えば難民申請をしていても認定が本当に遅いですから、というか、されないですから…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/122", "sentence": ["…トジボワールから二〇〇八年に日本に入国した方。当時、内戦状態。空港で難民申請をしました。二〇一四年に認定しないという判断が出されたので、すぐ…", "…後、何の連絡もなかったけれど、今年五月十二日に異議申立てが認められて難民認定になったんです。極めてまれなケースです。ところが、このケースでさ…", "…からだというんですけれども、この異議申立て、二〇一四年に行っている、難民認定のね、されなかったことについて、それが認められたということは、そ…", "…、その二〇一四年に遡って行政処分が取り消されたんですよ。二〇〇八年の難民申請の認定が行われたということになるんですね。単に行政判断が遅れただ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00120200709/124", "sentence": []}]}]}]