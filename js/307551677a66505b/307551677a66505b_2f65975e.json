[{"date": "2020-05-19", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/113", "sentence": ["…を得ません。銀行利用者にとって直接的に不利益となるのが、自分に身近な支店がなくなるということですね。合併による経理合理化の方法として、窓口業…", "…として、窓口業務の人材を他の部署に回せると金融庁も説明をしています。支店の維持ということは、基盤的サービス維持計画の中に入るのでしょうか。ま…", "…基盤的サービス維持計画の中に入るのでしょうか。また、金融庁がこれまで支店の閉鎖について是正措置を講じた事例があるでしょうか。併せてお答えくだ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/116", "sentence": ["…県日南町では、鳥取銀行がＡＴＭだけを残して二〇一九年一月に町内唯一の支店を閉鎖することが発表されました。町長が抗議し、町議会も、窓口は振り込…", "…状況になったりするわけですよ。そうすると、窓口で相談できるというこの支店、大変重要な役割を果たすというふうに思いますが、大臣、いかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/118", "sentence": ["…ょっと筋違いですよ、大臣ね。一般的な話じゃないんですから。これ、是非支店の維持というのを強く求めるものです。そもそも地方銀行の収益が悪化して…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01020200519/130", "sentence": []}]}]}]