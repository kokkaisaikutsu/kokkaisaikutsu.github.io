[{"date": "2020-03-09", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/438", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/440", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/442", "sentence": ["…り大きな影響が出ていると思います。就学援助を受けている世帯などは、学校給食がないことが子供の健康と家計を直撃します。栄養バランスの取れた食事…", "…免疫力を付ける、感染症予防にもなるわけですよね。ですから、希望者に学校給食を国が費用負担をして提供すると、私、これ、あした決定する緊急対応策…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/444", "sentence": ["○田村智子君もう直撃していると思うんですよ。もう学校給食一週間ないんですからね、直撃しているんですよ。そんな悠長なこと言っていられないんです…", "…いうときは、いついかなるときも国は手放しちゃ駄目なんですよ。是非、学校給食、これは国がお金出す、あした盛り込んでいただきたい。強く求めます。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/446", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/448", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/450", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/452", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/454", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/456", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/458", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/460", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/462", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/464", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/466", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/468", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/470", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/472", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/474", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/12011526