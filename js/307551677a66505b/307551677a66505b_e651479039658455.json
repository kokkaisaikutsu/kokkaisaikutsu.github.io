[{"date": "2020-11-26", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/113", "sentence": ["…も大きくなってしまう、その影響緩和をどうするのかなんですね。また、処遇改善は進んできたとはいえ、いまだ保育士の年収は全産業平均との格差は大き…", "…ある待機児童対策を進めるためにも、今回の引下げが直撃しないような対策、また更なる処遇改善、これ具体的に進めるべきと考えますが、いかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/115", "sentence": ["○田村智子君処遇改善、それから影響緩和も是非やっていただきたいんですけど、やっぱり民間準拠だから国家公務員下げればいいという話じゃないんです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00420201126/135", "sentence": []}]}]}, {"date": "2021-05-12", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X02120210512/22", "sentence": ["…延長のように扱ってきた、そうした歴史的、構造的な問題にも切り込んで処遇改善が求められているのです。専門職にふさわしい処遇、経験が評価される処…", "…です。短時間勤務を基本的な保育士配置の中に持ち込むことは、こうした処遇改善に逆行し、逆に保育士不足を加速することにもなるのではありませんか。…"]}]}]}]