[{"date": "2020-04-06", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/12", "sentence": ["…雑になるのではないかとも思います。私も首長として国の経済対策を現場で執行した経験がございますが、時間が掛かり過ぎて効果的と言えないものもかつ…", "…のもかつてはございました。必要な人に必要な支援を、しかもスピーディーに届けるためにはどのような執行スキームが考えられるか、お伺いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/20", "sentence": ["○長峯誠君これについては、地方議会でも執行残が出ているということで、一体何やっているんだというようなお声もいただいておるところでございます。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00220200406/30", "sentence": []}]}]}]