[{"date": "2020-12-16", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/84", "sentence": ["…優先順位が出ると思います。今、大西さんが言われたように、我々は、児童手当は減らすべきじゃないという立場ですけれども、ただ、本当にめりと張りが…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/90", "sentence": ["…が減らされるというのは、私は理不尽だと思います。それに対して具体的に手当てが必要だ。補正ではなされていない。だから再支給するか。あるいは、結…", "…減収が大きいんですよ。四月分までは、例えば、重点医療機関のいろいろな手当がさかのぼって出されるんですけれども、ことし二月、三月分は出されない…", "…出されるんですけれども、ことし二月、三月分は出されないんです。だから、そういうことになるんですね。きちっと手当てしてくださいと言っています。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/102", "sentence": []}]}]}]