[{"date": "2020-12-16", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/82", "sentence": ["…。さらに、いろいろな意見があったけれども、看板政策まで見直して、歳出改革を大胆にやって、そして財源を捻出をして、復興の予算というのをつくって…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/84", "sentence": ["○玄葉委員歳出の改革をするときには、かなり政権の姿勢というか優先順位が出ると思います。今、大西さんが言われたように、我々は、児童手当は減らす…", "…すけれども、ただ、本当にめりと張りがとても大事だ。ぜひ、これは、歳出改革でやはり一定程度このコロナ禍の対策の財源をきちっと生み出していくんだ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/86", "sentence": ["…同時に、そういう姿勢を、西村大臣、つまり、そういう姿勢というのは歳出改革をするという姿勢を持っていないと、本当に野方図な予算になりますよ。今…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00720201216/102", "sentence": []}]}]}]