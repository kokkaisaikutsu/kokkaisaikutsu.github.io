[{"date": "2020-04-15", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/34", "sentence": ["…まず成田空港について質問をさせていただきます。まさに今、成田空港も、昭和五十三年、一九七八年の開港ですけれども、それ以来、一番の危機だと言っ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/42", "sentence": ["…ていない若い世代の方もいらっしゃるかもしれませんが、実は、何とこれは昭和四十六年、一九七一年に、上越新幹線、東北新幹線とともに整備計画が決定…", "…たんですね。しかし、沿線住民の反対等いろいろありまして、残念ながら、昭和六十一年、一九八六年に計画が断念されました。成田新幹線ができると成田…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/52", "sentence": []}]}]}, {"date": "2020-06-01", "meeting": [{"meeting_name": "衆議院 政治倫理の確立及び公職選挙法改正に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/25", "sentence": ["…きないという規定なんですね。もともとはそういう規定はなかったんです。昭和二十六年から昭和三十年にかけて、第二回統一地方選挙から第三回統一地方…", "…なんですね。もともとはそういう規定はなかったんです。昭和二十六年から昭和三十年にかけて、第二回統一地方選挙から第三回統一地方選挙にかけて、当…", "…いませんでしたので、四十六の都道府県知事がいまして、その二十六年から昭和三十年までの間、何と十七人の知事が途中で辞職して、そこの出直し知事選…", "…手にやったら、対抗馬の準備もないから、選挙の公正性を害するといって、昭和三十一年の法改正で、自分の都合でやめた首長