[{"date": "2020-05-15", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/26", "sentence": ["…すけれども、災害時の緊急事態において、復旧を急ぐために行っている査定前着工という制度がありますが、これをわかりやすく簡潔に説明してください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/28", "sentence": ["…は、皆さん、おわかりいただけると思うんですね。実は、こういった査定前着工というのは農林水産省でもあるんです。今から九年前の東日本大震災でも、…", "…かならないかと農水省にかけ合ったんですよ。そうしたら農水省が、査定前着工というのがあるんだ、簡単な書類と証拠写真を提示するだけですぐやれます…", "…植は二割もできないんじゃないかと言われていたんですよね。何と、査定前着工のおかげで九割田植ができたんですよ、九割も。私、このとき学んだ教訓と…", "…大変なものがありますよね。そこで、大臣、国交省とか農水省のこの査定前着工の精神、これは、困っている人にできるだけ早く手が差し伸べられる、そう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01220200515/140", "sentence": []}]}]}, {"date": "2021-04-07", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405124X00920210407/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X00920210407/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X00920210407/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X00920210407/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X00920210407/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X00920210407/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X00920210407/40", "s