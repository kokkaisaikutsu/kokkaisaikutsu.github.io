[{"date": "2020-04-06", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会第二分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/249", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/251", "sentence": ["…ら約十年間、千葉県議会議員をしておりました。そのときから持っていた問題意識なんですが、というのは、当時、千葉県教育委員会、学校の先生の資格を…", "…が大体五〇％ぐらいいたんですね。私は、非常に多いんじゃないかという問題意識を持っていたんですよ。とにかく、学校現場で優秀な成績を上げた人が県…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/253", "sentence": ["…臣、私と認識を共有していただいて、ありがとうございます。ぜひ、その問題意識を持ち続けていただいて、文科省に適切な指導助言を各教育委員会にする…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/255", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/257", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/259", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/261", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/263", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/265", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/267", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104132X00120200406/269", "sentence": []}]}]}]