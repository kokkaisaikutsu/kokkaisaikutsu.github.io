[{"date": "2020-03-06", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/126", "sentence": ["…せんだっての参議院予算委員会でも我が会派の蓮舫議員も指摘しましたが、公文書管理法に基づいた行政文書の管理に関するガイドラインというのがあるん…", "…を認めたと私は受けとめています。そこで、私はこういった会議について記録を残すべきと考えますけれども、公文書管理担当の内閣府の見解を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/143", "sentence": ["…ういった政策決定過程での会議の議事録というのはとっておくのが、まさに公文書管理法に基づく歴史的緊急事態といいますか、そういうことだと思うんで…", "…ですよ。文書管理法というのは、福田内閣のときに、福田総理の肝いりで、公文書というのは国民共有の知的資源、こう位置づけられたわけですよね。ぜひ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/149", "sentence": ["○谷田川委員いろいろありがとうございました。公文書については、赤羽大臣が公文書担当大臣になられればよかったなということを思いをいたしました。…", "…田川委員いろいろありがとうございました。公文書については、赤羽大臣が公文書担当大臣になられればよかったなということを思いをいたしました。いず…"]}]}]}]