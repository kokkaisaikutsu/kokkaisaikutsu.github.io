[{"date": "2020-06-01", "meeting": [{"meeting_name": "衆議院 政治倫理の確立及び公職選挙法改正に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/23", "sentence": ["…上げなかったんだけれども、日程がおくれた理由というのは、やはり衆参ダブル選挙を最後まで考えていたからなんですよ。安倍総理も、去年の参議院選挙…", "…よ。安倍総理も、去年の参議院選挙の投票日のときのテレビ番組で、衆参ダブル選挙を考えなかったらうそになるというようなこともおっしゃっていました…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/25", "sentence": ["…ます。そこでまず、ちょっと観点は少しずれますけれども、昨年、大阪のダブル選挙が実施されました。知事がやめて市長選へ、市長が出て知事選へと、非…", "…でだよという緩和措置がとられました。そういうわけで、私は、この大阪ダブル選挙、公職選挙法の二百五十九条の二の精神から逸脱していると思いますが…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104577X00320200601/37", "sentence": []}]}]}]