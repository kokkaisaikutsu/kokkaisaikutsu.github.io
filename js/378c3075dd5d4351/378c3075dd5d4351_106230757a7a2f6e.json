[{"date": "2020-03-06", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/116", "sentence": ["…だ、一つ残念なのが、羽田空港のことについては言及があったんですが、成田空港について何もなかったんですよ。特に、成田空港は、この一月三十一日に…", "…言及があったんですが、成田空港について何もなかったんですよ。特に、成田空港は、この一月三十一日に機能強化案が、大臣の承認がされているんですよ…", "…よ。これは大体五千億円ですよ、事業費。非常に大事な点なので、ぜひ大臣、大臣の成田空港の機能強化に向けた決意をお聞かせいただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/149", "sentence": []}]}]}, {"date": "2020-04-15", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/34", "sentence": ["…共有していただきたい、そのことを要望したいと思います。そこで、まず成田空港について質問をさせていただきます。まさに今、成田空港も、昭和五十三…", "…。そこで、まず成田空港について質問をさせていただきます。まさに今、成田空港も、昭和五十三年