[{"date": "2020-06-02", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/4", "sentence": ["…法律案を議題といたします。本案の趣旨説明に関しましては既に聴取をしておりますので、これより質疑に入ります。質疑のある方は順次御発言願います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/131", "sentence": ["…進め方について申し上げます。まず、後藤参考人、赤松参考人、上野参考人の順にお一人十分以内で御意見をお述べいただき、その後、委員の質疑にお答え…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/137", "sentence": ["…述は終わりました。これより参考人に対する質疑を行います。なお、質疑及び答弁は着席のままで結構でございます。質疑のある方は順次御発言願います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00820200602/231", "sentence": []}]}]}]