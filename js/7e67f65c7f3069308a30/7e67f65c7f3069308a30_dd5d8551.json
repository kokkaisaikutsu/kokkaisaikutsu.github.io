[{"date": "2020-03-13", "meeting": [{"meeting_name": "衆議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/15", "sentence": ["○松島委員長次に、川内博史さん。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/21", "sentence": ["○松島委員長速記を起こしてください。大臣に、川内委員の質問に対する再答弁をお願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/57", "sentence": ["○松島委員長速記を起こしてください。森大臣、川内委員の質問にお答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/112", "sentence": ["○松島委員長川内委員が、法律に基づくのかどうかを答えてほしいとおっしゃいました。そして、野党の理事からも、それについてきちっと答えていない、…", "…りましたので、私は大臣に答弁をお願いしました。そして、その法的根拠の有無という川内委員の質問に対しては、答弁をきちっとしたと思っております。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/114", "sentence": ["○松島委員長川内さんの質問に対しては答えたと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/117", "sentence": ["○松島委員長川内委員、いかがでしょうか。質問に対しては答弁を。質疑の持ち時間が終了いたしました。速記を停止した十分を考慮し、当初よりずらしま…", "…質問席からのいてください。藤野保史さんの質問時間に入っております。（川内委員「最後、一言言わせてくださいよ」と呼ぶ）川内さん、一言だけ。質疑…", "…藤野保史さんの質問時間に入っております。（川内委員「最後、一言言わせてくださいよ」と呼ぶ）川内さん、一言だけ。質疑時間は終わっていますから。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/204", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/206", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/210", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00420200313/215", "sentence": []}]}]}]