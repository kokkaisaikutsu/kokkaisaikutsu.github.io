[{"date": "2020-10-08", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/34", "sentence": ["○杉尾秀哉君形式的任命というふうにはっきり書いてありますよね。実際に、これも資料としてお配りしました。一九八三年五月十二日、参議院の文教委員…", "…任命で会員の任命は左右されない。中曽根総理に至っては、政府が行うのは形式的任命にすぎない、この想定問答どおりに答弁されている。十一月には丹羽…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/40", "sentence": ["…一八年の文書に何て書いてありますか。あれだけ、だって中曽根総理大臣が形式的な任命権であると言いながら、ここに何て書いてあるのか。内閣総理大臣…", "…。内閣総理大臣による会員の任命は、推薦を前提とするものであることから形式的任命と言われることもあると書いてある。言われることもあるじゃなくて…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/58", "sentence": []}]}]}]