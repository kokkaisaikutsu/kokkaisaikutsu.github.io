[{"date": "2020-03-25", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/192", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/194", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/204", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/206", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/208", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/210", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/212", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/229", "sentence": ["○杉尾秀哉君是非お願いします。太田主計局長にも来ていただきましたので、一つ伺います。来年度予算が上がったら、次はこの新型コロナ対策の補正予算…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/233", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/235", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/237", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/239", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/241", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/243", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/245", "sentence": ["○杉尾秀哉君手記にはこう書いてあります。麻生財務大臣、太田理財局長の説明、行政文書の開示請求の中で、改めて近畿財務局で確認したところ、法律相…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/247", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/249", "sentence": ["○杉尾秀哉君太田理財局長にここも伺います。同じく虚偽答弁だというふうに書かれていますけれども、太田理財局長、その当時ですね、現主計局長、太田…", "…ここも伺います。同じく虚偽答弁だというふうに書かれていますけれども、太田理財局長、その当時ですね、現主計局長、太田主計局長はこの部分について…", "…弁だというふうに書かれていますけれども、太田理財局長、その当時ですね、現主計局長、太田主計局長はこの部分についてどういうふうに思われますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/253", "sentence": ["○杉尾秀哉君太田局長、いるじゃないですか。答えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/255", "sentence": ["○杉尾秀哉君太田さんは、ここで何度も何度もどういうふうに答弁したんですか。文書に気付かず悔いがある、おわびする、何度も何度もおっしゃっている…", "…確認する必要があります、あっ、虚偽説明か否か確認する必要があります。太田局長にも証人として来ていただかなきゃいけない、こういうことになります…", "…と、こう書いてあるんですよ。だから、麻生大臣、麻生大臣の説明、そして太田当時の理財局長の説明が虚偽だというふうに赤木さんはおっしゃっているん…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/257", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/259", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/261", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/263", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/265", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/267", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/269", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/271", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325