[{"date": "2020-05-26", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/106", "sentence": ["○川合孝典君常習性の認定できるほどの調査していないから常習性の認定ができていないということなんですよ。刑事罰として要は判断していないというこ…", "○川合孝典君常習性の認定できるほどの調査していないから常習性の認定ができていないということなんですよ。刑事罰として要は判断していないというこ…", "…れ以外の過去のいわゆる賭けマージャン行為だとか、そういうことについて新たな事実関係が認定されればこの判断は変わるという理解でよろしいですね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/108", "sentence": ["○川合孝典君ということは、過去のマージャン行為に対しても既に事実認定ができたという理解でよろしいですか、今の説明だと。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/112", "sentence": []}]}]}, {"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/29", "sentence": ["…させていただきたいんですが、先ほどの危険運転が過失運転と結局結果的に認定されたということにもつながってくるんですが、そういったいわゆる判断を…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/33", "sentence": ["…おいても、四度繰り返し危険なあおり行為があったということが一つの事実認定の根拠になったように私は理解しておるんですけれども、この辺りのところ…", "…当然なるわけなんですけれども、これが何度か起こると、要はあおりとして認定される、捕まる可能性が高まるといったようなことが明示的に示されるとい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/35", "sentence": ["…、私は、そもそもこのドライブレコーダーの情報がこのいわゆる危険運転を認定する上でどれほどのウエートを占めているのかということについてちょっと…", "…ょっと確認させてください。ドライブレコーダー情報というのは、この一連の危険運転行為を認定する上での重要度というのはどのようなものでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/43", "sentence": []}]}]}]