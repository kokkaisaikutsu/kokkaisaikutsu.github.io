[{"date": "2020-03-18", "meeting": [{"meeting_name": "衆議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/42", "sentence": ["…たしております。医療機関向けのいわゆるサージカルマスクにつきまして、具体的に申し上げますと、現在、国内体制によりまして、月産六千五百万枚……"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/44", "sentence": ["○小島大臣政務官お答え申し上げます。日本におきましては月産九千万枚でございます。これは月産ですよ。月産九千万枚。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/46", "sentence": ["○小島大臣政務官需要につきましては、月産九千万枚です。月の需要が九千万枚。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/54", "sentence": ["○小島大臣政務官今現在、月産六千五百万枚でございます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/56", "sentence": ["…海外からの輸入なんですね。これが今、中国等が入っておりません。そういう中で、今申し上げたように月産六千五百万枚、日本でいえばということです。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/64", "sentence": ["○小島大臣政務官一応、六億枚と言いましたけれども、今現在は九千万枚でありまして、そして、月産、できていましても六千五百万枚でございます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00320200318/82", "sentence": []}, {"url": "https://kok