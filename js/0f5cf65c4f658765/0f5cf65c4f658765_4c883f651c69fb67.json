[{"date": "2020-04-14", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/58", "sentence": ["○小島大臣政務官お答え申し上げます。行政検査として行うＰＣＲにつきましては、検査に係る自己負担分は公費で賄うことになっております。したがって…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/62", "sentence": []}]}]}, {"date": "2020-05-13", "meeting": [{"meeting_name": "衆議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104080X00920200513/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00920200513/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00920200513/166", "sentence": ["…ＰＣＲ検査に係る費用につきましては、御指摘の検査試薬の費用を含め、行政検査として行うＰＣＲ検査につきましては、費用は全額公費で行うこととして…", "…という公衆衛生目的として実施する観点もあることから、都道府県等から行政検査を委託しているものとして取り扱い、検査費用の自己負担分は行政が補助…"]}]}]}]