[{"date": "2021-03-22", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/108", "sentence": ["…いうふうに思います。ちょっとテーマを変えまして、次に博士課程修了者のポストについて伺ってまいりたいというふうに思います。文部科学省におかれま…", "…に思っております。しかしながら、一方で、博士課程修了者、その修了後のポストを十分に確保していくということも同様に進めていかなければなりません…", "…を十分に確保していくということも同様に進めていかなければなりません。ポストをセットで拡充しなければ、結局高学歴のワーキングプアを生み出すとい…", "…ねないからです。そこで、文科省にお尋ねをいたしますが、任期なしのアカデミックポストを更に拡充すべきと考えますが、御所見を伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/110", "sentence": ["…安心して夢に向かって突き進んでいけるためにも、任期なしのアカデミックポストの拡充を引き続きお願いをしたい、このように思います。あわせまして、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00420210322/122", "sentence": []}]}]}]