[{"date": "2020-03-23", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/341", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/343", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/345", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/347", "sentence": ["…からスタートいたします。しかし一方で、新型コロナの影響によって家計が急変をし、大学、高校への進学あるいは修学の継続が困難な状況に陥りつつある…", "…ある若者が多数います。そこで、今回の新型コロナウイルスによって家計の急変があった学生に対しましても、奨学金支援を速やかに行い、救済をしていた…", "…国として、自治体とも連携をしつつ、学校独自の授業料延納制度の拡充を支援するなど、家計の急変に応じた柔軟な支援を行っていただけないでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/349", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/351", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/353", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/355", "sentence": []}]}]}, {"date": "2021-03-16", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415104X00320210316/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00320210316/106", "sentence": ["…新年度を迎えるに当たって、学生さんたち、またその親御さんの状況も突然急変することもあり得るわけであります。いずれにいたしましても、いかなる経…", "…性ということを踏まえると、やはり一か月、二か月で、短いスパンで状況が急変し得るということも重要な観点かというふうに思います。政治は機敏に反応…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00320210316/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00320210316/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00320210316/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00320210316/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00320210316/116", "sentence": []}]}]}]