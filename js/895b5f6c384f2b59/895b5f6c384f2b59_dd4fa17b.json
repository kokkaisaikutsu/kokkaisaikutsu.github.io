[{"date": "2020-05-28", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00920200528/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00920200528/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00920200528/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00920200528/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00920200528/52", "sentence": ["…。済みません、時間の都合上、最後の質問とさせていただきます。遺言書の保管制度について質問をさせていただきたいというふうに思います。今年の七月…", "…質問をさせていただきたいというふうに思います。今年の七月より遺言書の保管制度がスタートするものと承知をしております。遺言書を法務局に保管して…", "…書の保管制度がスタートするものと承知をしております。遺言書を法務局に保管してもらうこと等を内容とするこの制度の利用により、遺言書の紛失、滅失…", "…きと考えますが、いかがでございましょうか。また、あわせまして、遺言書保管制度についても同様の観点から積極的に周知、広報を行うべきと考えますが…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00920200528/54", "sentence": []}]}]}, {"date": "2021-03-17", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/399", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/401", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/403", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/405", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/407", "sentence": ["…かりと万全の体制にしていくということももちろんでございますが、物資を保管しているのは倉庫でございます。大きな営業用、営業倉庫を中を見たことが…", "…が、本当に数十メートルの高いラックに多くの荷物がパレットに載せられて保管されている状況を拝見した機会がございます。大地震が起こった際、このラ…", "…災害時においても途切れることのない物流を実現するとの観点から、貨物の保管拠点である営業倉庫において荷崩れ防止のための取組の強化、この必要性に…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/409", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/411", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/413", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/415", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01220210317/417", "sentenc