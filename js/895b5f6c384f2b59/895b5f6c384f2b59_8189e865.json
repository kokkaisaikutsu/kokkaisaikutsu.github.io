[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/56", "sentence": ["…ついての判断であろうかと思います。確認になりますが、判決、多数意見、憲法二十四条違反の主張に対してどのように判断しているか、要旨を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/60", "sentence": ["…の中で岡部喜代子裁判官の意見が傾聴に値すべきものと考えます。この岡部裁判官は二十四条違反についてどのように判示したのか、要旨をお願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/65", "sentence": []}]}]}]