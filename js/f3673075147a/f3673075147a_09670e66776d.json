[{"date": "2021-04-08", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/114", "sentence": ["…なのか、そして一番きつい、厳しいという伊勢湾はどうなのか、もう一つは有明海、あれも似たような地形ですからね、どうなのか、説明してもらえます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/116", "sentence": ["…う意味で、海水が入れ替わらない。周りはほとんど全てが大都市ですよね。有明海は周りがほとんど緑、山なんですよ。行ったことあると思いますが、ほと…", "…、ほとんど山でしょう、緑。それと、干満の差、これが大きいんですよね、有明海は。だから、ここも海水の入替えというか、大分いいんじゃないかなと。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/118", "sentence": []}]}]}]