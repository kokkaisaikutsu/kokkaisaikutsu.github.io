[{"date": "2021-03-16", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/84", "sentence": ["…な状況になっているのかなと、そこでどういう議論がされて、いつ頃までに結論を出すのかなということについてまず教えていただきたいんですけれども。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/86", "sentence": ["…いますので。ちなみに、中央環境審議会、産業構造審議会というのが一つありますが、これは何を目的にして、いつ頃までに結論を出すつもりなんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/88", "sentence": ["…がない中で答えを出すと。では次に、経産省中心なんでしょうけど、成長戦略会議というのはどういう内容で、いつまでに結論を出すおつもりなんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/90", "sentence": ["○柳田稔君いつ頃までに結論を出す計画なんです。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/96", "sentence": ["○柳田稔君これもそう長く掛けずに結論を出すという感じで進んでいるんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/100", "sentence": []}]}]}]