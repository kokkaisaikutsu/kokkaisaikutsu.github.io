[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/13", "sentence": ["…た。一九六四年のオリンピックに合わせて造られ、世界の注目を集めた首都高速道路でありますけれども、建設から約五十五年が経過をしていまして、高架…", "…て、一日百万台の車が行き交い、老朽化に拍車を掛けておって、現在、首都高速で見付かる損傷は一年でおよそ四万か所に上るということであります。その…", "…考えますけれども、今後どのように具体的に進めていくのか。先ほどの首都高速の事例も含めて、その効果を見込まれるのかを御見解をお伺いするとともに…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/22", "sentence": []}]}]}]