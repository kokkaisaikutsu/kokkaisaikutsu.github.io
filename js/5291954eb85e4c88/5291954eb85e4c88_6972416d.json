[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/5", "sentence": ["…ては大変大きな役割であります。また、国民の生活を支えるトラックなどの物流に関わる方、こうした方の役割も大変大きいというふうに思います。トイレ…", "…になるというふうにも考えられます。特に私が心配するのは、食品に関する物流が滞ってしまうとこれは大変なことになるというふうに考えます。こうした…", "…通省として、新型コロナウイルスの感染拡大を阻止するための取組について、特に公共交通関係、そして物流関係の対応についてお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/22", "sentence": []}]}]}]