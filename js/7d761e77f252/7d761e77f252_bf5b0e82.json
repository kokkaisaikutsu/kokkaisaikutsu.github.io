[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/85", "sentence": ["…二日の記者会見において、今回私の副大臣をやっていただくに当たり、議員宿舎があるのだから議員宿舎に入れと命じまして、青山宿舎に入りましたと説明…", "…、今回私の副大臣をやっていただくに当たり、議員宿舎があるのだから議員宿舎に入れと命じまして、青山宿舎に入りましたと説明されています、大臣がで…", "…だくに当たり、議員宿舎があるのだから議員宿舎に入れと命じまして、青山宿舎に入りましたと説明されています、大臣がですね。山本防衛副大臣は二〇一…", "…月十三日に防衛副大臣に任命されていますけれども、河野防衛大臣は、議員宿舎に入れというふうにおっしゃったのはいつなんでしょうか、山本副大臣に。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/91", "sentence": ["○白眞勲君ちょっと私、分からないのは、副大臣、なぜ議員宿舎に入らなかったんですか。なぜなんですか、これ、今まで。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/95", "sentence": ["…ろ、防衛省の政務三役が在京待機を行う際には、都内に住居がなければ議員宿舎を自費で借りて危機管理対応をしているのが通常でしたというふうな文章が…", "…ども、ちょっと私これを見てびっくりしたんですよね。普通、大体もう議員宿舎にいるのが当たり前だろうと思っていたら、今、今回確認したらそうだった…", "…も、そもそもそういう自覚はあるんでしょうかということなんですね。議員宿舎というのは在京時の公務の円滑な遂行のために設けられているわけでして、…", "…うのは在京時の公務の円滑な遂行のために設けられているわけでして、副大臣として何のための議員宿舎であるというふうに考えていらっしゃるんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/101", "sentence": ["…かったかもしれないけど、いざというときにどうなるんだというための議員宿舎であるということじゃないんでしょうか。それで、ちょっとお聞きしたいん…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/105", "sentence": ["…ら検討した方がいいと思いますよ。私、もう一つ分からないのが、何で青山宿舎に、これ入居していれば公費負担による宿泊の必要は全くなかったわけです…", "…費を支払ってくれるから、それだったら、ホテルに宿泊すれば、家賃、議員宿舎の家賃も節約できるんじゃないかななんて、そういうふうに思ったんじゃな…", "…ったら、ちょっとみみっちくないのかなと私は思っているわけですよね。これ、議員宿舎に入居することを避ける何らかの理由というのはあったんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/125", "sentence": 