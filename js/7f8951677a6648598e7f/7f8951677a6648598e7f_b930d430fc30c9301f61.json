[{"date": "2020-03-11", "meeting": [{"meeting_name": "衆議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/12", "sentence": ["…ところなんですけれども、これまで私たちが聞いております範囲の中で、スピード感のある、そして十分な対応がなされているとはとても言えないと思って…", "…なのに、二カ月、三カ月待たされたらどういうことになりますか。もっとスピード感を持ってやってもらいたい。これは本当の、文字どおりの死活問題です…", "…よ。出ているけれども、実際にそれが回るかどうかというところが大事なので、もっとスピード感を持ってやるべきだと思いますけれども、いかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/14", "sentence": ["…なところで上げられています。そのことを真剣に受けとめていただいて、スピード感なんて生易しい言葉じゃない、すぐやってください。今いいことをいろ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00320200311/32", "sentence": []}]}]}]