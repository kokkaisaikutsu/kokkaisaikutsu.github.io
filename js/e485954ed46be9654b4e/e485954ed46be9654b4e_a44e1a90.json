[{"date": "2020-02-18", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/22", "sentence": ["…、国が音頭をとらねばならぬと考えます、国民の命を守り抜くために。国土交通省として、樹木伐採、河道掘削等をどう進められるのか、お伺いいたします…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/26", "sentence": ["…ほかのダムがあかんかったと言われて批判されたら、特に、省を超えて国土交通省のダムに批判が行って御迷惑をかけたらあかんと言うて、これは伏せてく…", "…どうするかという問題を解決する必要があると思いますけれども、赤羽国土交通大臣に見解をお伺いしたいと思います。また、事前放流を実施するためには…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/28", "sentence": ["…よろしくお願い申し上げたいと思います。今回、予算といたしまして、国土交通省の地方整備局、こちらは定数がふえております。地方整備局の定員は、平…", "…さかのぼれば、五十三年ぶりの歴史的な快挙ということになりますけれども、赤羽交通大臣に地方整備局の現場の定員が増加する意義をお伺いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/36", "sentence": []}]}]}]