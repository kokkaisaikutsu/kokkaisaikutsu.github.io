[{"date": "2021-04-05", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/24", "sentence": ["…した状況の中でこの大会の開催意義を国民に理解していただくには、やはり五輪精神の原点、すなわち平和や人権の尊重といった原点に立ち返ることが重要…", "…効果は大きく減殺されることになりましょうけれども、しかしその分、この五輪精神を見詰め直す、コンセプトを見詰め直す非常にいい機会ではないかと私…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/26", "sentence": ["○古賀友一郎君ありがとうございました。今こそこの五輪精神を見詰め直すときであると、こういうことであります。今回、最後にこの平和の問題を取り上…"]}]}]}]