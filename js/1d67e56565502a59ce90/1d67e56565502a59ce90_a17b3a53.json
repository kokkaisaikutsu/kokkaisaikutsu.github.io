[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/29", "sentence": ["…ども、先日の国土交通委員会、我々の視察で、那覇港、海上保安庁の第十一管区を視察をさせていただきました。まさに、この今資料三にありますとおり、…", "…いうことを我々も認識をさせていただきました。同じ時期に私、横浜港第三管区も視察をする機会をいただきまして、まさに第三管区といえば、小笠原諸島…", "…時期に私、横浜港第三管区も視察をする機会をいただきまして、まさに第三管区といえば、小笠原諸島、南鳥島、沖ノ鳥島といった本当に広い海域を管轄を…", "…ものを教えていただきました。そうした中で、特に気になったのが、第十一管区の巡視船「おきなわ」を視察をさせていただきました。船長のいらっしゃる…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/42", "sentence": []}]}]}]