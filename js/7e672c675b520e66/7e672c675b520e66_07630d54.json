[{"date": "2020-03-04", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00120200304/1", "sentence": ["…が一名欠員となっております。その補欠選任につきましては、先例により、委員長において指名するに御異議ありませんか。〔「異議なし」と呼ぶ者あり〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00120200304/2", "sentence": ["○松本委員長御異議なしと認めます。よって、そのように決しました。それでは、理事に大西健介君を指名いたします。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00120200304/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00120200304/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00120200304/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00120200304/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00120200304/9", "sentence": []}]}]}]