[{"date": "2020-03-31", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/108", "sentence": ["…が進む中で、なかなか難しい目標になるのではないかと思います。一方、輸出額で見れば、二〇一九年は、当初の農林水産物・食品目標、輸出額一兆円だっ…", "…。一方、輸出額で見れば、二〇一九年は、当初の農林水産物・食品目標、輸出額一兆円だったのが、結果九千百二十一億円となりました。そのうち和牛の輸…", "…回ったことは大変喜ばしいことであると思います。そして、二〇三〇年には総額で五兆円を目標にしているというふうに書かれておりますが、そこで、政府…", "…書かれておりますが、そこで、政府が考える二〇三〇年のそのときの和牛輸出額の目標をどのように考えられているのか、お答え願えればありがたいと思い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/122", "sentence": []}]}]}]