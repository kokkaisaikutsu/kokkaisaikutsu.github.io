[{"date": "2020-03-31", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/112", "sentence": ["…江藤大臣にお願いと応援をいただきたいと思っております。私の地元広島県庄原市に、七塚原牧場畜産試験場がございます。畜産を普及しようと、日本で最…", "…ざいます。畜産を普及しようと、日本で最初の国策国営の種牛牧場は広島県庄原市にある七塚原種牛牧場と聞いておりますが、そのとおりでよろしいでしょ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/114", "sentence": ["…まで畜産資料館として活用されております。私がお願いしたいことは、この庄原、まさに畜産の、日本のスタートだったという原点、しかし、その後、江藤…", "…出身の宮崎県、鹿児島県、これは和牛のまさに横綱でございます。今、地元庄原で、この畜産試験場の古い建物を文化財として何とかして登録をして、それ…", "…の古い建物を文化財として何とかして登録をして、それを起点に、この地元庄原、隣は神石牛というまた牛のメッカでもございます。でも、まだまだ横綱に…", "…す。地元の方々が今、この文化財登録、及び、もう一度原点に立ち返って、庄原、神石といったところを和牛の産地としていきたい。比婆牛というのがござ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/122", "sentence": []}]}]}]