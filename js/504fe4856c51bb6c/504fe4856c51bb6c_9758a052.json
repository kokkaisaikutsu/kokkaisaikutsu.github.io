[{"date": "2020-03-31", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/108", "sentence": ["…からいただいた事前資料では、牛肉、牛乳・乳製品などの畜産の国内需要の増加への対応と輸出拡大に向けてと書かれておりますけれども、国内需要増加に…", "…の増加への対応と輸出拡大に向けてと書かれておりますけれども、国内需要増加については、人口減が進む中で、なかなか難しい目標になるのではないかと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/110", "sentence": ["…います。そこで、これは確認です。今回のこの法改正は、和牛の価値を守りその価値を高める、輸出増加につなげていくということでよろしいでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/122", "sentence": []}]}]}]