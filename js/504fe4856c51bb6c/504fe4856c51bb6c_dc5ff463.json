[{"date": "2020-03-31", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/112", "sentence": ["…員そこで、少し私の地元の話もさせていただきながら、江藤大臣にお願いと応援をいただきたいと思っております。私の地元広島県庄原市に、七塚原牧場畜…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/114", "sentence": ["…全てできるとは私は思いません、こういったところに力を注いでいただく、応援をしていただくことが、私は大事であり、また私からお願いをしたいことで…", "…省として力を今後注いでいただきたいという思いで、大臣に、御感想というか、応援をお願いできるような御答弁をいただけたら、ありがたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/116", "sentence": ["○佐藤（公）委員ありがとうございます。大変力強い応援をいただいた答弁だというふうに私は思いました。それを地元に持って帰って、和牛をこれからや…", "…ていこうというみんなに私はこの話をさせていただきますので、どうか強い応援をお願い申し上げたいと思います。さて、もう時間もなくなってきてしまっ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01020200331/122", "sentence": []}]}]}]