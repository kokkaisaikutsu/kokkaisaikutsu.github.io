[{"date": "2020-11-18", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/8", "sentence": ["…されることについて、東京都民はもちろん、国民が不安を感じるようでは、歓迎されるオリンピックにならないのではないか。私は、国民がこぞって歓迎を…", "…、歓迎されるオリンピックにならないのではないか。私は、国民がこぞって歓迎をする、喜びを持って迎えるオリンピックになってほしいと願っているわけ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/12", "sentence": ["○中村（裕）委員私の方では、国民がこぞって歓迎をするオリンピックになってほしい、そういう意味では、国民が不安を感じないような形で検査体制をと…", "…うな形で検査体制をとっていただいて、訪日する外国人のお客様をみんなで歓迎していきたいと思いますので、ぜひ中間取りまとめに向けて慎重な御検討を…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00320201118/22", "sentence": []}]}]}]