[{"date": "2020-04-06", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会第四分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/217", "sentence": ["…いうことを最初に考えていただきたいと思います。そういった意味で、船が大型化をする、これは悪いことばかりではありません。船員の居住性を確保して…", "…なか乗っていただけないというような事情もございます。そういった中で、大型化というのは必要なんでしょう。ただ、大型化するのに、規制そのものとい…", "…ございます。そういった中で、大型化というのは必要なんでしょう。ただ、大型化するのに、規制そのものというか海技士の資格そのもの、こういった安全…", "…、これについて反対の声が上がっているというふうに聞いております。船は大型化し、さはさりながら資格は緩和では安全が保てないんじゃないかという声…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/219", "sentence": ["…大丈夫なのかという声を上げられています。例えて言えば、普通車から車は大型化するのに、免許そのものは、普通免許どころか普通のバイクの免許でも運…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/229", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/233", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/235", "sentence": []}]}]}]