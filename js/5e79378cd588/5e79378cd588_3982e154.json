[{"date": "2020-04-06", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会第四分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/217", "sentence": ["…いった意味で、船が大型化をする、これは悪いことばかりではありません。船員の居住性を確保していただく、これは大事なことです。まして、海技士とい…", "…安全上の観点から、実際にそういった船に乗っておられるような皆さん方、船員の団体の皆さん方から、これについて反対の声が上がっているというふうに…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/219", "sentence": ["…。でも、本当にそれで大丈夫なんでしょうか。何より専門家であるところの船員さん方が、こんなので大丈夫なのかという声を上げられています。例えて言…", "…やはり安全というのは何よりかえがたいものでございますから、乗船される船員の不安は看過できるものではないというふうに思います。そういった意味で…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/229", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/233", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/235", "sentence": []}]}]}]