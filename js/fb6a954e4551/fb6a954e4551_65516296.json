[{"date": "2021-05-13", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/17", "sentence": ["…知り合いの七十代の女性ですけれど、自宅療養していました、犬がいるので入院したくないと言ってですね。ところが、一週間ぐらいたってみたら酸素飽和…", "…一週間ぐらいたってみたら酸素飽和度が九〇％ぐらいになりました。慌てて入院した方がいいからと言ったら、肺は真っ白でした。このときに何が問題なの…", "…てはパルスオキシメーター全員に配付して、何％を切ったらちゃんとすぐに入院させるとかそういう体制取らないと、自宅療養で亡くなる方々は相当増える…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/19", "sentence": ["…の方々の方が圧倒的に亡くなっている割合高いんですよ。重症化しなければ入院できなくなっているから、今度は病院もすごく大変になってくるわけですよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01020210513/31", "sentence": []}]}]}]