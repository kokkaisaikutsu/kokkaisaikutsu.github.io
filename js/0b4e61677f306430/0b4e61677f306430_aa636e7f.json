[{"date": "2020-11-13", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/53", "sentence": ["…ふうに思います。このリモートは、今度のコロナが入ったことによって特別措置を文科省でもやられていて、大学の設置基準でいうと、卒業要件は百二十四…", "…百二十四単位中、遠隔授業は六十単位まで上限だったんですが、今回、特別措置としてこれを取っ払っていいと。簡単に言えば、全単位をリモートでも取れ…", "…ですが、今回、特別措置としてこれを取っ払っていいと。簡単に言えば、全単位をリモートでも取れますよという特別措置で理解してよろしいでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/55", "sentence": ["…これは大変ありがたい話です。ただ、私がお聞きしたところによると、この措置は、来年度末、つまり令和三年末までというふうにお聞きしています。それ…", "…ちもいらっしゃると思います、大学を目指している中で。これはぜひ、特例措置の期限をあと一年ちょっとじゃなくて、なぜかというと、一年ちょっとでは…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00220201113/75", "sentence": []}]}]}]