[{"date": "2020-04-03", "meeting": [{"meeting_name": "衆議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/152", "sentence": ["…療体制というのは当然、マスクあり、防護服あり、それで、ベッドだ、人工呼吸器だ、それからＥＣＭＯとかなんとか、いろいろありますよね。その中で、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/160", "sentence": ["…願いします。今ちょこっと出たＥＣＭＯの話であります。ＥＣＭＯは、人工呼吸器がだめになっちゃって、肺が全くだめな人に対して、血液から二酸化炭素…", "…、それで何とか治していきたいということですよね。それで、私のところに呼吸器関連の団体から来ている資料でいくと、ＥＣＭＯを最近使った四十五例か…", "…。ところが、看護師さん、それからお医者さん以外にも、ＥＣＭＯとか人工呼吸器というのは、私が聞いている話では、大体お医者様一人で三台ぐらいしか…", "…す、技士を。医師と看護師にしたんですけれども、あと、過去において人工呼吸器とかＥＣＭＯを取り扱える人たちもいると思うし、あれはどのぐらいの教…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X00620200403/166", "sentence": []}]}]}]