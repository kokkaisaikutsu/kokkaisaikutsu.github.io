[{"date": "2020-06-12", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/58", "sentence": ["○三谷委員ありがとうございます。私も、以前、マンションを購入させていただいたことがありまして、そのときにやはり気になるのが、マンションの値段…", "…ことですので、早いうちに手放した方はちょっと得をするんですが、後から購入される方が実質この積立金を多く支払うということで、損をしかねないとい…", "…ブルにつながることもあるというふうに言われております。ちなみに、私が購入したマンションも同じ問題を抱えておりまして、私も当時理事を務めていた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/70", "sentence": []}]}]}]