[{"date": "2020-11-26", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314319X00220201126/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00220201126/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00220201126/52", "sentence": ["…隆君ありがとうございます。是非御尽力いただきたいと思います。次に、国土強靱化の観点から、公共交通機関への公的助成の充実についてということで御…", "…地方公共交通に対する予算などの公的援助を充実することがトータルでは国土強靱化に本当につながっていくんだろうと、こういうふうに考えております。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00220201126/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00220201126/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00220201126/58", "sentence": []}]}]}]