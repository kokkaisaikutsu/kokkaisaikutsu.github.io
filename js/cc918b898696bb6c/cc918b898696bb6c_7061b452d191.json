[{"date": "2020-06-11", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/616", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/618", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/620", "sentence": ["…お話がありました、その医療関係者と同様に最大二十万円、そして五万円の慰労金、早くお届けしたいと、そのように思います。公明党としてもこれも強く…", "…そのように思います。公明党としてもこれも強く要請をしてまいりました。慰労金は、職種や、常勤、非常勤、また設置者の官民の区別にかかわらず、社会…", "…とにも影響がないように非課税で迅速にお届けすべきと考えます。加藤大臣、この慰労金の仕組み、手続について具体的にお示しいただけますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/622", "sentence": ["…います。より広く皆様の手元に届くようによろしくお願いいたします。この慰労金のみならず、介護、障害福祉サービスの施設で、マスク、消毒液等の衛生…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/624", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/626", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/628", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/630", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/632", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/634", "sentence": []}]}]}]