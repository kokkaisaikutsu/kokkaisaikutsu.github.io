[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/256", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/258", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/260", "sentence": ["…い申し上げます。続きまして、この首里城の再建に当たりましては、木材の調達というものが非常に大きなテーマになっております。前回の復元の際には、…", "…方でも、ヒノキの伐採、輸出というものが法的な制約がありまして、簡単に調達はいかないという動きがあります。その一方で、今、日本と台湾の方での議…", "…ぱいまでには工程表が定まっていく流れにおきまして、この最大のテーマの一つである木材の調達についての今の最新の現状というものを教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/262", "sentence": ["…では、国内に首里城に活用できるヒノキはないということも聞いたんですけれども、現状は調達は可能であるということで認識してよろしいんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/264", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/266", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/268", "sentence": ["○國場分科員では、今答弁ありましたように、資材の調達であるとか、何らかの方法でできると理解してよろしいのでしょうか、正式な要請があれば。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/270", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/272", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/274", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/276", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/278", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/280", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/282", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/284", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/286", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/288", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/290", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X0012020