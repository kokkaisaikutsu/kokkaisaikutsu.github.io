[{"date": "2021-05-13", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/30", "sentence": ["…務省自体もそのことを重く受け止めていただきたいというふうに思います。遺族、ごきょうだいの方が日本においででございます。御案内のとおりだという…", "…御案内のとおりだというふうに思いますが、大臣は衆議院の審議の中で、御遺族からの大臣面会の御希望についてどのように御答弁されましたか。また、今…", "…希望についてどのように御答弁されましたか。また、今どのように、今の現時点でどのように御遺族の皆さんとの面談についてお考えでございましょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/32", "sentence": ["…対応をなされ、そして今御答弁ございましたけれども、その真実について御遺族にやっぱり語ることの必要性というものはあるというふうに思っております…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01320210513/52", "sentence": []}]}]}]