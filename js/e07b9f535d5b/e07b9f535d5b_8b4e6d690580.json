[{"date": "2021-04-27", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00820210427/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00820210427/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00820210427/28", "sentence": ["…たいと思うんです。次に、副大臣にお伺いしたいと思います。地方自治体や事業者を巻き込んで国民も、国民が一番最初になって、国、地方自治体、そして…", "…者を巻き込んで国民も、国民が一番最初になって、国、地方自治体、そして事業者とか団体とかと書いてありますね。地方自治体に計画を作ってとかなんと…", "…えばですけれども、目標達成の上に国はこうやるんだ、だから地方自治体も事業者もついてこいというふうに、国こそが今度はここも、この次の改正でいい…", "…ういうのをきちんと、びしばし法律に書いていく。だから、地方自治体は、事業者はこれをやらなくちゃいけないと。民間企業もいろいろやっていますよね…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00820210427/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00820210427/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00820210427/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00820210427/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00820210427/38", "sentence": []}]}]}, {"date": "2021-05-21", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/14", "sentence": ["…、国民にだけ義務を強いてはいけないと思います。私は、たるんでいるのは事業者だと思います。後でこの点については言いますけれども。次に、熱です。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01120210521/22", "sentence