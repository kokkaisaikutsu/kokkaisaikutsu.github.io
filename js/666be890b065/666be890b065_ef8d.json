[{"date": "2020-02-10", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/203", "sentence": ["…ました。また、これが一日で復旧したということもありまして、規格の高い道路の耐久性ということが改めて確認できたところであります。また、平成三十…", "…また、平成三十年におきましては、その豪雨のときに、山陽道が広域的な迂回路として活用されましたし、高知においては高知道が、四車線あったので、そ…", "…通の確保をすることができたということであります。災害時において高規格道路が非常に命綱になるという、国民の安全、安心な生活を確保する上で大変重…", "…の安全、安心な生活を確保する上で大変重要だと私は思っております。高速道路のミッシングリンクの解消、暫定二車線区間の四車線化について、ぜひ進め…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/205", "sentence": ["…部委員ありがとうございます。大臣の御指摘あったとおり、北海道は、高速道路の進捗率も二車線も、大変、進んでいない、四車線化が進んでいないところ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/228", "sentence": []}]}]}]