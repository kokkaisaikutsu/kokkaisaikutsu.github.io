[{"date": "2020-05-13", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/138", "sentence": ["…組を重ねてお願い申し上げたいというふうに思います。続きまして、プラスチックごみの削減に向けてお伺いしたいと思います。日本全体でプラスチックの…", "…ていないんですね、本当数％、二、三％。にもかかわらず、ここからプラスチックごみの削減に取り組んでいこうと、こういう政府のスタンスだというふう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/142", "sentence": ["…君是非しっかりとやっていただきたいなというふうに思います。このプラスチックごみの削減に向けてのやっぱり一丁目一番地の取組は、包装容器ですとか…", "…。日本がそういう世界の流れに遅れないように、しっかりと、今後のプラスチックごみの削減に対して全体どう取り組んでいくのか、その戦略をしっかり立…", "…ップ取ってやるべきことだというふうに思っていますので、今後そのプラスチックごみ全体をどう削減していくのか、そこへの取組についてのお考えを是非…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/152", "sentence": []}]}]}]