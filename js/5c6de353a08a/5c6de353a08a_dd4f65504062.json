[{"date": "2021-08-05", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/78", "sentence": ["…思っております。その一方で、この事務連絡については、都道府県、そして保健所の設置市、そして特別区、こういったところに事務連絡は出されています…", "…この入院基準の見直しについて最終的に誰が判断するのかと。知事なのか、保健所の設置市の首長なのか、特別区の区長なのか、明確になっていないですね…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/80", "sentence": ["…。最終的に、知事とか、じゃ、首長とか特別区の区長さんというのは、もう保健所所長が決めたらもうそれで、その判断に従うということなんでしょうか。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/82", "sentence": ["…の前にあると思うんですけれども、それはあくまで都道府県知事であったり保健所設置の市であったり、あるいは特別区で判断しないといけないかというふ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00220210805/102", "sentence": []}]}]}]