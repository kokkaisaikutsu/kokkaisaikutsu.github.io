[{"date": "2020-05-13", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/150", "sentence": ["…非しっかりやっていただきたいと思います。同じような視点でいうと、地方公営企業も非常に経営的に厳しいところもたくさんあるというふうに認識してお…", "…ももう四兆円になっているというふうに認識しておりますので、これ、地方公営企業というのは、上下水道ですとか病院とか、あるいは交通とか、そういう…", "…いったところに、総務省としても地方公共団体とも連携しながら、この地方公営企業をどう支えていくのか、あるいは広域連携だとか民間活力の活用とか、…", "…携だとか民間活力の活用とか、いろんなアプローチが必要だと思いますけれども、総務省としての地方公営企業への対応についてお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/152", "sentence": ["○浜口誠君是非、地方公営企業にも、総務省としてしっかり関わっていただくことをお願い申し上げて、質問を終わります。ありがとうございました。"]}]}]}]