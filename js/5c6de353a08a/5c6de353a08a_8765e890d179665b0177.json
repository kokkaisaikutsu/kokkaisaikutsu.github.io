[{"date": "2020-05-18", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/107", "sentence": ["…いというように思います。じゃ、国交省さん、もうここで。では、続きまして、文科省にお伺いします。国交省、赤羽大臣、退席していただいて結構です。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/109", "sentence": ["○浜口誠君文科省にお伺いしますけれども、大学の研究力の低下についての懸念をちょっと申し上げたいと思います。国際的な学術誌なんかに掲載される日…", "…であると言っても過言ではないというふうに思っています。こうした中で、文科省も、研究力向上改革二〇一九というのを取りまとめて、しっかりと研究資…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/111", "sentence": ["…とした研究を支える仕組み、あるいはそういう環境を整えていくというのが文科省としての大きな役割だというふうに思っておりますので、このテーマは単…", "…っていただくことを重ねてお願いをしておきたいというふうに思っております。文科省はここで結構でございます。萩生田大臣、ありがとうございました。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/119", "sentence": []}]}]}]