[{"date": "2020-06-09", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/77", "sentence": ["○浜口誠君そのときの、立入検査に行かれるときのチーム編成というのはどのような編成を考えられているんですか。お一人で行くのか、お一人だと何かト…", "…ブルがあったときに迅速な対応ができないということにもなるので、複数のチームとして立入り、聴取に入られるのか。具体的なチーム編成についてどのよ…", "…とにもなるので、複数のチームとして立入り、聴取に入られるのか。具体的なチーム編成についてどのような考え方でやるのか、お伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/79", "sentence": ["…君是非、立入検査で何が起こるか分からないので、安全の確保という面でもチーム編成はしっかりと整えて対応していただきたいというふうに思っておりま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01920200609/161", "sentence": []}]}]}, {"date": "2020-06-15", "meeting": [{"meeting_name": "参議院 決算