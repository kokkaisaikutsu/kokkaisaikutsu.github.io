[{"date": "2020-03-03", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/52", "sentence": ["○浜口誠君じゃ、誠実に履行されている間は、米国が安全保障上を理由にしても発動しないということでよろしいですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/54", "sentence": ["…ということを今日確認させていただいたというふうに思います。じゃ、その誠実に履行されている間というのは、具体的にどういうことなんですかね。具体…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/56", "sentence": ["○浜口誠君それでは、今から申し上げる対応が誠実な履行に値するということを確認したいと思います。日本が、自動車、自動車部品の関税撤廃の具体的な…", "…合意を得るまで、米国に対してですね、具体的な合意を得るまで日本は交渉に応じないと、この対応をしたときも誠実な履行ということでよろしいですね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/58", "sentence": ["○浜口誠君もう一度、誠実な履行に当たるのかどうか。私が先ほど申し上げたとおり、具体的な合意を得るまで交渉に応じないと、この対応は誠実な履行に…", "…当たるのかどうか。私が先ほど申し上げたとおり、具体的な合意を得るまで交渉に応じないと、この対応は誠実な履行に当たるかどうか、答えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/62", "sentence": ["○浜口誠君それでは、附属書あるいは協定の中に書かれているのであれば、それを求めていることは誠実な履行に当たるんじゃないですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/64", "sentence": ["…織り込まれているのであれば、日本がその関税撤廃を合意するまで交渉に応じないということは、誠実な履行ということに当たるんではないでしょうかと。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/80", "sentence": []}]}]}]