[{"date": "2020-11-20", "meeting": [{"meeting_name": "参議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/103", "sentence": ["…お願いしておきたいと思います。今回、令和二年七月豪雨の義援金に関して差押禁止の議員立法を議論する、審議する予定になっているんですけれども、私…", "…るんですけれども、私は、こういった大災害が起こったときにこの義援金の差押禁止法案がその都度出されているということに対して、やはり空白期間が議…", "…ことに対して、やはり空白期間が議員立法ですと生じてしまうので、やはり差押えの禁止の空白をつくらないという観点からは、恒久法にしていくというこ…", "…うことも必要ではないかなというふうに感じております。小此木大臣、この差押禁止法案、その都度審議するのではなくて、恒久法化していくことに対して…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/116", "sentence": []}]}]}]