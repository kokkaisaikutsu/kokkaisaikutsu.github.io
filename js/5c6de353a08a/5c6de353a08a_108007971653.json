[{"date": "2020-05-18", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/105", "sentence": ["○浜口誠君では、続きまして、下水道の老朽化、耐震化について質問させていただきたいと思います。下水道も全国各地で広がっている公共のインフラの一…", "…全国各地で広がっている公共のインフラの一つなんですけれども、老朽化、耐震化がやっぱり進んでいません。重要幹線においては耐震化されていないのが…", "…けれども、老朽化、耐震化がやっぱり進んでいません。重要幹線においては耐震化されていないのが四九％、下水道の処理場においては六三％、半分以上が…", "…化されていないのが四九％、下水道の処理場においては六三％、半分以上が耐震化になっていないという今実態にあります。更に言うと、老朽化が進んでい…", "…ります。こういう実態を踏まえた上で国土交通省に聞きますけれども、要は耐震化あるいは下水道の老朽化更新、どのような考え方でこれからやっていくの…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/119", "sentence": []}]}]}]