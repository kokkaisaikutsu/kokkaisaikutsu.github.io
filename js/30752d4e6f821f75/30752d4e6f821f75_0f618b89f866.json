[{"date": "2020-06-17", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X02020200617/1", "sentence": ["…ることに関する陳情書外五件、また、地方自治法第九十九条の規定に基づく意見書は、所得税法の寡婦（寡夫）控除の拡大を求める意見書外二十一件であり…", "…、また、地方自治法第九十九条の規定に基づく意見書は、所得税法の寡婦（寡夫）控除の拡大を求める意見書外二十一件であります。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X02020200617/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X02020200617/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X02020200617/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X02020200617/5", "sentence": []}]}]}, {"date": "2020-09-18", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120204376X00120200918/1", "sentence": ["…期中、当委員会に参考送付されました地方自治法第九十九条の規定に基づく意見書は、国の「持続化給付金」及び大阪府「休業要請支援金」等に対して課税…", "…書は、国の「持続化給付金」及び大阪府「休業要請支援金」等に対して課税されない仕組みの構築を求める意見書外十件であります。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120204376X00120200918/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204376X00120200918/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204376X00120200918/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204376X00120200918/5", "sentence": []}]}]}]