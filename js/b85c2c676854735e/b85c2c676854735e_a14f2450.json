[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X00520200225/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00520200225/70", "sentence": ["…そこでは当然ビッグデータを収集します。ビッグデータを収集して、それが価値を生みます、お金を生みます。その知的財産は、アメリカの消費者がいろい…", "…いわけですよね、データだけでは。ある一定のアルゴリズムを通して初めて価値が出る。これが恐らくこれから課税当局の間では大きな問題になってくるん…", "…倉庫を使うわけじゃありませんし、一体それは何なんだと。そして、まさに価値が生まれる土地と納税する土地が乖離をしてくる。さらには、無形資産です…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00520200225/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00520200225/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00520200225/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00520200225/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00520200225/80", "sentence": []}]}]}]