[{"date": "2020-02-03", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/12", "sentence": ["…長戦略です。大胆な金融政策、機動的な財政政策、この二つを中心に経済をリードしてきたわけでありますが、こうした金融政策、財政政策で経済を支えて…", "…得ています。経済のみならず、行政のデジタル化、電子政府の推進で世界をリードし、高い効率性と利便性、低コスト化、これを進め、経済成長を実現して…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/18", "sentence": ["…大事にしながら、国際社会に向けては、分断から協調への流れ、これをぜひリードできるような国でありたいと強く思います。今、国際社会においては、自…", "…国民の一体性も大事にしながら、この分断から協調へという国際的な動きをリードして地球規模の課題に貢献し、国際的な存在感や発言力を確保し、そして…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00520200203/22", "sentence": []}]}]}]