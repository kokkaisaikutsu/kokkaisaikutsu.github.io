[{"date": "2020-06-05", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X02220200605/59", "sentence": ["…な理由の一つは、介護福祉士養成施設卒業者の国家試験の義務付けに係る経過措置の延長をし、介護職の社会的地位向上を妨げるものだからです。今から遡…", "…において、衆参両院で決議された附帯決議が踏みにじられ、本案によって経過措置が更に五年間も延長されようとしています。その五年間の根拠も質疑で明…", "…しろにする政府の取組姿勢を見過ごすわけにはいきません。そして、この経過措置の延長をめぐっては、社会保障審議会社会福祉部会においてたった二回の…", "…す。厚生労働省は、福祉部会における議論のどこをどう十分に検討して、経過措置の延長という改正案を提出してきたのでしょうか。そもそも初めから延長…", "…せん。五年間という期間だけでなく、外国人留学生の合格率が低いことを経過措置の延長の理由の一つに挙げられましたが、現状把握、分析するにも、介護…"]}]}, {"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X01020200605/87", "sentence": []}]}]}]