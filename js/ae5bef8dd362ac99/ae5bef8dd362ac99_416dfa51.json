[{"date": "2020-03-25", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X00920200325/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00920200325/6", "sentence": ["…の皆様は、これまで一生懸命、育種、改良してきた和牛の遺伝資源が海外に流出し、海外で霜降り肉が生産され、そのマーケットで競合したり、あるいは日…", "…ような懸念もされるところであります。本法案により、どのようにこうした海外流出事案の再発防止が図られるのか、具体的に御説明をお願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00920200325/8", "sentence": ["…確保を図るということ。こうしたことにより、不正な流通を排除して、海外流出を阻止することが極めて重要であると考えております。ただ、一方で、実は…", "…ったというふうに把握をしております。日本の宝である和牛遺伝資源の海外流出を防ぎ、和牛の輸出促進を図っていこうとする中で、和牛ブランドに対する…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00920200325/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00920200325/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00920200325/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00920200325/16", "sentence": []}]}, {"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00620200325/56", "sentence": []}]}]}]