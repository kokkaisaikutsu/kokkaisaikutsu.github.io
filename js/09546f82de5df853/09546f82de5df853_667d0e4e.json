[{"date": "2020-03-11", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/97", "sentence": ["…代に首長に立候補する人は、教育第一を掲げて、そして独自財源でも教員の給与を確保するというような首長が選ばれ、かつそれを実行に移すのが理想型だ…", "…ます。ただ、現実問題としては、国からの国庫補助がなければ、教員数又は給与を抑えるという方向にベクトルが進んでいるというふうに思っています。そ…", "…を修正することによって、実際問題として今まで都道府県の独自財源で教員給与を確保していたところに加算がされるという仕組み、又は、今の場合は普通…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00320200311/100", "sentence": []}]}]}]