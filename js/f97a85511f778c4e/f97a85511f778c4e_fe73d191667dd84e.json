[{"date": "2020-04-01", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/207", "sentence": ["…ら簡単に紹介をさせていただきますと、①家計を支えるための生活支援、現金給付の実施、一人当たり十万円の支援と赤い字で書かれています。それから、…", "…ている方々の生活を守りたいということで、収入減の方々に一人十万円の現金給付というのを提言しております。そこで、総理、収入が減って生活に著しく…", "…ち全てに行き渡るよう、過去の収入ではなくて、現在の収入の状況を考えて速やかに現金給付というものを行ってほしいと思いますが、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/225", "sentence": []}]}]}]