[{"date": "2020-04-01", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/207", "sentence": ["…、携帯代も払えないと、こういうような声が上がっております。あるいは、大学生からも、今までスマホのスケジュール帳にはバイトのシフトがみんな埋ま…", "…ル帳、バイトのシフトは全く入っていないと。この三月、四月というのは、大学の前期授業料の納入があると、これが払えなくなって大学どうしようと、こ…", "…四月というのは、大学の前期授業料の納入があると、これが払えなくなって大学どうしようと、こういうような声も上がっております。そこで、公明党とし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/225", "sentence": []}]}]}, {"date": "2021-04-16", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X01620210416/10", "sentence": ["…わる改革にどのように取り組んでいくのか、説明を願います。地域の医療は大学病院等からの医師の派遣に支えられています。医師の労働時間の短縮を進め…", "…引き揚げられてしまうのではないかと心配する声も上がっています。また、大学病院等で働く医師にとって地域医療を経験することを重要と考え、希望する…", "…。そこで、本法案には、地域医療を守るために必要と認められる場合には、大学病院等が指定申請をすれば派遣医師について時間外の上限を高く設定できる…", "…派遣医師について時間外の上限を高く設定できる制度を盛り込んでいます。大学病院等が適切に指定申請するよう、実効性の伴った制度にすべきと考えます…"]}]}]}]