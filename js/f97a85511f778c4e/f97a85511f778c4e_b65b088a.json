[{"date": "2020-04-01", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/207", "sentence": ["…トがこれになっております。上から簡単に紹介をさせていただきますと、①家計を支えるための生活支援、現金給付の実施、一人当たり十万円の支援と赤い…", "…ていただきたいと思います。中でも、この中でも優先度が高いのが、やはり家計、生活支援なんですね。私の地元神奈川でも、一人親家庭の方から、仕事が…", "…した様々な生活に今苦しんでいるという声を真っ正面から受け止めまして、家計に深刻な影響を生じている方々の生活を守りたいということで、収入減の方…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/209", "sentence": ["…があるんですね。これ、大変すばらしい、私、制度だと思うんです。これ、家計が苦しくなった場合、特にこの新型コロナウイルスでですね、特例措置が今…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/225", "sentence": []}]}]}]