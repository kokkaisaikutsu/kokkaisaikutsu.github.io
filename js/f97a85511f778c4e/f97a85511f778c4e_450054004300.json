[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/111", "sentence": ["…、そういう強い決意で来年の取りまとめをお願いしたいと思います。次に、ＥＴＣ二・〇についてお聞きします。まず、二〇一五年から導入されていますＥ…", "…ＴＣ二・〇についてお聞きします。まず、二〇一五年から導入されていますＥＴＣの二・〇ですけれども、高速道路での利用率が二割程度にとどまっている…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/115", "sentence": ["…君じゃ、一問ここで飛ばしまして、赤羽大臣にまたお聞きしますけれども、ＥＴＣ二・〇というのは地域の活性化にも今役立ち始めています。現在、高速道…", "…ないと思うんですね。そこで、渋滞緩和や災害時に役立ち、地域活性化にもつながるＥＴＣ二・〇の普及促進に向けた大臣の御見解を伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/123", "sentence": []}]}]}]