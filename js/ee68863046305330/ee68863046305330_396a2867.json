[{"date": "2020-05-14", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/48", "sentence": ["…から御提出をいただきました。テーマになったのは、一番が国有林における樹木伐採権制度の具体化の進捗状況ということで、あとはいろいろあるんですけ…", "…行されましたけれども、国有林野管理経営法の施行状況について伺います。樹木採取権の契約成立及びその内容について、説明できることがあればお願いい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/52", "sentence": ["○森ゆうこ君それで、この一月十五日に行われた未来投資会議の構造改革徹底推進合同会合では、この樹木採取権について何が話し合われたんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/64", "sentence": ["…た資料、昨年の国有林野管理経営法の施行状況について、長期、大ロットの樹木採取権に係るマーケットサウンディングについて。これは一番竹中会長が、…", "…皆様。募集の案、募集する事項、いろいろ書いてあるんですけど、希望する樹木採取権の設定期間、約十年以上と、十年からというふうに書いてありますけ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/70", "sentence": ["…けれども、カナダの森林と日本の森林が比べてあります。長期、大ロットで樹木を取れるようなところなんてほとんどないんじゃないですか。違いますか。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/83", "sentence": []}