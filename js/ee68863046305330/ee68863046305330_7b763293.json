[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/59", "sentence": ["○森ゆうこ君いや、どうしてきちっと質問に答えていただけないんですか。登録品種、自家増殖、許諾さえ得ればこれまでどおり可能だとおっしゃるわけで…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/61", "sentence": ["…ら採決するんですよ。全然答弁めちゃくちゃじゃないですか。これまでは、登録品種の自家増殖に育成者権の効力を及ぼす植物の基準ということで、自家増…", "…等を検討し、それがなければ自家増殖に、元々農業者は自家増殖について、登録品種であっても可能であるわけですから、自家増殖に育成者権の効力を及ぼ…", "…を及ぼす植物を決定していたわけです。じゃ、今回、全面的に原則禁止と、登録品種の農業者の自家増殖を全面禁止というこの法律案を、改正案を提出する…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/64", "sentence": ["…か。私、そんなこと聞いていませんよ。今回の法改正によって、これまで、登録品種の自家増殖に育成者権の効力を及ぼす植物の基準ということで、これ農…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00520201201/74", "sentence": []}]}]}]