[{"date": "2020-04-28", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/17", "sentence": ["…は非常にやはり厳しいと言わざるを得ません。そして、配慮が必要なのは、同居の家庭の場合でもこれは同じだと思います。仕事や生活の先行きが見えない…", "…て、子供の虐待、またＤＶに関する相談が今やはりふえてきています。この同居する家族関係によっても受取が難しいという場合は、考える必要があります…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/19", "sentence": ["…、これは後者であるほかないと私は思っています。離婚の協議中だけれども同居をしているとか、虐待を受けていて、極力家にはいないようにしているけれ…", "…いるとか、虐待を受けていて、極力家にはいないようにしているけれども、同居をして扶養に入っている、さまざまな境遇にある方が受け取れない場合があ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/27", "sentence": []}]}]}]