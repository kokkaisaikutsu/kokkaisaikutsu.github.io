[{"date": "2020-11-13", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/122", "sentence": ["…いきます。首脳外交というのは今後ももちろん大事なんですが、アメリカ民主党政権下における国務省そして日本の外務省、この事務レベルの意思疎通をい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/124", "sentence": ["…ります。日本における民主党との関係はもとよりですけれども、アメリカ民主党政権との関係づくりにはやはり過去苦しんできたというところは、これまで…", "…うのは大きく変わってきたところです。ですけれども、アメリカの今後の民主党政権でも、確かに人権問題とか気候変動などの対策についての例外はあるに…", "…あるとはいっても、同盟国に負担を求めるような交渉というのは、今後、民主党政権下においてもふえてくる可能性も、注意深く見ていく必要があるという…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00220201113/135", "sentence": []}]}]}]