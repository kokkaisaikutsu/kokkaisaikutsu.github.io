[{"date": "2020-04-28", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/21", "sentence": ["…必要とするのは、自治体に対してもこれは同じことが言えます。地方創生臨時交付金について伺いたいと思います。感染拡大の防止を受けて、事業者の休業…", "…いましたから、補正予算の組み替えを決めた二十日までに時間がありました。その間、なぜ組み替え時に臨時交付金の予算をふやさなかったんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/23", "sentence": ["…て、休業への支援についても長期を見据えた対応がやはり求められます。臨時交付金というのは、おっしゃるように、病床の確保、また軽症者の宿泊施設の…", "…の協力支援金を出そうという自治体もあるわけです。今後の追加的なこの臨時交付金、予備費の活用も含めた上積み、そしてこの第二次補正予算の策定での…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/27", "sentence": []}]}]}]