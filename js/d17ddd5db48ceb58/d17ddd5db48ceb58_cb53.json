[{"date": "2020-05-27", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/74", "sentence": ["…じゃないかというふうに思います。そのために今も奮闘しているのがやはり猟友会の皆さんですが、現場の負担がとにかくきつい、増しています。担い手が…", "…と、やはり捕獲の、また駆除の技術、それも課題になっているという中で、猟友会への活動支援、処遇改善策について今後どのように考えていらっしゃるの…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/76", "sentence": ["○緑川委員この自粛の影響もあり、猟友会の活動、なかなか制限されてしまっているところもやはりあると思うんですけれども、一方で、日々、神経をすり…", "…イノシシの血液の採取とか、捕獲した後も、やはり処分についても最後まで猟友会がかかわっている。本当にこの一連の作業を一手に担っている大変な担い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/86", "sentence": []}]}]}]