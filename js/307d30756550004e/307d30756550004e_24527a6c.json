[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第七分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/216", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/218", "sentence": ["…おります。次に、この前の、先般の広島高裁の伊方原発の一時停止を命じた判決について、規制委員会の見解をお伺いしたいというふうに思います。これは…", "…て、規制委員会の見解をお伺いしたいというふうに思います。これは、私も判決の要旨を拝読をさせていただきましたけれども、極めて技術的な、特に断層…", "…に断層をどう認識するかという問題について、かなり踏み込んでいろいろと判決文でお書きになっておられます。それで、各裁判官が法と良心に従って判決…", "…判決文でお書きになっておられます。それで、各裁判官が法と良心に従って判決をお書きになるというのは当然のことだと思いますけれども、ただ一方で、…", "…然のことだと思いますけれども、ただ一方で、こういう自由社会ですから、判決自身もさまざまな建設的な批判にさらされるということもまた当然だと思っ…", "…裁判官の方がひっくり返したというのは素直に驚きを持って受けとめていますけれども、この判決の内容についての規制委員会の見解はいかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/220", "sentence": ["○細田（健）分科員ありがとうございました。私の印象では、高裁の判決、決定というのはかなり技術的な面に踏み込んでさまざまな書き方がなされていま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/222", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/224", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/226", "sentence": []}]}, {"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/488", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/490", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/492", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/494", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/496", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/498", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/500", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/502", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/504", "sentence": []}, {"url": "https