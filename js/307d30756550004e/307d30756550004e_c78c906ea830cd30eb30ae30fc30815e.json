[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第七分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/216", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/218", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/220", "sentence": ["…はないかというような印象がございまして、この点については、特に資源エネルギー庁の方から、日本の太陽光発電でありますとか、あるいは風力、そうい…", "…コストがどうなっているかというようなことをぜひ公表いただきたいというふうに思っているんですけれども、資源エネルギー庁の御見解をお願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/222", "sentence": ["…応えていただくような形で強力に展開をしていただきたいというふうに思っております。まずこの点について、資源エネルギー庁の御見解をお願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/224", "sentence": ["○細田（健）分科員ありがとうございました。資源エネルギー庁から大変前向きな御答弁をいただいたと思っております。本当にありがとうございます。今…", "…ざいますし、また、先般、いわゆる防災ラジオの配付等々についても資源エネルギー庁からさまざまな御支援をいただいたというふうに理解をしております…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/226", "sentence": []}]}, {"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/488", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/490", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/492", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/494", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/496", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/498", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/500", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/502", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/504", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/506", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/508", "sentence": []}, {"u