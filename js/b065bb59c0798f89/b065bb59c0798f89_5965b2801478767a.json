[{"date": "2020-06-25", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/88", "sentence": ["○新妻秀規君まず最初に、資料を見ながら、福島浜通り地域の国際教育研究拠点の構想についてお伺いをしたいと思います。この福島浜通り地域、言うまで…", "…ト国立研究所、またワシントン州立大学のトライシティーズ校、こうした教育研究機関だったわけであります。これを福島にもつくろうというのが今回の拠…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/90", "sentence": ["…トにおけるトライデックを始めとした地域の発展のための調整機関、また教育研究機関、地方自治体などの連携を示した図であります。この真ん中の緑のと…", "…とであるが、福島浜通り地域においてはトライデックのような地元企業と教育研究機関、地方自治体とを調整する機能が弱い、このように分析をした上で、…", "…トの事例におけるトライデックのように、新しい産業の創出に向けて国際教育研究拠点と地元企業や誘致企業との連携を担う機能を強化していくべきである…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00120200625/108", "sentence": []}]}]}]