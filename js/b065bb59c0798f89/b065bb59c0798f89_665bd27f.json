[{"date": "2020-03-03", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/232", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/234", "sentence": ["○新妻秀規君次に、学習支援の在り方について伺います。先月二十七日、我が党より政府に対し緊急提言を行いました。児童生徒等の学習に著しい遅れが生…", "…先月二十七日、我が党より政府に対し緊急提言を行いました。児童生徒等の学習に著しい遅れが生じないよう、学習を補うため適切な措置をとるよう配慮を…", "…し緊急提言を行いました。児童生徒等の学習に著しい遅れが生じないよう、学習を補うため適切な措置をとるよう配慮を促すこと、こうした要望であります…", "…多くの自治体で休校に入っていることと思います。どのようにしてこの間の学習を補っていくのでしょうか。また、休み中も児童生徒の訪問指導をしたい、…", "…とか、こうした検定試験を休み明けに受検することなどによって子供たちの学習意欲を向上させることも一案でありまして、こうした場合の支援策について…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/236", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/238", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/240", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/242", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/244", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/246", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/248", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/250", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/252", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/254", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/257", "sentence": []}]}]}]