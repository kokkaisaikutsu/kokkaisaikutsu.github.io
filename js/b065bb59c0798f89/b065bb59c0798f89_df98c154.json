[{"date": "2020-03-03", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/232", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/234", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/236", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/238", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/240", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/242", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/244", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/246", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/248", "sentence": ["…普及が進むような積極的な取組を是非ともお願いしたいと思います。次に、食品ロスの削減について伺います。今回の新型コロナウイルス感染症のために、…", "…ん。日本国内で、食べられるのに、食べられるはずなのに捨てられてしまう食品、すなわち食品ロスの総量は、二〇一八年度のデータでは年間約六百四十万…", "…、食べられるのに、食べられるはずなのに捨てられてしまう食品、すなわち食品ロスの総量は、二〇一八年度のデータでは年間約六百四十万トンであります…", "…ェクトチームを立ち上げまして、その後、超党派の議員連盟の設立を経て、食品ロスの削減を推進する議員立法、これが昨年五月、衆参とも全会一致で可決…", "…も全会一致で可決、成立し、十月に施行となりました。事業者、消費者共に食品ロス削減を国民運動にしていかなければなりません。ここで、文科大臣に伺…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/250", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/252", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/254", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/257", "sentence": []}]}]}]