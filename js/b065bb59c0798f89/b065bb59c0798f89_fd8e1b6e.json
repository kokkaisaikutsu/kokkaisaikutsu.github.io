[{"date": "2020-03-03", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/232", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/234", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/236", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/238", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/240", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/242", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/244", "sentence": ["…倒的にやはり人材の育成、確保、約九割です、八七・八％。次に事務負担の軽減などが続いていきます。私自身、利用者である保護者の方はもとより、石川…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/246", "sentence": ["…新妻秀規君次に、預かり保育、延長保育のニーズ実態把握、また事務負担の軽減について、少子化担当大臣に伺います。調査に取り組んでいく中で、今回の…", "…のこのパネルの右側の人材の育成、確保の支援のすぐ左側、これ事務負担の軽減を求める声、六二％に上ります。アンケートの自由記述欄からは、給食費の…", "…一については先行事例もあるというふうに伺っております。先行事例の周知などを通じて事務負担の軽減に努めてほしいと思いますが、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/248", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/250", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/252", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/254", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/257", "sentence": []}]}]}]