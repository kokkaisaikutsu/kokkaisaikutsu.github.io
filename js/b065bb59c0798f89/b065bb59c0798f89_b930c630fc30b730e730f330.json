[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/72", "sentence": ["…なと思うんですけれども、福島ではまだ六十台、水素バスは一台、水素ステーションは据置きタイプ、移動タイプそれぞれ一台ずつと、まだまだ少ない状況…", "…と、まだまだ少ない状況です。地元浪江町は、建設予定の道の駅に水素ステーションを設けるよう国に要望をしております。また、国が定めた水素・燃料電…", "…す。ここで、浪江を始めとした浜通り地域はもとより福島県全体に水素ステーション整備を進めてほしいが、どのように取り組まれるでしょうか。また、地…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/82", "sentence": ["…築に向けた民間支援について伺いたいと思います。先ほど福島での水素ステーションの整備などについてお伺いしましたが、燃料電池車の普及拡大のために…", "…ためには、そもそも燃料電池車、また水素バスそのもの自体、また水素ステーション自体のコスト低減が非常に重要だと思いますが、どのようにして取り組…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/86", "sentence": []}]}]}]