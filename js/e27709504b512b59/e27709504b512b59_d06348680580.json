[{"date": "2021-02-03", "meeting": [{"meeting_name": "参議院 内閣委員会、厚生労働委員会連合審査会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/105", "sentence": ["…り重要だという、そういうことであるかというふうに思います。今日は、御提案者の方、お忙しい中来ていただきました。ありがとうございます。今回の感…", "…案の方が行政罰となる、こういうふうにされた合理的な根拠、特に行政罰とすべきという御提案に至った趣旨を提案者より御説明いただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/109", "sentence": ["…も大きな意義が私はあるというふうに思っております。それも含めてでありますが、改めて今回の修正の趣旨を提案者より御説明いただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/111", "sentence": ["…うことを強くまたお訴えし、強調もさせていただきたいというふうに思います。それでは、御提案者の皆様、こちらで御退席いただいて結構でございます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/117", "sentence": []}]}]}]