[{"date": "2021-11-12", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120604006X00120211112/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120604006X00120211112/2", "sentence": ["…行います。理事の員数は八名とし、その選任につきましては、先例により、委員長において指名するに御異議ありませんか。〔「異議なし」と呼ぶ者あり〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120604006X00120211112/3", "sentence": ["…それでは、理事に勝俣孝明君菅家一郎君土屋品子君牧原秀樹君源馬謙太郎君近藤昭一君漆間譲司君及び角田秀穂君を指名いたします。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120604006X00120211112/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120604006X00120211112/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120604006X00120211112/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120604006X00120211112/7", "sentence": []}]}]}, {"date": "2021-12-21", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120704006X00120211221/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704006X00120211221/2", "sentence": ["…が三名欠員となっております。その補欠選任につきましては、先例により、委員長において指名するに御異議ありませんか。〔「異議なし」と呼ぶ者あり〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120704006X00120211221/3", "sentence": ["…御異議なしと認めます。よって、そのように決しました。それでは、理事に小泉進次郎君笹川博義君及び田嶋要君を指名いたします。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120704006X00120211221/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704006X00120211221/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704006X00120211221/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704006X00120211221/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704006X00120211221/8", "sentence": []}]}]}]