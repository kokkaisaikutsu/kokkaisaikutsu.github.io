[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/21", "sentence": ["…一定の魚しか捕らない、そしてまた消費者も朝捕れの魚をいただける、また漁業者も通勤型の従事ができる、まさに環境に優しいＳＤＧｓ型の漁法でもある…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/23", "sentence": ["…こんなことを申し上げたかったわけでありますが。何といっても、最後に、漁業者は、大変経済的にもピンチにあります。浜の活力プラン、特に、その中で…", "…ます。浜の活力プラン、特に、その中で積立ぷらすの充実ということを強く漁業者からたくさん聞いておりますので、是非それをお伝えして、質問を終わり…"]}]}]}]