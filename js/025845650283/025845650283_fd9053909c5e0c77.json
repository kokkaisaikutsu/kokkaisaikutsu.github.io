[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/23", "sentence": ["…やっぱり真剣に解決していかなきゃいけない。国際枠の拡大、あるいは各都道府県に割り当てられた枠の増加、あるいは弾力的な運用といったことも大事な…"]}]}]}, {"date": "2020-05-25", "meeting": [{"meeting_name": "参議院 行政監視委員会国と地方の行政の役割分担に関する小委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115352X00220200525/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115352X00220200525/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115352X00220200525/7", "sentence": ["…まま教育格差につながってしまうという状況だったわけであります。国と都道府県と市町村、そして各教育委員会、教育に関わる皆さんの温度差、連携が足…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115352X00220200525/9", "sentence": ["○堂故茂君やはり、国と都道府県、そして市町村、教育委員会の温度差を埋めてもらいたい。しっかり整備進めると同時に、これは教育をいかに質として高…", "…町村の役割分担が曖昧にも思えるわけでありますが、先日の小委員会で、都道府県による補完、支援の役割について地方制度調査会において議論もされてい…", "…制度調査会において議論もされていると伺っていますが、説明がありましたが、市町村の大切さ、都道府県の役割について改めてお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115352X00220200525/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115352X00220200525/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115352X00220200525/15", "sentence": []}]}]}]