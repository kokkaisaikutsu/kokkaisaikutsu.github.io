[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/17", "sentence": ["…心的な役割を果たしているのが猟友会であります。少子高齢化に伴いまして会員の高齢化が進んでおります。鳥獣被害における猟友会の役割、大変重要であ…", "…ける猟友会の役割、大変重要であると思いますし、それへの活動支援、猟友会員の確保、特に若い会員の確保に向け何か考えあるか、藤木政務官のお考えを…", "…変重要であると思いますし、それへの活動支援、猟友会員の確保、特に若い会員の確保に向け何か考えあるか、藤木政務官のお考えを聞きたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/19", "sentence": ["…省、それから警察庁とも連携の上、是非、猟友会が活動しやすい、あるいは会員が増えることについて御尽力いただきたいと思います。一方、地元の皆さん…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/23", "sentence": []}]}]}]