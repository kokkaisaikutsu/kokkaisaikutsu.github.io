[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/7", "sentence": ["…で漁港協会の会長を務めてまいりました。多少我田引水となりますが、農林水産業と農山漁村地域の振興について、これから質問をさせていただきたいと思…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/23", "sentence": ["…な運用といったことも大事なのかなと思います。それから、本当は、次に、水産業界で一番遅れているＩＣＴ、これを活用して日本の水産業を非常に効率の…", "…、本当は、次に、水産業界で一番遅れているＩＣＴ、これを活用して日本の水産業を非常に効率のいい成長産業にしていくためには、ＩＣＴ、生産から流通…", "…流通まで絶対取り入れられなきゃいけない、あるいは漁港を活用して日本の水産業を、養殖を含めて進めなきゃいけないと、こんなことを申し上げたかった…"]}]}]}]