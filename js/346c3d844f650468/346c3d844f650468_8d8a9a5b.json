[{"date": "2020-10-30", "meeting": [{"meeting_name": "参議院 議院運営委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314024X00320201030/1", "sentence": ["…ただいまから議院運営委員会を開会いたします。まず、立法事務費の交付を受ける会派の認定に関する件を議題といたします。事務総長の説明を求めます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314024X00320201030/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314024X00320201030/5", "sentence": ["…しては、事務総長説明のとおり、ＷＥＡＲＥＡＬＬＯＮＥを立法事務費の交付を受ける会派と認定することに賛成の諸君の起立を願います。〔賛成者起立〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314024X00320201030/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314024X00320201030/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314024X00320201030/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314024X00320201030/10", "sentence": []}]}]}]