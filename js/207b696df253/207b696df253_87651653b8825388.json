[{"date": "2020-05-15", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/190", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/192", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/194", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/204", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/206", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/208", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/210", "sentence": ["…うに思います。次に、きょう午前中も議論になっておりましたけれども、文化芸術分野への支援について、私の方からも要請をさせていただきたいというふ…", "…だきたいというふうに思います。先ほど萩生田大臣は、午前中の答弁で、文化芸術の灯を消すことがないように全力を挙げるという思いを述べられました。…", "…挙げるという思いを述べられました。ただ、先日の補正予算の中で、この文化芸術についての予算が幾つか積まれているわけですけれども、これは大きく自…", "…もいいんです、それはそれで、しかし、やはり文化庁として、しっかりと文化芸術を預かる責任ある庁として、自分たちが予算を獲得して支援をやるんだと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/212", "sentence": ["…創設をされるということで伺っております。独法の日本芸術文化振興会に文化芸術復興基金を設置して民間からの寄附の受皿とするような、これはもう決ま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/216", "sentence": ["…んですけれども、もちろん、経済的な発展も大事だけれども、この日本の文化芸術を、伝統を継承し、また次につなげていくというのはやはり我々の責任で…", "…ういった思いに寄り添って、ぜひ大臣のリーダーシップで、必ず二次補正で文化芸術の支援のための予算を獲得することをお約束いただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/218", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/220", "sentence": []}]}]}]