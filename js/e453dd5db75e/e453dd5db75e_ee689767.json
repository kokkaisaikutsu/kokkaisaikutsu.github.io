[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第二分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/121", "sentence": ["○古川（康）分科員古川康でございます。まず最初に、森林環境譲与税についてお尋ねをさせていただきます。私どもも含めた全国の森林、林野の、そして…", "…林環境譲与税についてお尋ねをさせていただきます。私どもも含めた全国の森林、林野の、そしてさらには山村の関係者の願いが久しかった森林環境譲与税…", "…めた全国の森林、林野の、そしてさらには山村の関係者の願いが久しかった森林環境譲与税、無事に船出を見たところでございます。本日は、まず冒頭にこ…", "…させていただきますが、まずは数字を教えてください。令和元年度にはこの森林環境譲与税、幾らでありましたでしょうか。それが二年度には幾らになるの…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/123", "sentence": ["…でありますが、問題はここからでありまして、この本当に苦労してつくった森林環境譲与税、これがどのような使途に使われているのかということでありま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/125", "sentence": ["○古川（康）分科員ありがとうございました。今は森林経営管理法も施行しましたので、そういったものに基づく意向調査が行われている、そういう状況の…", "…でございました。大事なことは、これまでも、地方財政措置の中でこうした森林の整備などについては措置がなされていたわけでありまして、一定程度は、…", "…備などについては措置がなされていたわけでありまして、一定程度は、この森林環境譲与税なしでも地方公共団体においては行っていただく必要があります…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/149", "sentence": ["…りがとうございました。本日、三十分という時間でございましたが、最初の森林環境譲与税から各種の防災対策、そして最後の養護老人ホームに至るまで、…"]}