[{"date": "2020-03-17", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/100", "sentence": ["…。私は、当時、佐賀県で知事をいたしておりましたが、佐賀県においても、消毒ポイント設置、農場の緊急消毒などの対応に加えて、県の行動指針を策定い…", "…いたしておりましたが、佐賀県においても、消毒ポイント設置、農場の緊急消毒などの対応に加えて、県の行動指針を策定いたしました。当時は、法律や国…", "…法律や国の防疫指針に明記されていなかったために、九州各県が競うように消毒ポイントの設置をするような事態になりましたが、終息後は、飼養衛生管理…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/110", "sentence": ["…した。例えば、発生直後の住民説明会、防疫対応に必要な水の確保、埋却や消毒による周辺環境汚染に関する調査、埋却が終わった後に生じる少量の廃棄物…", "…後に生じる少量の廃棄物の、例えば防護服とかそういったものの焼却処分、消毒ポイントにおける協力、こうしたものは県の仕事というよりは市町村の仕事…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/114", "sentence": []}]}]}]