[{"date": "2020-03-17", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/96", "sentence": ["…いうのを感じたところであります。野菜や畜産の世界にはマルキンとか野菜価格安定制度とか、そういったのがあるわけでありますけれども、このお花の、…", "…のがあるわけでありますけれども、このお花の、花卉の世界には、そういう価格安定制度というものがありません。本当はこうしたものについても考えなく…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/98", "sentence": ["○古川（康）委員ありがとうございました。次に、肥育牛、牛肉の枝肉価格のことについてお尋ねをさせていただきます。佐賀県は佐賀牛を始めとするブラ…", "…きます。佐賀県は佐賀牛を始めとするブランド牛の産地でありますが、枝肉価格が、やはり昨年同期に比べてキロ三百円ないし五百円ぐらい下がっている。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/114", "sentence": []}]}]}]