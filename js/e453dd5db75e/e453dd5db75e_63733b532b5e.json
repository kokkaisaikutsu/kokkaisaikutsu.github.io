[{"date": "2020-03-17", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/112", "sentence": ["…、県、それぞれ仕事がしやすくなるものと思います。次に、家畜防疫員など獣医師の増員についてお尋ねをさせていただきます。これまでのこの委員会にお…", "…、地方公共団体における家保、家畜保健衛生所の機能強化や、家畜防疫員、獣医師がメーンになりますが、この増員が非常に重要なものになってきています…", "…で、地方公共団体又は国の有資格者が当該発生地域に派遣をされています。獣医師が不足する規模の県内農場でＣＳＦ等が発生した場合には、県外の家畜防…", "…派遣した職員が自分の県に帰ってきた後、一定期間、テレワークで、職場の獣医師や畜産関係者と接触しないように対応をしています。通常業務に戻るまで…", "…化はどのようになっているのか、また、こうした状況の中、家畜防疫員、すなわち獣医師の増員についてどのように考えているのか、お尋ねをいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/114", "sentence": []}]}]}]