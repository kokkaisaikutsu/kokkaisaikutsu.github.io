[{"date": "2020-03-17", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/96", "sentence": ["…も考えなくていいんだろうか、そんなことすら思う次第であります。また、収入保険の制度がスタートをしました。本来であれば、この収入保険の制度を使…", "…ります。また、収入保険の制度がスタートをしました。本来であれば、この収入保険の制度を使って花卉農家についても収入の補填があってしかるべきであ…", "…しました。本来であれば、この収入保険の制度を使って花卉農家についても収入の補填があってしかるべきでありますし、制度的にはそのようになっており…", "…きでありますし、制度的にはそのようになっておりますが、残念なことに、収入保険、いまだなかなか加入率が高くない。ましてや、花卉を中心にしておら…", "…た。農業関係でも大きな豪雨被害があったわけでありますが、そのときにも収入保険に入っていた農家は助かった、そういう声がありました。ぜひとも、収…", "…入保険に入っていた農家は助かった、そういう声がありました。ぜひとも、収入保険については、こうしたさまざまな実例を通じて理解の促進に努めていた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/98", "sentence": ["…グラムとして、農家からしてみれば、一頭当たり十五万円から三十万円近い収入の減少になっている、こうした声が聞かれました。肥育農家にとっての死活…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00520200317/114", "senten