[{"date": "2020-03-06", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/143", "sentence": ["…月に、都内の日本語学校に対し、非常勤講師の労働条件に関して是正勧告と指導票が交付をされております。大臣、この案件については御存じでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/145", "sentence": ["○吉川（元）委員この一月の労基署からの是正勧告それから指導票の交付なんですけれども、どういうことが是正勧告をされたか。是正勧告は三つされてお…", "…間管理をしていない、これも是正勧告として出されています。それから、指導票の交付としては、例えば遠足時に三千円の手当しか支払っていない。実際に…", "…円しか支払っていないのではないか、労働なのではないかということでの指導票の交付。それから、これは先ほどの是正勧告と同じあれですけれども、勤怠…", "…管理とあわせて非常勤講師の労働実態をきちんと把握しなさい、こういう指導票が交付をされております。この日本語学校ですけれども、国内では老舗の最…", "…ムの非常勤というのは形容矛盾のような気もいたしますが、その方の源泉徴収票を見せていただきましたところ、その金額、百六十四万三千八百十円です。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00220200306/159", "sentence": []}]}]}]