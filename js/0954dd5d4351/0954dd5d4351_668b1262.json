[{"date": "2020-04-02", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/52", "sentence": ["…は三つなんですけれども、名称が少し異なっております。一つ目、感染拡大警戒地域、それから三つ目の感染未確認地域、これはほぼ三月十九日の取りまと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/54", "sentence": ["…てきているんだろうというふうに思います。ただ、一方で、例えば感染拡大警戒地域というところには、一週間前と比較して大幅な増加が確認されている、…", "…きるかということが、かなり今回明確に書かれています。例えば、感染拡大警戒地域では、十名以上が集まる集会、イベントへの参加を避けることというふ…", "…は控えることというふうになっています。そうしますと、うちの地域は拡大警戒地域なのかあるいは確認地域なのかによって、例えば自治会等々でいろいろ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/72", "sentence": []}]}]}]