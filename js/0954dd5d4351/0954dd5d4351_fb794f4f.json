[{"date": "2020-02-28", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105254X00820200228/32", "sentence": []}]}, {"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/78", "sentence": ["○吉川（元）委員これも総理の施政方針演説で取り上げた地方への移住、定着なんですが、総理の施政方針演説では、地方の創意工夫を一千億円の地方創生…", "…うに述べられています。この一千億の地方創生交付金を使った自治体による移住相談会の多くが民間企業への外注だ、こういうふうに聞いておりますが、そ…", "…いておりますが、その中で、一部企業が、相談会への参加者、つまり、私は移住について少し関心があります、移住について関心があるんです、だからちょ…", "…業が、相談会への参加者、つまり、私は移住について少し関心があります、移住について関心があるんです、だからちょっと説明会に行ってお話を聞かせて…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/82", "sentence": ["…といって報告するわけですよ。そうすると、自治体は、おっ、これはうちに移住の本格的な相談が来ると待ち構えるんだけれども、待てど暮らせど誰も問合…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/102", "sentence": []}]}]}]