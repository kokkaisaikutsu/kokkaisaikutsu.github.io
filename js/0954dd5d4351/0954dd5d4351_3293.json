[{"date": "2020-03-05", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/66", "sentence": ["…ますし、先ほど長尾委員からも指摘がありましたけれども、経営委員会の議事録というのは公表が原則ですから、そして、なおかつ、このような疑いが持た…", "…原則ですから、そして、なおかつ、このような疑いが持たれている以上、それを晴らすためにも、この議事録の公開、経営委員長、どうですか、この点は。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/68", "sentence": ["…元）委員もう、ちょっと話にならないですよ。今発言されたのをもう一回速記録を見て調べますけれども、今後の分析、つまり、今後の取材のあり方等々に…", "…ょっともう、ほかにコロナをやりたいので、ぜひ、先ほど言ったとおり、議事録を公開する気はないと言いますけれども、もう一回、じゃ、十二人で集まっ…", "…員会が疑惑の目で見られているんだから、きちんとそれを晴らすためにも議事録を公開しようということをもう一回提起してくださいよ、経営委員会の中で…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/70", "sentence": ["…ら、疑惑を晴らすためにも、放送法に違反していないというのであれば、議事録を公開すればいいじゃないですか。何でそれをしないんですか。委員長、ぜ…", "…しなきゃいけないんですよ。そのためにも必要な事項だというふうに思いますし、ぜひ、議事録の公開、これを求めていただきたいというふうに思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00820200305/82", "sentence": []}, {"ur