[{"date": "2020-02-28", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105254X00820200228/32", "sentence": []}]}, {"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/76", "sentence": ["…ども、昨年十二月に厚労省から、二〇一九年の人口動態の年間推計、国内の出生数が八十六万四千人、前年比六％の大幅な減少、こういうことが発表されま…", "…を割り込むと。これは予想よりも二年早いペースということでありますし、出生数が死亡数を五十一万人下回る、こういう状況であります。少子化、人口減…", "…現状であります。総合戦略、五カ年計画の中で、こうした人口減、あるいは出生数の低下、東京圏への人口集中がむしろ進んでしまったのではないか。こう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/86", "sentence": ["…するまでに至っていない。」としています。要は、東京の一極集中の是正や出生率の改善で効果が十分ではなかったということだろうというふうに思います…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00720200228/102", "sentence": []}]}]}]