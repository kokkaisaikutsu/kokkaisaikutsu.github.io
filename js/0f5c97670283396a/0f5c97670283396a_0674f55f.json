[{"date": "2020-03-18", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/32", "sentence": ["…うものから、活用するものに転換をしていこうというのが今回の法律の基本理念であると思うんですが、であるならば、旧法は既に地価を抑制するという役…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/42", "sentence": ["…いるわけでありますが、引き続きよろしくお願いいたします。土地基本法の理念、所有から活用というふうに切りかわっていく、これらの理念が浸透されて…", "…土地基本法の理念、所有から活用というふうに切りかわっていく、これらの理念が浸透されて、地方においても、このたびの法律改正に基づいて官民の施策…"]}]}]}]