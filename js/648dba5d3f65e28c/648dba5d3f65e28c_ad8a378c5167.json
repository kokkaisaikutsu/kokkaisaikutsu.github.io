[{"date": "2020-04-10", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/109", "sentence": ["…に、米軍機事故の問題について質問をいたします。二月二十五日、沖縄県の読谷村にある米軍トリイ通信施設の西約一・三キロの海上で、米軍普天間基地所…", "…があり、漁業者が日常的に操業し、多くの観光客が訪れる場所であります。読谷村の石嶺村長は、現場の海域は恒常的に漁民の漁業活動があり、年間二万人…", "…上の観光客が訪れる、訓練は中止してほしい、このように述べております。読谷村漁業協同組合の金城組合長は、万が一、乗客がいる船に落ちていたら大惨…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/127", "sentence": ["…県民を欺くために、日本国民を欺くためにやったも同様ではありませんか。読谷村議会の意見書は、今回の事故についてこのように述べています。「本村に…", "…止を幾度となく求めてきたにもかかわらず訓練がくり返されていることは、読谷村民の人権を蹂躙し、人命を軽視するものであり、断固抗議するものである…", "…、上空から落下させられたトレーラーによって圧死した、あの事件が今でも読谷村民の心の中に深く傷として残っている。だから、落下訓練やつり下げ訓練…", "…に厳しく反応していくわけです。外務大臣、日本政府としてこの声を正面から受けとめるべきだと思いますが、読谷村民の声、どのように受けとめますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/139", "