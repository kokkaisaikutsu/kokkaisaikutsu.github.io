[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/14", "sentence": ["…ことであります。昨年も台風十五号、十九号、また十月豪雨等においてテックフォースには多大な貢献をいただいたところであります。被災地域の皆様から…", "…には多大な貢献をいただいたところであります。被災地域の皆様からもテックフォースの姿を見ると安心するというような声もいただいております。そこで…", "…るというような声もいただいております。そこで、今後の災害に備え、テックフォースの更なる強化、そして共に協力をする民間の人材の育成も図るべきと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/16", "sentence": ["○清水真人君本当に、被災地の方々にしてみると、このテックフォースの存在というのは大きなものであろうというふうに思っております。そしてまた、今…", "…のような存在にしておかなければならないわけでありますので、今後もテックフォースの強化と民間との連携、そしてまた建設業の更なる育成というのも図…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00420200318/31", "sentence": []}]}]}]