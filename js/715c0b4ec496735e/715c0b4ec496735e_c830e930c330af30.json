[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/6", "sentence": ["…うに思っております。前方で車を停止させて、そして、その車の後ろからトラックが突っ込んで、両親二人が亡くなってしまうという本当に痛ましい事故、…", "…も、私の地元佐賀県小城市でこういう交通事故、事件がありました。大型トラックを運転していた男性が、別の大型トラックから車間距離を詰められたり幅…", "…事故、事件がありました。大型トラックを運転していた男性が、別の大型トラックから車間距離を詰められたり幅寄せされたりするなどあおり運転を受けて…", "…故が起きて、被害者はけがをされました。佐賀県警は、あおり運転をしたトラックドライバー、加害者の方を危険運転致死傷罪で逮捕しております。しかし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/24", "sentence": []}]}]}]