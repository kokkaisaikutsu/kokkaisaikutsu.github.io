[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/6", "sentence": ["…一七年の東名高速での死傷事故だというふうに思っております。前方で車を停止させて、そして、その車の後ろからトラックが突っ込んで、両親二人が亡く…", "…件でありまして、大きく報道もされました。ただ、この今の現行法であれば停止というものが危険運転致死傷罪になかなか適用が難しいという法的な欠陥が…", "…けでは該当しないというふうに答弁されております。そして、加えて、単に停止することだけではなく、こうした積極的に意図した場合というような意味内…", "…の事件とは全く別に、加害者が急ハンドルで前方に入ってきたり、前方で急停止したりしたとしても、例えば、いや、前に障害物があったので自分はこう動…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/24", "sentence": []}]}]}]