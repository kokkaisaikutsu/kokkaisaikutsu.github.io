[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/18", "sentence": ["…時間、執拗なものであったとしても暴行と同等とはみなせず、脅迫だという線引きはどこから生まれるんでしょうか。また、物理的に極めて接近していなく…", "…ます。そうしたことを考えれば、一市民、一国民から考えて、この改正案の線引きというのはなかなかすとんと落ちないんですけれども、なぜこの線引きが…", "…正案の線引きというのはなかなかすとんと落ちないんですけれども、なぜこの線引きが妥当と言えるのか、分かりやすく説明していただけますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/20", "sentence": ["…のかもしれないですけれども、国民、市民の目線からいって、それはそこで線引きができるんだ、類型的に違うんだと言われても、なかなか難しいかなと、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X01120200604/24", "sentence": []}]}]}]