[{"date": "2020-05-13", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/28", "sentence": ["…すけれども、作業用端末の数とインターネット端末がそれぞれ警察官一人当たりにどれぐらい配備されているのか、数字を教えていただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/30", "sentence": ["…はなかろうかと思っています。今、小学校、中学校でも一人一台パソコンを配備しましょうというふうになっている中です。是非とも警察の皆さんにも、す…", "…なかなか難しいかもしれませんけれども、一人一台のインターネット端末を配備するべきではないでしょうか。是非、武田国家公安委員長の御見解をお伺い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/34", "sentence": ["○山下雄平君五万台配備しているということだったんですけれども、これは佐賀県のような田舎の県警ではなくて都会の県警の人に聞いても、それって何で…", "…取り締まるんではなくて、そういうことをしなくてもいいような形で、数の配備であったり、そうした操作性に富むものの配備を是非とも警察の皆さんにお…", "…くてもいいような形で、数の配備であったり、そうした操作性に富むものの配備を是非とも警察の皆さんにお願いしたいと思っております。警察庁に関する…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/58", "sentence": []}]}]}]