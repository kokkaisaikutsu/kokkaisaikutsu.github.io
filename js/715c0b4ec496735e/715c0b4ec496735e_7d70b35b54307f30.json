[{"date": "2020-05-13", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/48", "sentence": ["…お話を聞いていただきました。災害は、救命救急の段階が終われば、この災害ごみの処理が大きな課題になってくると思います。昨年、私の地元、武雄の市…", "…は元々皆さんの思い出の品ですと、処理するのは心が痛みますと、でも、災害ごみがなくなり、町がきれいになったとき、人は一歩前に進もうという気持ち…", "…の姿を見て、まさにそのとおりだというふうに感じました。だからこそ、災害ごみの運搬、処理が迅速にできる体制を平時からつくっておく必要があるとい…", "…る体制を平時からつくっておく必要があるというふうに考えております。災害ごみの迅速な処理を妨げる要因は幾つかあろうかと思いますけれども、その一…", "…探すのは非常に困難になります。こうした事態に備えて、例えば災害時に災害ごみを優先して受け入れる処理場を事前に整備するということも検討すべきで…", "…れる処理場を事前に整備するということも検討すべきではないでしょうか。災害ごみ優先の処理場は考えられないでしょうか、お考えをお聞かせください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/58", "sentence": []}]}]}]