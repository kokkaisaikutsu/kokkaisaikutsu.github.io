[{"date": "2020-05-13", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/40", "sentence": ["…まして、離島で出るごみ問題について質問したいと思います。離島のごみ処理費用が自治体の財政に大きくのしかかっております。私の地元佐賀県にも有人…", "…私の地元佐賀県にも有人離島が七島あります。そこでも、運搬であったり処理費用であったり、また運搬船の維持コストなどが財政を圧迫しています。私の…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/42", "sentence": ["…交付税で措置しているという話でしたけれども、では、地方交付税で地域振興費（人口）の属島人口に係る補正によって措置されていることになっておりま…", "…正によって措置されていることになっておりますけれども、各自治体からは経費の方が大幅に上回っているというような声が上がっております。総務省とし…", "…っているというような声が上がっております。総務省として、離島のごみ処理費用は地方交付税で適正に計上されているというような認識でしょうか、お聞…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/44", "sentence": ["…けれども。それでは、離島振興を所管する国土交通省として、離島のごみ処理費用や運搬費用を財政的に支援しているのかどうか、現状をお聞かせください…", "…れども。それでは、離島振興を所管する国土交通省として、離島のごみ処理費用や運搬費用を財政的に支援しているのかどうか、現状をお聞かせください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/58", "sentence": []}]}]}]