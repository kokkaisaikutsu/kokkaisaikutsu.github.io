[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/52", "sentence": ["…三十年以内に福島県外での最終処分完了するためには、除去土壌の減容、再生利用は不可欠でございます。今般、一月八日にパブリックコメントに付された…", "…ございます。今般、一月八日にパブリックコメントに付された除去土壌の再生利用に関する省令案、告示案の内容、趣旨はどういうものでしょうか。また、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/56", "sentence": ["…ざいますが、そこで大臣にお聞きしたいと思っています。この除去土壌の再生利用って、まあいろんな意見があるわけですね。これについては、やはり理解…", "…って、この三十年以内の福島県外での最終処分が円滑に実現するために、再生利用の幅広い理解拡大に今回の特会の繰入れを活用して検討していくべきと考…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/64", "sentence": []}]}]}]