[{"date": "2021-12-14", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705261X00320211214/186", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00320211214/277", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00320211214/313", "sentence": ["…ような会計上の資産性がないと考えられ、そのような支出については確実な償還財源もなく、新たな特別な国債を発行することは実質的には赤字国債の発行…"]}]}]}, {"date": "2021-12-15", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/36", "sentence": ["…います。一つは、全て特例公債の追加発行で対応するか、あるいは、公債の償還財源を活用してでも特例公債の追加発行を抑制するかということであったわ…", "…多額の決算剰余金が発生していることを踏まえれば、これを極力当該債務の償還に充て、債務残高を圧縮すること、この方が適当であると考えられます。そ…", "…は、剰余金特例法を提出しませんで、財政法第六条第一項の規定に基づきまして、剰余金の二分の一を債務の償還に充てることとしたところでございます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/102", "sentence": []}]}]}]