[{"date": "2020-03-05", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/364", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/366", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/368", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/370", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/372", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/374", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/378", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/380", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/382", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/384", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/386", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/388", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/390", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/392", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/400", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/402", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/404", "sentence": ["…一番上を御覧ください。第二項は、任命権者は、十分な理由があるときは、人事院の承認を得て、一年を超えない範囲内で期限を延長することができるとし…", "…ることができるとしています。検事総長や検事長の任免権は内閣にあり、天皇が認証します。内閣が人事院の認証を得て再延長を決めるということですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/406", "sentence": ["○山添拓君人事院に伺います。人事院は、準司法官である検察官、内閣が任免する認証官の人事まで左右できると、こういうことになるわけですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/409", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/411", "sentence": ["○山添拓君法務大臣に伺いますけれども、そもそも人事院は検察官の人事には関与しないんですよ。国家公務員の給料は、人事院勧告に基づき一般職の給与…", "…そも人事院は検察官の人事には関与しないんですよ。国家公務員の給料は、人事院勧告に基づき一般職の給与法で定められますが、検察官は検察官俸給法で…", "…づき一般職の給与法で定められますが、検察官は検察官俸給法ですね。勤務延長の再延長については、そこだけは人事院の承認を受けるということですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/413", "sentence": ["○山添拓君驚きの答弁だと思います。再延長は特例です。人事院の審査が必要とされます。伺いますが、どのような審査を人事院は行うんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/415", "sentence": ["…山添拓君資料の八ページを御覧ください。勤務延長の期限の延長承認申請書とあります。人事院事務総局はどのような項目を記載すべきとしておりますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/417", "sentence": ["○山添拓君確認しますけど、人事院は検察官の再延長についても同じように求めるということですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/419", "sentence": ["○山添拓君法務大臣に伺います。これを人事記録の写しとともに人事院に提出することとされています。準司法官である検察官について、こんな扱いをする…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/421", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/423", "sentence": ["…拓君黒川氏の勤務延長の理由、今、国会ではほとんど答弁なさいませんけれども、その詳細についても人事院に報告を上げるということになるわけですね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/425", "sentence": ["○山添拓君これは到底理解できません。検察官が人事院の下に服するということをおっしゃっています。こういうおかしな事態が起きるのは、無理に解釈を…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/430", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/434", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/436", "sentence": ["…に、そこに特殊性があるわけですね。その特殊性を今法務大臣は否定をし、人事院の下に勤務延長の、とりわけ再延長の可否を委ねると、こういう御答弁さ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00720200305/438", "sentence": ["…件に関して作成したという文書は、一月十六日付けのメモ、そして法制局や人事院への照会文書、二点だけです。しかもそこには、解釈変更であることもそ…"]}]}]}, {"date": "2020-03-16", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X01120200316/380", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01120200316/382", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01120200316/384", "sentence": []}, {"url": "https://kokk