[{"date": "2020-03-25", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/470", "sentence": ["○山添拓君日本共産党の山添拓です。三月二十九日、羽田新ルートの運用開始が予定されています。どのような計画ですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/472", "sentence": ["…添拓君騒音、落下物、事故の危険など、様々な不安や懸念が表明されてきました。この新ルートの実機テストが行われました。その概要も御説明ください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/474", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/476", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/478", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/480", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/482", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/484", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/486", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/488", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/490", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/492", "sentence": ["…ますように、これまで羽田空港の離発着機は海から入って海に出ると、海上ルートを通っておりましたので、ですから落下物があったとしても分からないと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/494", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/496", "sentence": ["…着陸時の標準的な降下角度は日本でも世界でも三度です。ところが、昨年八月、新ルートでは三・五度にすると言い出しました。大臣、これはなぜですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/498", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/500", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/502", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/504", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/506", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/508", "