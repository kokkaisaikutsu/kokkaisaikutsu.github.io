[{"date": "2021-04-27", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/109", "sentence": ["…伺います。市場化テスト法では、競争入札を継続するかどうか、四年ごとに監理委員会が評価を行っています。二〇一九年にも市場化テストを継続すること…", "…ことになります。テストの期間というのはもう終わっていると思うんですね。監理委員会としてテストを終了させる、そういう判断することもできますね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/111", "sentence": ["○山添拓君いや、監理委員会が、継続することが適当という判断をしているんですね、評価としてしているわけです。だったら、継続することは適当でない…", "…しているんですね、評価としてしているわけです。だったら、継続することは適当でないと、こういう判断も監理委員会としてし得るんじゃありませんか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415206X01020210427/116", "sentence": []}]}]}]