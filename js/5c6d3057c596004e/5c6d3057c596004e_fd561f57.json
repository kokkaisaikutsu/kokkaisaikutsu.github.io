[{"date": "2021-02-24", "meeting": [{"meeting_name": "衆議院 予算委員会公聴会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/28", "sentence": ["…ます。今日はありがとうございます。先ほど様々な観点から、防災・減災、国土強靱化、特に強靱化というところで御指摘をいただいたところでございます…", "…、また国交省としても、今回、十五兆円規模で、骨太の方針ということで、国土強靱化の予算、加速化五か年計画というのを作らせていただきました。過去…", "…ざいます。前回、補正予算の審議をしたときに、実は、補正予算の中にこの国土強靱化の五か年加速化計画の初年度分の予算が入っていることに対して、メ…", "…と思っております。そこで、先生の御専門的な観点から、この十五兆規模の国土強靱化加速化プランということの評価についてお伺い、いただければと思い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405262X00120210224/119", "sentence": []}]}]}]