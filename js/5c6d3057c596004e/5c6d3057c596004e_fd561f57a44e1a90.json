[{"date": "2021-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/1", "sentence": ["…た、分科員の先生方、どうぞよろしくお願い申し上げます。本分科会は、国土交通省所管について審査を行うことになっております。令和三年度一般会計予…", "…一般会計予算、令和三年度特別会計予算及び令和三年度政府関係機関予算中国土交通省所管について、政府から説明を聴取いたします。赤羽国土交通大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/3", "sentence": ["○浜地主査この際、お諮りいたします。ただいま赤羽国土交通大臣から申出がありましたとおり、国土交通省所管関係予算の概要につきましては、その詳細…", "…りいたします。ただいま赤羽国土交通大臣から申出がありましたとおり、国土交通省所管関係予算の概要につきましては、その詳細な説明を省略し、本日の…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/5", "sentence": ["○浜地主査以上をもちまして国土交通省所管についての説明は終わりました。―――――――――――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405273X00120210225/142", "sentence": []}]}]}]