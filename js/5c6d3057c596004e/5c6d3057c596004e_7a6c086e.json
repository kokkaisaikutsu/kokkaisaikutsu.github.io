[{"date": "2020-04-06", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会第三分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/246", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/248", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/250", "sentence": ["…から、一カ月、二カ月先になって、資金繰りがもたない。逆に、ＱＲコード決済は、少額、例えば一万円たまればその次の週に入金をしていただくというこ…", "…にもなりますし、今なかなか消費は厳しいですが、しかし、このＱＲコード決済というのは少額の金額を扱う飲食業界にとっては非常に有用だということで…", "…まれていなかったということでございます。そこで、今後のキャッシュレス決済の普及についてはどのように考えているか、そこをやはりお聞かせいただけ…", "…かなか納得しがたいところもあるわけでございます。今後のキャッシュレス決済の普及促進について、経産省のお考えをお聞きさせていただきたいと思いま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/252", "sentence": ["○浜地分科員ポイント還元制度がなくなっても、確かにキャッシュレス決済独自のポイント等ございますので、やはりこれは推進していただきたいと思って…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/254", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/256", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/258", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/260", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/262", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/264", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/266", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/268", "sentence": []}]}]}]