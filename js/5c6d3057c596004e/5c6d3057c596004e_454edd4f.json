[{"date": "2020-05-27", "meeting": [{"meeting_name": "衆議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/23", "sentence": ["…りがとうございます。次に、妨害目的について、これも橋爪委員と、これは久保参考人にもお聞きをしたいと思います。妨害目的で車両を運行するというの…", "…いますか、運転者は予想できるわけでございます。そうなりますと、先ほど久保参考人からありましたとおり、処罰範囲が広くなり過ぎないかという懸念が…", "…ではないかというふうに私自身思いますが、この点に関して、橋爪委員また久保委員の御見解を拝聴できればと思います。ああ、参考人ですね、済みません…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/26", "sentence": ["…的に思ったところでございます。最後の質問にしたいと思いますが、先ほど久保委員からも御指摘がございましたが、五号の被害車両のところでございます…", "…詳しく解説をされるとしますと、どのような御説明をされるか。もう一度、久保参考人に、やはりこの要件について、御自身はこの要件について、どのよう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X01220200527/101", "sentence": []}]}]}]