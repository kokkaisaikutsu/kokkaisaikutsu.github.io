[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120313950X00520201201/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00520201201/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00520201201/9", "sentence": ["…した。その質問に対して、茂木大臣は、外相会談の中で尖閣は我が国固有の領土であること、そのことを明確に伝えたと答弁されました。そして、その本会…", "…けれども、その辺のこと、こうした中国の挑発にいかに対応するか、そして我が国の領土、領海をいかに守っていくか、その辺、決意をお伺いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00520201201/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00520201201/13", "sentence": []}]}]}]