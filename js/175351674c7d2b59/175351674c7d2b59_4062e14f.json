[{"date": "2020-03-05", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113950X00220200305/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00220200305/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00220200305/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00220200305/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00220200305/5", "sentence": ["…委員長（北村経夫君）外交、防衛等に関する調査を議題といたします。まず、外務大臣から外交の基本方針について所信を聴取いたします。茂木外務大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00220200305/7", "sentence": ["○委員長（北村経夫君）次に、防衛大臣から国の防衛の基本方針について所信を聴取いたします。河野防衛大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00220200305/9", "sentence": ["○委員長（北村経夫君）以上で所信の聴取は終了いたしました。本件に対する質疑は後日に譲ることとし、本日はこれにて散会いたします。午後零時五十一…"]}]}]}]