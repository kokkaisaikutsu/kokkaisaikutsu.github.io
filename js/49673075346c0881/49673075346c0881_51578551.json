[{"date": "2021-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第二分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/127", "sentence": ["…〕昭和三十年十一月十七日、ＮＨＫで、長崎の端島炭坑、いわゆる軍艦島の坑内作業の様子を報じた「緑なき島」というドキュメンタリー番組が放送されま…", "…もされています。番組内では、ふんどし姿の作業員がつるはしを振るったり坑内を四つんばいで進む映像などが放送され、この映像は、戦時中のいわゆる強…", "…は裸での作業が事実上禁じられていた、当時、つるはしは使われておらず、坑内の高さも一・五メートルが確保され、はいつくばる必要もなかった、坑内は…", "…、坑内の高さも一・五メートルが確保され、はいつくばる必要もなかった、坑内はガス爆発を防ぐため特殊な照明器具が設置され、ヘルメットには照明灯の…", "…ルメットに照明が装着されていないなど、複数の点で元島民の証言や当時の坑内規則と食い違うことが分かりました。元島民は、事実と異なると検証を求め…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405272X00120210225/157", "sentence": []}]}]}, {"date": "2021-03-18", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404601X01020210318/107", "sentence": ["…もされています。番組では、端島の当時の様子が紹介されるとともに、炭坑坑内の様子も映し出されます。放