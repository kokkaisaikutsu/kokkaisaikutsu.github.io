[{"date": "2021-05-21", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/6", "sentence": ["…方々もおられます。そこで、お尋ねいたします。本法案が定める国境離島等には、当然、尖閣諸島や竹島が含まれているという理解でよろしいでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/8", "sentence": ["…お答えできないという答弁でございましたが、言うまでもなく、尖閣諸島も竹島も、日本の安全保障上非常に重要な土地です。現状に鑑みれば、当然個別指…", "…、相手国の政府に対して同様の勧告及び命令ができるのでしょうか。現在、竹島では韓国の武装警察が常駐しておりますが、韓国政府に対して勧告及び命令…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/12", "sentence": ["○杉田委員答弁ありがとうございます。そもそも、韓国による竹島の実効支配は不法占拠です。この法案によらずとも、撤去命令を出し、従わない場合は何…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02620210521/24", "sentence": []}]}]}]