[{"date": "2020-11-19", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/130", "sentence": ["…ンターの調査なんです。最新のものです。コロナの間に、特別な配慮を要する園児の家庭や、高い育児ストレス、子供への不適切な関わりなどが心配される…", "…い育児ストレス、子供への不適切な関わりなどが心配される家庭について、登園しなくなってしまった家庭ですね、そのうちの、特に対応していない、また…", "…いと答えた方が、これ大体一七％ぐらいあるんですね。二〇％、二割弱の保育園の方々がどうしていいか分からない、また登園しなくなっても特に対応して…", "…ですね。二〇％、二割弱の保育園の方々がどうしていいか分からない、また登園しなくなっても特に対応していなかったということを回答されております。…", "…いなかったということを回答されております。保育所の突然の退所は、また休園は、虐待、児童虐待の早期発見のサインというふうに言われておりますけれ…", "…るべきなんじゃないかなと思っております。今後の児童虐待を関わっていらっしゃる方々と保育園との連携についてお考えがあったら伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201