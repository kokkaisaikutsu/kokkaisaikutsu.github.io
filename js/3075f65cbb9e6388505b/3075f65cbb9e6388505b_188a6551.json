[{"date": "2021-05-13", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/21", "sentence": ["…だきたいと思っております。次です。高齢者の接種が始まっておりますが、記入漏れが相次いでいると各新聞報道出ております。ＶＲＳという、河野システ…", "…ＲＳという、河野システムと昔呼ばれておりましたシステムが非常に煩雑で記入しづらいと。また、タブレットを皆さん自治体に配っていて、私も予算委員…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/23", "sentence": ["…て改善していかなければならないと私は強く思っております。高齢者の方の記入漏れのお話なんですが、厚労省の昨日のいただいた数によりますと、五月九…", "…大きな漏れだと思います。必ず目詰まりを起こしておりますし、しっかりと記入漏れのないように、前は手入力をして、それでファクスを送って新規感染者…", "…す。しっかりとシステムを改修し、使い勝手の良いものを送り、そしてこの記入漏れがないようにしっかりとお願いしたいと思います。いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01520210513/43", "senten