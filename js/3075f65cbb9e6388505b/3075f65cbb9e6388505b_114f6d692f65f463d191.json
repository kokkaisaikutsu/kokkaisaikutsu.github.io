[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/55", "sentence": ["…んある中で、二次補正で雇用調整助成金に代わる形で、また並列する形で休業支援金制度というものが今議論されているというふうに理解しております。資…", "…夫なのかという、多くの人数の方々が今休業されております。次に、この休業支援金制度の制度設計について伺いたいと思います。この新しい支援金制度と…", "…も払わなきゃいけなくて大変だということ、声を聞いております。この新しい休業支援金制度、学生アルバイトは対象になるでしょうか、お答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/57", "sentence": ["…勤の保育士さんたくさん働いていらっしゃるんですが、こうした方々、新しい政府が考えている休業支援金制度、対象になるでしょうか、お答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/65", "sentence": ["…もないという中で、困っている外国人労働者がいる。こうした方々に今政府が検討されている休業支援金制度、これ対象になるかどうか、お答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/75", "sentenc