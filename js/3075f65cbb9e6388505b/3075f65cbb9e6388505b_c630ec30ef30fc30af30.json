[{"date": "2020-11-19", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/122", "sentence": ["…省の方々が調査を行いました。どうして我々は時短勤務ができないのか、テレワークができないのか、たくさんの業務改善ができないのかということのアン…", "…改善ができないのかということのアンケート調査の結果が出ております。テレワークができなかった理由、四割が、自分が希望していても、厚労省の皆さん…", "…ができなかった理由、四割が、自分が希望していても、厚労省の皆さん、テレワークができなかった。その理由は、トークンが融通できなかったからという…", "…いんです。本当にやれる立場にある方々が周りに気兼ねをして時短勤務やテレワークができないというのは非常に悲しいことだと私は思います。こうした空…", "…るべき立場にある厚労大臣だと思います。周りに気兼ねせずに、積極的にテレワークや時差通勤、ペーパーレスなどの業務改善を進めることができる職場づ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/126", "sentence": ["…しまってやりにくいというのは非常に私自身も感じております。次です。テレワークができなかった理由として、国会対応が大きな大きな理由になっており…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00320201119/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X003202011