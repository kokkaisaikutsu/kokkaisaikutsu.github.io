[{"date": "2020-11-17", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/8", "sentence": ["…げてまいりたいと思います。武田大臣の所信の中で、復旧・復興支援技術職員派遣制度に言及されました。そこで、この復旧・復興支援技術職員派遣制度の…", "…・復興支援技術職員派遣制度に言及されました。そこで、この復旧・復興支援技術職員派遣制度の活用状況と今後の見通しをお聞かせ願いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/12", "sentence": ["…なというふうに思うわけであります。この制度は、先ほど申し上げた技術職員派遣制度とともに、私は、まさにこの総務省のヒット商品と言うべきすばらし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00220201117/22", "sentence": []}]}]}]