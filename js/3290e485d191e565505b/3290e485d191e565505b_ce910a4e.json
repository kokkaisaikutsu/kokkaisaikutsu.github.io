[{"date": "2021-03-15", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/38", "sentence": ["…いう目標を掲げております。そこで、食料自給率目標の達成に向けて、食料自給率を引き上げていく具体的な方策を野上農林水産大臣にお聞きいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/40", "sentence": ["○進藤金日子君野上大臣、ありがとうございます。食料自給率の向上を図るためには、具体的に資料二の図の中の白の、白いところですね、白色の部分を青…", "…丁寧に説明をし、理解を得ていく必要があると考えております。これ、今、野上大臣も御指摘になられました。やはり国民の皆様に御理解いただくことが重…", "…夫が必要だと今私は提案しているわけであります。そこで、食料安全保障の観点からの農政の推進について、野上農林水産大臣にお聞きしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01120210315/51", "sentence": []}]}]}]