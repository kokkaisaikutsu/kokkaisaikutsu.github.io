[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/6", "sentence": ["…防衛省におきましては、政務三役は緊急事態の発生に備えて交代で待機する態勢を確保しております。待機態勢を取る場合には、速やかに防衛省又は官邸な…", "…役は緊急事態の発生に備えて交代で待機する態勢を確保しております。待機態勢を取る場合には、速やかに防衛省又は官邸などに参集できるよう、そういっ…", "…っております。私は、副大臣就任時に都内に住居がなかったことから、待機態勢を取る場合には宿泊施設を利用しておりました。しかし、昨年の秋、河野防…", "…舎がちょうど青山に空いておりましたので入居をいたしまして、現在、待機態勢を取るために公費による宿泊施設の利用は行っていないというところでござ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00320200310/106", "sentence": []}]}]}]