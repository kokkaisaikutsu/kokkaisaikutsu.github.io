[{"date": "2020-11-20", "meeting": [{"meeting_name": "参議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/15", "sentence": ["…も含めた治水の在り方をじっくりと議論すべきという意見もありますが、治水対策を決めずに復興事業を進めることは可能なのか、お答えいただきたいと思…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/17", "sentence": ["…基づいて、川辺川ダム建設を含む球磨川流域の科学的、客観的で抜本的な治水対策をスピード感を持って講じられるよう強く要望するとの意見書を可決され…", "…を目指し、新たな流水型ダムを含む緑の流域治水を表明しております。その表明を受けて国はどのような治水対策を進めていくのか、お尋ねをいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/24", "sentence": []}]}]}]