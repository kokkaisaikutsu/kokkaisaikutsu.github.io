[{"date": "2020-11-25", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/133", "sentence": ["…ります。総理もバイデン氏と電話会談を行っていただきました。この中で、日米安保第五条が尖閣諸島に適用するということを改めて御確認をいただきまし…", "…諸島に適用するということを改めて御確認をいただきましたし、その上で、日米同盟を強化してインド太平洋地域の平和と安定に向けて共に協力していくと…", "…ていくという発言があったとされております。菅総理は、官房長官時代から日米同盟の強化に向けては様々なお取組をしてこられました。これまでどおり、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/144", "sentence": []}]}]}, {"date": "2021-05-07", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X02020210507/10", "sentence": ["…に復帰した米国とは、共に世界の脱炭素化をリードしていくことを確認し、日米気候パートナーシップを立ち上げるなど、一連の取組を高く評価いたします…"]}]}]}]