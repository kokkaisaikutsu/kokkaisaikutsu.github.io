[{"date": "2020-10-30", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315254X00320201030/15", "sentence": ["○小池晃君日本共産党の小池晃です。会派を代表して、質問します。日本学術会議が推薦した会員候補六名の任命拒否は、民主主義と法治国家の在り方に対…", "…ないと答弁してきました。実際、委員が任命制になって以来三十七年間、学術会議が推薦した委員が任命されなかったことは一度もありませんでした。それ…", "…たことは一度もありませんでした。それが総理に拒否されたのですから、学術会議の事務局長も驚愕したと答弁したのであります。理由の説明を学術会議側…", "…、学術会議の事務局長も驚愕したと答弁したのであります。理由の説明を学術会議側が求めるのは当然ではありませんか。任命拒否された六名の方も説明を…", "…う点について、内閣法制局の了解を得たと言いますが、そのことは当時の学術会議会長にも、意思決定機関である幹事会にも伝えられていませんでした。こ…", "…られるとしましたが、それぞれ具体的な根拠をお示しください。この間の学術会議の改革努力によって、男女比も、会員の地域分布も、特定大学への集中も…", "…否したのは、総合的、俯瞰的な観点に反するのではありませんか。総理は学術会議の在り方を見直すと言いますが、安倍政権下の有識者会議が一五年三月に…", "…の問題でもありません。全ての国民にとっての重大問題であります。日本学術会議法に反し憲法で保障された学問の自由を脅かす任命拒否は撤回すべきです…"]}]}]}, {"date": "2020-11-06", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/319", "sentence": ["○小池晃君日本共産党の小池晃です。日本学術会議委員六名の任命拒否について聞きます。総理は、昨日、自民党の質問に対して、以前は内閣府の事務局な…", "…す。総理は、昨日、自民党の質問に対して、以前は内閣府の事務局などと学術会議の会長との間で一定の調整が行われていたと答弁されました。以前とはい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/321", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/323", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/329", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/331", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/333", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/335", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/341", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/343", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/345", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/349", "sentence": ["…。総理は、今回の任命に当たっては、推薦前の調整が働かず、結果として学術会議から推薦された者の中に任命に至らなかった者が生じたと昨日述べている…"]}, {"url": "https://kok