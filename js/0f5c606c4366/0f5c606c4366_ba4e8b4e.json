[{"date": "2020-10-30", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315254X00320201030/15", "sentence": ["…然ではありませんか。任命拒否された六名の方も説明を求めており、個別の人事を盾に拒否する理由は成り立ちません。総理には、任命拒否の理由を誠実に…", "…経済の危機も進行しています。小口倒産が急増し、過去の借金が返せない個人事業主の自己破産も増加しています。コロナ禍の下で、小さいところから潰れ…"]}]}]}, {"date": "2020-11-06", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/319", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/321", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/323", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/329", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/331", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/333", "sentence": ["○小池晃君人事のプロセスだから説明を控えるということは、人事だから言えないということは、個別の人事に関わる調整をやったということですね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/335", "sentence": ["○小池晃君答えてない。だって、個別の人事だから答えられないと言ったんです。だったらば、個別の人事に関する調整やったんですかと私聞いているんで…", "…って、個別の人事だから答えられないと言ったんです。だったらば、個別の人事に関する調整やったんですかと私聞いているんです。答えていただきたい。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/341", "sentence": ["○小池晃君私は、人事のプロセスだから答えられない、すなわち個別の人事に関わる問題だから答えられないというわけでしょう。ということは、この調整…", "○小池晃君私は、人事のプロセスだから答えられない、すなわち個別の人事に関わる問題だから答えられないというわけでしょう。ということは、この調整…", "…問題だから答えられないというわけでしょう。ということは、この調整というのは個別の人事に関わる調整ですよね、イエスかノーかと聞いているんです。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/343", "sentence": ["○小池晃君人事のことが問題になっているときに人事について答えられなかったら議論にならないじゃないですか。こんなの駄目ですよ。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/345", "sentence": ["○小池晃君私は個人の人事の理由を一切聞いていません。一切聞いていません。この調整は何かと聞いているだけです。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/349", "sentence": ["…ということは、この一定の調整というのは、これは先ほど認められた個別の人事に関わる問題なんですよ。だって、個別の人事は答えられないと最初言った…", "…れは先ほど認められた個別の人事に関わる問題なんですよ。だって、個別の人事は答えられないと最初言ったんだから。この一定の調整とい