[{"date": "2020-10-30", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315254X00320201030/15", "sentence": ["…の結論を覆すような事実があったのですか。具体的に示していただきたい。学問と科学は、政治権力に従属するものであってはなりません。学問が弾圧され…", "…だきたい。学問と科学は、政治権力に従属するものであってはなりません。学問が弾圧され、戦争に突き進んだ過去の教訓から、憲法二十三条は学問の自由…", "…せん。学問が弾圧され、戦争に突き進んだ過去の教訓から、憲法二十三条は学問の自由を保障したのです。学問も科学も国民のためのものです。この問題は…", "…突き進んだ過去の教訓から、憲法二十三条は学問の自由を保障したのです。学問も科学も国民のためのものです。この問題は、任命を拒否された六名だけの…", "…民にとっての重大問題であります。日本学術会議法に反し憲法で保障された学問の自由を脅かす任命拒否は撤回すべきです。以上、総理の答弁を求めます。…"]}]}]}, {"date": "2020-11-06", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/319", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/321", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/323", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/329", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/331", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/333", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/335", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/341", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/343", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/345", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/349", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/353", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/355", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/359", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/362", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/364", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/366", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/368", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/370", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/373", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/375", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/379", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/383", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/387", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/391", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/394", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/396", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/398", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/402", "sentence": ["…房副長官には出席を求めます。続けて聞きます。総理は、今回の任命拒否は学問の自由を脅かすものではないと。総理の考える学問の自由とは一体何ですか…", "…副長官には出席を求めます。続けて聞きます。総理は、今回の任命拒否は学問の自由を脅かすものではないと。総理の考える学問の自由とは一体何ですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/404", "sentence": ["○小池晃君すなわち、学問の自由というのは個々の研究者の学問研究の自由だけではないという理解でよろしいですね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/406", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/408", "sentence": ["…をきちっと、自律性、自主性を保障するということまで含めたものですねと、丁寧に聞いているんです。そういうのが学問の自由ですねと。いかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/410", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/416", "sentence": ["…コミュニティーの自律性、自主性を尊重することが、やはり個々の研究者の学問研究の自由を保障するためにも、これは絶対不可欠であるし、中でも日本学…", "…にも、これは絶対不可欠であるし、中でも日本学術会議というのは、科学、学問の見地から政府に意見を述べることを任務とするところなわけでしょう。だ…", "…組織だと思うんですよ。総理、もう一回聞きます。憲法二十三条が保障する学問の自由には、個々の学者の研究内容だけではなく、学者コミュニティーの政…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/420", "sentence": ["…そ、会員の選出方法を変更した一九八三年の国会で、当時の中曽根首相は、学問の自由について、問われてもいないんです、この質問は。質問されていない…", "…かかわらず、あえて、政府の行為は形式的行為であるとお考えくだされば、学問の自由独立というものはあくまで保障されると、そう中曽根さんは答弁され…", "…はあくまで保障されると、そう中曽根さんは答弁されたんですよ。それだけ学問の自由を重視していたわけですよ。総理は、これまで三十七年間、もう前例…", "…すか。私は違うと思いますよ。中曽根首相を始め、やはり憲法で保障された学問の自由は極めて大事だから、だから、その趣旨を踏まえて、会員選考におけ…", "…総理はこの形式的任命を覆したんですよ。だから私は、総理がやったことは学問の自由を脅かすものにほかならないと、学問の自由の侵害だと申し上げます…", "…から私は、総理がやったことは学問の自由を脅かすものにほかならないと、学問の自由の侵害だと申し上げます。学問の自由の侵害そのものじゃないですか…", "…ら私は、総理がやったことは学問の自由を脅かすものにほかならないと、学問の自由の侵害だと申し上げます。学問の自由の侵害そのものじゃないですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/422", "sentence": ["○小池晃君答えていない。今回の任命拒否は学問の自由を脅かすものではないですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/424", "sentence": ["○小池晃君学問の自由ということについてこれほど軽い答弁はないと思いますよ。何かメモがなきゃしゃべれないような話じゃないでしょう。政治家として…", "…る考え方を披瀝するべきなんじゃないですか。それが全くない。戦前だって学問の自由は守ると繰り返してきたんですよ。しかし、どういう歴史があったか…", "…都大学の教授会は、もしいっときの政策により教授の進退が左右されれば、学問の真の発達は阻害されると抗議をした。しかし、政府は、文部大臣が監督下…", "…族院で審議された。本会議場で賛成討論に立った議員はこう演説しました。学問の自由というのはどこまでも絶叫いたしたい、けれども、我が国においては…", "…議員を辞めさせられ、公職から追放されたわけです。今総理が言ったこと、学問の自由は守るけれども、でも、全く同じじゃないですか。権力の側は、いつ…", "…権を迫害してきたんですよ。菅政権がやっていることは戦前の政府がやった学問の自由の侵害と一体どこが違うのか。結局同じことやってるんですよ、今。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/426", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/428", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/430", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/432", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/434", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/436", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/438", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/440", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/442", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/