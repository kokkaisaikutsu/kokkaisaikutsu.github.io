[{"date": "2021-06-03", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/55", "sentence": ["…定年制のときに、明確に内閣委員会の中で時の総理大臣は、最大限この団体交渉権と労働協約締結権は尊重しなければならないというふうに答えていますの…", "…、少なくとも、結果として勤務条件に影響する今回のこの定年延長の事項は交渉対象であることを指摘しておきます。一方で、問題は、管理運営事項をめぐ…", "…な労使の紛争とかを起こすことにもなりかねないと思うんですが、再度この今回の定年延長はきちんと労使交渉事項だということを答えていただけますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/57", "sentence": ["○岸真紀子君分かりました。対象になるよということですね。その交渉の申入れがあってというのがちょっとおかしくて、それでちょっと私も今変だなと思…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/65", "sentence": []}]}]}]