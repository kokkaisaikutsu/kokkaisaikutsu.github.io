[{"date": "2020-02-19", "meeting": [{"meeting_name": "参議院 資源エネルギーに関する調査会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/52", "sentence": ["…状況にあります。さらに、伊方原発においては、活断層や火山の影響という自然災害に、まあ大丈夫だろうと言うだけでは安心できる住民という方はいない…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/56", "sentence": ["…ギーなので電気に限らないというところですが、脱原発社会にこれを見ると自然となっているんではないかというふうに考えます。このまま、どうでしょう…", "…、本当の意味でクリーンなエネルギーでもあり、日本国内で自給ができる、自然を利用した再生エネルギーに力を注いでいった方がいいのではないでしょう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114396X00220200219/62", "sentence": []}]}]}]