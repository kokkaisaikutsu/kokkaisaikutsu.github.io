[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/144", "sentence": ["…とが、農業高校卒業生、新規就農に対する皆さんに対して思い切った様々な手だてを、農林水産省、きちっと入れてくれましたよね。このことがやっぱり大…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/146", "sentence": ["…いただきました。私は、そのことをどうぞ新規就農の皆さん、担い手確保の手だての中に入れ込んで、そして具体化しましょうよ。さっき言いましたように…", "…せん。どうぞ、どんな魅力を持って農業に就農してもらうか、ここにどんな手だてを講じていくかということについて、もっともっと我々工夫しようじゃな…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/148", "sentence": ["…もありますし、農業共済の仕組みもありますし、酪農や畜産なんかは特別の手だてもあります。米についても対策はあります。まあまあいろんな形での品目…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/152", "sentence": []}]}]}, {"date": "2021-03-16", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/8", "sentence": ["…ぎりの段階だというふうに思います。心配される過剰対策に農水省はどんな手だてを講じようとしているのか、また講ずるつもりか、決意をお聞きします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/18", "sentence": []}]}]}]