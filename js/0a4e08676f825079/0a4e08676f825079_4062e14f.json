[{"date": "2021-03-09", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415007X00120210309/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00120210309/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00120210309/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00120210309/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00120210309/5", "sentence": ["…農林水産に関する調査を議題といたします。令和三年度の農林水産行政の基本施策について、農林水産大臣から所信を聴取いたします。野上農林水産大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00120210309/7", "sentence": ["○委員長（上月良祐君）以上で所信の聴取は終わりました。本件に対する質疑は後日に譲ることとし、本日はこれにて散会いたします。午後零時十八分散会"]}]}]}]