[{"date": "2020-05-25", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/144", "sentence": ["…します。次に、ＦＭＳ、防衛装備品のＦＭＳについて伺います。この調達、納入遅れ、海上自衛隊の対艦誘導弾、六年超過、中には九年超過しているものま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/150", "sentence": ["…件によって取引が実施され、結果として、防衛省において防衛装備品等の未納入等により未精算額が多額に上ります。米国政府に支払った前払金の精算状況…", "…計八千五百十億円。このうち、出荷予定時期を経過したが、防衛装備品等の納入が完了していないため精算が遅延しているケースの件数及び未精算額は八十…", "…なっていたことが明らかになりました。ＦＭＳ調達における防衛装備品等の納入が完了していない状態が続いた場合には、部隊等の運用にも支障を来すおそ…", "…検査院では、部隊等の運用にも支障を来すおそれがある事態が複数見受けられたとされていますが、未納入が続く場合の部隊等への影響について伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00620200525/156", "sentence": []}]}]}]