[{"date": "2021-05-17", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/9", "sentence": ["…れてきたんじゃないのかというふうに言われているわけですが、まずこのことについて梶山大臣の見解、事実関係も含めてお述べいただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/17", "sentence": ["…、今現在でももちろんそういうことがあってもいいと思うんですよ。先ほど大臣は、今回のＣＶＣについては、いや、我々は何も関知、関与していませんと…", "…報が出ないようにするためも含めて、国益を損なわないために国有化ということも私は考えてもいいと思いますが、大臣の見解をお聞きしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00620210517/33", "sentence": ["…れならそういうふうに国の方が整理してあげるべきなんですね。今日、梶山大臣に残っていただいているのは、要はこれ、原子力のこの後の始末の話は環境…"]}]}]}]