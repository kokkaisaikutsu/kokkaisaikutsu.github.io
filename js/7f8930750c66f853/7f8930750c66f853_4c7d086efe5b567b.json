[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/122", "sentence": ["…いくという、そういう仕組みが大事だと思うんですけれども、お二人に、経済対策として、まず供給力、それから、その先のＶ字回復のためにそれを守らせ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/125", "sentence": ["…うに、まず終息させていくため、そしてその間に潰させないと、その後は経済対策してやっていこうと、こういうことだと思うんですね。さて、そのときに…", "…分かりませんが、それを目指してあらかじめ我々は何をすべきかという、経済対策、この準備しておかなきゃなりませんよ。そもそも、その準備期間が結構…", "…たときに、五百数十兆のＧＤＰの一〇％がなくなるということですから、経済対策としましても、やっぱり五、六十兆円、年間、年単位でやらなきゃならな…", "…お金がそこで使えると。しかも、プラスそこからあと三十兆円近い様々な経済対策が必要だと思うんですね。ですから、まず、ここは一番大事なのは、昨日…", "…て異次元の、できること全部、全てやるという、かなり思い切った大胆な経済対策をやらねばならないという、こういう決意を表明されたわけでありますが…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/127", "sentence": ["○西田昌司君ちなみに、今、二十五、六兆の経済対策おっしゃいましたけれども、それは事業費ベースであって、真水はうんと少ない四兆円台だったと思い…", "…きに、これ二か年にわたってそれなりの、これ麻生内閣もしていただきましたけれども、どれぐらいの経済対策されたんですか、ちょっと教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/133", "sentence": []}]}]}, {"date": "2021-04-07", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/10", "sentence": ["…でございますけれども、バイデン政権、まず二百兆円規模のコロナ対策の経済対策、これを上院で可決されたと。その後、矢継ぎ早に、今度は二百二十兆円…", "…を上院で可決されたと。その後、矢継ぎ早に、今度は二百二十兆円規模の経済対策、いわゆる八年間でこれぐらいのインフラ整備などをするということを発…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/12", "sentence": []}, {"url": "htt