[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/131", "sentence": ["…いう話ですよ。全く逆さまです。今、ゼロ％の金利ですよ。深掘りしてマイナス金利までやっちゃっている。それで何かインフレ状態が起こっているかと、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/133", "sentence": []}]}]}, {"date": "2021-04-13", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/89", "sentence": ["…えしてやっていこうと、こういうことだと思うんですよ。日銀は、実際マイナス金利までやっていますから、もう考えられないことまでやっているんです。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/91", "sentence": ["…金融機関を応援していると。もう片っ方で貸出しをどんどんさすためにマイナス金利を付けて、貸さないとおまえら損だぞという、罰金も取っているわけで…", "…しましても、このことが金融機関にとって大変負担になってくるので、マイナス金利というのはですね。そこで、そういうコロナ融資やったところはプラス…", "…なる。そうすると、金利が上がるわけですね。金利が上がると、日本はマイナス金利、ゼロ金利、それが金利が上がるとアメリカのドルの方が、どうなるん…", "…バランスが崩れてくると。だから、それに対抗するためには深掘りするマイナス金利をやれる準備をしているんだという解説なんですが、そうなんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00920210413/97", "sentence": []}]}]}]