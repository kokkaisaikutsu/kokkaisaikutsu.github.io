[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/129", "sentence": ["…きな違いがある。つまり、片っ方のこの付加価値税の方は、ある意味で法人課税されているようなものですよ、ある意味ね、それは。かつ、しかし、消費税…", "…に、もう一度消費税を上手に、三％、五％なり、そのときの状況に合わせて課税を掛けていけば、加熱した経済を抑えながら、経済成長もできながら、ヨー…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/133", "sentence": []}]}]}, {"date": "2021-04-07", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/22", "sentence": ["…来てもらっていますが、そもそも今金利がほとんどないですから、源泉分離課税で入ってくる利子課税なんかもほとんどないと思いますよ。これ、一％上が…", "…、そもそも今金利がほとんどないですから、源泉分離課税で入ってくる利子課税なんかもほとんどないと思いますよ。これ、一％上がれば、その分どかっと…", "…ず増えるんですよ、これはね。そのことによって税収増えるんじゃないですか。少なくとも源泉分離課税の利子税の