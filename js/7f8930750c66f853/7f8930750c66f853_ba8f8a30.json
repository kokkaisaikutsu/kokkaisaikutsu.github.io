[{"date": "2021-04-07", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/12", "sentence": ["…いるかというと、要するに、太い線がありますね。太い線がこの二〇〇一年辺りから急激に伸びていっています。この太い線というのが国債発行残高なんで…", "…たのかというと、この二〇〇〇年行く手前ですね、一九九七年、九年、この辺りから急激に増えていますね、国債残高。これ何かというと、逆に民間の借入…", "…の借入金残高はずっとこれ伸びていたんですね。ところが、この一九九三年辺りをピークに一挙に下がっています。これ何かというと、いわゆるバブル崩壊…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/24", "sentence": ["…申し上げているわけです。この後、小泉大臣に質問しますので、黒田総裁はこの辺りで。また今度財金で質問しますので、よろしくお願いします。どうぞ。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/32", "sentence": []}]}]}]