[{"date": "2020-04-10", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X01120200410/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01120200410/97", "sentence": ["…いただいております。私がいろいろと聞いた中ですと、私のところは埼玉、牧原副大臣のところも同じ埼玉県ですけれども、恐らく、もしかすると東京ある…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01120200410/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01120200410/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01120200410/103", "sentence": ["…きましたので、そのあたりのお話を聞いていきたいと思います。きょうは、牧原経産副大臣にもお越しをいただいております。埼玉県の信用保証協会のお話…", "…かなければいけないということでございまして、きょうはたまたま委員長も牧原先生も埼玉なので、別に埼玉の話だけをするつもりはないんですけれども、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01120200410/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01120200410/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01120200410/109", "sentence": []}]}]}]