[{"date": "2020-03-10", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/44", "sentence": ["…たのではないかなというふうに思っております。聞くところによると、一回着岸して、いろいろと検疫をしたり何だりしている、その合間だったかちょっと…", "…り何だりしている、その合間だったかちょっと記憶にないですけれども、一旦岸を離れて、船自体の真水をつくったりあるいは排水をしたりするので、一回…", "…思いますけれども。この船だけではなく、今もほかの国では、クルーズ船を着岸させるさせないということも含めていろいろ問題が起こっているということ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/54", "sentence": []}]}]}]