[{"date": "2020-11-17", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/20", "sentence": ["…裕通総務副大臣にお伺いします。国民の理解を得ながら、将来的にはマイナンバーカード一枚で何でも行政サービスを受けられるように私はすべきだと考え…", "…サービスを受けられるように私はすべきだと考えています。そこで、マイナンバーカードの国民の取得一〇〇％への取組の強化や、取得する国民のメリット…", "…得一〇〇％への取組の強化や、取得する国民のメリット、さらには、マイナンバーカードを取得していない場合の現状のデメリットは何があるのか、そして…", "…存の各種証明書と併用も含めて利用することも踏まえまして、今後、マイナンバーカードに各個人情報の集約を進める上でマイナンバーカードを持たない国…", "…ことも踏まえまして、今後、マイナンバーカードに各個人情報の集約を進める上でマイナンバーカードを持たない国民のデメリットについてお伺いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00220201117/31", "sentence": []}]}]}]