[{"date": "2020-03-18", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/227", "sentence": ["…豪雨災害は、全国各地に甚大な被害をもたらしました。河川の堤防の決壊や越水、溢水などが多数生じたところです。私の地元の埼玉でも、例えば東松山市…", "…ツ印がついているところです。一方、左上のところを見ていただきますと、越水ということで、東松山市葛袋地先ということで、越水の表記があるところで…", "…見ていただきますと、越水ということで、東松山市葛袋地先ということで、越水の表記があるところです。私は、発災の翌日に現地に調査に入りました。現…", "…るように、都幾川が右から左手の方に流れている、その左岸側で、右上に、越水箇所と赤い楕円が記してあるところというのがまさにこの三枚目の写真のと…", "…っくり流されている状況というのは写真で見ていただけると思います。この現場を国交省は越水としているんですが、これは堤防の決壊ではないんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/229", "sentence": ["○塩川委員現地事務所が越水としたんだけれども、これはもう堤防の決壊ということでよろしいですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/231", "sentence": ["○塩川委員十月の災害なわけなんです。でも、現状まで越水のままなんですよ。この場所というのは、二枚目の写真にもありますように、右手の方の下流部…", "…るわけですね。そういったときに、国交省の認識が、決壊じゃありません、越水ですと通されると、それは地元的にも納得がいかないような話じゃないでし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/233", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/235", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/237", "sentence": ["…とおりだと思います。その上で、そうであれば、やはりもう一歩進んで、耐越水堤防と言われるような天端の舗装、補強、それから裏のり尻のブロックの強…", "…ブロックの強化にとどまらず、堤防全体をいわばよろいのように補強する耐越水堤防、この実施に踏み出すときじゃないのか。この点についてはいかがです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/239", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/241", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/243", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/245", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/247", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/249", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/253", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/255", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/257", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/259", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/261", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/263", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/265", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/267", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/269", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/271", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00420200318/273", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/12010