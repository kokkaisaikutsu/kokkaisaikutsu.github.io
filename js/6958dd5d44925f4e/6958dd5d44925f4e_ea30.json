[{"date": "2020-04-15", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/136", "sentence": ["…ジネスモデルを探せという話ですけれども、この間、金融庁は、金融システムリポートなどを通じて地域金融機関の経営危機をあおり、銀行の合併や人件費…", "…トなどを通じて地域金融機関の経営危機をあおり、銀行の合併や人件費などのリストラ、人材紹介など他業への展開を迫ってまいりました。本法案もその一…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/155", "sentence": ["…取引委員会が判断を行っています。本案は、金融庁に監督権限を与え、モニタリングし、是正措置を行い、利用者への不当な不利益を回避できるとしていま…", "…ません。この間、金融庁は、地域金融機関の経営危機をあおり、経営統合のメリットを並べ立て、人件費や店舗統廃合などのリストラ、人材紹介など他業へ…", "…営危機をあおり、経営統合のメリットを並べ立て、人件費や店舗統廃合などのリストラ、人材紹介など他業への展開を迫るなどといった政策を進めています…"]}]}]}]