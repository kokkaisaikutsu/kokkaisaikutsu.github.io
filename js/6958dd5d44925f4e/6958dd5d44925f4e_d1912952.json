[{"date": "2020-04-15", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/134", "sentence": ["…化をしているわけです。アベノミクスを支えるための日銀の金融緩和政策で金利がマイナスまで下がり、国債の運用や貸出しで十分な利益が確保できなかっ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/155", "sentence": ["…ることを目的としています。銀行の経営統合、合併について言えば、不当な金利引上げや、貸し渋り、貸し剥がし、手数料引上げで利用者に不利益をもたら…", "…銀行が一つしかない状況で、中小零細業者、地域住民は、銀行が決めた融資金利や各種金融サービスの手数料などを受け入れざるを得ない懸念が生まれます…", "…を見れば明らかです。またもや、地銀合併を進めても、資金需要の減少や低金利などといった構造的な課題は抜本的に解決せず、地域経済の問題を先送りし…", "…化した根本原因は、アベノミクスを支える日銀の金融緩和策によりマイナス金利となり、銀行の本業である貸出しなどで利益が確保できなくなったことにあ…"]}]}]}]