[{"date": "2021-06-02", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/204", "sentence": ["…関連施設として原子力関係施設を挙げています。答弁では、原子力発電所と核燃料サイクル施設を検討しているということですが、それでは、研究用の原子…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/206", "sentence": ["…、原子力関係施設については、電力供給への影響、原子力施設の災害防止、核燃料物質等の保護の観点から、必要な施設の周辺を区域指定することを検討と…", "…な施設の周辺を区域指定することを検討とあるんですけれども、研究炉や実験炉であっても、核燃料物質の保護の観点で考えたら、入るんじゃないですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/208", "sentence": ["…そもかかっているところもありますから、何で新たにこれなんだというところがよく分かりません。それと、核燃料の製造、加工事業所はどうでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/210", "sentence": ["○塩川委員核燃料又は核燃料廃棄物の貯蔵施設というのはどうなりますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/212", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/216", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/218", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/220", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/222", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/224", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/226", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/228", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/230", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02920210602/232", "sentence": []}]}]}]