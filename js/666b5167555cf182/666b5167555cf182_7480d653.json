[{"date": "2020-04-06", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会第四分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/74", "sentence": ["○武村主査代理これより国土交通省所管について審査を行います。まず、概要説明を聴取いたします。赤羽国土交通大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/76", "sentence": ["○武村主査代理次に、会計検査院の検査概要説明を聴取いたします。会計検査院宮川第三局長。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/78", "sentence": ["○武村主査代理ただいまの会計検査院の指摘に基づき講じた措置について説明を聴取いたします。赤羽国土交通大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/80", "sentence": ["…す。お手元に配付いたしております決算概要説明等のうち、ただいま説明を聴取した部分を除き、詳細な説明は、これを省略し、本日の会議録に掲載いたし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104131X00120200406/83", "sentence": []}]}]}]