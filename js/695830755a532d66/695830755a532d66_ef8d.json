[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/136", "sentence": ["…級河川の秋山川が台風十九号で決壊をいたしまして、市内の田島町は農道も水路も大幅に崩れ、田畑やイチゴ農家のハウスに大量の土砂が流れ込んだ被災地…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/138", "sentence": ["…が開始できる、このような状況ではございませんでした。さらに、水田の用水路と排水路のＵ字溝には土砂が覆いかぶさったままでございまして、中には、…", "…きる、このような状況ではございませんでした。さらに、水田の用水路と排水路のＵ字溝には土砂が覆いかぶさったままでございまして、中には、Ｕ字溝そ…", "…、このような状況でありました。春から初夏の田植に向けまして、一体いつ水路が使えるようになるのか、水が来なければ田植が始められないと、何も分か…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/153", "sentence": []}]}]}]