[{"date": "2020-05-14", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/102", "sentence": ["…なってまいりましたので一問飛ばさせていただいて、最後に、公共建築物の木造化率の向上についてお伺いをいたします。二〇一〇年に公共建築物等におけ…", "…る木材の利用の促進に関する法律が施行されまして十年がたちます。直近の木造率を見ますと、施行された年と比較して、低層の公共建築物などの木造率は…", "…近の木造率を見ますと、施行された年と比較して、低層の公共建築物などの木造率は僅かに上昇していますが、建物全体では若干下がっております。例えば…", "…格や工法などの兼ね合いもあると思いますけれども、今後更に公共建築物の木造化率を高めていくべきと考えますが、最後に大臣の見解をお伺いいたします…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/105", "sentence": []}]}]}]