[{"date": "2020-04-01", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/229", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/233", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/235", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/237", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/239", "sentence": ["…線グラフ、上の方を見ていただきたいと思います。（資料提示）患者の病院収容までの時間は年々延び続けております。最新のデータで、救急車の現場到着…", "…は四一・六％、長期入院が必要な重症の方は八・二％に上っています。病院収容時間の延びも、軽症の患者にとっては大きな不利益にはなりませんけれども…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/241", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/243", "sentence": []}]}]}, {"date": "2021-07-08", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X00120210708/85", "sentence": ["…十分掛かっております。往復で二十分掛かります。通報から患者を救急車に収容するまでは、ここまでで約二十七分掛かるんですね。急患の受入れが空港最…", "…港内の現場到着まで、より時間が掛かることになります。加えて、救急車の収容後、受入れ機関、医療機関が直ちに決まるということもなかなかないわけで…", "…ます。東京消防庁の救急車の出動実績に照らして、羽田空港への救急車出動から医療機関に収容するまでの平均所要時間をお示しいただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00120210708/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00120210708/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00120210708/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00120210708/93", "sentence": []}]}]}]