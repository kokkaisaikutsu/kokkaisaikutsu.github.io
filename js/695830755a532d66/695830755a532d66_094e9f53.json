[{"date": "2021-03-16", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/174", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/176", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/178", "sentence": ["…た。積極的な勧奨の中止からもう約八年になりますけれども、今回、接種対象者への情報提供に至った背景について三原副大臣にお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/180", "sentence": ["○塩田博昭君その背景には三原副大臣も相当頑張っていただいたんだと、このように思います。その中で、子宮頸がんについては、世界の女性にとって四番…", "…当時、適切な情報提供ができるまでの間は積極的な勧奨は控えるとしたわけですけれども、現在の検討状況も踏まえて、三原副大臣に伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/182", "sentence": ["…、効果について、効果についてですね、教えていただきたいということ、そして日本での公費助成の見通しについて三原副大臣にお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/184", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00320210316/186", "sentence": []}]}]}]