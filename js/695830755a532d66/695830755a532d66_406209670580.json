[{"date": "2020-05-14", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/90", "sentence": ["…の正組合員資格の拡大についてお伺いをしたいと思います。森林組合は森林所有者の組合でありますから、林業の場合、苗を植えてから木材として出荷でき…", "…たため、改正案では、正組合員として指定される人を推定相続人とし、森林所有者と同居していない子供らに正組合員になれる道を開き、人数制限も撤廃す…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/92", "sentence": ["…くお願いをいたします。そして、後継者をあらかじめ指定しておくことで、所有者不明の森林の発生を防ぐ効果があると思います。一方で、共有相続される…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/105", "sentence": []}]}]}]