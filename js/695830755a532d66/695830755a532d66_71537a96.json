[{"date": "2020-05-14", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/98", "sentence": ["…君次に、林業イノベーションの推進についてお伺いをいたします。林業には危険な作業が伴い、労働災害率が極めて高いこと、造林に人手や費用が掛かる上…", "…していくことが求められております。特に、木を切り倒す伐倒作業はとても危険で、林業における死亡災害の七割を占めております。近年は、高性能の林業…", "…、林業労働における死傷災害の発生件数は長期的には減少傾向にあります。危険な作業に自動化技術を導入することにより労働災害を更に減少させることが…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01220200514/105", "sentence": []}]}]}]