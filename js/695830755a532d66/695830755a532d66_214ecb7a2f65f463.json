[{"date": "2021-04-13", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X00820210413/188", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00820210413/190", "sentence": ["…お伺いしますけれども、常に今育児休業制度の充実が図られている中で、両立支援制度の改正に対応しなければならない事業主、また労務管理の行う従業員…", "…とは否めないというふうにも思うんですね。そういう中で、事業主として複雑化する両立支援制度に対する御所見をお伺いしたいと、このように思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00820210413/192", "sentence": ["…に思うんですね。そこでお伺いしたいんですけれども、有期雇用労働者が両立支援制度を利用するために特に重要だと考えている課題についてお聞かせいた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00820210413/194", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00820210413/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00820210413/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00820210413/200", "sentence": []}]}]}]