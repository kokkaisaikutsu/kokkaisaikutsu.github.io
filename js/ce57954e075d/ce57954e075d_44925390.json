[{"date": "2020-11-17", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/133", "sentence": ["…ます。続きまして、地域の公共交通の持続可能性及び九州地方の豪雨による鉄道の復旧支援についてお伺いいたします。新型コロナウイルスの影響によって…", "…の復旧支援についてお伺いいたします。新型コロナウイルスの影響によって鉄道各社も厳しい経営に追い込まれています。例えば、大手公共交通事業者の一…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/135", "sentence": ["…いう点を改めてチェックをいただきたいというふうに思っています。今回、鉄道各社が迎えている苦境が日ごろのいわゆる経営難というところからも更に度…", "…とも選択肢かもしれません。ただ、新型コロナで明らかに経営悪化している鉄道会社にこれまで以上の復旧費用負担を、現在、期待するというのは難しいと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/137", "sentence": ["○城井委員私が今質問で申し上げたところは、その改正後の鉄道軌道整備法を踏まえても対象に入らないのではないかというふうに現場からは伺ったもので…", "…ら、今の質問を申し上げたんですけれども。大臣、では、肥薩線や久大線についてはこの鉄道軌道整備法の補助の範囲に入るという認識でよろしいですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304319X00220201117/149", "sentence": []}]}]}]