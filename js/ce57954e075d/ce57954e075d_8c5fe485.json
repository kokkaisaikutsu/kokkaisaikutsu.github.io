[{"date": "2020-05-20", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/28", "sentence": ["○城井委員国民民主党の城井崇です。後藤参考人、堀内参考人、そして福井参考人、大変お忙しい中、当委員会にお越しいただきましてありがとうございま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/30", "sentence": ["○城井委員続いて、後藤参考人にお伺いいたします。きょうの意見陳述でも、これまでのＣＯＤＡにおけるさまざまな取組について御紹介をいただきました…", "…まして、この対策を更に強化する必要があるのではないかというふうに考えるわけですが、この点について後藤参考人の御意見をお聞かせいただけますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/32", "sentence": ["…が残ってしまうのではないかというふうに私自身も考えています。そこで、後藤参考人と福井参考人にそれぞれ同じ質問をしたいというふうに思いますけれ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/35", "sentence": ["○城井委員ありがとうございます。今の福井参考人のお話を受けて、後藤参考人に一つ確認をしたいんです。海外でも著作権を守っていく取組を国がやらな…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00820200520/138",