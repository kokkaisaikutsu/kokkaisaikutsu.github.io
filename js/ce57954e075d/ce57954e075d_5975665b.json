[{"date": "2020-03-24", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/19", "sentence": ["…こで御退席されて結構です。ありがとうございました。続きまして、日本人留学生への対応について、文部科学大臣にお伺いします。世界じゅうで入国制限…", "…お伺いします。世界じゅうで入国制限措置がとられる中、海外にいる日本人留学生が厳しい状況に追い込まれています。三月十六日に、外務省が多くの地域…", "…止を勧告いたしました。結果、日本学生支援機構の規定により、その地域に留学していた学生への奨学金が停止をし、自費による現地滞在若しくは自費によ…", "…上がっています。これに対し、文部科学省は、十九日にウエブサイトにて、留学の一時中断措置を認めることは発表しましたが、奨学金の継続は認めておら…", "…ていますが、滞在施設を国が用意し、移動方法も用意しています。日本人の留学奨励は、そもそも、トビタテ！ＪＡＰＡＮなど国策でやってきました。日本…", "…励は、そもそも、トビタテ！ＪＡＰＡＮなど国策でやってきました。日本人留学生の自己責任と放置せず、奨学金の継続若しくは二週間の滞在先を用意する…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00520200324/39", "sentence"