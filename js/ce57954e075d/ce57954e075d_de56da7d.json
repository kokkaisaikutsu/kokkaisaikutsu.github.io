[{"date": "2020-05-15", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/144", "sentence": ["…算などでＧＩＧＡスクール構想を進め、一人一台端末、学校への高速大容量回線の整備を全ての学校で全ての児童生徒対象に行えるだけの予算を準備したと…", "…り、端末の製造もおくれるという状況があるからであります。高速大容量の回線の整備も業者が限られているなどして、おくれているというふうにも聞きま…", "…者が限られているなどして、おくれているというふうにも聞きます。端末と回線がそろえば最低限のインフラが整います。調達の迅速化と調達価格の適正化…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/146", "sentence": ["…が重点的な支援が必要だという点があります。公立高校であります。端末や回線整備の追加的支援が足りないという声があります。ただ、高校生の場合には…", "…かというふうに思っています。こうしたことを踏まえまして、高校における回線整備の支援とＢＹＯＤ、端末貸与の併用を迅速に行うべきだと考えますが、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/160", "sentence": []}]}]}]