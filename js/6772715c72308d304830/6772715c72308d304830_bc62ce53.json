[{"date": "2021-03-30", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/9", "sentence": ["…が増加していると聞いております。覚醒剤など不正薬物に関する摘発実績や押収量などの状況について、全体との比率も含めて御説明願いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/11", "sentence": ["○牧山ひろえ君不正薬物の押収量の規模の大きさに改めて驚きます。押収された分でこれだけの規模になるということは、国内に持ち込まれている不正薬物…", "○牧山ひろえ君不正薬物の押収量の規模の大きさに改めて驚きます。押収された分でこれだけの規模になるということは、国内に持ち込まれている不正薬物…", "…では、エリアの対象も絞り込むことが可能で、流通の上流段階であるので、押収の規模も非常に大きい傾向があります。成田、羽田、関空、中部そして福岡…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00820210330/63", "sentence": []}]}]}]