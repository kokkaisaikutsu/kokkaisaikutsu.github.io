[{"date": "2020-11-19", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/25", "sentence": ["…ロッパの場合は九割以上回復しているということになります。このように、欧米は我が国を上回る回復ペースを示しています。日本の回復ペースが欧米に及…", "…のように、欧米は我が国を上回る回復ペースを示しています。日本の回復ペースが欧米に及ばない原因について、麻生大臣はどのようにお考えでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/37", "sentence": []}]}]}, {"date": "2020-11-24", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/71", "sentence": ["…を上回るように、極めて注意深い運用が必要だと考えております。日本は、欧米に比べ潜在成長率が低いにもかかわらず、長期にわたり資産買入れといった…", "…わたり資産買入れといった非伝統的な金融政策を継続してきたこともあり、欧米中銀と比べると日銀の資産規模は二から四倍程度になっています。金額にし…", "…思うんです。大規模な金融緩和は、リーマン・ショック以降、日銀に限らず欧米諸国でも採用されました。ですが、あくまでもそれは緊急的な措置であって…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/75", "se