[{"date": "2020-04-14", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/95", "sentence": ["…ういう状況の中で、新型コロナウイルス感染症の影響で、当てにしていたアルバイトができない状況になって、大変不安な思いをされている学生さんが多く…", "…の方だけではなくて、京都府でも調査をされておりまして、その中では、アルバイトが軒並み休みになって、病院代を自分で払わなくてはいけない、この状…", "…の皆様が調査をされました。ある浜松市の学生さんは、仕送りが五万円、アルバイト月七万円で生活をしていたそうです。しかし、先月は二万円にまで減っ…", "…うことで不安を語っておられました。このＦＲＥＥの皆さんの調査では、アルバイト収入の減少したのが三七・六％、収入が減ったことで学費確保できずと…", "…・三％でございます。今はもっと自粛要請が強まっておりますので、一層アルバイトで生活費を稼ぐということは大変になっているというふうに思います。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/174", "sentence": []}]}]}, {"date": "2020-05-21", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01720200521/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X0172020052