[{"date": "2020-05-26", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/136", "sentence": ["…める際に当たっても、そして、提供機関の事業計画とか運営、支援機関の諮問委員会、そして法の見直しの際にも、オペレーターの養成なども含めて、あら…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/142", "sentence": ["…提供機関に交付金を交付する業務を担うわけでございます。支援機関には諮問委員会を設置するということになっておりますけれども、その委員には聴覚障…", "…かわってくる、大事なことを話すところだというふうに思います。当然、諮問委員会にも当事者を入れるべきだと思いますけれども、大臣、御答弁いただき…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/144", "sentence": ["…者を積極的に関与させるという国の義務があるわけですから、ぜひ果たしていただきたいと思います。この諮問委員会、議事録は公開されますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/166", "sentence": []}]}]}]