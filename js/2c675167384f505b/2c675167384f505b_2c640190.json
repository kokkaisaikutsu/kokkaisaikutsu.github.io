[{"date": "2020-02-20", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/219", "sentence": ["…たけれども、肺炎の疑いがある方がおられ、そして、愛知県内の医療機関へ搬送されるというふうになっております。藤田医科大学の皆様方の決断というの…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/221", "sentence": ["…も、肺炎の症状があった方を岡崎市の消防本部の救急車で県外の医療機関へ搬送したということがございまして、その搬送の際に使用した二台の救急車は、…", "…本部の救急車で県外の医療機関へ搬送したということがございまして、その搬送の際に使用した二台の救急車は、感染拡大予防のために、新型コロナウイル…", "…材等ということで、感染予防キット、防護服等八百セット、出動二百回分。搬送の重複が予想されるため、県内消防、ＤＭＡＴの派遣一隊。消毒用アルコー…", "…医療機関の確保。陽性で無症状の乗客が、最初の受入れで早くも四名が救急搬送された。この状況が続くと岡崎市だけでは対応できない。愛知県、近隣県等…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/226", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/228", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/230", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/232", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/234", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/236", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/238", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/240", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/242", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/246", "sentence": []}]}]}]