[{"date": "2020-04-02", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/113", "sentence": ["…。ぜひとも観光業の損失に対する支援をするべきだというふうに思います。温泉関係の方からは、上下水道の料金の減免を求める声も出ております。災害の…", "…た。やはりこういう危機ですから、水道事業者が減免に踏み切れるように、温泉関係の方々を含め、事業継続できるように財政支援をするべきだというふう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/116", "sentence": ["○本村委員もう既に温泉の旅館などが潰れておりますので、ぜひこうした点も、早急な対応をとっていただいて、支援をしていただきたいというふうに思い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01220200402/125", "sentence": []}]}]}]