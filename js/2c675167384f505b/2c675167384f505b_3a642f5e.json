[{"date": "2020-04-14", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/101", "sentence": ["○本村委員これまでも、固定電話と携帯電話の比較で、音声の品質、遅延とか揺らぎとか、そういうものが問題になってきております。包括的な検証が行わ…", "…います。停電時の非常電源の基準ですとか、固定電話と比較した技術基準、携帯電話事業者が現状行っている以上の技術基準ということで今回はなってくる…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/103", "sentence": ["○本村委員今回の改定では、今の携帯電話の品質よりもいいようにしていこうということだというふうに思いますけれども、そうすると、別の規格になって…", "…すとか離島ですとか、そういったところは採算性の問題があるというふうに思うんですけれども、簡単に携帯電話事業者が請け負えるものなんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/105", "sentence": ["…ども、利用件数が少ないためにＮＴＴにとって高コスト地域とされている。携帯事業会社にとっても、安定性確保のために基地局を多くしたり、あるいは設…", "…提供の関与について撤退するということもあり得るというふうに思います。携帯事業者は、法律で規制されているわけでもございません。ユニバーサルサー…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01420200414/174", "sentence": []}]}]}]