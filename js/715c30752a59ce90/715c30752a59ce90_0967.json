[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/37", "sentence": ["…処しなきゃいけない問題なんですが、政府が全くこれまで、国民病と言われて有病率も半分ぐらいあるんじゃないかというこの花粉症、何をやってきたのか…", "…もう御案内だと思いますが、日本のアレルギー学会の二〇〇八年の杉花粉症の有病率は二八％ということなんですけれども、随分古い資料でありまして、ま…", "…せん。ただ、東京都は独自で調査をしておりまして、二〇一七年の杉花粉症の有病者は四八・八％。半分の東京都民は花粉症にかかっているんではないかと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/49", "sentence": []}]}]}]