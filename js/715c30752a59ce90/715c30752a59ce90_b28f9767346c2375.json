[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/37", "sentence": ["…ているわけであります。私も、二〇一三年、前回バッジを着けたときに、農林水産委員会なんかでも積極的に花粉症の問題はしつこく取り上げてきたんであ…", "…無花粉杉、これの苗が随分増えてきたと。低花粉杉を含めて、当初私が林農林水産大臣に指摘したときには一〇％ぐらい、植え替えの一〇％ぐらいがそうい…", "…今は五割に達してきた、達成してきたということで、発生源に関しては、農林水産省さん以下頑張っていただいたということであります。まさに、私も今回…", "…たなというふうに思うんですが、ただ残念なのは、この花粉対策、じゃ、農林水産省さん以外でどんな取組をしているかというと、随分厳しい状態だなとい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/49", "sentence": []}]}]}]