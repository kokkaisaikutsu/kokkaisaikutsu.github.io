[{"date": "2021-04-20", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/10", "sentence": ["…思いますので、これからも注視していきたいと考えております。次に、環境教育についてお話を伺いたいと思いますが、二〇五〇年カーボンニュートラルの…", "…実現しないということでございますが、未来を担う子供、若者世代への環境教育が大変に重要であると考えています。私は、実は、当選当時、文部科学省に…", "…私としては、例えば、一学期に一こま取って環境、それを年間三こま、環境教育に特化した時間割り、カリキュラムとして導入してもらいたいと考えていま…", "…ます。環境省でも副読本作成のための資料を作っていて、それを参考にして教育委員会が地域の市町村に合った副読本を作っておられます。一部の市のを見…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/20", "sentence": []}]}]}]