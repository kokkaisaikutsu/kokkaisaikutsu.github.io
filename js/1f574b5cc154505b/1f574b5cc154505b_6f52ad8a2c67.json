[{"date": "2021-04-20", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/10", "sentence": ["…割り、カリキュラムとして導入してもらいたいと考えています。環境省でも副読本作成のための資料を作っていて、それを参考にして教育委員会が地域の市…", "…の資料を作っていて、それを参考にして教育委員会が地域の市町村に合った副読本を作っておられます。一部の市のを見せていただきました。全国統一では…", "…っているよとか、本当に、まさに住んでいる地域のことを学びながらの環境副読本になっているのはすばらしいと思います。ただ、私が調べている限りでは…", "…私が調べている限りでは、残念ながらほんの一部の市町村しかまだそういう副読本を作っておられないので、これが普及することが大事かなと思っています…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00620210420/20", "sentence": []}]}]}]