[{"date": "2020-06-02", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/14", "sentence": ["…それから、水圧という恐ろしい敵もあります。同時に、特に日本においては漁家の方々が非常に優れた仕事をなさっていて、日本の広い海の隅々に至るまで…", "…の方々が非常に優れた仕事をなさっていて、日本の広い海の隅々に至るまで漁家の方々がきちんと漁場を築いていらっしゃいます。メタンハイドレートの開…", "…つですけれども、入っているわけですね。それを考えますと、逆に言うと、漁家の方々と話していますと、やっぱり漁業補償という考え方は必要だとおっし…", "…はあり得ますから。メタンプルームであっても、船がたくさん出たりすれば漁家の方々の動きを制限しますから。ところが、このプルームを見付ける機械、…", "…段もやや高くて、研究用という意味です。しかし、普通の漁船でも、日本の漁家のレベル高いですから、大体魚探、魚群探知機、しかも精度のかなり高いも…", "…で、何と、僕らが最初に実際に海で研究を始めたときに驚いたのは、日本の漁家の方々ってデータを持っていらっしゃるんですよね。つまり、これはメタン…", "…きましたけれども、やっぱり限られますよね。これ、隅々までいらっしゃる漁家の方々に協力を得て、そしてデータをいただき連携を進めれば、かつてない…", "…の方々に協力を得て、そしてデータをいただき連携を進めれば、かつてない漁家と政府あるいは研究者の連携ができます。したがって、当然データに十分な…", "…ータに十分な対価を払っていただくことも含めて、まさしく政治の出番だと思うんですけれども、漁家の方々との連携について牧原副大臣にお尋ねします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X01120200602/25", "sentence": []}]}]}, {"date": "2020-11-24", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314080X00220201124/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314080X00220201124/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314080X00220201124/22", "sentence": []}, {"url": "ht