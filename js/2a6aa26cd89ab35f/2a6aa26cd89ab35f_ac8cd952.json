[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/53", "sentence": ["…沢高徳君分かりました。是非前向きに御検討いただければと思います。次、責務規定についてお伺いをしたいと思います。本法律案第三条では、国の責務と…", "…、責務規定についてお伺いをしたいと思います。本法律案第三条では、国の責務として、教育活動、広報活動等を通じて、聴覚障害者等による電話の利用の…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/55", "sentence": ["○横沢高徳君また、電話リレーサービス提供機関については責務規定が置かれておりませんが、電話リレーサービス提供主体として、広報活動についての責…", "…務規定が置かれておりませんが、電話リレーサービス提供主体として、広報活動についての責務は基本方針に書かれるということでよろしいんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/67", "sentence": ["…こととなる事業者、例えば金融機関やカード会社、保険会社などに対しても責務規定を追加するべきではないかという意見もありました。本法律案第六条で…", "…加するべきではないかという意見もありました。本法律案第六条では国民の責務が規定されておりますが、こうした事業者に対する責務は国民の責務の内容…", "…律案第六条では国民の責務が規定されておりますが、こうした事業者に対する責務は国民の責務の内容に含まれているという理解でよろしいのでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/75", "sentence": []}]}]}]