[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/47", "sentence": ["…知するサービスとは言えない状況でございます。資料にもありますが、オペレーターと相手との間のやり取りで待たされたが約四割、相手に通話を切られた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01720200604/57", "sentence": ["○横沢高徳君ありがとうございます。それでは次に、通訳オペレーターについてお伺いをしたいと思います。電話リレーサービスにおいて聴覚障害者等の命…", "…電話リレーサービスにおいて聴覚障害者等の命や人権を守る業務を担うオペレーターの役割は非常に重要だと考えます。また、オペレーターの質も重要だと…", "…守る業務を担うオペレーターの役割は非常に重要だと考えます。また、オペレーターの質も重要だと思います。本法律案は、オペレーターの要件や養成等に…", "…考えます。また、オペレーターの質も重要だと思います。本法律案は、オペレーターの要件や養成等に関する規定は明記されておりません。衆議院の審議で…", "…件や養成等に関する規定は明記されておりません。衆議院の審議では、オペレーターの要件や養成等について総務大臣が定める基本方針において定められる…