[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/47", "sentence": ["○横沢高徳君続きまして、長期休校中にオンライン学習を実施する必要性についてお伺いをいたします。今回の長期休校中には家庭学習用の教材で対応する…", "…生を対象とした授業の動画視聴や教科書が閲覧できるサイトの開設など、オンラインでの学習に向けた取組が進められております。我が国でも、文科省は子…", "…産省は学びを止めない未来への教室を開設したり、また民間業者が無料でオンライン教材を提供したり、特にＬＩＮＥの休校学習サポートは登録者十二万人…", "…万人を超えたとのことですが、これらの動きがありますが、休校期間中のオンライン上の学びの必要性はあると考えます。なお、十代はＳＮＳの利用期間が…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/49", "sentence": ["…考えます。このような長期休校になる場合も想定されますので、是非このオンライン学習に関して、民間事業者とともに前へ体制整備を進めていただきたい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00220200310/67", "sentence": []}]}]}]