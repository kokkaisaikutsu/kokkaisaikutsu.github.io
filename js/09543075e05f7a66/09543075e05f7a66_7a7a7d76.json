[{"date": "2021-04-26", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/54", "sentence": ["○吉田忠智君ちょっと通告の順番を変えまして、過疎地での交通空白地解消に向けた取組に関して質問をいたします。本来ならばバスやタクシーが輸送すべ…", "…運営しているところもまだありますけれども、いずれにしても、全国で交通空白地帯と言われるところが三割にも達しているということは御案内のとおりで…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/56", "sentence": ["…て、先般、過疎法が新たに延長して成立しましたけれども、過疎地域の交通空白地を、いかに確保していくのか、そしてまた、自治体の財政負担をしっかり…", "…ていく必要があると思いますが、今後のこの制度を活用した移動手段の確保、交通空白地帯の解消に向けての国土交通大臣のお考えを伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00520210426/67", "sentence": []}]}]}]