[{"date": "2020-03-26", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/18", "sentence": ["○吉田忠智君立憲・国民．新緑風会・社民の吉田忠智でございます。市町村合併特例法の改正案について質問をさせていただきます。先ほど質問をされまし…", "…いまして、そのピークの前後の十年間、五年ずつを大分県議会の場でこの市町村合併を見させていただきました。そして、大分県におきましては、全部で、…", "…八、そして減少率でいいますと全国で五番目の減少率ということで、大変市町村合併が進みました。当時、今は亡くなられましたけれども、平松守彦さんが…", "…成をさせていただきました。今日出席の皆さんは、それぞれの立場でこの市町村合併の状況を見られていろんな思いがあると思いますが、私のそうした経歴…", "…りすることをお許しをいただきたいと思います。いずれにしても、今後の市町村合併、この受皿を用意をするという意味では大事なことでありますから、今…", "…」を公表されました。当時は平成の合併推進から十年が経過をしまして、市町村合併がある程度進捗した状況での総括でございました。その中では、合併に…", "…の法改正に向けて、第三十二次地方制度調査会が昨年十月三十日に出した市町村合併についての今後の対応方策に関する答申では、幾つかの課題が指摘をさ…", "…と、多くの団体において、専門職員の配置、組織の充実、行財政効率等、市町村合併の成果が既に現れつつあるということが述べられておりますので、そう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/48", "sentence": []}, {"url