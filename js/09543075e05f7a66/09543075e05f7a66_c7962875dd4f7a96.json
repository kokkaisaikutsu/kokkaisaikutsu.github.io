[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/174", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/176", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/178", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/180", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/182", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/184", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/186", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/188", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/190", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/194", "sentence": ["…に伺います。政府の対応策第二弾では、活動の自粛を要請している地域の雇用保険被保険者は、非正規を含めた雇用者に雇用調整助成金の支給を行うとされ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/196", "sentence": ["…枚だけ配りました。資料一。厚生労働省は、平成二十八年八月二十三日に雇用保険課長名で、競走事業従事者の雇用保険の適用についてという文書を各都道…", "…省は、平成二十八年八月二十三日に雇用保険課長名で、競走事業従事者の雇用保険の適用についてという文書を各都道府県労働局職業安定部長宛てに発出を…", "…れました。そこに、もう時間が掛かりますので読みませんけれども、この雇用保険の一般被保険者として取り扱うということであれば、この雇用調整助成金…", "…資料一の右側の①、事務処理について、従事員を雇用する個々の施行者が雇用保険の事務を行うこととせず引き続き一本化するが、掛け持ち就業先の施行者…", "…による場外車券発売業務を通算対象とすると。③として、平成七年以降の雇用保険法改正、賃金額や月の就労日数を要件としない、を踏まえて、一般被保険…", "…ことが書かれています。そして、その記の下に、基本的な考え方として、雇用保険は週の所定労働時間が二十時間以上かつ三十一日以上の雇用見込みがある…", "…時間以上かつ三十一日以上の雇用見込みがあるなどの要件を満たす場合に雇用保険の適用となり、この要件については形式的な雇用契約のみで判断するので…", "…とに異なる特殊な雇用関係にあるということを書かれています。そこで、雇用保険の一般被保険者として取り扱うということであれば、雇用調整助成金の対…", "…併せて聞きます、もう。場外車券発売に従事する分も含めて管理施行者を雇用保険上の事業主として取り扱うこととするという先ほどの文書のとおり理解を…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/204", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/206", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/208", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/210", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/212", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/217", "sentence": []}]}]}]