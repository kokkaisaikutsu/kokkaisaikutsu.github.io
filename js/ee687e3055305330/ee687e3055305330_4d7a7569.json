[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/67", "sentence": ["○国務大臣（森まさこ君）悔悟の情や改善更生の意欲のある者を積極的に仮釈放につなげて、保護観察による指導監督、補導援護を行っていくことが再犯防…", "…くことが再犯防止に効果的であるのは委員の御指摘のとおりです。仮釈放の積極的な運用のために受刑者の出所後の適切な帰住先や必要な支援を早期に確保…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/82", "sentence": ["…解しつつ自らの職責を果たすこと、被疑者、被告人等の主張に耳を傾けて、積極、消極を問わず十分な証拠の収集、把握に努め、冷静かつ多角的にその評価…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/116", "sentence": ["…が国の司法制度に対する正しい理解を得るために、外務省と連携しながら、積極的な国際発信や各国の司法関係閣僚との対話などを積極的に行ってまいりた…", "…に対する正しい理解を得るために、外務省と連携しながら、積極的な国際発信や各国の司法関係閣僚との対話などを積極的に行ってまいりたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00420200402/122", "sentence": []}]}]}]