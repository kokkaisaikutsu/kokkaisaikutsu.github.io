[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第六分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/38", "sentence": ["…臣子供の育ちの中で、静かな環境というのは私も大切だと思います。特に、飛行機に限らず、私も今でも家に帰ってチャイムを押すこともやめていますし、…", "…す。環境省は、平成十八年の東京国際空港の環境影響評価において、今後、飛行経路等の変更があった場合に、騒音を予測し、それに基づき所要の措置を講…", "…るよう国交大臣に意見を提出しています。そして、現在、国交省では、実機飛行確認で測定した騒音について、予測の検証を含め分析していると聞いていま…", "…行い、必要に応じ障害防止工事等を行うと認識しています。国交省には、新飛行ルートに伴う騒音測定を踏まえ、引き続き適切な対策の実施に努めていただ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X001