[{"date": "2021-12-13", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/125", "sentence": ["…た中、補正予算案には、公明党が衆議院選挙で公約に掲げました新たなマイナポイント制度が盛り込まれ、マイナンバーカードの一層の普及促進や消費喚起…", "…ントが付与されます。また、既にカードを取得している方でも、現行のマイナポイントに申請していなければ、同様に最大五千円相当のポイントが付与され…", "…付与される仕組みになっているわけでございます。改めて、この新たなマイナポイント制度の目的を始め、実施スケジュールや手続方法につきまして、そし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/127", "sentence": ["○竹内委員ありがとうございました。現在のマイナポイントでは、実は、スマホやパソコンを持たない方などでも制度を活用できるように、コンビニのＡＴ…", "…用できるように、コンビニのＡＴＭとかマルチコピー機などを活用したマイナポイント手続スポットが全国約九万か所に設置されてあるんですね。しかし、…", "…できるユニバーサルデザイン機器の開発支援も推進して、多くの方々がマイナポイントを利用できる環境を整備すべきであると思いますが、いかがでしょう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/136", "sentence": []}]}]}]