[{"date": "2020-04-10", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/4", "sentence": ["…んですけれども、その前に、やはり新型コロナウイルス対策に関しまして、外務省に関連する質問を少しさせていただきたいというふうに思っております。…", "…動をされているようですけれども、これらの点につきまして、感染の状況と感染対策の特徴などにつきまして、外務省から報告をお願いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/10", "sentence": ["…そのほかにも、抗体検査の問題とかいろいろあろうかと思いますけれども、外務省関係にきょうは絞っておりますので、個別の国の話はこの辺にさせていた…", "…ただきたいと思います。全体として、この緊急事態宣言の状況下で、やはり外務省として果たすべき役割は何かということを、緊急経済対策の内容も含めて…", "…求をしてきたわけでございます。この辺につきましてトータルに、大臣の方から、ぜひ外務省としての果たすべき役割についてお話を願いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00520200410/24", "sentence": []}]}, {"meeting_name": "衆議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/35", "sentence": []}]}]}]