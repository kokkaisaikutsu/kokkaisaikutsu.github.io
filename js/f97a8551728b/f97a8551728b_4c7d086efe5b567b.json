[{"date": "2021-12-13", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/107", "sentence": ["…ねをいたします。パネルを御覧ください。まず、これまでの三度にわたる経済対策は、感染抑制と経済の両面に対してどのような効果があったのか。その上…", "…制と経済の両面に対してどのような効果があったのか。その上で、今回の経済対策は、対策国費が四十三・七兆円と、コロナ禍の対策としては最大規模とな…", "…し、国民生活を守り、日本経済を再生することができるのか。いま一度、本経済対策の趣旨や狙い、規模の妥当性について総理にお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/109", "sentence": ["○竹内委員そこで、本経済対策の経済効果につきまして、政府はＧＤＰの五・六％程度を下支え、押し上げると試算されていますが、民間のエコノミストは…", "…そ一から三％程度と試算しております。この乖離について説明をお願いします。また、経済対策による波及効果についても説明をお願いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/136", "sentence": []}]}]}]