[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第四分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/304", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/306", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/308", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/310", "sentence": ["…ながら申し上げているんですけれども。やはり、日本で、聞く、書く、話す能力を上達させるのはなかなか容易ではない。これらの中でも、しかし、その中…", "…ね。主張が明確になれば、それに必要な情報を収集するために、当然、聞く能力も高まってくるというのを私なりに感じた次第です。そして、当然、もっと…", "…以上は、ネーティブじゃありませんので。ただし、英語を聞く、書く、話す能力を習得するには、やはり、大半の高校生が日本で育っていますから、ハンデ…", "…じがしました。私の感じでは、感覚ですけれども、書く、聞く、話すなどの能力評価は、やはり個別の大学入試試験に委ねた方がいいのではないかと思って…", "…これはしっかり問えることはできると思います。そういう意味で、より高い能力を持つ、書く、聞く、話す能力のある高校生は、それにふさわしい大学を当…", "…きると思います。そういう意味で、より高い能力を持つ、書く、聞く、話す能力のある高校生は、それにふさわしい大学を当然受験されるでしょうから、そ…", "…ふうに思っております。その意味で、各大学の個別試験こそ、求める人材の能力を評価できる良問をつくるように努力すべきであって、何でもかんでも国に…", "…でも国にお任せで、各大学が楽をして、国に全部お任せする、いろんな高い能力を国が評価しないといけないとか、それはちょっとおかしいんじゃないか。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/312", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/314", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/316", "sentence": []}]}]}, {"date": "2020-11-02", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305261X00220201102/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00220201102/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00220201102/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00220201102/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00220201102/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00220201102/138", "sentence": ["…という声がありますけれども、この点はいかがでしょうか。建設業界の施工能力に全く懸念がないということを私は思いますけれども、この点を、国土交通…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00220201102/140", "sentence":