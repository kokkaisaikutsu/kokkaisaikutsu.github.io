[{"date": "2021-11-12", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/5", "sentence": ["…室会議予備議員に衛藤征士郎君及び菅直人君を指名いたします。なお、その職務を行う順序は、ただいま指名した順序によることといたします。次に、皇室…", "…済会議予備議員に衛藤征士郎君及び菅直人君を指名いたします。なお、その職務を行う順序は、ただいま指名した順序によることといたします。次に、裁判…", "…田美樹君大河原まさこ君及び吉田豊史君を指名いたします。なお、予備員の職務を行う順序は、ただいま指名した順序によることといたします。次に、裁判…", "…俊郎君吉川元君中西健治君及び中司宏君を指名いたします。なお、予備員の職務を行う順序は、ただいま指名した順序によることといたします。――――◇…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/10", "sentence": []}]}]}]