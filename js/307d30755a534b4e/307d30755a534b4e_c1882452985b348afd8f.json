[{"date": "2021-11-12", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/1", "sentence": ["…――――◇―――――皇室会議予備議員の選挙皇室経済会議予備議員の選挙裁判官弾劾裁判所裁判員及び同予備員の選挙裁判官訴追委員及び同予備員の選挙"]}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/2", "sentence": ["…議長（細田博之君）皇室会議予備議員、皇室経済会議予備議員、裁判官弾劾裁判所裁判員及び同予備員及び裁判官訴追委員及び同予備員の選挙を行います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/5", "sentence": ["…務を行う順序は、ただいま指名した順序によることといたします。次に、裁判官訴追委員に新藤義孝君柴山昌彦君奥野信亮君鈴木淳司君越智隆雄君盛山正仁…", "…藤昭一君中川正春君美延映夫君及び大口善徳君を指名いたします。また、裁判官訴追委員の予備員に門山宏哲君井野俊郎君吉川元君中西健治君及び中司宏君…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120605254X00320211112/10", "sentence": []}]}]}]