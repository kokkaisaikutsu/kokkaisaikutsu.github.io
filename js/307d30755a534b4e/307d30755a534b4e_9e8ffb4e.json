[{"date": "2020-10-26", "meeting": [{"meeting_name": "衆議院 憲法審査会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304183X00120201026/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304183X00120201026/7", "sentence": ["○細田会長幹事の辞任についてお諮りいたします。幹事柴山昌彦君及び山下貴司君から、幹事辞任の申出があります。これを許可するに御異議ありませんか…", "…辞任についてお諮りいたします。幹事柴山昌彦君及び山下貴司君から、幹事辞任の申出があります。これを許可するに御異議ありませんか。〔「異議なし」…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304183X00120201026/8", "sentence": ["…た。引き続き、幹事の補欠選任についてお諮りいたします。ただいまの幹事辞任に伴い、現在幹事が二名欠員となっております。その補欠選任につきまして…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304183X00120201026/9", "sentence": []}]}]}, {"date": "2021-12-06", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/4", "sentence": ["○議長（細田博之君）起立多数。よって、会期は十六日間とすることに決まりました。――――◇―――――懲罰委員長辞任の件"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/5", "sentence": ["…長（細田博之君）お諮りいたします。懲罰委員長山井和則君から、委員長を辞任いたしたいとの申出があります。これを許可するに御異議ありませんか。〔…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/10", "sentence": ["…ます。よって、動議のとおり決まりました。議長は、懲罰委員長に安住淳君を指名いたします。〔拍手〕――――◇―――――情報監視審査会委員辞任の件"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/11", "sentence": ["…、柴山昌彦君、盛山正仁君、大島敦君及び新垣邦男君から、それぞれ委員を辞任いたしたいとの申出があります。これを許可するに御異議ありませんか。〔…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705254X00120211206/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/1