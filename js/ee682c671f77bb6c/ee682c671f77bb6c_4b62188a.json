[{"date": "2020-03-19", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/130", "sentence": ["…係る財務省の決裁文書改ざん問題。命を落とされた近畿財務局の職員の方の手記が昨日公開をされました。私も読ませていただきました。本当に、良心の呵…", "…に、良心の呵責に耐えかねて命を絶たれた、その苦しみの中で記されたこの手記でございましたけれども、本当に胸の詰まる思いで言葉が見付からない状況…", "…されたこの手記でございましたけれども、本当に胸の詰まる思いで言葉が見付からない状況でございます。総理、この手記はお読みになられたでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/132", "sentence": ["…生大臣の下で事実を徹底的に明らかにしたというふうに答えられていらっしゃいます。手記も読まれて、そのお考えにお変わりはございませんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/134", "sentence": ["○森本真治君今回、お亡くなりになられた職員の方の御遺族の方がこの手記を公開されて、そしてコメントも発表されて、真実を明らかにしてもらいたいん…", "…表されて、真実を明らかにしてもらいたいんだと、そういうことで今回この手記も公開をされているということですね。総理は、これまでの調査の中で真実…", "…れども、私も改めてこの財務省の報告書読ませていただきました。例えば、手記の中に出てくる内容の部分で、例えば当時の佐川局長の指示の下でこの改ざ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00620200319/138", "sentence": []}]}]}]