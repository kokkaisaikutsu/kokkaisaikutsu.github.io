[{"date": "2020-03-11", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X00720200311/5", "sentence": ["…源となっているのでしょうか。総務大臣の明確な答弁を求めます。最後に、核兵器のない世界の実現に向けて、被爆体験の継承についてお伺いします。本年…", "…ている今、被爆の実相を伝える被爆建物は残さなければなりません。それが核兵器廃絶にもつながります。現在、広島市内最大級の被爆建物である旧陸軍被…"]}]}]}, {"date": "2021-12-20", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/32", "sentence": ["…いただきたいというふうに思います。それでは、通告に従いまして、まずは核兵器のない世界の実現に向けて、総理、二〇一六年、あれからもう五年がたっ…", "…となられました。改めて、この広島の思い、被爆者の思い、しっかりとこの核兵器のない世界の実現に向けて、これから総理としてしっかり取り組んでいた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/36", "sentence": ["…たような気がしたんですけれども、新たにやっぱり岸田政権になって、この核兵器のない世界の実現に向けて更なる取組というものを是非考えていただきた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/46", "sentence": ["…できるように是非とも調整もしていただきたいと思います。総理はこれまで核兵器のこの問題への取組として、まず日米の信頼関係を優先すると述べられて…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/48", "sentence": ["○森本真治君今の総理のお話ですと、バイデン大統領も核兵器のない世界に向けての思いがこれは共通して持たれているというような趣旨の答弁をされたと…", "…、オバマ大統領の核軍縮路線から、この間アメリカはトランプ大統領時代に核兵器の実用化と流れが逆流していきましたが、再び、先ほどの話でもありまし…"]}, {"url": "https://