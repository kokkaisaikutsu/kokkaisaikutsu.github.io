[{"date": "2021-04-06", "meeting": [{"meeting_name": "衆議院 安全保障委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/76", "sentence": ["…テレビでも、我々のこの委員会でも、もう本当に、二月一日に施行された海警法の問題が緊張を高めていて、不測の事態が起きるリスクも増しているんじゃ…", "…、ちょっと法的にお伺いしたいので御質問させていただくんですが、中国海警法が国際法に違反しているというふうに主張があります。これは、まず政府も…", "…法も含めて、国際法の法源というのはいっぱいあるんですよ。その中で、海警法のどの規定が国際法に明確に違反をしていると考えているのか、教えていた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/78", "sentence": ["○篠原（豪）委員そうすると、この中国海警法は国際法に違反をするおそれのある部分が含まれているという話ですか。それとも、もう既に違反していると…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120403815X00220210406/90", "sentence": []}]}]}]