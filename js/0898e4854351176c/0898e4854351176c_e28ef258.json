[{"date": "2020-05-19", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/29", "sentence": ["…イデアを出して、無駄にならないようにしていただきたいです。次に、高額転売についてですが、先月から、あっ、先月じゃないです、政府は、三月からの…", "…、政府は、三月からのこのマスクに続き、消毒液や除菌シートなどの、高額転売禁止の対象とする方針を固めたと聞いております。今ネットオークションで…", "…ます。問題に上がってから一つずつ閣議決定をするのではなく、今後、高額転売が予想される新型コロナウイルス対策に関連する衛生用品全般に転売禁止の…", "…するのではなく、今後、高額転売が予想される新型コロナウイルス対策に関連する衛生用品全般に転売禁止の規制を掛けるようにできないものでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/45", "sentence": []}]}]}]