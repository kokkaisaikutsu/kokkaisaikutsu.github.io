[{"date": "2020-05-21", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/15", "sentence": ["…分するという取組があると伺っています。このような取組に対して、国、自治体の方でどのような枠組みが現在あるのか、現状の説明をお願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/21", "sentence": ["…し、その取組を継続的に共有、更新するＧ20海洋プラスチックごみ対策実施枠組が採択されました。その後、国際的な取組の進捗状況をお聞かせください…", "…せください。そして、我が国がリーダーシップを発揮し、このビジョンと実施枠組を世界中に広げ、全ての国が参加するグローバルな枠組みを構築していく…", "…、このビジョンと実施枠組を世界中に広げ、全ての国が参加するグローバルな枠組みを構築していくべきではないでしょうか。お考えをお伺いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/23", "sentence": ["…のをつくっていただければと思います。この全ての国が参加するグローバルな枠組みの構築と併せて、海洋プラスチック問題の解決に向けた足下からの取組…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/31", "sentence": []}]}]}]