[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/47", "sentence": ["…してのバランスシートに踏まえつつ、過度なインフレにならない限り政府の借金に問題はなく、政府の赤字は民間の黒字であるというこのＭＭＴの主張は基…", "…このＭＭＴの主張は基本的に正しいと思っております。この自国通貨建てで借金をしている国が財政破綻することはないというのは経済学的にごく当たり前…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/51", "sentence": ["…ネット保証等を実施しております。しかし、融資という言葉は言い換えると借金ということになり、幾ら借りたらいいのか、果たして返済することができる…", "…も収束は近いと流れたり、年明けまで続くと言ってみたり、先の見えない、借金をするぐらいならもう閉店がらがらと決断する人も少なくないと思います。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00320200318/62", "sentence": []}]}]}]