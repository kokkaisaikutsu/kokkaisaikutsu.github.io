[{"date": "2020-05-21", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/23", "sentence": ["…ついて国際的に確立された推計はないそうですが、一部の推計ではアジアや途上国からの流出が多いと聞いています。実際にプラスチックごみの流出が大変…", "…が多いと聞いています。実際にプラスチックごみの流出が大変多いとされる途上国に対して、我が国のプラスチックの３Ｒや廃棄物の適正処理の経験や技術…", "…に基づき対策を計画するというところも大変必要な国もあるかもしれません。環境省として途上国の海洋ごみ対策をどう後押ししていく方針か、伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/31", "sentence": []}]}]}]