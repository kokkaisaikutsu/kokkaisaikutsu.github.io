[{"date": "2020-05-19", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/31", "sentence": ["…このコロナ禍を何とか乗り切った中小零細企業、特に飲食店は、また休業を要請されると再び窮地に立たされる状況が目に浮かびます。格闘技で言うところ…", "…スの第二波、第三波が来ることを想定しまして、今回の対応を踏まえ、休業要請と補償の枠組みの検討も考えていくことも必要ではないかと思いますが、い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/45", "sentence": []}]}]}, {"date": "2021-06-08", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415007X01620210608/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X01620210608/100", "sentence": ["…飲食店を含む事業者に対する支援策についてお伺いします。時短営業や休業要請に応じた事業者に対する協力金について、事業規模に応じた支給の見直しが…", "…した申請手続が六月三十日から開始されるという情報もあり、このままでは要請に協力してきた飲食店が協力金の支給が間に合わないことで廃業するという…", "…か、お伺いします。また、政府から、東京都を始めとした各自治体に対して協力金の迅速な支給を要請していただきたいと思いますが、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X01620210608/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X01620210608/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X01620210608/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X01620210608/108"