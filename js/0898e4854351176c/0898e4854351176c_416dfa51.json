[{"date": "2020-05-21", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/11", "sentence": ["…なり膨大なものとなっております。その一部とはいえ、プラスチックが海に流出しているという現状を変えるためには何が必要なんでしょうか。私は、私た…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/17", "sentence": ["…にごみが残っているというのが現実です。この海ごみ問題の解決に向けて、流出を減らすことが何よりの解決策ですが、海のごみを集めて処理することも大…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/19", "sentence": ["…ラスチック問題の解決に向けて、理想的には、プラスチックごみの海洋への流出をゼロにすることが理想的ですが、現実問題として海洋への流出を完全にゼ…", "…の海洋への流出をゼロにすることが理想的ですが、現実問題として海洋への流出を完全にゼロにすることは難しいことを理解しております。また、マイクロ…", "…についてはごみとして回収されることなく海に出ていっています。そこで、流出を減らすことと併せて、海に出ても汚染につながらない海洋生分解性プラス…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/23", "sentence": ["…た足下からの取組も進めていかなければいけません。海へのプラスチックの流出について国際的に確立された推計はないそうですが、一部の推計ではアジア…", "…に確立された推計はないそうですが、一部の推計ではアジアや途上国からの流出が多いと聞いています。実際にプラスチックごみの流出が大変多いとされる…", "…ジアや途上国からの流出が多いと聞いています。実際にプラスチックごみの流出が大変多いとされる途上国に対して、我が国のプラスチックの３Ｒや廃棄物…", "…、我が国のプラスチックの３Ｒや廃棄物の適正処理の経験や技術を展開し、流出削減の具体的な成果を上げてもらうべきではないでしょうか。そのことが日…", "…ことにもつながると考えます。もちろん、まずは海へのプラスチックごみの流出実態を調べて、データを確認し、データに基づき対策を計画するというとこ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/31", "sentence": []}]}]}, {"date": "2020-11-26", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/102", "sentence": ["…ところが正直あります。本改正案の目的について、農水省は主に種子の海外流出を防ぐためと説明されています。この海外流出といえば、何か中国で日本の…", "…て、農水省は主に種子の海外流出を防ぐためと説明されています。この海外流出といえば、何か中国で日本のアニメのアミューズメントパークができたみた…", "…パークができたみたいなニュース見たことはありますが、実は私自身も海外流出というものを経験したことがあります。中国の広東省発の生活雑貨店、メイ…", "…ですから、今回のこの種苗法改正案である、この大義名分である種子の海外流出を防ぐためという気持ちは十分に分かりますし、本当に大賛成であります。…", "…気持ちは十分に分かりますし、本当に大賛成であります。しかし、もし海外流出を本当に防ぎたいのであれば、海外で品種登録するしかないと、農水省は過…", "…ないなと思うわけです。そこで、質問なんですが、この種苗法改正案で海外流出は避けられないと私は思うんですけれども、その辺どうお考えでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/194", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/207", "sentence": []}]}]}, {"date": "2021-03-16", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/222", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/224", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/226", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00220210316/228", "sentence"