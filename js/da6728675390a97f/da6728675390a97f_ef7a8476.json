[{"date": "2020-04-06", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会第三分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/183", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/185", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/187", "sentence": ["○柚木分科員いや、ちょっと端的にお答えいただきたいんですが、この後もお聞きする専門家会議のいわゆる三段階の地域区分、まさに今お答えになられた…", "…れば、今は始業式、入学式、再開となったところが再休校になるところも出てくる、そういう理解でいいかどうか、ちょっと端的にお答えいただけますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/190", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/192", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/195", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/208", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104130X00120200406/211", "sentence": []}]}]}, {"date": "2020-10-07", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/94", "sentence": ["…長官のかわりにお越しいただいていると聞いていますから、聞かれたことを端的に、明確にお答えください。具体的な理由をお答えになられないと今言われ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/105", "sentence": ["○柚木委員官房長、端的に答えてください。今まさに御自分が述べられた欠格条項のど