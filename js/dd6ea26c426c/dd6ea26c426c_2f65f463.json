[{"date": "2021-05-20", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/15", "sentence": ["…は、国として、地域の脱炭素化を担う人材の育成など、地方自治体に対する支援を実施していくことが私は必要不可欠だと考えております。小泉大臣は、脱…", "…すが、環境省として、どのように地方自治体に寄り添って、いわゆる伴走しながら脱炭素化に向けた支援策を行っていくのか、小泉大臣の所見を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/18", "sentence": ["…で伺いますが、地域の中小企業の競争力を高めるためにも、脱炭素経営の重要性について普及啓発や取組の支援が私は重要と考えますが、見解を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/20", "sentence": ["…ございますので、このサプライチェーンから排除されないようにしっかりと支援していただきたいと。そして、先ほどの答弁の中でありましたけど、今回、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01020210520/24", "sentence": []}]}]}]