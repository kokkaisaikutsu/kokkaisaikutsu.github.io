[{"date": "2020-03-24", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/11", "sentence": ["○滝沢求君八木政務官におかれては、十和田湖、お越しいただきまして、ありがとうございます。そして、またお待ちしていますから、どうぞよろしくお願…", "…後押ししていただければと、よろしくお願いをいたします。続きまして、十和田湖休屋地区においては、団体旅行客の減少により経営が悪化し、東日本大震…", "…打ちとなって廃業に至り、廃屋化したホテルや旅館が目立っております。十和田湖の美しい景観を阻害し、町並みの雰囲気を暗くしており、せっかく訪れた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/17", "sentence": []}]}]}, {"date": "2021-04-07", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/37", "sentence": ["○滝沢求君続いて伺います。現在、私の地元、十和田湖八幡平国立公園では、環境省が進める国立公園満喫プロジェクトとして、秋の蔦沼事前予約、奥入瀬…", "…として、秋の蔦沼事前予約、奥入瀬渓流の氷瀑ツアーの冬期利用促進や、十和田湖湖畔での景観改善等の様々な取組が進められており、引き続き地域の皆様…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/43", "sentence": []}]}]}]