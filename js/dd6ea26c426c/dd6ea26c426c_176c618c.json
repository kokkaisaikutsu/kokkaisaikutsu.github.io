[{"date": "2020-03-24", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/5", "sentence": ["…上の河川で決壊するなど、全国各地で甚大な被害を及ぼしました。こうした気象災害は、気候変動の影響によって今後更に深刻化するのではないかと考えら…", "…会に向けた取組を加速することもこれまた重要ではございますが、こうした気象災害や気温上昇による農作物への影響等に対応するための気候変動の適応は…", "…、現在、適応法に基づきどのような取組が行われているのか、そしてまた、近年発生している気象災害を受けてどのような取組を進めているのか伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/17", "sentence": []}]}]}]