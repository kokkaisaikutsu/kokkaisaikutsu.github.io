[{"date": "2020-11-06", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/19", "sentence": ["…ます。税とか保険料あるいは手数料、交通の反則金とかも含めた税、公金の納付というのは依然として平日の日中に金融機関の窓口に足を運んで納付をしな…", "…公金の納付というのは依然として平日の日中に金融機関の窓口に足を運んで納付をしなければいけないものが非常に多いわけであります。私も元銀行員であ…", "…べてみましたら、この国税というのは約七割が銀行等の窓口で紙による対面納付をしているという状況であります。業界の調査では、これによる納税者のコ…", "…うな社会的コストがあるわけであります。昨年度に銀行窓口に持ち込まれた納付書というのは三億五千万枚以上ですので、赤ちゃんから御老人まで一人三枚…", "…人三枚以上は平均して持ち込まなきゃいけない環境にあります。当然紙での納付ですので、物理的に仕分とか搬送を行わなければいけない上に、公金収納の…", "…に伺いますが、国民生活で重要なこの身近な納税制度にＱＲコード等の電子納付を導入するということで利便性を上げて、まさに無駄な社会的コストを削減…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/30", "sentence": []}]}]}]