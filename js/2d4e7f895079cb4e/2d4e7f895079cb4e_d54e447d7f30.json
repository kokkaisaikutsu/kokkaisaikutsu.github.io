[{"date": "2020-11-06", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/11", "sentence": ["…ような、懸念される季節でありますけれども、十分な検査能力を持つような仕組みも必要であります。我が国は、まさに医療機関の皆様のひたむきな御努力…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/19", "sentence": ["…に、公金収納の場合は銀行側の手数料の多くを金融機関で賄うというふうな仕組みになっておりまして、多大な見えない社会的コストが生じているというの…", "…こういうものを通じて、納税者、自治体、そして金融機関にとって三方よしとなる仕組みを一刻も早く導入すべきだと考えておりますが、御意見伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00220201106/30", "sentence": []}]}]}]