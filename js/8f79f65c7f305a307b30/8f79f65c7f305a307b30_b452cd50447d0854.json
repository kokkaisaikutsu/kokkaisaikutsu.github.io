[{"date": "2020-03-31", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/74", "sentence": ["○福島みずほ君定年引上げ、再雇用、定年の廃止のうち一つでも加われば労働組合の同意を取らなくてもよいわけです。雇用関係なしの働き方しか提供しな…", "…取らなくてもよいわけです。雇用関係なしの働き方しか提供しないのなら労働組合の同意が必要です。でも、こういう在り方だと、結局、再雇用ちょっと取…", "…と取っていますというので、実態は雇用関係なしの働き方が中心になってしまうんじゃないか。労働組合の同意要りません。これ、大問題ではないですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/76", "sentence": ["…も、実際には業務委託契約が中心となって労働者の保護ができなくなる。労働組合の同意が不要な方法を取ることは企業にとって抜け道となります。労政審…", "…の議論でしっかりここ、私は法の欠陥だと思いますので、しっかりこれは労働組合の同意と同じ、それ以上何かチェックをすべきだということを強く申し上…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00820200331/105", "sentence": []}]}]}, {"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 厚生労働委員