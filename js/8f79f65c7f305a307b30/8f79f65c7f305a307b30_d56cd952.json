[{"date": "2020-05-21", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/205", "sentence": ["○福島みずほ君そのとおりだと思います。今日は法務副大臣に来ていただきました。昨日質問通告をしておりますが、黒川弘務東京高検検事長のこの賭けマ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/223", "sentence": ["○福島みずほ君極めて重要なことなので聞いております。では、これ、法務省は黒川さんが賭けマージャンをしているのを知っていたんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/229", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/233", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/235", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/237", "sentence": ["…認めれば、一応それを前提に話をするということではないんでしょうか。森法務大臣は、まさにこれについて懲戒処分、処分を考えているということでした…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/239", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200521/241", "sentence": ["…弁です。つまり、歴代の本当に頑張ってきた検察官の人たちの意見書から見れば、定年延長の必要性はないということなんですよ。法務省、いかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01320200