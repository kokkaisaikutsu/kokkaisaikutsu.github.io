[{"date": "2020-12-10", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/35", "sentence": ["○福島みずほ君入管庁にお聞きをいたします。技能実習生に対する雇用維持支援策の実施状況はどうなっているでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/37", "sentence": ["○福島みずほ君技能実習生は送り出し機関に多額の費用を支払って来日をしております。コロナ禍で働けなくなると、この借金だけが残り、帰国後も借金の…", "…れることになります。このようなことを恐れて帰国するわけにはいかず、技能実習以外の仕事をせざるを得なくなる場合もあります。労働関係に第三者が介…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00120201210/41", "sentence": ["…二つの例を除外したとありますが、是非、今回、コロナ禍で借金だけ残る技能実習生の問題などありますので、是非努力してくださるようお願いいたします…"]}]}]}]