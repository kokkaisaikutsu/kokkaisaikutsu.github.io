[{"date": "2020-05-22", "meeting": [{"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/46", "sentence": ["…行う自家用有償旅客運送を拡大することになります。先日、本会議で赤羽国交大臣は、改定案はライドシェアを解禁しないと、ライドシェアはまさに責任が…", "…ますが、これまさにライドシェアに該当しないんでしょうか。白タクに該当するんじゃないでしょうか。国交大臣の答弁との整合性はどうなんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/48", "sentence": ["○福島みずほ君問題ですよ。幾ら国交大臣が、参議院の本会議でもそうでした、ライドシェアはこれは駄目ですと言ったんですよ。にもかかわらず、今の答…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/54", "sentence": []}]}]}]