[{"date": "2020-07-02", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/107", "sentence": ["…て緊急事態宣言もあり得るかという状態で、専門家の会議がないんですよ。空白ですよ。これ、いいんですか。今、誰が判断するんですか。誰が専門的見地…", "…んですよ。空白ですよ。これ、いいんですか。今、誰が判断するんですか。誰が専門的見地に基づいて判断するんですか。空白生んだ問題はあるでしょう。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/113", "sentence": ["…おっしゃいました。今日、廃止はしていないからまた専門家会議。でも、今空白なんですよ。専門家会議は廃止すると大臣が言った、新たな分科会は開かれ…", "…言った、新たな分科会は開かれていない、でも東京は感染者が増えている。空白が生まれているじゃないですか。みんな専門家の意見聞きたいですよ。何で…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/115", "sentence": ["…と宣言して専門家会議開くんですか。それはおかしいじゃないですか。今、空白が生まれているんですよ。この責任は極めて大きいというふうに思います。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00120200702/121", "sentence": []}]}]}]