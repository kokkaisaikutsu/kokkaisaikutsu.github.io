[{"date": "2021-02-03", "meeting": [{"meeting_name": "参議院 内閣委員会、厚生労働委員会連合審査会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/25", "sentence": ["○福島みずほ君ということは、突然過料ではなくて、この手続を踏むということなんですね。義務違反はないというふうに今までコンメンタール、義務違反…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/27", "sentence": ["…れは本当に理解ができません。でも、今、前置ということだったので、突然過料とはならないと。でも、義務が掛からないにもかかわらず過料の制裁がある…", "…たので、突然過料とはならないと。でも、義務が掛からないにもかかわらず過料の制裁があると。過料を払って、そして、じゃ入院しないということもあり…", "…ならないと。でも、義務が掛からないにもかかわらず過料の制裁があると。過料を払って、そして、じゃ入院しないということもあり得るのかという論点に…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/33", "sentence": ["…思いますよ。病院と連携もしなくちゃいけないし、何が正当の理由なのか。過料を科すんですよ。現場では本当に負担だと思います。次に特措法改正案の方…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/35", "sentence": ["○福島みずほ君法案見て何が過料の対象になるか分からないわけですよ。政令を作る、しかもその政令は自由に役所が作ることができるわけですし、また都…", "…はある、非常にあると思います。次に、この例えば八時以降の営業に関して過料で処罰するということですが、国会議員がイタリアンのお店に行って粘って…", "…員がイタリアンのお店に行って粘って九時までいると。お店は、お客は処罰されないが、お店はこの法律が成立すれば過料の制裁になるということですね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/37", "sentence": ["○福島みずほ君そうしたら、全部お客が居座っていると言えばこの過料の制裁にならないじゃないですか。お客はほとんど、お客が居座っているということ…", "…がイタリアンのお店で十時まで粘っていたら、お客が粘っているからこれは過料の制裁にならないわけですよね。でも、お客が粘っているのかお店が営業し…", "…常に言いますよ。お客が国会議員で追い出せませんでしたって言えばそれで過料の制裁にならないんだったら、それはおかしいですよ。ちょっと時間がない…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/39", "sentence": ["…月の十何日かで施行になるんですか。そして、そうだとすると、昨日までは過料がないが、今日から過料になるということになるんですか。そうだとすると…", "…るんですか。そして、そうだとすると、昨日までは過料がないが、今日から過料になるということになるんですか。そうだとすると、周知が本当に必要であ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/41", "sentence": ["…ことは当然です。でも、私の質問は、その行為は法律が施行されたときから過料の対象になるわけですよね。つまり、今もし法律が成立して公布がすぐさま…", "…れば、二月の十数日後に、ある行為が、つまり、八時以降に営業していれば過料の対象になるということになるんですか。なるということでよろしいですか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414894X00120210203/45", "sentence": []}]}]}, {"date": "2021-03-30", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/93", "sentence": ["○福島みずほ君これ、緊急事態宣言中であれば、お店は過料の制裁が科されるわけですよね。実際、過料の制裁が科されるお店があるというふうにされてい…", "…急事態宣言中であれば、お店は過料の制裁が科されるわけですよね。実際、過料の制裁が科されるお店があるというふうにされていますけれども。緊急事態…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/111", "sentence": []}, {"url":