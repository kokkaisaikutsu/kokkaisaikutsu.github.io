[{"date": "2020-03-19", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/128", "sentence": ["…中でも様々、区々です。親御さん、当事者、いろんな話を聞くと、物すごく勉強したい、物すごく高校に行きたい、同級生と一緒に勉強したい、熱意がすご…", "…を聞くと、物すごく勉強したい、物すごく高校に行きたい、同級生と一緒に勉強したい、熱意がすごくあるわけです。子供たちは、学校なんか行きたくない…", "…は、学校なんか行きたくない、学校つまらない、サボりたい、面白くない、勉強したくない、でも行こうなんという子供も実は多いと思うんですが、やっぱ…", "…す。つまり、かなり義務教育に近くなっているんですね。是非、その本当に勉強したい、学校に行きたい、これを是非満たしてほしい。定員内不合格ではな…", "…に行きたい、これを是非満たしてほしい。定員内不合格ではなくて、やっぱり勉強ができるようにしてほしい。これを強く求めますが、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X0