[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第三分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/19", "sentence": ["…で六・三％でありました。改めて、大臣にお尋ねいたします。この数字を見て、どのように現下の情勢、率直な御感想をお聞かせいただけますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/21", "sentence": ["…のと比べると、マイナス、これは大きいものだ、想定していた数字よりも大きなものだ、このように述べられましたが、麻生大臣の御感想はいかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/23", "sentence": ["…数字だったことは間違いないですね。西村大臣もそのように、これは個人的感想だと後ほど述べられておりましたけれども、でも、政府としてやはりそうい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/37", "sentence": []}]}]}]