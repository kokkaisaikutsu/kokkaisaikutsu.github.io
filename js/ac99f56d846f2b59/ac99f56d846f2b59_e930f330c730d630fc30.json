[{"date": "2020-03-06", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/92", "sentence": ["…おりてこられない、強風のためにおりられないということでありました。ランデブーポイントという、着陸地点をどうするかということが喫緊の課題という…", "…たものですから意識ははっきりしておりました。その通信を聞きながら、ランデブーポイントをどうするかということで、幸いにも、そこから少し離れたと…", "…そこから少し離れたところに小中学校のグラウンドがありまして、そこをランデブーポイントとして着陸し、本当にあと十分という瀬戸際のところで、ドク…", "…広明参議院議員が質問された部分であります。これは、当時、高速道路をランデブーポイントにすることに関しての質問でありました。救急車が高速道路ま…", "…ったかということで、十年前のこの指摘に対して、現在における高速道路のランデブーポイントの整備状況、これについてお答えいただけますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00220200306/113", "sentence": []}]}]}]