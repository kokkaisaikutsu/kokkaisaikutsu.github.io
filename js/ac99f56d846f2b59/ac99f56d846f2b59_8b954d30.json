[{"date": "2020-02-10", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/100", "sentence": ["…カオもラスベガスも四十施設強でございますが、これだけの、六倍、七倍の開きがあるというのは、結局は、ミニマムベットと呼ばれるような最低かけ金の…", "…のお金をかける方々が集まるということから、四兆円と六千九百億円という開きがあるわけであります。こうした中で、私がこの資料の中に示してまいりま…", "…昨年の二月の十二日に、大阪府、大阪市は第十七回の副首都推進本部会議を開き、そこでは、大阪ＩＲのＧＧＲ、カジノ部分です、そこのゲーミング収入と…", "…、事業者、自治体と事業者が一体となって申請してくる、その業者に対して許可を与える立場です。この開きについてはどのようにお考えになられますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/121", "sentence": []}]}]}]