[{"date": "2020-03-18", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/89", "sentence": ["…ことが上昇していく、時間がかかってしまうということから、土地所有者の探索、これに対しまして、国土調査法の改正等々を含めて今回のこの土地基本法…", "…わけでありますが、今までは、戸籍あるいは住民票、それをもとに所有者の探索が行われてきた、そして今回は、改正によって固定資産課税台帳等の情報利…", "…利用の円滑化等に関する特別措置法、ここでは、所有者不明土地の効果的な探索を図るためには、所有者の探索を合理化することが重要であるということが…", "…置法、ここでは、所有者不明土地の効果的な探索を図るためには、所有者の探索を合理化することが重要であるということが基本方針にも述べられています…", "…も位置づけられているのではないかと思っておりまして、こうした効果的な探索のために、固定資産課税台帳や農地台帳、これらの情報を集約していくシス…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00320200318/109", "sentence": []}]}]}]