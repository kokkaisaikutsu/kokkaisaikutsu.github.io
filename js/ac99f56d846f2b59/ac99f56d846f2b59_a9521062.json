[{"date": "2020-04-14", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/62", "sentence": ["○馬淵委員雇用調整助成金や、あるいは無担保無利子の貸付け、また軽油引取税減免措置、これは、でも、残念ながら国交省ではなく他省の所管ということ…", "…策ということでありますが、やはり直入れですよね。何といっても直入れの助成ということについては、これは国交省としても、こういう未曽有の危機です…", "…くるんですが、所管する立場として、勇気を持って、私は、予算措置を含む助成ということについて踏み込むべきだと思いますよ。検討すべきだと思います…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/81", "sentence": []}]}]}]