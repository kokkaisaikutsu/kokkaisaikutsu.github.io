[{"date": "2020-04-14", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/89", "sentence": ["…ながら進めていきたいというふうに思っております。次に、ライドシェアの合法化の阻止についてであります。先ほど来何名かの委員さんが質問されました…", "…味するのではないでしょうか。この制度が将来的にいわゆるライドシェアの合法化につながるのではないかと多くの方々が大変危惧しております。ライドシ…", "…合法化につながるのではないかと多くの方々が大変危惧しております。ライドシェアの合法化につながらないという説明を大臣にお願いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/91", "sentence": ["…含めて、中央省庁間で連携して、ライドシェア、ぜひ国交省が先頭に立って合法化阻止に向けて取り組んでいただきたいというふうに思っております。次に…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/101", "sentence": []}]}]}]