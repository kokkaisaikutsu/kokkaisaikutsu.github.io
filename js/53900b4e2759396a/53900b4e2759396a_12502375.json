[{"date": "2020-05-27", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/30", "sentence": ["…免、猶予に応じないで、それで結局テナントが出ていかざるを得ない、また倒産せざるを得ないだとかそういうことになると、結局、長期的に見たら、ＲＥ…", "…。この件について最後なんですけれども、そうした入居するテナント企業の倒産ということは防がなければなりません。立憲民主党など野党五党は、中小事…", "…しずつ、今、支援に関する案が明らかになってきておりますが、テナントの倒産並びにＲＥＩＴも含めた不動産賃貸事業者の倒産等を防止するために国交省…", "…ておりますが、テナントの倒産並びにＲＥＩＴも含めた不動産賃貸事業者の倒産等を防止するために国交省として今後どのような措置を講じていこうと考え…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01520200527/40", "sentence": []}]}]}]