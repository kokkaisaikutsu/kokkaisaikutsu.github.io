[{"date": "2021-12-15", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705254X00420211215/10", "sentence": ["…新型コロナ対策として必要と考える経費を追加支出すべく、補正予算の編成替え動議を提出いたしました。その内容は、病床、療養施設の確保や医療機関等…", "…まない項目を撤回し、これらの緊急対策経費の支出が可能になるよう、編成替え動議を提出したところではありますが、自民党など与党の無理解によって否…"]}]}, {"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705261X00420211215/173", "sentence": ["…となりました令和三年度補正予算案に反対、立憲民主党・無所属提出の編成替え動議に賛成の立場から討論いたします。その前に、今朝の新聞報道で、国土…", "…を創設すべきと提唱していますが、これも含まれていません。我が党の編成替え動議は、コロナ感染第六波から国民の命、暮らし、事業を守り抜くためのコ…", "…減する内容であり、高く評価できます。以上、令和三年度補正予算案に反対、立憲民主党・無所属提案の編成替え動議に賛成の討論といたします。（拍手）"]}]}, {"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120704601X00120211215/73", "sentence": []}]}]}]