[{"date": "2020-03-26", "meeting": [{"meeting_name": "衆議院 原子力問題調査特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104194X00220200326/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104194X00220200326/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104194X00220200326/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104194X00220200326/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104194X00220200326/18", "sentence": ["…んだろうと思います。この委員会でも多くの議員の皆さんから同じような問題提起があったと承知をしています。更田委員長も、運転期間というのは、立法…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104194X00220200326/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104194X00220200326/22", "sentence": ["…えられた時間はそんなに多くないというように感じますので、こういった問題提起をさせていただきました。次に、最後の質問になりますけれども、先ほど…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104194X00220200326/24", "sentence": ["…を本当に期待をしてやみません。そして、このエネルギー問題、さまざま問題提起をさせていただきました。四十年問題、六十年問題についても議論をこれ…"]}]}]}]