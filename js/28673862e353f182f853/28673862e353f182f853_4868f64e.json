[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/46", "sentence": ["…、リッチ社との関係、総務会長当時のリッチ社との面談、その際、馬毛島の案件について話題が出たことを認めておられます。リッチ社の面談記録には二〇…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/48", "sentence": ["…ただきました。それでは、資料四でありますけれども、朝日新聞、「「スガ案件」官僚動かす天の声」ということで、この記事には、米軍機の訓練を想定し…", "…とで、この記事には、米軍機の訓練を想定した無人島馬毛島の買収問題も菅案件だった、防衛省と島の所有会社との間で八年に及ぶ買収交渉が続く中、菅は…", "…場所は最適、安いもんだろ、菅は周囲にそう胸を張った、防衛省関係者は天の声と漏らしたと。馬毛島案件は菅案件なんでしょうか。官房長官、伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/50", "sentence": ["○木戸口英司君この案件はまた引き続き聞いてまいりたいと思います。官房長官は結構です。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/56", "sentence": []}]}]}]