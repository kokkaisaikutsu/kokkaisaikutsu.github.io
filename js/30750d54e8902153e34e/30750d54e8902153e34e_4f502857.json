[{"date": "2021-12-22", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/39", "sentence": ["…医師の確保について伺いたいのですけれども、農水省としては、これ不足だと考えているのか、偏在だと考えているのか、お答えいただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/41", "sentence": ["○田名部匡代君偏在をどのように解消していくおつもりですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/43", "sentence": ["…学費支援なども行ってきていますし、いろんな取組しているけど、それでも偏在は解消されず、地域で困っている状況がありますので、是非ここを本腰を入…", "…含めて、しっかりと国として積極的に責任を持って対応していただきたい、偏在を解消していただきたいと思いますので、よろしくお願いして、終わります…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715007X00120211222/167", "sentence": []}]}]}]