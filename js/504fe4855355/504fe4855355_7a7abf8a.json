[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/17", "sentence": ["…おりますけれども、子供たちをやはり熱中症から守るという観点で、学校に空調を設置するということ、大変重要であります。大変補正予算なんかも使って…", "…も使って進めてきていただいていますが、これ、現状、今どうなっているのか、公立小中学校におけるこの空調の設置状況を改めて確認したいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/19", "sentence": ["…て、こういった格差がないということも大変大事でありますので、この公立小中学校への空調設置のための文科省の取組をお答えいただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/29", "sentence": []}]}]}]