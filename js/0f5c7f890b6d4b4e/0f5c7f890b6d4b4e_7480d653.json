[{"date": "2020-03-11", "meeting": [{"meeting_name": "参議院 沖縄及び北方問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/3", "sentence": ["…。沖縄及び北方問題に関しての施策に関する件について関係大臣から所信を聴取いたします。まず、衛藤沖縄及び北方対策担当大臣より所信を聴取いたしま…", "…関する件について関係大臣から所信を聴取いたします。まず、衛藤沖縄及び北方対策担当大臣より所信を聴取いたします。衛藤沖縄及び北方対策担当大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/5", "sentence": ["○委員長（小西洋之君）次に、茂木外務大臣から所信を聴取いたします。茂木外務大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/7", "sentence": ["○委員長（小西洋之君）以上で所信の聴取は終了いたしました。本件に対する質疑は後日に譲ることといたします。この際、若宮外務副大臣から発言を求め…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/10", "sentence": ["○委員長（小西洋之君）次に、先般本委員会が行いました委員派遣につきまして、派遣委員の報告を聴取いたします。山田宏君。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00320200311/13", "sentence": []}]}]}, {"date": "2020-03-19", "meeting": [{"meeting_name": "参議院 沖縄及び北方問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113895X00420200319/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00420200319/2", "sentence": ["…おり、内閣府政策統括官宮地毅君外九名を政府参考人として出席を求め、その説明を聴取することに御異議ございませんか。〔「異議なし」と呼ぶ者あり〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00420200319/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00420200319/4", "sentence": ["…本件を議題といたします。審査を委嘱されました予算について衛藤沖縄及び北方対策担当大臣から説明を聴取いたします。衛藤沖縄及び北方対策担当大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00420200319/6", "sentence": ["○委員長（小西洋之君）以上で予算の説明の聴取は終わりました。これより質疑に入ります。質疑のある方は順次御発言願います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00420200319/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113895X00420200319/96", "s