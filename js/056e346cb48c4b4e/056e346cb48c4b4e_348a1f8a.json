[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/150", "sentence": ["…Ｐアドレスなど一部と。それを基に今度は携帯電話事業者などに情報開示を訴訟で求める必要があるということで、もう大変な労力と時間が掛かるわけです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/152", "sentence": ["…図られて加害者側が特定されたとして、今度は、被害を受けたと感じた方が訴訟などを起こして権利回復を図ろうとしたとしても、これはこれでまた時間と…", "…手間暇と掛かるわけですね。実際、賠償額というのも、こういう名誉毀損の訴訟になるんですが、決して高いものではありません。ネット上での名誉毀損の…", "…なんですね。としますと、なかなか、それだけ時間と手間暇掛けてと、で、訴訟費用も掛かる中で、二の足を踏む方が多いというのも実情ではないかと思い…", "…てしまうというふうに考えます。ちょっとリツイート、いいねは余談かもしれませんが、訴訟の面について、今の見解を聞かせていただけますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/174", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/176", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/178", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/180", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X01320200604/182", "sentence": []}]}]}]