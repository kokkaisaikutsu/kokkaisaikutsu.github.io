[{"date": "2020-11-17", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/100", "sentence": ["…・無所属の会、公明党及び日本維新の会・無所属の会の三派共同提案による修正案並びに亀井亜紀子君外三名から、立憲民主党・社民・無所属による修正案…", "…る修正案並びに亀井亜紀子君外三名から、立憲民主党・社民・無所属による修正案がそれぞれ提出されております。提出者から順次趣旨の説明を聴取いたし…", "…聴取いたします。加藤寛治君。―――――――――――――種苗法の一部を改正する法律案に対する修正案〔本号末尾に掲載〕―――――――――――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/102", "sentence": ["…鳥委員長次に、亀井亜紀子君。―――――――――――――種苗法の一部を改正する法律案に対する修正案〔本号末尾に掲載〕―――――――――――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/104", "sentence": ["○高鳥委員長これにて両修正案の趣旨の説明は終わりました。―――――――――――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/105", "sentence": ["○高鳥委員長これより原案及びこれに対する両修正案を一括して討論に入ります。討論の申出がありますので、順次これを許します。亀井亜紀子君。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/110", "sentence": ["…百一回国会、内閣提出、種苗法の一部を改正する法律案及びこれに対する両修正案について採決いたします。まず、亀井亜紀子君外三名提出の修正案につい…", "…対する両修正案について採決いたします。まず、亀井亜紀子君外三名提出の修正案について採決いたします。本修正案に賛成の諸君の起立を求めます。〔賛…", "…正案について採決いたします。まず、亀井亜紀子君外三名提出の修正案について採決いたします。本修正案に賛成の諸君の起立を求めます。〔賛成者起立〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/111", "sentence": ["○高鳥委員長起立少数。よって、本修正案は否決されました。次に、加藤寛治君外二名提出の修正案について採決いたします。本修正案に賛成の諸君の起立…", "…少数。よって、本修正案は否決されました。次に、加藤寛治君外二名提出の修正案について採決いたします。本修正案に賛成の諸君の起立を求めます。〔賛…", "…て、本修正案は否決されました。次に、加藤寛治君外二名提出の修正案について採決いたします。本修正案に賛成の諸君の起立を求めます。〔賛成者起立〕"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/112", "sentence": ["○高鳥委員長起立多数。よって、本修正案は可決されました。次に、ただいま可決いたしました修正部分を除く原案について採決いたします。これに賛成の…", "…数。よって、本修正案は可決されました。次に、ただいま可決いたしました修正部分を除く原案について採決いたします。これに賛成の諸君の起立を求めま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/113", "sentence": ["○高鳥委員長起立多数。よって、本案は修正議決すべきものと決しました。―――――――――――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00420201117/121", "sentence": []}]}]}, {"date": "2020-11-19", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305254X00620201119/16", "sentence": ["…明党及び日本維新の会・無所属の会の共同提案により、施行期日についての修正案が提出されました。また、立憲民主党・社民・無所属から、有機農業にお…", "…ける自家増殖を育成者権の効力が及ぶ範囲の例外とすること等を内容とする修正案が提出され、それぞれ趣旨の説明を聴取いたしました。次いで、討論を行…", "…論を行い、採決いたしましたところ、立憲民主党・社民・無所属提出に係る修正案は賛成少数で否決され、自由民主党・無所属の会、公明党及び日本維新の…", "…主党・無所属の会、公明党及び日本維新の会・無所属の会の共同提案に係る修正案並びに修正部分を除く原案は賛成多数をもって可決され、本案は修正議決…", "…の会、公明党及び日本維新の会・無所属の会の共同提案に係る修正案並びに修正部分を除く原案は賛成多数をもって可決され、本案は修正議決すべきものと…", "…係る修正案並びに修正部分を除く原案は賛成多数をもって可決され、本案は修正議決すべきものと議決した次第であります。なお、本案に対し附帯決議が付…"]}]}, {"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119