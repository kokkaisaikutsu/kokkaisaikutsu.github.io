[{"date": "2021-04-16", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/68", "sentence": ["…れも上手ですよね。電通みたいですよ、パリ協定の死。だけれども、地元の横須賀で石炭火力をやっているじゃないですか。それだって、みんな何となく遠…", "…た方が日本の未来のためですよ。日本が未来を間違える、その入口が、今、横須賀じゃないんですか。私はそういう気持ちを持っていますよ。千葉は立派で…", "…は、変だな、輸出は一生懸命何か出さないようにするとか言っていて、地元の横須賀でしっかりやってほしいと思うんですけれども、どうですか、そこは。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/76", "sentence": []}]}]}]