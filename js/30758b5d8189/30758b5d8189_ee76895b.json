[{"date": "2021-04-16", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/60", "sentence": ["…分野で提案をしたいんです、提案を。野党の提案ですけれども、私は是非、目安箱をつくってほしいんです、目安箱。これは、調べてみたら、徳川吉宗の目…", "…を。野党の提案ですけれども、私は是非、目安箱をつくってほしいんです、目安箱。これは、調べてみたら、徳川吉宗の目安箱から、今年で三百年なんです…", "…安箱をつくってほしいんです、目安箱。これは、調べてみたら、徳川吉宗の目安箱から、今年で三百年なんですよ、ちょうど。だから、享保の改革、令和の…", "…、今年で三百年なんですよ、ちょうど。だから、享保の改革、令和の改革で目安箱。なぜかというと、セブンさんとかが頑張ってサプライサイドから進める…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/62", "sentence": ["…どに便利な時代に持っていってほしいなというふうに私は思っているんです。まずそのことを、目安箱と併せて大臣から御確認をいただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/76", "sentence": []}]}]}]