[{"date": "2020-02-04", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/183", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/185", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/187", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/195", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/197", "sentence": ["…のは海外から輸入をしている、資源の乏しい国日本でありますから。そのときに、毎年、石油、石炭を海外から調達するのに幾らのお金をかけていますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/212", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/220", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/222", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/226", "sentence": []}]}]}, {"date": "2020-05-22", "meeting": [{"meeting_name": "衆議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/8", "sentence": ["…うにきちんと答弁もしていただきたいというふうに思います。それで、私、石油火力について確認をさせていただきたいんですけれども。以前経団連のホー…", "…けないんですが、よくここで誤解があるのは、中東リスク、中東リスクと言いますけれども、日本は石油の火力発電というのはどのぐらいの依存率ですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/12", "sentence": ["○田嶋委員今回、中東リスクということで説明を受けておりますけれども、石油火力というのはほとんどないんですよ、大臣も御存じのとおり。ただ、日本…", "…私は思っております。私、中東リスクを下げていく最大のポイントは、もう石油火力をやめにすることだと思うんですよ。どうやら日本の十電力、やめてい…", "…石炭火力の問題ばかりが強調されますけれども、石炭火力は温室効果ガス、石油火力はコストですよ。国民負担に大きく響くのが石油火力の高コスト体質で…", "…火力は温室効果ガス、石油火力はコストですよ。国民負担に大きく響くのが石油火力の高コスト体質ですね。大臣、これは、このＪＯＧＭＥＣの法改正以前…", "…前の話で、そういう意味で大臣、これを機に、この法改正は法改正として、石油火力発電、それをやはり全廃に向かって加速をしていく、私そのことが大事…", "…ちろん大事ですけれども。しかし、方針としては、火力依存というのを下げるだけではなくて、石油火力依存をやはりゼロにしていく。どうですか、大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/15", "sentence": ["…に、この地政学的リスクをどうやって抑え込んでいくかということになれば、石油火力依存を下げるというのがやはり大きな道になると。発言されますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/17", "sentence": ["…田嶋委員ありがとうございました。そういう今おっしゃったようなことも、石油業界も資料とかで書かれておりますね。石炭やＬＮＧで役割としてはだんだ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01220200522/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01