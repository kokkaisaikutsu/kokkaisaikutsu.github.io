[{"date": "2021-04-23", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/6", "sentence": ["…、他方、今回、国家公務員の定年引上げの前提となった、平成三十年八月の人事院の意見の申出においては、六十五歳以上の職員の活用については触れられ…", "…れていないわけです。国家公務員の六十五歳以上の活用という観点から、どのように考えているのか、意見の申出を行った人事院の方に御意見を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/8", "sentence": ["…つける観点も重要だと考えます。この給与制度について、給与制度の見直しの具体的な内容それからスケジュール等について、人事院にお伺いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/10", "sentence": ["…はないか。本法案におきましては、附則第十六条第三項において、先ほどの人事院による給与制度の見直しの前提といたしまして、「職員の能力及び実績を…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X02120210423/22", "sentence": []}]}]}]