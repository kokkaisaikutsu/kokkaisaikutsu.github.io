[{"date": "2021-03-24", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/154", "sentence": ["…てお伺いしたいと思います。カボタージュ規制というのは、国内輸送を自国船籍に限るという国際慣習に基づく規制でありまして、日本では、船舶法に基づ…", "…イーンビートルについて、特許を与えた。本来であれば、これはやはり日本船籍に変えさせて、国内で輸送を認めるべきだったものだと思うんですが、なぜ…", "…えさせて、国内で輸送を認めるべきだったものだと思うんですが、なぜ日本船籍に変えさせずに、結果としてカボタージュ規制に風穴を空けることにつなが…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/158", "sentence": ["○古川（元）委員これはなぜ、じゃ、日本船籍に船籍変更する、そうしてやってください、そのための支援はする、そういう手だては取れなかったんですか…", "○古川（元）委員これはなぜ、じゃ、日本船籍に船籍変更する、そうしてやってください、そのための支援はする、そういう手だては取れなかったんですか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/166", "sentence": ["…ための支援をしてあげればいいんじゃないかと思うんですよね。やはり外国船籍というのは、先ほどの高橋委員のダイヤモンドクルーズの話もありましたけ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/168", "sentence": ["…連して、少し附属的なことを質問したいと思いますが、今回のような事例で、パナマ船籍の乗船に関して、船員の船員保険は付保されているんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/173", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/175", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404319X00620210324/177", "sentence": []}]}]}]