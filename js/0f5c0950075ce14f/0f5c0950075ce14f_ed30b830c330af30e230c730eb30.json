[{"date": "2020-02-05", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/46", "sentence": ["○小倉委員何が重要かというと、私は、ロジックモデルと因果関係の推定、これを申し上げたいと思います。これでも、何のことか多分わからない、なじみ…", "…ためには歯科口腔医療にもっとお金をかけるべきだというのは、これはロジックモデルとしても因果関係の推定としても正しいわけでありますけれども、例…", "…けれども、例えば、歯磨きをすれば水虫にならないというのは、これはロジックモデルとしては破綻をしているわけでありますし、例えば、歯磨きをして、…", "…ことにもつながります。そういう意味では、きちんとそれぞれの政策でロジックモデルを構築をして、構築をするだけではなくて、ロジックモデルの間と間…", "…れの政策でロジックモデルを構築をして、構築をするだけではなくて、ロジックモデルの間と間をつなぐ矢印の因果関係、確からしさというのを科学的に行…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00720200205/60", "sentence": []}]}]}]