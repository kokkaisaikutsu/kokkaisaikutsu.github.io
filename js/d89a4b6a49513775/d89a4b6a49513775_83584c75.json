[{"date": "2021-03-25", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/37", "sentence": ["…ます。地元の木材市場から、山村部では土地所有者の高齢化が進み、土地の境界が分からなくなってきていると伺いました。この点、お配りした資料一を御…", "…と思います。なぜなら、間伐や植栽などの森林整備を行うためには、森林の境界が明確化され、森林所有者が明らかになっていることが大前提だからです。…", "…いわゆるエリートツリー、この植栽を行うに当たっても、地籍調査を通じて境界を明確化することが不可欠ではないでしょうか。ついては、林野庁として、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/48", "sentence": []}]}]}]