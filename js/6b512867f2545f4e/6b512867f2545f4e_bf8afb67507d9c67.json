[{"date": "2020-05-15", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/15", "sentence": ["○八木大臣政務官ありがとうございます。今回の改正で義務づける事前調査結果の報告により、都道府県などが幅広くかつ速やかに解体工事の現場を把握で…", "…き、他法令の届出に基づく解体工事の情報を収集することによって、事前調査結果の報告漏れなども防ぎながら、違反事例の把握の徹底を図っていきます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/99", "sentence": []}]}]}]