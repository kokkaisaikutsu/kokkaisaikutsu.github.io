[{"date": "2020-04-01", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/38", "sentence": ["…、東京一極集中を始め、過疎と過密の地域間格差はますます広がります。手遅れでございます。現在のＢバイＣの算定方法の考え方や高過ぎる割引率の設定…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/40", "sentence": ["…ぎます。これからは、人口減少が深刻な地域ほど、人口が少ない地域ほど、遅れている事業なり国のグランドデザインとしてやるべき事業は前倒しして実施…", "…はもちろんのこと、リニアや東海道、山陽、上越新幹線は地元負担なしで、遅れた地域の新幹線は財政力が弱いのに地元負担大というのは余りにも不平等だ…", "…格上げし、地元負担等に配慮しながら強力に進めていただきたいと思いますが、長年の遅れを取り戻すべく、再度総理から力強い答弁をお願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/46", "sentence": []}]}]}, {"date": "2021-03-22", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415007X00320210322/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00320210322/8", "sentence": ["…やはり今回の新型コロナ問題で世界は一変しまして、日本でもデジタル化の遅れや東京を始めとする巨大都市の過密リスクなどが改めて浮き彫りになり、Ｄ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00320210322/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00320210322/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00320210322/15", "sentence": []}]}]}]