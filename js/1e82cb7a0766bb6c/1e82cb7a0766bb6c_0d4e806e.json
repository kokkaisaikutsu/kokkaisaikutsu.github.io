[{"date": "2021-06-07", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00920210607/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00920210607/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00920210607/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00920210607/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00920210607/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00920210607/17", "sentence": ["…過ぎた今、長年のデフレと人口減少に苦しむ地方では国の鉄道政策に対する不満と不安が相当たまっているのも事実です。不満の項目は、昨年四月もこの委…", "…方では国の鉄道政策に対する不満と不安が相当たまっているのも事実です。不満の項目は、昨年四月もこの委員会で取り上げましたが、新幹線の問題で、山…", "…法も令和の時代にふさわしいものに見直す必要があると考えますが、以上二点、赤羽大臣から地方の不満と不安に配慮した優しい答弁をお願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00920210607/19", "sentence": []}]}]}]