[{"date": "2020-05-15", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/64", "sentence": ["…改めて出てきているわけであります。私としては、この罰則、量刑の水準、罰金が四十年前と同じと。よく、私もそうしたことを政府に言いますと、他の量…", "…ついていかにお考えか。私は、健康という守るべき利益、健康に対する危険度に合った量刑、罰金であるべきだと思うんですが、いかがでありましょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/66", "sentence": ["…りますけれども、私は、繰り返しますけれども、いわば事件になったときの罰金あるいは量刑、こういうものが、やはりきちっと規制をしていく上で厳しさ…", "…は、そういう意味で、総合的に、今もおっしゃった、そうした量刑の問題、罰金の問題、またそうした規制、つまり、規制がかかっても、例えば調査に時間…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104006X00420200515/72", "sentence": []}]}]}]