[{"date": "2021-05-28", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/22", "sentence": ["…のアンケートから。国や県に望むこととして、例えば、福島県中通りに住む十代の男性は、何年先、何十年先も県民の健康を見ていく責任を負ってほしい、…", "…年先も県民の健康を見ていく責任を負ってほしい、避難指示地域を出ている十代の女性も、東京電力の事故がなければ避難も被曝もしなかったはず、地震の…", "…あります。そうしたときにも精神的ダメージを受けます。しかし、今、この十代の方の言及にもありましたが、東京電力のいわゆる原発の事故があったんだ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/32", "sentence": []}]}]}]