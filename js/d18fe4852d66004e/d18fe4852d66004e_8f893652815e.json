[{"date": "2021-03-09", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00220210309/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00220210309/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00220210309/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00220210309/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00220210309/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00220210309/71", "sentence": ["…大な事件が発生しました。翌九月二十一日には東電が事案を把握し、原子力規制庁にも報告をしました。しかしながら、原子力規制委員会には報告をしなか…", "…す。審査の最終段階の流れの中で、このＩＤ不正使用事案の重要性は東電も規制庁も認識していたはずであります。規制委員会に報告しなかったことは到底…", "…ついて、二月二十五日、予算委員会第七分科会、山田総括審議官は、原子力規制庁幹部では長官までは報告はされてございます、長官まではと答弁しました…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00220210309/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00220210309/75", "sentence": []}]}]}]