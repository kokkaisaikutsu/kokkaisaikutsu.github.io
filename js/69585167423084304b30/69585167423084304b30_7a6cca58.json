[{"date": "2020-11-27", "meeting": [{"meeting_name": "参議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/60", "sentence": ["…水プロジェクトについてお伺いをいたします。西日本の豪雨災害などで多数決壊したのがため池で、ニュースで多く取り上げられたと思います。私も広島出…", "…立法で成立をして、十月に施行されたところです。この特措法は、ため池の決壊などによる水害から国民の生命と財産を守ることを目的としていると。災害…", "…を守ることを目的としていると。災害時などに備えて堤体を開削することで決壊を防いでいくもので、補強だけではなくて廃止工事も含んでいるものと理解…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00520201127/67", "sentence": []}]}]}]