[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 予算委員会公聴会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/16", "sentence": ["…について公述人のお二人にお伺いをしたいと思っています。まず、全国の一斉休校についてお伺いをいたします。安倍総理は、二月二十七日、唐突に全国の…", "…規模イベントの二週間の自粛の呼びかけがありまして、そして二十七日に一斉休校の要請がありました。これ、少し思うんですけれども、戦略を持って本当…", "…るのかというところが少し疑問が残るところではあります。この間、全国一斉休校の要請に対して専門家会議では提言をしていないと、同じ専門家会議の岡…", "…ようにおっしゃっています。そこで、まず上公述人にお伺いをいたします。この全国の一斉休校は科学的な根拠と合理性があるのか、お伺いをいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/20", "sentence": ["…ありがとうございます。そこで、もう一点お伺いしたいんですけれども、一斉休校を春休みまでと決めたことに対するちょっと疑問があります。ここについ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115262X00120200310/43", "sentence": []}]}]}]