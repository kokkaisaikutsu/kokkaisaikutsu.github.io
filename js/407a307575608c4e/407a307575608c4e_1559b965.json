[{"date": "2020-03-06", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/252", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/254", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/256", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/258", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/260", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/262", "sentence": ["…であります。茂木大臣は、湖北省をレベル３にしたことを、一月二十四日の夕方十六時四十三分から行った記者会見で発表されました。しかし、同じ日の朝…", "…前中までは武漢市のみをレベル２とすることでよしとしていたものを、その夕方になって、今度は湖北省をレベル３にすると判断を改めたわけですけれども…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/264", "sentence": ["…あります。茂木大臣は、今、レベル３とした理由について、一月二十四日の夕方の記者会見では、武漢市及び近隣六市が公共交通機関の停止などを発表した…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/266", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/268", "sentence": ["…に更に引上げという文言をつけ加えているんですよね。だから、茂木大臣の夕方の記者会見を受けて、今お話ししたように、政府の対応と、自民党の一部議…", "…。武漢市だけでなくて湖北省全体をレベル３にすべきだったという対応のおくれ、つまり、これを夕方の記者会見で修正したということでいいわけですね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/271", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/273", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/275", "sentence": []}]}]}]