[{"date": "2020-05-13", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/75", "sentence": ["…いうことで、ある意味では、しかし、日本国外から入国することは例外的に許可を得た場合を除き想定されないとおっしゃっていました。そこで、アメリカ…", "…ているが、ＳＯＦＡ、日米協定ですね、地位協定、関係者の日本への入国は許可していると書かれています。また、在日米海軍司令部が四月二十二日に出し…", "…り、米側からは、日本国外から米軍関係者が日本に入国することは例外的に許可を得た場合を除き想定されていないと説明を受けていると答弁されました。…", "…と説明を受けていると答弁されました。そこで聞きますけれども、例外的に許可を得た場合とはどんな場合なのか、米側からはどんな場合、例外的に許可を…", "…聞きますけれども、例外的に許可を得た場合とはどんな場合なのか、米側からはどんな場合、例外的に許可を与えていると説明されたのか、お尋ねします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/77", "sentence": ["…門の長官などが任務上不可欠と判断すれば、ケース・バイ・ケースで移動を許可するものとなっています。大臣は、書面で出してもそれでも認めない場合が…", "…官や長官などが任務上不可欠と判断すれば、ケース・バイ・ケースで移動を許可するものとなっています。つまり、米側の裁量で事実上幾らでも移動できる…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/99", "sentence": []}]}]}]