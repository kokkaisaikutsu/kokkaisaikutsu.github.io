[{"date": "2020-05-22", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/135", "sentence": ["…京都ふぐ組合の方々に話を聞きますと、かつて京都では、試験による基準の統一化とその徹底のために、ふぐ組合の役員が京都府北部の久美浜や間人などの…", "…がしっかりとしておれば、客には提供されない。だから、文字どおり基準を統一して徹底することが必要だと。こうしたところまで、つまり、全ての工程に…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/137", "sentence": ["…いようにするためであります。厚労省は、二〇二一年をめどに全都道府県が統一基準で認定試験を行うようにするとのことですけれども、本当にこれは京都…", "…行うようにするとのことですけれども、本当にこれは京都などと同様に全国統一基準となるような担保があるのか。通知やガイドラインを見ましても、そう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/139", "sentence": ["…各都道府県でやってみて、やはり問題点が克服されない場合は、将来、全国統一試験、つまり国家試験化も視野に入れる必要があるんじゃないかと私は考え…", "…た日本の食文化の最高傑作の一つであります。フグの取扱制度と免許を全国統一基準で確立し、最高峰の食の安全確保の体制を確立してこそ、フグ食を世界…", "…、フグ関連業界の一層の発展につながる。したがって、フグ処理免許の全国統一、国家試験の制度化も視野に入れた取組の強化を求めて、質問を終わります…"]}]}]}]