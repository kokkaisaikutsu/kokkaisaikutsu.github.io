[{"date": "2020-05-13", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/75", "sentence": ["…られるということで、ある意味では、しかし、日本国外から入国することは例外的に許可を得た場合を除き想定されないとおっしゃっていました。そこで、…", "…止しており、米側からは、日本国外から米軍関係者が日本に入国することは例外的に許可を得た場合を除き想定されていないと説明を受けていると答弁され…", "…ていないと説明を受けていると答弁されました。そこで聞きますけれども、例外的に許可を得た場合とはどんな場合なのか、米側からはどんな場合、例外的…", "…聞きますけれども、例外的に許可を得た場合とはどんな場合なのか、米側からはどんな場合、例外的に許可を与えていると説明されたのか、お尋ねします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/77", "sentence": ["…厳しいみたいな言い方をしていますが、逆に私は、この移動制限には多くの例外措置が定められていて、統合軍司令官や統合参謀本部議長、軍事関係部門の…", "…うときつ目に言われるけれども、私の方は逆に、あっちの文書を見ますと、例外措置が多くて、その議長や司令官や長官などが任務上不可欠と判断すれば、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/79", "sentence": ["…いろ違うかもしれません。しかし、私は、国防総省の移動制限には明らかに例外措置が設けられているということは確かだということ、そして、お話あるよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00620200513/99", "sentence": []}]}]}]