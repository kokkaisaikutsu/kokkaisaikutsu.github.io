[{"date": "2020-04-03", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/105", "sentence": ["…野大臣は、十七日の会見で、艦内で一時隔離した後、必要な場合には陸上の病院にヘリ等で輸送することになると説明しております。さらに、三月十日の会…", "…と説明しております。さらに、三月十日の会見では、ジブチのフランス軍の病院等とも連携がとれるように打合せをしていると述べられています。その後、…", "…の病院等とも連携がとれるように打合せをしていると述べられています。その後、フランス軍の病院などとの調整はどうなっているのか、御報告ください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/107", "sentence": ["…記を掲載しています。それによると、自衛隊員がジブチにあるフランス軍の病院やアメリカ軍の医務室で治療を受けるときというのは、自衛隊拠点内の医務…", "…仮にそういう方がおられた場合で、自衛隊の感染者がジブチのフランス軍の病院に搬送されるというのは、自衛隊では十分な治療が行えない場合を想定して…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00420200403/121", "sentence": []}]}]}]