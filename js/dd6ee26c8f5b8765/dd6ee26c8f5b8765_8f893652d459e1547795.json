[{"date": "2021-02-17", "meeting": [{"meeting_name": "参議院 資源エネルギーに関する調査会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/9", "sentence": ["…だけに、立地県全体を代表する議員としてのお願いであります。そこで、規制委員長に問います。三・一一後設立された規制委員会の長年の業務の結果とし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/13", "sentence": ["…的な見地から規制委員会が具体的にどのように安全を確認しているかも含め、丁寧に説明をいただくことが必要であります。規制委員長の答弁を求めます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/17", "sentence": ["…地地域も付いてこないということを警句として申し上げます。さて、また規制委員長への質問に戻り、三・一一から十年の棚卸し、振り返りをしたいと思い…", "…査の加速化に向けて、論点は早く提示する、後から出さない、変えない等の取組を改めて強化する必要があると思いますが、規制委員長の見解を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414396X00220210217/23", "sentence": []}]}]}]