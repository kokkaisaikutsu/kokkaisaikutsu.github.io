[{"date": "2020-04-10", "meeting": [{"meeting_name": "衆議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/36", "sentence": ["…たら、線を引っ張りましたけれども、資料七。三月二十九日としながら、受け付け日は三月十八日になっているんですね。長官に伺いますけれども、二十七…", "…ますけれども、二十七日に知ったとある。これは三月十八日も、こういう受け付け日があって、これは組織的に事前にわかっていたんじゃないですか。お伺…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/38", "sentence": ["○山岡委員受け付け日が三月十八日で、文書番号自体は〇三一八ということは、〇三一八に打たないとこの文書番号は出てこないじゃないですか。システム…", "…、文書番号も〇三一八となっているということは、十八日の時点でこのことを受け付けているということにならないんですか。もう一回答弁してください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X00520200410/54", "sentence": []}]}]}]