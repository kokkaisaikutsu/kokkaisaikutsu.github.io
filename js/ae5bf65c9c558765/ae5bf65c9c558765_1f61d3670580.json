[{"date": "2020-11-19", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/5", "sentence": ["…る消費活動の低迷など深刻な影響が生じました。また、十一月に入り全国で感染者が再び増加していることから、新型コロナ感染症の第三波が来ているので…", "…るのではないかと、こういうような話も言われているところでございます。感染者の確定、また感染源の究明、さらには接触者の調査など、クラスター対策…", "…は接触者の調査など、クラスター対策などに当たる保健所や検疫所、また、感染者の診療や検査に当たります最前線、医師、看護師、看護助手、検査技師な…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/7", "sentence": ["…、まだ引き続き弱さも見られるんではないかと思います。また、欧米では今感染者が再拡大しているという状況にございますから、そういう中で、我が国も…", "…者が再拡大しているという状況にございますから、そういう中で、我が国も感染者が増えているということを考えますと、仮にこういう状態が続いていきま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/9", "sentence": ["…うお話でございまして、こういうことを考えていきますと、また今それこそ感染者が増えているという状況を考えると、今後も引き続き警戒を緩めるわけに…", "…とが重要だと考えているところでございます。また、私が思うに、やはり、感染者や医療従事者を取り巻く社会的環境でございますが、これは差別や偏見も…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/20", "sentence": []}]}]}, {"date": "2021-03-05", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X00520210305/633", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00520210305/635", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00520210305/637", "sentence": ["…な方策も作ったわけでございます。そうはいっても、よく話に聞きますと、感染者の受入れは意外と、地方自治体の病院、本来感染症指定病院ではない病院…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00520210305/639", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00520210305/641", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00520210305/643", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00520210305/645", "sentence": []}, {"url