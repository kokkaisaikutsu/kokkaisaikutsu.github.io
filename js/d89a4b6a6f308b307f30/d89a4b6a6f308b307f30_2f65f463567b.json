[{"date": "2020-05-19", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/8", "sentence": ["…の法案では、指針を整備をして、ベンダーの信頼性などを確認した上で各種支援策を講じていくものと承知をしているところでありますが、あくまで振興法…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00720200519/22", "sentence": []}]}]}, {"date": "2021-06-03", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/5", "sentence": ["…コロナ禍の影響で厳しい状況にある企業に対し、持続化給付金を始め様々な支援策が講じられてきたところであります。今、政権が挙げてワクチン接種、努…", "…るところであります。こうした中、現在コロナ禍で苦境にある企業に対する支援策はどのような形で進められているのか、中小企業へのものも含め、お答え…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/21", "sentence": ["…応していただきたいと考えるところであります。次に、多様な中小企業への支援策について質問を進めてまいります。我が国企業の中で、企業数で見て九九…", "…あります。多様な中小企業を幾つかのパターンに分類し、それぞれに沿った支援策を講ずることは大変意義深いと考えるものであります。まずは、成長志向…", "…。今回の法改正案でも更にこれを充実しようとするものであります。改めて、こうした中小企業の規模拡大支援策の政策意図をお伺いをしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/23", "sentence": ["○高橋はるみ君次に、地域密着型企業支援策についてであります。中小企業の九割近くを占める小規模企業に着目をし、その社会経済的な役割を踏まえ、小…", "…雇用を支える重要な存在であり、地域社会、経済の安定的発展のため、その支援策を講ずることは大変重要であります。こうした観点から、今回の法改正に…", "…は大変重要であります。こうした観点から、今回の法改正によって措置された政策を含め、今後の地域密着型中小企業支援策の方向性を伺ってまいります。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/25", "sentence": ["…ところであります。こうした中、他の事業者と同様に、コロナ対策としての支援策も様々に行われてきたところであります。世の中には四百五十万人以上い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00820210603/30", "sentence": []}]}]}]