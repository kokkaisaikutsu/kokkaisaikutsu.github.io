[{"date": "2020-11-30", "meeting": [{"meeting_name": "参議院 行政監視委員会国と地方の行政の役割分担に関する小委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315352X00120201130/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315352X00120201130/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315352X00120201130/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315352X00120201130/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315352X00120201130/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315352X00120201130/13", "sentence": ["…分担と連携をしっかり進めていく形で制度を運営をしていく、そして更なる普及率の向上ということを図っていかなければならない課題であるというふうに…", "…記憶をいたしているところでございます。そういった中で、マイナンバーの普及率は今二〇％を少し超えるぐらいというふうにお伺いをいたしているところ…", "…うふうにお伺いをいたしているところでございますが、マイナンバー制度の普及率の向上、そしてそれと裏腹の関係にある利便性の向上、どういったところ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315352X00120201130/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315352X00120201130/17", "sentence": []}]}]}]