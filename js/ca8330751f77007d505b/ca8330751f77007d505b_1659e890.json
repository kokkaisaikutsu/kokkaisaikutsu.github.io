[{"date": "2020-11-27", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/59", "sentence": ["…御指摘のとおりだと思います。今後、芸術院会員の選考に当たりましては、外部の意見を適切に反映されるようにすることが望ましいため、会員候補者の推…", "…ため、会員候補者の推薦に当たっては、もともと規定があるわけですから、外部の意見が取り入れられるよう、日本芸術院に検討を求めてまいりたいと思い…", "…しかし、この二〇一五年の質疑から五年経過した今、なお、日本芸術院は、外部の意見を取り入れるかどうか検討中なんです。文化庁の説明によると、五年…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/61", "sentence": ["…わらず、五年も結論を出していない組織はあり得ません。本当のところは、外部の意見を取り入れると会員の既得権益が失われてしまうから、のらりくらり…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305124X00520201127/73", "sentence": []}]}]}]