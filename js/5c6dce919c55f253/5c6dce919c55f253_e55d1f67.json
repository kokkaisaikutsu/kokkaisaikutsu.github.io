[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/36", "sentence": ["…思います。関係する職場の方々も注目をしております建設業における適正な工期の設定に関してお伺いをさせていただきたいと思います。まず、中央建設業…", "…関してお伺いをさせていただきたいと思います。まず、中央建設業審議会の工期に関する基準の作成に関するワーキンググループで工期の基準についての検…", "…中央建設業審議会の工期に関する基準の作成に関するワーキンググループで工期の基準についての検討を進めていただいております。公共工事、民間を含め…", "…ております。公共工事、民間を含めて多種多様な建設工事が存在する中で、工期に関する基準の設定というのは極めて難しい検討であろうというふうに思う…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/38", "sentence": ["…が施行ということになりますので、この十月以降、現在検討いただいている工期の基準に照らして、著しく短い工期で下請契約を締結していると疑われる場…", "…この十月以降、現在検討いただいている工期の基準に照らして、著しく短い工期で下請契約を締結していると疑われる場合は、発注者、元請業者、下請業者…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/40", "sentence": ["…ども、現実問題、下請の立場で働いておられる方々の懸念とすれば、著しい工期と考えざるを得ないという状況が生じたとしても、果たしてこの仕組みを踏…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114080X00220200310/52", "sentence": []}, 