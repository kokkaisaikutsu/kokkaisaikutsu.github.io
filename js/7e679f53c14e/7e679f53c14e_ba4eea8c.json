[{"date": "2021-06-11", "meeting": [{"meeting_name": "衆議院 北朝鮮による拉致問題等に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/34", "sentence": ["…いかと率直に思っています。そこで、お伺いします。拉致問題の解決のための交渉は、通常の外交交渉なのか、むしろ人質奪還交渉なのか、お伺いしたい。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/36", "sentence": ["…くんですよ。その手が、外務省の人間が交渉するのか、誰が交渉するのか。人質奪還交渉ですよ。北朝鮮という国は、我々の常識とちょっと違うと私は思っ…", "…じゃないけれども、強烈に、彼らが分かる言葉を使わなければいけないと私は思っている。その上で、外務省は、今まで人質奪還交渉を経験していますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/38", "sentence": ["○松原委員警察は、人質奪還交渉というのはしたことはありますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/42", "sentence": ["○松原委員これは、人質奪還交渉であるという本質を考えたときに、交渉の現場に、私は、警察庁若しくは拉致対策本部の警察出身の人間が必ず同席をする…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405253X00320210611/50", "sentence": ["…原委員これで私は質問を終わりますが、本当に、これは外交交渉ではない、人質奪還交渉であり、朝鮮という国の体質を考えて、我々はその国と対話をする…"]}]}]}]