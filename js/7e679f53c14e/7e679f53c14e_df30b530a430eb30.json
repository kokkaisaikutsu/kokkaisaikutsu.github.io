[{"date": "2020-04-13", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/60", "sentence": ["○松原委員我々拉致議連も含めて、拉致、核、ミサイル、この問題は一括して解決ということを従来から言ってまいりました。ただ、ここまで来て、今、菅…", "…ように、有本さんのお母さんも亡くなった。また、アメリカは、北朝鮮のミサイルに関して、絶対的にこれを許さないという姿勢のようには必ずしも見えな…", "…ようには必ずしも見えない。私は非常に遺憾ではあるが、この拉致、核、ミサイル一括の解決によって、この拉致問題が、新しい安倍政権、六年経過して、…", "…問題だと思っておりますが、ここまで膠着している以上、大胆にこの核、ミサイルの問題と拉致問題は分離して扱うべきではないかということを明確に申し…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/62", "sentence": ["…ありますが、北朝鮮の核をなくすというこのことをやめるわけではない。ミサイルに対してもやめるわけではない。しかし、拉致は別枠にしてもうやるべき…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00220200413/82", "sentence": []}]}]}]