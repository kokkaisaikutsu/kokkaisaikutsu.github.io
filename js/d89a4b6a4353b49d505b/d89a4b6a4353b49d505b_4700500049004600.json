[{"date": "2020-04-14", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105254X01820200414/25", "sentence": ["○高橋千鶴子君宮本徹議員から、年金積立金管理運用独立行政法人、ＧＰＩＦが管理、運用する年金積立金の資産の安定的な運用の必要性についてお尋ねが…", "…のであることに特に留意し、専ら被保険者の利益のために行うというのがＧＰＩＦの基本姿勢であります。ところが、安倍政権になって以降、御指摘のよう…", "…の割合が高まったことで、損益の幅が非常に大きくなっています。また、ＧＰＩＦは、この四月に五年半ぶりに基本ポートフォリオを変更し、国内債券を一…", "…やしました。これにより、更に海外リスクが高まるとの指摘もあります。ＧＰＩＦは、約百六十兆円を運用する世界最大規模の機関投資家です。市場に与え…", "…、本法案では、年金積立金の資産の額に占める株式の構成割合について、ＧＰＩＦ設立時の株式の構成割合を参考に、おおむね二〇％を超えない範囲で定め…"]}]}, {"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/146", "sentence": []}]}]}]