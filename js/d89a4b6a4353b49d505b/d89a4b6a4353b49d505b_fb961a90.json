[{"date": "2020-06-03", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/143", "sentence": ["…て経産省に伺います。資料の一枚目、昨日の東京新聞の一面であります。「電通パソナなどに外注」と見出しがあります。持続化給付金を七百六十九億円で…", "…進協議会が、二十億円を残して七百四十九億円、ほぼ丸々だと思いますが、電通に再委託。さらに、パソナ、トランスコスモスに再々委託をしている。この…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/149", "sentence": ["○高橋（千）委員経産省が承認したのはどこまでですか。電通までですか。資料の２に全部その先の外注先も書いてありますが。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/157", "sentence": ["…千）委員微妙な言い方。二千九百人とおっしゃいましたよね。そうすると、電通ライブからその先もあるかもしれないということでしょうか。二千九百人、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01720200603/173", "sentence": []}]}]}, {"date": "2020-06-12", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612