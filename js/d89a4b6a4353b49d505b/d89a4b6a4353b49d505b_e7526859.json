[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第五分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/493", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/495", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/497", "sentence": ["…接種となっていますが、わずか二カ月後の六月十四日、健康局長通知で積極勧奨しないということになりました。あれから七年、ワクチンが世に出てからは…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/499", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/501", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/503", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/505", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/507", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/509", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/511", "sentence": ["…、さっき言った二〇一八年作成のリーフレット、この内容見直しについて検討を始めています。これは積極勧奨を再開したいためですか。大臣に伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/513", "sentence": ["…、日本医師会の常任理事である長島委員は、最も有効な方法は積極的な接種勧奨を再開することだと思います、こう言っていますね。この後のヒアリングで…", "…ね。この後のヒアリングで、十分な広報を行う中で、第一歩として、積極的勧奨の再開というところに向いていただくことを希望しますとはっきり言ってい…", "…治体にお任せしていたこのリーフレットを対象年齢のお宅に全戸配付するというわけでしょう。これは積極的勧奨と見られたって当たり前じゃないですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/515", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/517", "sentence": ["…で流れている情報などでは、全戸配付はする、しかし、ただし書きで積極的勧奨ではないと書くというふうなことで一応決着をしているというふうに聞いて…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/519", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/521", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/523", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105267X00120200225/525", "sentence": []}]}]}]