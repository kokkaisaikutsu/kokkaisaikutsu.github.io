[{"date": "2020-06-12", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/144", "sentence": ["…マンションの管理は区分所有者全員で当たるのが原則であり、その本人の自覚があるなしにかかわらず管理組合の一員となっている、その理由を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/146", "sentence": ["…際には居住しないけれども、投資目的でマンションを購入する方も少なくないと思います。こうした方も区分所有者として管理組合の一員であるか。一言。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/156", "sentence": ["…いく必要があるんじゃないか。中には投資目的の購入もあって、管理組合の一員だけれども誰も住んでいないということがふえていったときに何が起きるか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01820200612/166", "sentence": []}]}]}]