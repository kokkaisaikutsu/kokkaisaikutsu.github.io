[{"date": "2020-09-16", "meeting": [{"meeting_name": "参議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120214339X00120200916/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214339X00120200916/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214339X00120200916/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214339X00120200916/8", "sentence": ["…九日に本委員会が行いました令和二年七月豪雨による被害状況等の実情調査のための委員派遣につきまして、派遣委員の報告を聴取いたします。長峯誠君。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120214339X00120200916/10", "sentence": ["○委員長（杉久武君）以上で派遣委員の報告は終了いたしました。本日はこれにて散会いたします。午前十時三十四分散会"]}]}]}]