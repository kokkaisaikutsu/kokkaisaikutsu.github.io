[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200318/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200318/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200318/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200318/6", "sentence": []}]}, {"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/187", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/195", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/201", "sentence": ["…含めて、丁寧な御対応をいただければ幸いであります。続いて、国税職員の定員について質問をさせていただきます。本委員会でも度々取り上げられており…", "…ただきます。本委員会でも度々取り上げられておりますけれども、国税庁の定員というのはこの二十年間で、今、何とかこの下げ止まりはしておりますけれ…", "…備するためには、国税庁の職員の皆様、これが本当に要になってまいりますけれども、この国税庁の定員に対する見解を国税庁の方に伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/203", "sentence": ["○杉久武君定員を急に増やすことは難しいかもしれませんが、それ以上に、やはりこの人材育成というもの、先ほど大臣からも御指摘ありましたが、やっぱ…", "…税制を維持する生命線であると、このように思いますので、どうか今後とも定員、人員確保に御尽力いただきたいというふうに思います。さて、先ほどから…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/211", "sentence": []}]}]}]