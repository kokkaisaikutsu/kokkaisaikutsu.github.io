[{"date": "2021-01-28", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00120210128/103", "sentence": ["…次の事項について特段の配慮をすべきである。一、本法による大学に対する助成のための基金のような大規模かつ新たな仕組みを創設する際、補正予算で計…", "…において十分に審議ができるよう努めること。二、本法による大学に対する助成のための基金の創設に伴い、これまで措置されてきた運営費交付金や競争的…", "…講ずること。三、国立大学法人から寄託された資金の運用及び大学に対する助成に関する資金の運用については、その責任の所在を明確にするとともに、必…", "…率的な運用が着実に行える体制を構築すること。四、文部科学大臣が定める助成業務の基金の運用に関する基本指針については、運用開始当初は運用益の相…", "…れるよう、有識者等の意見を踏まえた十分な検討の上で定めること。また、助成対象となる大学の要件についても、世界レベルの研究基盤を構築する観点か…", "…を構築する観点から、公平性を担保しつつ、地方大学を含め、適切な大学に助成を行い、多くの若手研究者に十分な資金を配分できるよう、有識者等の意見…"]}]}]}]