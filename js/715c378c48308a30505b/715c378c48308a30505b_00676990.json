[{"date": "2020-10-08", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/19", "sentence": ["…ことでありますけれども。そして、文科省は最近、ＳＴＥＡＭ教育とか個別最適化とかいうんですが、ちょっとインターネットを御覧の皆様、このＳＴＥＡ…", "…もいるでしょう、あるいはどこかで引っかかっちゃっている子もいる。個別最適化、一斉授業じゃなくて、それぞれの個人の学びの保障、このためにも、先…", "…、このプロジェクトを考えていただきたいと思うんですが、このＳＴＥＡＭ教育、個別教育、個別最適化、和室づくりについて何かお考えがありましたら。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120214889X00120201008/29", "sentence": []}]}]}]