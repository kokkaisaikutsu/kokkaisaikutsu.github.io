[{"date": "2020-05-12", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/9", "sentence": ["○三宅伸吾君今の御説明は国内での話でございました。国際緊急援助隊の派遣に関する法律というのがございます。本年一月二十九日、参議院の予算委員会…", "…としている場合、当該国の政府又は国際機関の要請に応じ、政府は国際緊急援助隊を派遣できるとの内容の法律でございます。私の質問に対しまして、外務…", "…うふうに答弁をされました。そしてまた、この法律によりますと、国際緊急援助隊は、救助、医療、災害応急対策及び災害復旧のための活動ができるわけで…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/11", "sentence": ["○三宅伸吾君今、外務大臣よりまだ海外より援助の要請は来ていないという御答弁ございましたけれども、河野防衛大臣、準備の方はいかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01120200512/21", "sentence": []}]}]}]