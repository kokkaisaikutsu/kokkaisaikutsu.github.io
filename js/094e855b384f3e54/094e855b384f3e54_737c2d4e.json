[{"date": "2021-03-16", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/7", "sentence": ["…た観点から、国際政治学者でハーバード大学のグレアム・アリソン教授は「米中戦争前夜」という名著を出されておられます。台頭国が覇権国に挑む構図の…", "…という分析をしております。そこで、茂木外務大臣にお尋ねをいたします。米中間の衝突を避けるために、アメリカは中国のどのような分野のステータスを…", "…構築することができると茂木大臣はお考えでしょうか。そしてまた、日本は米中間の紛争リスク低減のためにどのようなことができるとお考えでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/9", "sentence": ["○三宅伸吾君岸防衛大臣にお聞きいたします。日本は米中間の紛争リスク低減のためにどのようなことができますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120413950X00220210316/31", "sentence": []}]}]}]