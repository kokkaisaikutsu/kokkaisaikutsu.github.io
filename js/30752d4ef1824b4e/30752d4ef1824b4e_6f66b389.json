[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/201", "sentence": ["…また快適に安全に歩いていただくために使ったり、そして観光とかそういう景観、そしてオリンピック、パラリンピックと、三カ年計画では大きく四つに分…", "…る、目標がある。そして、その次に実は前にずっと進めているのは、やはり景観であったり観光の分野です、先ほど申し上げたとおり。この無電柱化を進め…", "…そういう意味では、これまでのウエートというのはどちらかというと観光、景観。ですから、でき得れば、これから以降、観光はまたそういった予算をも活…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/209", "sentence": []}]}]}]