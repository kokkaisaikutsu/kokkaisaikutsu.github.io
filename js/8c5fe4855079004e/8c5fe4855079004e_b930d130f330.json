[{"date": "2021-04-09", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/147", "sentence": ["…よね。児童手当がこれだけ払われる見込みがあるから、将来の見通し、十年スパンの見通しが、家計が見通せるから、じゃ、産んでも大丈夫だという面がや…", "…いう意味で、こういう特例給付がぽつっと切られてしまうと、十年、二十年スパンで考えてこられている方もいらっしゃるわけですよ、やはりそういう面で…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/151", "sentence": ["…でしょうね。少なくとも、この一、二年とかということではなくて、五年、十年というスパンではこの特例給付が維持されるということでよろしいですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/153", "sentence": ["…いるわけです。少なくとも、来年、再来年にやめるということはなくて、五年、十年とか長いスパンで特例給付を維持されるということでよろしいですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/173", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/175", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/177", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/179", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/182", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X0