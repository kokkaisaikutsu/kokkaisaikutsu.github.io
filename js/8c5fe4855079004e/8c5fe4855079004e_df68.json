[{"date": "2020-04-15", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/64", "sentence": ["…ておりますが、平成元年以前の千平米以上の大規模建築物、これが約二十七万棟あるそうですが、これを優先して調査してきていると聞いております。ただ…", "…成十八年までの千平米未満の小規模建築物まで含めたものは全てで二百八十万棟あると聞いておりますが、この二百八十万棟に対するアスベスト調査は今後…", "…築物まで含めたものは全てで二百八十万棟あると聞いておりますが、この二百八十万棟に対するアスベスト調査は今後どのように進めていくのでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00920200415/70", "sentence": []}]}]}]