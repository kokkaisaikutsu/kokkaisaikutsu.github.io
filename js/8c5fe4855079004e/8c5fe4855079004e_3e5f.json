[{"date": "2021-06-04", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/107", "sentence": ["…もお伺いしておりますので、国家公安委員長に伺いたいと思います。まずは、弾丸の譲受け許可証というものを所轄の警察署で取得しないと弾が買えないわ…", "…ます。まずは、弾丸の譲受け許可証というものを所轄の警察署で取得しないと弾が買えないわけですけれども、東京都では即日に発行されるらしいんですね…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/111", "sentence": ["…有害鳥獣をやられている方からお伺いした話なんですけれども、ライフルは、弾六発、充填できるんですね。ところが、散弾銃は三発しか充填できないとい…", "…なんですけれども、ライフルは、弾六発、充填できるんですね。ところが、散弾銃は三発しか充填できないということが、銃砲刀剣類所持等取締法施行規則…", "…けれども、是非ここは、余り理由がない気がしますので、ライフル以外の銃も六発、弾を込められるようにしてはいかがと思いますが、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/113", "sentence": ["…にいかなくて、実際に出たという形にならないと容器から出せない、あるいは弾を装填できないというようなことになっていたそうでございます。去年の秋…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X03020210604/123", "sentence": []}]}]}]