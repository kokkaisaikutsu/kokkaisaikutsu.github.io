[{"date": "2021-02-08", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/8", "sentence": ["…ｏキャンペーンに期待をしている事業者は大変多いです。特に、ＧｏＴｏトラベル事業の早期の再開を望む声は、観光業を中心に大きいです。観光業は裾野…", "…は、観光業を中心に大きいです。観光業は裾野の広い業種です。ＧｏＴｏトラベルは、宿泊のみならず、交通、飲食、物販等の幅広い業種が助かっています…", "…交通事業者や物販の支援にはならないわけです。ですから、国のＧｏＴｏトラベルに期待をする声が大きいということなんだと思います。そこで、北陸とか…", "…定で始めることはできないのかということをお伺いしたいと思います。ＧｏＴｏトラベルの再開の時期と方法について、国交省の見解をお願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00620210208/26", "sentence": []}]}]}]