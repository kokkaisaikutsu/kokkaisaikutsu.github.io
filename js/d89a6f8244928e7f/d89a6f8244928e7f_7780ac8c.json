[{"date": "2020-05-26", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/216", "sentence": ["…、違法の、法的、法運用だと言わざるを得ません。検察は行政に属する組織ではありますが、検察官の職責について、森大臣の御認識をお聞かせください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/218", "sentence": ["…鉄美君今ありましたけれども、国公法の特例というだけじゃなくて、検察の職責あるいはその在り方、あらゆる司法権との関係ということがありました。ま…", "…ということがありました。まさに、今回、公正あるいは公平、その検察官の職責ということで、法と証拠に基づいて正義を実現するということなので、まさ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/220", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/222", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/224", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/226", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/228", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/230", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/232", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/235", "sentence": []}]}]}]