[{"date": "2021-04-15", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/99", "sentence": ["○寺田静君ありがとうございます。次に、流出防止のところですけれども、前回もちょっとお話をさせていただきましたが、業者の方にお伺いをすると、こ…", "…回収して産業廃棄物として出すとお金が掛かってしまうと。ここへの、流出防止策の徹底というところに何か環境省としてできることはないんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/105", "sentence": []}]}]}]