[{"date": "2020-05-28", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/115", "sentence": ["…林破壊などだけでもなくて、その生態系中の種の喪失というものが結果的に病原体の増加につながるという知見もあるというふうに聞いております。病原体…", "…に病原体の増加につながるという知見もあるというふうに聞いております。病原体の拡大を防ぐ緩衝機能を果たしていた一つの種が絶滅することで、本来で…", "…た一つの種が絶滅することで、本来であればその種が捕食をするはずだった病原体を運ぶ宿主、媒介生物が生き残った結果、健康被害を助長するといったよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/121", "sentence": []}]}]}]