[{"date": "2020-11-19", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314006X00220201119/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314006X00220201119/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314006X00220201119/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314006X00220201119/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314006X00220201119/128", "sentence": ["…いかなというところに思いを致しました。今、もちろん様々な教科の中で、国語、算数、理科、社会と、あと総合的な学習というものの中で環境というもの…", "…も、ただ、その環境ということを科目にして、その環境の科目の中でほかの国語、算数、理科、社会を学ぶということが私はもっと実際的なんではないかな…", "…ことを考えていく中で、もちろん様々資料に当たらなければなりませんし、国語はそこで学ぶと。基本的な科学的、理科の知識もなければいけない、もちろ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314006X00220201119/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314006X00220201119/132", "sentence": []}]}]}]