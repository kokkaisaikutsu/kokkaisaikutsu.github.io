[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/121", "sentence": ["…いの量出しているのかという、その量り方もすごく難しいんだと、いろんな指標があるんだというふうに事前のレクでも教えていただきましたけれども、そ…", "…り方をしっかり定めた上で、この十年間で、例えばこの十年と定めて、この指標でいけば二五％を減らしたんだということを二〇三〇年に言えるように、今…", "…らしたんだということを二〇三〇年に言えるように、今年を基準年と定めて、そしてその量る指標も定められませんでしょうか。大臣、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/123", "sentence": []}]}]}]