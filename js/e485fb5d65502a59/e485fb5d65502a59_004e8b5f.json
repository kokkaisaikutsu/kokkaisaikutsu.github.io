[{"date": "2022-02-04", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120804376X00220220204/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00220220204/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00220220204/122", "sentence": ["…巻委員コロナ禍でその対応に忙殺されている方も多いかと思います。今年も一律四月十五日にするのも選択肢かと思いますので、そちらの方の御検討もよろ…", "…控除について御質問させていただきます。二〇二〇年一月に、基礎控除は、一律三十八万円だったものから、段階的に減らしていくという制度に変わりまし…", "…労働意欲を減退させかねない現在の制度をどうお考えでしょうか。また、あるいは、基礎控除は一律のままでは駄目だったんでしょうか。お答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00220220204/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00220220204/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00220220204/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00220220204/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00220220204/132", "sentence": []}]}]}]