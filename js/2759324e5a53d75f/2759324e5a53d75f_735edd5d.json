/120104080X01520200603/179", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01520200603/181", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01520200603/183", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01520200603/185", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01520200603/187", "sentence": ["…階において、極めて重要な役割を果たしていると思われるのは、やはりこの平川さんです、元電通の業務執行理事Ａ。これは、業務執行理事にこの四月七日…", "…いろいろありますけれども、そこに既に業務執行理事と書かれていますよ、平川さん。別に四月七日に業務執行理事になったわけじゃないんです。その説明…", "…ものだから、委員長、この一連の経緯は、全てを知っていると思われるこの平川さんにこの委員会に来てもらって、詳細を語ってもらわないとよくわからな…", "…会に来てもらって、詳細を語ってもらわないとよくわからないと思います。平川さんのこの委員会への参考人招致をお願いします。お取り計らいください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01520200603/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01520200603/191", "sentence": []}]}]}, {"date": "2020-06-12", "meeting": [{"meeting_name": "衆議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104080X01620200612/40", "sentence": []}, {"url"