[{"date": "2020-03-19", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/201", "sentence": ["…です。だから、今の減収分反映するのがそうなる。このままではやっぱり運転資金不足にも陥る医療機関がこれ続出しかねないと。融資で対応するという提…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/203", "sentence": ["…けれども。ところが、医療機関は通常でさえ過半数は赤字ということで、運転資金そのものを今でも銀行から借り入れてやりくりしているというところがあ…", "…体制を確保し、そして維持する、そのためには、やっぱり貸付けと違うて運転資金を全額入れるということをしっかりやるべきじゃないかと思うんですよ。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00420200319/213", "sentence": []}]}]}]