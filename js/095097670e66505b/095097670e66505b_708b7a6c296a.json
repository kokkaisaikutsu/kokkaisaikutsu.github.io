[{"date": "2020-05-29", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X02020200529/18", "sentence": ["…医療法人、株式会社等営利法人なども社員となることができますが、総会の議決権は定款に委ねられております。地域における影響力、規模などにより、行…", "…に委ねられております。地域における影響力、規模などにより、行使できる議決権の数に差を付けることもできるのですか。大規模法人等が多数を占め、連…"]}]}]}, {"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/204", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/206", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/208", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/210", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/212", "sentence": ["…だと私も聞いていて思いました。改めて確認したいと思うんですね。総会の議決権というのは、これ定款に委ねられることになるわけですが、社員である社…", "…とになるわけですが、社員である社会福祉法人は、規模にかかわらず一個の議決権を持つことができると、これが原則だと説明されているんですが、これ実…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/214", "sentence": ["…うな場合に、あり得るという説明があったので確認したいんですけれども、議決権を各一個としない、こういうことできるのかということと、定款で地域福…", "…できるのかということと、定款で地域福祉への貢献度とか施設の規模などによって議決権に差を付けると、こういうこと可能にはならないのか、確認です。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/216", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/218", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/220", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/222", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/224", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/226", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/288", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01720200604/290",