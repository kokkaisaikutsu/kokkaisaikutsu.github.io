[{"date": "2021-04-16", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X01620210416/21", "sentence": ["…のではありませんか。医師は、医師である前に一人の労働者であり、一人の人間です。医師の人権を守るとともに患者の安全を守るために、労働時間の上限…", "…規制はせめて他の職種と同水準とすべきです。異常な働き方を改め、医師が人間らしく働ける本当の働き方改革を求めて、質問を終わります。（拍手）〔国…"]}]}, {"meeting_name": "参議院 議院運営委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414024X02120210416/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414024X02120210416/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414024X02120210416/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414024X02120210416/51", "sentence": []}]}]}]