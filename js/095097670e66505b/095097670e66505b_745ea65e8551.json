[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/320", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/322", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/324", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/326", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/328", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/330", "sentence": ["…たい。十一月二十八日の日経新聞読みました。そうしたら、ワクチン接種、年度内目指すと大きい見出しで出ていまして、厚労省は海外でのワクチン実用化…", "…まして、厚労省は海外でのワクチン実用化の状況をにらみつつも、国内でも年度内の接種開始を想定して準備を進めていると、想定ということで出ていまし…", "…も、国内の治験結果もまだ出ていないという状況だし、申請する時期も定かでないと。なぜ年度内の接種開始ということなのか。どういうことでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/332", "sentence": ["…験の結果が出る前から、来年前半には国民全員分のワクチンを確保するとか年度内接種の話出てくるんですよね。総理は、Ｇ20ですか、地域首脳会議とい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/334", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/336", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/338", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00620201201/340", "sentence": []}]}]}]