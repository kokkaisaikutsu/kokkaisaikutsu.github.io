[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/94", "sentence": ["…論を進めていきたいと思うんです。これ、水俣湾周辺だけでなく、汚染された魚介類が、水俣そして芦北地域、いわゆる山間部まで流通していた。鹿児島県…", "…北地域、いわゆる山間部まで流通していた。鹿児島県の伊佐市などへも行商で魚介類が運ばれて、大量に流通していたと、食べていたということが明らかだ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/96", "sentence": ["…でないんですね。なぜか。地域外の申請者は、一九六八年以前に水俣湾周辺の魚介類をたくさん食べていたと、この事実の立証が必要になるんですよ。もう…", "…ん食べていたと、この事実の立証が必要になるんですよ。もう何十年も前の、魚を買った領収書なんていうのは残っていないし、行商の方、もう生きておら…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00320200318/106", "sentence": []}]}]}]