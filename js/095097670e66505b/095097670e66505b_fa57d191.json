[{"date": "2021-06-08", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/216", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/218", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/220", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/222", "sentence": ["…これ実は企業ともずうっと交渉を重ねてこられております。そうした中で、基金制度の創設を繰り返し求める中、主要建材メーカー十一社については、これ…", "…立を受けた後、国は、この検討を表明するとしていた十一社に対して改めて基金制度への参加、正式に求めるべきではないかと思いますが、いかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/224", "sentence": ["○倉林明子君その経産省が全然頼りなくて、本当にその補償、基金の参加に積極的に参加してくれということでの働きかけになっているとはちょっと受け止…", "…ます。判決受けてその変化もあるだろうと思うんだけれども、一回きちんと基金に参加するようにということを政府として求めたらどうかということについ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/226", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/228", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/230", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/232", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/234", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/236", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/238", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/240", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/252", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/254", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/256", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/258", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X02320210608/260", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/1204142