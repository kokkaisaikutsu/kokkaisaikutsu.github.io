[{"date": "2021-04-05", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/268", "sentence": ["…ると。こうした背景に、これ国民に自粛を要請する中で、総理を始めとした政治家、これ相次いだ会食、緊急事態宣言下での飲食等がありました。パネルを…", "…りました。パネルを用意しております。（資料提示）総理、これ、こうした政治家の飲食等について、今回の事案に対する影響はなかったと言えるんでしょ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/270", "sentence": ["…子君いや、私、影響がなかったとは言えないんじゃないかと思うんですね。政治家が率先してこれ自粛破り、先にやっていたんですよね。で、官僚にも国民…", "…すよね。で、官僚にも国民にも、自粛要請してもこれ協力してもらえないと、こうした要因を政治家自らがつくっていると、こういう認識はありませんか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/272", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/274", "sentence": ["○倉林明子君総理、政治家としていかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/276", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/278", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/280", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/282", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/284", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/286", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/288", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/290", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/292", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00120210405/294", "sentence": []}]}]}]