[{"date": "2021-04-21", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/152", "sentence": ["…力があったら、その資格を取り上げることで、それを起こさせないような抑止効果を発生させるという両面で、私は後者の方が今回のハラスメントとか暴力…", "…けれども、そういった、スポーツ指導におけるそういう資格制度における抑止効果なんかを及ぼしていくというアイデア、又はそういう意見について御見解…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405124X01220210421/154", "sentence": ["…というのは、議論、設計はいろいろ考えられると思うんですが、そういう抑止効果を及ぼせるような、特に学校現場において、今後、部活動改革も進んでい…"]}]}]}]