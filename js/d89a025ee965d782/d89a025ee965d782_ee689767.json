[{"date": "2020-02-13", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105254X00620200213/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105254X00620200213/14", "sentence": ["…された職員人件費に対して地方財政措置を講ずることとしています。次に、森林環境譲与税についてお尋ねがありました。今般の税制改正では、災害防止、…", "…した。今般の税制改正では、災害防止、国土保全機能強化などの観点から、森林整備を一層促進するため、地方公共団体金融機構の公庫債権金利変動準備金…", "…しで増額することにしています。これを受け、地方団体が喫緊の課題である森林の整備をより一層推進することで、森林の有する公益的機能の維持増進が図…", "…受け、地方団体が喫緊の課題である森林の整備をより一層推進することで、森林の有する公益的機能の維持増進が図られ、地球温暖化防止や災害防止などに…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105254X00620200213/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105254X00620200213/28", "sentence": []}]}, {"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00320200213/99", "sentence": []}]}]}, {"date": "2020-02-20", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/60", "sentence": ["○高市国務大臣森林環境譲与税につきましては、今年度から地方団体に譲与を行い、森林の整備に取り組んでいただいております。さらに、今般の税制改正…", "…務大臣森林環境譲与税につきましては、今年度から地方団体に譲与を行い、森林の整備に取り組んでいただいております。さらに、今般の税制改正で、災害…", "…さらに、今般の税制改正で、災害防止、国土保全機能強化などの観点から、森林整備を一層促進するために、地方公共団体金融機構の公庫債権金利変動準備…", "…としておりますので、しっかり、各地方団体におかれましては、この増額の趣旨も踏まえて、森林整備などを一層推進していただきたいと考えております。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/130", "sentence": ["○高市国務大臣森林環境譲与税の譲与基準につきましては、法律上の使途と相関が高い指標として定めております。法律上の使途に森林の整備というものが…", "…は、法律上の使途と相関が高い指標として定めております。法律上の使途に森林の整備というものが入っておりますので、私有林人工林面積五割、それから…", "…増加が重要であるということと、都市部の住民の皆様を含めて、国民全体の森林環境税への理解が必要であるということなどを総合的に勘案して、まずは木…", "…れは、昨年の三月に衆参の総務委員会でも附帯決議をいただいております。森林環境譲与税を財源とした各地方団体の森林整備の取組や施策の実施状況を見…", "…附帯決議をいただいております。森林環境譲与税を財源とした各地方団体の森林整備の取組や施策の実施状況を見きわめて検討してまいりたいと存じます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/138", "sentence": []}, {"url": "https://kokkai.ndl.go