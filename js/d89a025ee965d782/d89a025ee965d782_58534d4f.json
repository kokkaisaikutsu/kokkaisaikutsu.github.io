url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00820200326/123", "sentence": []}]}]}, {"date": "2020-04-28", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X02020200428/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02020200428/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02020200428/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02020200428/96", "sentence": []}]}, {"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/18", "sentence": ["…、家計への支援をその趣旨としておりますので、定額給付金と同様に、世帯単位で給付することとしました。具体的には、居住と生計をともにする社会生活…", "…付することとしました。具体的には、居住と生計をともにする社会生活上の単位である住民基本台帳法の世帯を単位として給付をし、また、申請及び受給は…", "…、居住と生計をともにする社会生活上の単位である住民基本台帳法の世帯を単位として給付をし、また、申請及び受給は、その世帯を主宰する者である世帯…", "…その世帯を主宰する者である世帯主が行うことといたしました。仮に、世帯単位ではなく個人単位で受給を受け付けるということにした場合に、受給者が著…", "…る者である世帯主が行うことといたしました。仮に、世帯単位ではなく個人単位で受給を受け付けるということにした場合に、受給者が著しく増加をいたし…", "…け付けるということにした場合に、受給者が著しく増加をいたします。個人単位で別々の銀行口座などに振り込む必要が生じることから、市区町村に過大な…", "…、迅速な給付を行うことにも支障が生じることが想定されます。また、個人単位とした場合に、乳幼児まで全ての人が一人ずつ給付を受けるということにな…", "…そしてできるだけ市区町村の事務負担を減らすということを優先させていただきました。そこで、世帯単位で世帯主に給付する方法を適切といたしました。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01520200428/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/1201