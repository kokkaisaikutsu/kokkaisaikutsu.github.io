[{"date": "2020-06-05", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X02220200605/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115254X02220200605/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115254X02220200605/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115254X02220200605/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115254X02220200605/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115254X02220200605/22", "sentence": ["…え、政府としては真摯に対応すべきものと考えております。次に、公文書の隠蔽や破棄が行政監視に妨げになるのではないかとのお尋ねがございました。行…", "…存が行われる必要があります。一般論として申し上げると、公文書の違法な隠蔽や破棄が行われれば、行政監視における事例や事案の確認に支障が生ずる可…"]}]}, {"meeting_name": "参議院 政治倫理の確立及び選挙制度に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114578X00220200605/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114578X00220200605/11", "sentence": []}]}]}]