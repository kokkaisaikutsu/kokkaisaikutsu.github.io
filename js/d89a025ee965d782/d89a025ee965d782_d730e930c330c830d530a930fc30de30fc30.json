[{"date": "2020-04-07", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/99", "sentence": ["…で、令和三年度要求に向けて検討してまいりたいと存じます。また、プラットフォーマー規制が入らなかったということですが、もちろん、製造業者、輸入…", "…うことですが、もちろん、製造業者、輸入業者、販売業者に加えて、プラットフォーマーにおいても適切な取組は必要でございます。昨年、総務省の有識者…", "…。昨年、総務省の有識者会議で御検討いただきましたところ、複数のプラットフォーマーから取組を強化する旨の表明がございましたので、まずは、プラッ…", "…ォーマーから取組を強化する旨の表明がございましたので、まずは、プラットフォーマーの自主的な取組を促すということが適当だと考えられました。ただ…", "…、今後、総務省としては、製造業者、輸入業者、販売業者に加えて、プラットフォーマーも含めたガイドラインを策定して、各社に求められる取組を明確化…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01320200407/148", "sentence": []}]}]}]