[{"date": "2021-12-13", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/20", "sentence": ["…から、自衛隊は現地の空港から外には出られません。派遣された自衛隊員は武器を携行しておりましたけれども、自力で逃げてきた方を安全に輸送機に導く…", "…と、また、ハイジャックなどから機体を守る、人を守る、こういったことに武器使用が限定されていたと承知をしております。仮に、空港に向かう途中の日…", "…す。仮に、空港に向かう途中の日本人が襲撃されたとしても、空港外に出て武器を使うことはできませんので、なかなかこれは難しい派遣だったなと思いま…", "…邦人等を陸上輸送し、この保護任務の実施を妨害する行為を排除するための武器使用というのは認められています。ただし、この保護措置の実施には、第一…", "…を現地の当局が確保し、戦闘行為が行われていることがないこと、第二に、武器使用を含む自衛隊の活動について、領域国が同意していること、第三に、当…", "…安全が確保されて、戦闘行為が行われることがない地域であれば、自衛隊が武器を携行して日本人を助けに行く必要はございません。むしろ、危険な地域、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120705261X00220211213/33", "sentence": []}]}]}]