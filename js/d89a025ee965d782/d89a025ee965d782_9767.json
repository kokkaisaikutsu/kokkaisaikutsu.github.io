[{"date": "2020-02-20", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/60", "sentence": ["○高市国務大臣森林環境譲与税につきましては、今年度から地方団体に譲与を行い、森林の整備に取り組んでいただいております。さらに、今般の税制改正…", "…務大臣森林環境譲与税につきましては、今年度から地方団体に譲与を行い、森林の整備に取り組んでいただいております。さらに、今般の税制改正で、災害…", "…さらに、今般の税制改正で、災害防止、国土保全機能強化などの観点から、森林整備を一層促進するために、地方公共団体金融機構の公庫債権金利変動準備…", "…としておりますので、しっかり、各地方団体におかれましては、この増額の趣旨も踏まえて、森林整備などを一層推進していただきたいと考えております。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/130", "sentence": ["○高市国務大臣森林環境譲与税の譲与基準につきましては、法律上の使途と相関が高い指標として定めております。法律上の使途に森林の整備というものが…", "…は、法律上の使途と相関が高い指標として定めております。法律上の使途に森林の整備というものが入っておりますので、私有林人工林面積五割、それから…", "…おります。法律上の使途に森林の整備というものが入っておりますので、私有林人工林面積五割、それから、法律上の使途として人材の育成及び確保という…", "…す。法律上の使途に森林の整備というものが入っておりますので、私有林人工林面積五割、それから、法律上の使途として人材の育成及び確保ということで…", "…面積五割、それから、法律上の使途として人材の育成及び確保ということで、林業就業者数二割、普及啓発、木材利用ということで、今御指摘の人口三割と…", "…増加が重要であるということと、都市部の住民の皆様を含めて、国民全体の森林環境税への理解が必要であるということなどを総合的に勘案して、まずは木…", "…れは、昨年の三月に衆参の総務委員会でも附帯決議をいただいております。森林環境譲与税を財源とした各地方団体の森林整備の取組や施策の実施状況を見…", "…附帯決議をいただいております。森林環境譲与税を財源とした各地方団体の森林整備の取組や施策の実施状況を見きわめて検討してまいりたいと存じます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/237", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/244", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/249", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/251", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/255", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/257", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/259", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/263", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/265", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/267", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/271", "sentence": []}]}]}, {"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第二分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105272X00120200225/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/1