[{"date": "2021-05-14", "meeting": [{"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415328X01020210514/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01020210514/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01020210514/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01020210514/30", "sentence": ["…ございますが、その点をある程度明らかにしていただきたいと思いますが、これ、実際に刑法を執行する警察庁にお聞きしたいと思います。お願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01020210514/32", "sentence": ["○藤末健三君では、警察庁にちょっとお聞きしたいんですけれど、先ほど法務省の方から、所管するその省庁が判断してやるということをおっしゃったわけ…", "…すけれど、先ほど法務省の方から、所管するその省庁が判断してやるということをおっしゃったわけですが、その点はいかがですか、警察庁として見解は。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01020210514/34", "sentence": ["…管を考えますと内閣府の知的財産事務局になるわけですけど、そこら辺で議論すればいいというふうに理解すればよろしいですか。警察庁にお聞きします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01020210514/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01020210514/38", "sentence": []}]}]}, {"date": "2021-05-28", "meeting": [{"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415328X01220210528/5", "sentence": ["…大会の、失礼しました、世界大会の実施を進めるべきと考えておりますが、警察庁として、関連省庁との、その事業者や自治体との連携を通してルール作り…", "…というようなルール策定をやっていただくということでどうかということで、ちょっと警察庁のスタンスをお聞きしたいと思いますが、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01220210528/7", "sentence": ["…、ゲームセンター営業に言うスロットマシン、テレビゲーム機その他遊技設備に該当しないというふうに考えますが、警察庁のお考えをお聞かせください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01220210528/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01220210528/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01220210528/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01220210528/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01220210528/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01220210528/19", "se