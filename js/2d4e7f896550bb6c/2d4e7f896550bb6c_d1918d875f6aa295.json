[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/13", "sentence": ["…ます。今大臣がおっしゃられた通知、通達、金曜日の時点で改めて政府系金融機関及び民間金融機関に対して、条件変更等に柔軟に応じること、そしてどれ…", "…っしゃられた通知、通達、金曜日の時点で改めて政府系金融機関及び民間金融機関に対して、条件変更等に柔軟に応じること、そしてどれだけ応じたのかと…", "…末迎えますので、金融庁の方にはやはり、財務省もですね、こうした公的金融機関、民間金融機関がどれだけ対応しているのかということをしっかり見てい…", "…、金融庁の方にはやはり、財務省もですね、こうした公的金融機関、民間金融機関がどれだけ対応しているのかということをしっかり見ていていただきたい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/29", "sentence": []}]}]}, {"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/10", "sentence": ["…なこともあって移りやすくなるということも当然あると思うので、日本の金融機関の評価は余り高くないようでございますけど、海外のファンドとか、やは…", "…余り高くないようでございますけど、海外のファンドとか、やはり海外の金融機関とか、これも呼んでくるということは、これは十二分にやりやすい環境が…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/12", "sentence": ["…の改正によって金融サービス仲介業というものが創設をされます。特定の金融機関の下に付くという形ではなくて、金融機関と仲介業者が言わば対等な関係…", "…ものが