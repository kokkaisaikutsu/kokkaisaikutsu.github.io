[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/21", "sentence": ["…て、そして東証の中間報告というのも二月に出ております。今の、市場区分に関しての今回の改革案について、金融庁、説明していただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/27", "sentence": ["…、これはちょっとこれだけ言わせていただいて。最後に麻生大臣に、この東証改革についてどのようにお考えになっているのか、お伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/29", "sentence": ["○中西健治君どうもありがとうございました。ＴＯＰＩＸのインデックスの改革についてもお伺いしようと思っておりましたけれども、また次回以降に譲り…"]}]}]}, {"date": "2021-05-20", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415104X01320210520/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01320210520/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01320210520/44", "sentence": ["…います。あと、もう一つ言われていることとして、やはり教職員の働き方の改革、これも進めていく必要があるんじゃないかというふうに思っているところ…"]}]}]}]