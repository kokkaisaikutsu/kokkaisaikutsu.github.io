[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/150", "sentence": ["…ネギとかレタス、この野菜をカット野菜にして加工、製造、販売をして六次産業化を進めるということでございました。特に、このローカル一万プロジェク…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/152", "sentence": ["…ターは、生産から加工、製造、そして流通、販売まで一体的に取り組む六次産業化を目指した事業でございました。西条市もこの総合六次産業都市を目指し…", "…化、差異化を目指しているようでございました。農水省においてはこの六次産業化についてどのように推進をされているのか、お聞きをしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00320200310/166", "sentence": []}]}]}]