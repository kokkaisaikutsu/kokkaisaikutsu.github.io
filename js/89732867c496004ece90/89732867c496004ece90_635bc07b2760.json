[{"date": "2021-06-01", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/140", "sentence": ["…すが、私は、海域という、どこでやるのかという海域ごとの違いと同時に、季節性ですね、例えば、冬場のノリの養殖で、ゴールデンウィークぐらいまでや…", "…厳しめにするとか。海域ごと、湾ごと、灘ごとに加えて、もう一つの軸は、季節性をしっかり入れながら管理していく、モニタリングしていくということも…", "…と思いますので、そういった観点も是非入れていただいて、地域性あるいは季節性、これに応じた適切な管理が行えるように是非取り組んでいただきたいな…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/152", "sentence": []}]}]}]