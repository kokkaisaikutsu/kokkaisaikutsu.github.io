[{"date": "2020-11-04", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/474", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/476", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/478", "sentence": ["…思います。次に、菅内閣の看板政策の一つについて聞きます。不妊治療の保険適用です。私も、これは五年ぐらい前からずっと言っていますから、ぜひ進め…", "…進めてもらいたいと思うんですが、一つ提案があります。この不妊治療の保険適用に取り組むときにあわせて検討してもらいたいのが、妊孕性の保存につい…", "…んということに頭が及ばない。ただ、もしきちんとした補助とか助成とか保険適用があれば、こういった世代の方も希望を持つことができると思うので、こ…", "…、広い意味での未来への不妊治療だということで捉えて、あわせて今回、保険適用できるかどうかの検討対象に加えるべきだと思いますが、総理、いかがで…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/480", "sentence": ["…十年と検討されないと思うので、ぜひ総理、菅総理がせっかく不妊治療の保険適用ということを掲げたわけだから、こういう余りこれまで政治的な課題にも…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/482", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/484", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/486", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/488", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/491", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/493", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/495", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/497", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/499", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/501", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/504", "sentence": []}]}]}]