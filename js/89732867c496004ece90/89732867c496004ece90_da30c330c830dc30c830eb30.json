[{"date": "2021-06-01", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/144", "sentence": ["…香川県内のごみって三種類なんですよ、上からいうと。一位が飲料用のペットボトル、二番目がそのキャップ、三番目が実はカキの養殖用のパイプなんです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/146", "sentence": ["…取り組んでいっていただきたいなと思います。先ほど申し上げたごみのペットボトルなんですね、大臣も今お飲みになっていますけれども、自分で水をくん…", "…ますよということを、オアシスマップということを作成して、根本的にペットボトルを減らしていきましょうということをそういう意味でも支援をしていま…", "…のがあるんです。こういうものを積極的に推進していくことによって、ペットボトルを、あるいは結果としてはごみになっていくということを減らしていけ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/152", "sentence": []}]}]}]