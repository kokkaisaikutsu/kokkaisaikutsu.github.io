[{"date": "2020-11-04", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/474", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/476", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/478", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/480", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/482", "sentence": ["…変わると思いますね。カリフォルニアなんかはもともと強いですけれども、ＥＶ車にシフトもどんどん進むのかなと思います。ちょっと資料一を見ていただ…", "…ドもこういう目標を定めてやっているんですね。日本はない。一方の、このＥＶの、電気自動車の購入支援等々を見ていただくとわかるんですが、結構やっ…", "…つまり、コロナを受けてぐっと拡充しています。日本は今、一応あります、ＥＶの購入補助とか。最大四十万円ぐらいで、あと、これに取得時の免税措置が…", "…、年末の税制改正とか、与党の先生もぜひ、せめてドイツ、フランス並みのＥＶ購入補助にしないと競争力の観点から問題になるので、総理、二〇五〇年、…", "…るので、総理、二〇五〇年、せっかく目標をつくったんだから、せめてこのＥＶの支援については百万を超えるぐらいの購入補助にしませんか。いかがです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/484", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/486", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/488", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/491", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/493", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/495", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/497", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/499", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/501", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305261X00320201104/504", "sentence": []}]}]}]