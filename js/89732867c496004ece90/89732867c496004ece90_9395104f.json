[{"date": "2021-03-17", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/118", "sentence": ["…に、法案の中身に入りたいと思います。同僚議員からも質問がありました。間伐の面積が近年減少しているということなんですけれども、確かに、第二約束…", "…、森林吸収源というのをどれだけ想定するのか。それを実現する手段として間伐だ造林だとあるんですが、この二〇五〇年までのカーボンニュートラルを実…", "…二〇五〇年まで、どういう森林吸収量の目標を持っているのか、そのための間伐面積の目標と造林面積の目標を少なくとも、政府として目標を掲げたんだか…", "…す責任があると思います。改めて伺います。二〇五〇年のカーボンニュートラルの達成に向けた間伐面積の目標値をどのように政府として捉えていますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00320210317/128", "sentence": []}]}]}]