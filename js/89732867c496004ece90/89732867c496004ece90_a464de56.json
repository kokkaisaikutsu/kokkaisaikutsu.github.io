[{"date": "2020-02-26", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/350", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/353", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/355", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/357", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/360", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/364", "sentence": ["…いませんでしたので、同じ解釈を引き継いでいるとは言わないですよ。後で撤回されていましたけれども、かわいそうですよ。私は人事院はむしろ被害者だ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/367", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/370", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/372", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/374", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/376", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/381", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/383", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/385", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/389", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/391", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/397", "sentence": ["○玉木委員では、これを撤回されるんですか。過去の、一九八一年、昭和五十六年の政府見解をいつ知ったんだと聞かれたときに対して、二月十九日、人事…", "…八一年、昭和五十六年の見解を知ったときではなくて、勘違いで答えた。また勘違い。これは撤回されますか、では、森大臣、ここを。（発言する者あり）"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/400", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/402", "sentence": ["…過去の政府見解について知った時期について答えた二つの答えは、両方とも撤回するということでいいですか。明確に答えてください。（発言する者あり）"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/405", "sentence": ["…びはされたんですね、間違った答弁をしたということはおわびをされたんですが、議事録から削除する必要があると思いますので、これは撤回されますね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/409", "sentence": ["○玉木委員ということは、撤回しない、このままということで、これからの議論を進めていいわけですね。撤回されないということですね、では、逆に言う…", "…木委員ということは、撤回しない、このままということで、これからの議論を進めていいわけですね。撤回されないということですね、では、逆に言うと。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/411", "sentence": ["○玉木委員いや、だから、どちらですか。撤回するのか、しないのか。（発言する者あり）"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/415", "sentence": ["…閣僚席は特にお願いします。ちょっと、よくわかりません。人事院は答弁を撤回し、だって、法務大臣というのは法をつかさどる一番の大臣じゃないですか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/417", "sentence": ["…今の安倍政権の現状になっていることを憂えています。一回これは、総理、撤回をして、もう一回解釈の整理や過去の立法意思の確認もした上で、もう一度…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/419", "sentence": ["…、きちんと公務員としてのプライドを持って仕事をしてこられた方に答弁を撤回させたりするような政治であってはならない、そのことを改めて申し上げた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/421", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/425", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/429", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/436", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/439", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01620200226/441", "sentence": []}]}]}]