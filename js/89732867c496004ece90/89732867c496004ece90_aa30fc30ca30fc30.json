[{"date": "2020-04-29", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/8", "sentence": ["…二〇二一年度、来年度ですよ。来年度の固定資産税から。しかも、これはオーナーのメリットですから、テナントはメリットを受けないわけです、直接的に…", "…ントはメリットを受けないわけです、直接的には。今、国交大臣からも、オーナーさんに対しては、なるべく減免してくれという要請はしていますが、あく…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/10", "sentence": ["…聞いているんですよ。国交大臣が文書で出して、ちゃんと、苦しいから、オーナーさんあるいは大家さん、減免してくださいという要請を出していますよ、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/12", "sentence": ["…何人いるかをやはり調べないと対策は打てないんですよ。実は、不動産のオーナーさんというのは、多分、テナントさんは一回も会ったことのない人が多い…", "…。十年、二十年契約していても、仲介業者とは顔を合わすんだけれども、オーナーさんというのは、出てきてくださいといって、出てこないし、会わないん…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02120200429/26", "sentence": []}]}]}]