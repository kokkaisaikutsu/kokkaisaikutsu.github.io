[{"date": "2020-05-26", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/150", "sentence": ["…ージャンであって高額ではないという話であります。私は賭けマージャンは賭博だと思っておりますが、刑事局長は、賭けマージャンは賭博という認識はな…", "…高額ではないという話であります。私は賭けマージャンは賭博だと思っておりますが、刑事局長は、賭けマージャンは賭博という認識はないんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/152", "sentence": ["…〇六年十二月八日、私は質問主意書を出しているんです。賭けマージャンは賭博に該当するか。賭けルーレットは賭博に該当するか。内閣の答弁は、財物を…", "…出しているんです。賭けマージャンは賭博に該当するか。賭けルーレットは賭博に該当するか。内閣の答弁は、財物を賭けてマージャン又はいわゆるルーレ…", "…ャン又はいわゆるルーレットゲームを行い、その得喪を争うときは、刑法の賭博罪が成立し得るものと考えられる。これが政府の閣議決定での答弁でありま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/157", "sentence": ["…質問しているわけだから、一般論も何も要らぬから、私の聞いていることにストレートに答えてくれよ。賭博かどうかということをきちっと答えなさいよ。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/160", "sentence": ["○鈴木宗男君刑事局長、最後確認しますけれども、黒川さんが行った行為は、刑法は別にして、賭博であることは、じゃ認めますね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00820200526/164", "sentence": []}]}]}, {"date": "2020-05-28", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00920200528/55", "sentence": []}, {"ur