[{"date": "2021-12-17", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/298", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/300", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/302", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/304", "sentence": ["…な問題として取り上げられました文書通信交通滞在費であります。これ、財務大臣にお伺いしますけど、予算は参議院、衆議院、院が財務省の事務方と協議…", "…てまとめられますね。この文書通信交通滞在費、北海道も沖縄も東京も一律百万円なんです。これは公平でしょうか。財務大臣、どういうお考えでしょう。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/306", "sentence": ["○鈴木宗男君財務大臣、その百万円、これ、たまたま立法府が出すものですから、財務省の事務方、旧大蔵省の時代から手付けないんですよ。それで、議運…", "…よ、無駄をなくしましょうという感覚で切り込まないかということを私は財務大臣に聞いているんですね。そこで、大臣、これ時間ありませんから、これだ…", "…しをすれという声なんですよ。その声に寄り添うのが私は政治だと思うんです。そのことを強く財務大臣にお願いしたいんですけれども、いかがでしょう。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/308", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/310", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/312", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/314", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/316", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/318", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/320", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/322", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/324", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/326", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/328", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/330", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/332", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X0022021