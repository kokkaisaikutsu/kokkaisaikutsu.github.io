[{"date": "2020-04-07", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00520200407/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00520200407/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00520200407/9", "sentence": ["…める一時免税通関書類というものの発給事業というものを、これを日本商工会議所からの委託に基づいて行っているのであります。こちらのカルネの収益と…", "…と思います。そしてまた、ＪＣＡＡにカルネ発給事業を委託している日本商工会議所は経産省の所管の法人でありますので、経産省からも見解を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00520200407/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00520200407/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00520200407/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00520200407/18", "sentence": []}]}]}]