[{"date": "2021-04-15", "meeting": [{"meeting_name": "衆議院 憲法審査会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404183X00120210415/52", "sentence": ["…民の生命と財産を守るために、諸外国の憲法では、当然、緊急事態に備えた規定があります。緊急の対応が必要であるにもかかわらず、国会が機能しないと…", "…存在しております。例えば、憲法第一章第一条において、天皇を元首として規定すべきであるという考え方があります。これに対して、そもそも古来より、…", "…ことであります。したがって、元首、英訳するとヘッド・オブ・ステートと規定してしまうことは、天皇陛下の本来の役割を矮小化しかねず、諸外国に対し…"]}]}]}, {"date": "2021-11-12", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120603968X00120211112/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120603968X00120211112/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120603968X00120211112/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120603968X00120211112/4", "sentence": ["…いたしましたとおり、本会期中、当委員会に参考送付されました地方自治法第九十九条の規定に基づく意見書は三十七件であります。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120603968X00120211112/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120603968X00120211112/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120603968X00120211112/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120603968X00120211112/8", "sentence": []}]}]}, {"date": "2021-12-21", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120703968X00120211221/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120703968X00120211221/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120703968X00120211221/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120703968X00120211221/4", "sentence": ["…、本会期中、当委員会に参考送付されました陳情書は四件、また、地方自治法第九十九条の規定に基づく意見書は十五件であります。――――◇―――――"]}, {"url": "https://kokkai.ndl.go.jp/txt/120703968X00120211221/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120703968X00120211221/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120703968X00120211221/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120703968X00120211221/8", "sentence": []}]}]}]