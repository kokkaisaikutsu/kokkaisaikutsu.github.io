[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/185", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/187", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/195", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/199", "sentence": ["…い切った支援策を重ねて求めたいというふうに思います。次に、金融機関の貸し剥がしについて伺いたいと思うんですが、自交総連に寄せられた相談の中に…", "…した。こういう状況が広がれば、今後、バスやタクシー会社への金融機関の貸し剥がしも起こり得るんじゃないかと、実際にその懸念の声も広がっておりま…", "…も広がっております。金融庁にも来ていただいておりますけれども、金融機関の貸し剥がしは今後起こり得ると、金融庁にそういう認識はあるでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/201", "sentence": ["○武田良介君貸し剥がしが起こらないように、一社たりとも倒産する会社がないように、しっかりと金融機関を見張っていただきたいというふうに思います…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/207", "sentence": []}]}]}]