[{"date": "2021-03-30", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414319X00720210330/100", "sentence": ["…工事に十八年、合計三十四年近く掛かっております。こういうことを想起しても、なぜ長期間掛かるのか、この点について御説明いただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414319X00720210330/102", "sentence": ["…あります。用地買収に関わって、今年の二月十九日に、新貨物駅建設予定地の明渡しに応じておられなかった一名の方に対して、土地の行政代執行が行われ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414319X00720210330/104", "sentence": ["…評価が行われるわけですけれども、最新が二〇一六年だったと思います。この中でＢバイＣはどのように検討されたのか、御説明いただけますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414319X00720210330/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414319X00720210330/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414319X00720210330/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414319X00720210330/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414319X00720210330/114", "sentence": []}]}]}]