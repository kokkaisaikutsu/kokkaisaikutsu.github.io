[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/25", "sentence": ["○武田良介君日本共産党の武田良介でございます。今日は、発議者の先生方、どうぞよろしくお願いをいたします。早速、交通政策基本法の改正案の質問に…", "…事段階、それぞれで設けて、関係者間の合意形成を図ることが必要だというふうに考えておりますけれども、発議者の先生方のお考えはいかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/31", "sentence": ["…つである北陸新幹線の建設工事では今こういう状況があるんだと、冒頭にも発議者の先生から、地域社会のためにその理解、納得が必要なんだと、合意形成…", "…合意形成が図られているのかどうか、しっかりと見ていく必要があるというふうに思いますけれども、最後に発議者の先生の御見解を伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314319X00320201201/166", "sentence": []}]}]}]