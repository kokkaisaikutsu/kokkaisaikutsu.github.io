[{"date": "2020-11-20", "meeting": [{"meeting_name": "参議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/120", "sentence": ["…ども、お聞きしましたら、十月に発災をしております、今年の春の田んぼの作付け、頭首工が壊れているのでどうするかということで、土のうを使って、先…", "…今年七月豪雨災害でその土のうすらまた流されてしまったと。じゃ、来年の作付けに頭首工、間に合うかというと、なかなかこれ間に合わないんですね。や…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/128", "sentence": ["…町ですけれども、両角町長とお話をさせていただきました。それで、来年の作付けに向けて何とかその頭首工の改修をということで考えているんだそうであ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314339X00320201120/142", "sentence": []}]}]}]