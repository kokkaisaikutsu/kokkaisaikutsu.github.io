[{"date": "2020-06-22", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/166", "sentence": ["…終的に結論付けたものだけを掲記するというふうになるわけですが、国民の関心が非常に高いものについて、関心が高いものについて、結論が出ていなくて…", "…するというふうになるわけですが、国民の関心が非常に高いものについて、関心が高いものについて、結論が出ていなくても業務報告的なものとして検査状…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/168", "sentence": ["…られている、そういう事故であります。業務が終わっていなくても、社会的関心が極めて高い問題については会計検査の対象となり得るということでありま…", "…摘をされる状況になってきているというふうに思うんですね。既に国民的な関心になっているんだということをここで申し上げておきたいというふうに思い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/174", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/176", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/178", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200622/180", "sentence": []}]}]}]