[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第四分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/67", "sentence": ["…いしたいというふうに思います。次に、少し話をかえまして、フィギュア、オタク文化について質問したいと思います。私の地元の門真市というところに、…", "…九九六年に秋葉原にフィギュアショップをつくって、これは最初のホビー、オタクショップで、ここから秋葉原のいろいろなオタク文化が広がっていったと…", "…て、これは最初のホビー、オタクショップで、ここから秋葉原のいろいろなオタク文化が広がっていったというふうにも仄聞をしております。一九九九年に…", "…います。すごい技術、世界に誇る技術力でして、まさしくこれは世界に誇るオタク文化じゃないかと。この海洋堂が今、フィギュアの殿堂として博物館をつ…", "…うのは今までもいろいろと進めていただいたと思いますが、日本のこうしたオタクカルチャー、こういうものを世界に売り込んでいく、応援するような施策…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/69", "sentence": ["…て、文化庁、いろいろなツールがあると思いますので、そういうのを通じてオタク文化をぜひ広げていっていただきたいというふうに思います。あわせても…", "…というものでありますが、この文化資源というところにフィギュアも含めたオタク文化というのは入るのかどうか、支援の対象となるのかどうかというとこ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/83", "sentence": []}]}, {"meeting_name": "衆議院 予算委員会第七分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/398", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/400", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/402", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/404", "sentence": []}, {"url": "https://kokkai.