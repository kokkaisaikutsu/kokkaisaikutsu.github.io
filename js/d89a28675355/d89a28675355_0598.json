[{"date": "2020-05-08", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/31", "sentence": ["…もあると思うわけであります。この点については、本法案の附則第十六条第二項において次のように記載をされておるんですが、国家公務員の給与水準が現…", "…われる昇任及び昇格の基準、昇給の基準、俸給表に定める俸給月額その他の事項についての検討の状況を踏まえ、令和十二年三月三十一日までに所要の措置…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/33", "sentence": ["…り反映されることが重要であると考えます。こうした考えが附則第十六条第三項において次のように記載をされているんですが、職員の能力及び実績を職員…", "…重要であることに鑑み、この法律の公布後速やかに、人事評価に関し必要な事項について検討を行い、その結果に基づいて所要の措置を講ずる、こう規定を…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/47", "sentence": []}]}]}]