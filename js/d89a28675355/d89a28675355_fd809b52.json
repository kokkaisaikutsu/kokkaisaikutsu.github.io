[{"date": "2020-05-08", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/31", "sentence": ["…ては、全体の給与水準を連続的なものとするだけでなく、優秀な職員がその能力や実績に見合った処遇を受けられるようにする、このことが本当は一番大事…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/33", "sentence": ["…でよく言われる年次順送り的な人事を改めて、優秀な職員に報いるいわゆる能力・実績主義に基づく人事管理、これを徹底することが重要であると思うわけ…", "…附則第十六条第三項において次のように記載をされているんですが、職員の能力及び実績を職員の処遇に的確に反映するための人事評価の改善が重要である…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/35", "sentence": ["…単ですけれども、物すごく難しいと思うんですね。どのような評価をして、能力や実績主義の人事にするのか。このことは、抵抗ももちろんあると思います…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/47", "sentence": []}]}]}]