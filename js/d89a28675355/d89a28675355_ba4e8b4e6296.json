[{"date": "2020-05-08", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/29", "sentence": ["…に反するのではないかという議論もあると思うわけであります。そこで、給与を七割水準としたその根拠について、人事院にお伺いをさせていただきます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/31", "sentence": ["…の定年の前後で連続的なものになるよう、国家公務員の給与制度について、人事院においてこの法律の公布後速やかに行われる昇任及び昇格の基準、昇給の…", "…というふうに私は理解をしているわけであります。これは具体的にどのようなスケジュールでどのように見直しを行うのか、人事院にお伺いをいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/33", "sentence": ["…ているわけであります。そして、この人事評価の改善については、先ほど、人事院による給与の見直しの前提であるわけでありまして、このことが前提とな…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/47", "sentence": []}]}]}]