[{"date": "2020-05-08", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/35", "sentence": ["…て、退職手当についても幾つかの措置を講じていると思います。そこで、内閣人事局に伺いますが、退職手当に関する改正内容の概要についてお答えいただ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/37", "sentence": ["…すが、定年延長によって、実際に職員に支払われる退職手当の額は、これはふえてしまうのでしょうか。これを内閣人事局にお伺いをさせていただきます。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/39", "sentence": ["…者数を維持するための定員措置というものが私は必要であると思うんですが、この問題にどのように対応していくのか、内閣人事局にお伺いをいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/41", "sentence": ["…イルス感染症対応のような緊急時に国家公務員が力を発揮できる体制を構築すべきと考えますが、どのように対応するのか内閣人事局にお伺いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/47", "sentence": []}]}]}]