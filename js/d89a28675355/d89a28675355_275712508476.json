[{"date": "2020-11-19", "meeting": [{"meeting_name": "衆議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304339X00420201119/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00420201119/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00420201119/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00420201119/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00420201119/32", "sentence": ["…で、ぜひ、以下二点の要望をしたいと思います。一つは、避難所スペースが圧倒的に足りません。この避難所スペース不足というのを、特に都市部ではどう…", "…いと思います。もう一つ言うと、福祉的ケアの必要ないわゆる福祉避難所も圧倒的に不足をいたしておりますので、これはぜひ国から自治体に一層の改善を…"]}]}]}]