[{"date": "2020-05-08", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/33", "sentence": ["…これを徹底することが重要であると思うわけであります。そのためには、人事評価を厳格に実施して、その結果が職員の昇進や給与にしっかり反映されるこ…", "…いるんですが、職員の能力及び実績を職員の処遇に的確に反映するための人事評価の改善が重要であることに鑑み、この法律の公布後速やかに、人事評価に…", "…の人事評価の改善が重要であることに鑑み、この法律の公布後速やかに、人事評価に関し必要な事項について検討を行い、その結果に基づいて所要の措置を…", "…要の措置を講ずる、こう規定をされているわけであります。そして、この人事評価の改善については、先ほど、人事院による給与の見直しの前提であるわけ…", "…、これが行われるわけであります。そこで、この附則に規定をされている人事評価の改善については具体的にどのように取り組んでいくのか、スケジュール…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00920200508/47", "sentence": []}]}]}]