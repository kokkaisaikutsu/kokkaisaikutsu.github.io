[{"date": "2020-05-27", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/4", "sentence": ["…たりましては、関連業界の方々へのインタビューに始まって、金融庁からのレク、質問通告など、電話とウエブ会議を使って全てリモートで行いました。コ…", "…いたしました。特に霞が関では、夜中まで国会待機で待たされ、議員会館にレクに呼ばれて、本省、本庁と往復する移動時間だけでも三十分はかかるといっ…", "…らないと思っております。今回、電話やウエブ会議でもわかりやすく明快なレクをしてくださった関係者の方々に、この場をおかりしてお礼を申し上げます…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/18", "sentence": []}]}]}]