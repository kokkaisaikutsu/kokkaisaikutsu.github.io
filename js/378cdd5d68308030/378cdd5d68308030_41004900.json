[{"date": "2020-04-07", "meeting": [{"meeting_name": "衆議院 地方創生に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/6", "sentence": ["…ろうというものであります。政府の説明では、スーパーシティー構想とは、ＡＩ及びビッグデータを活用し、社会のあり方を根本から変えるような都市設計…", "…先行的に体現する最先端都市をつくるという構想です。今現在においては、ＡＩ、ビッグデータを活用した先進的な取組は、日本より諸外国の方が進んでい…", "…なっています。また、中国の杭州においては、道路のライブカメラの映像をＡＩで分析し、交通状況に応じて信号機を自動で切りかえることで、渋滞が緩和…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/18", "sentence": []}]}]}]