[{"date": "2020-04-07", "meeting": [{"meeting_name": "衆議院 地方創生に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/6", "sentence": ["…在においては、ＡＩ、ビッグデータを活用した先進的な取組は、日本より諸外国の方が進んでいると私は認識しております。例えば、エストニア共和国では…", "…救急車の到着時間も半減していると聞いております。我が国においても、諸外国以上にこうした先進的な取組を暮らしに実装するのがスーパーシティー構想…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/8", "sentence": ["…らおくれをとっていると言わざるを得ません。都市間の競争力が衰えれば、外国企業の誘致は厳しく、逆に、日本企業の海外流出にもつながってしまいます…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00520200407/18", "sentence": []}]}]}]