[{"date": "2020-05-13", "meeting": [{"meeting_name": "衆議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/4", "sentence": ["…支援、マスクや防護服などの物的支援はもちろんのこと、さらなる特段の財政支援をして、命を守るために厚生労働省としても全力でサポートするときであ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/8", "sentence": ["…化が予想されますので、肉体的にも精神的にも負担が大きくなる中、医療従事者に対してさらなる財政支援を検討すべきと考えますが、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/10", "sentence": ["…まいります。事業所はもちろんのこと、例えば特別手当等、介護、福祉職員に対してもさらなる財政支援をすべきであると考えますが、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/18", "sentence": []}]}]}]