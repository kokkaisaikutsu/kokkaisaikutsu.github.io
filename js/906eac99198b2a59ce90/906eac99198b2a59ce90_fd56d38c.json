[{"date": "2020-06-01", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/44", "sentence": ["…伺いしたいと思います。先日、菅官房長官が、中国の習近平国家主席をまた国賓として来日させる、それを再調整する意向を示されました。今、御存じのと…", "…こういうことを考えても、とてもじゃないけれども、今、習近平国家主席を国賓として迎える環境にはないと思いますが、大臣のそのことについての御所見…", "…ないと思いますが、大臣のそのことについての御所見と、どういう環境が整えば国賓招待するということが妥当だとお考えになるか、伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/46", "sentence": []}]}]}]