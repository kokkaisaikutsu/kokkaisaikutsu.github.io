[{"date": "2020-06-16", "meeting": [{"meeting_name": "衆議院 安全保障委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/67", "sentence": ["…というのは十兆円も積まれたわけでありまして、これは大変政策判断を伴う支出、しかも巨額なものが出されるんだと思います。しかし、性質的に見れば、…", "…きたいと思います。というのは、予備費であれば、閣議決定を経て、それで支出ができるわけですが、予算だって、閣議決定をして、審議にかかる日数を経…", "…できるわけですが、予算だって、閣議決定をして、審議にかかる日数を経て支出できるということを考えると、当初予算のようなさまざまな予算が盛られて…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/69", "sentence": ["…連の予算を予備費として積んでおく、あるいは今もある予備費というものを防衛費として支出をする、そういったことというのは想定にあるんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00520200616/77", "sentence": []}]}]}]