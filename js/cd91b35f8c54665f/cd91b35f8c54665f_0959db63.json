[{"date": "2020-05-26", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/72", "sentence": ["…また、一方で、ＵＤトークなんと言われる、音声をそのまま文字に自動的に変換する、そういったアプリといいましょうか、技術が既に充実してきておりま…", "…最近はよく使われるようになってきていると承知しております。音声の文字変換技術というものをこのリレーサービス、人手を介さずに、技術を導入する、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/74", "sentence": ["…所管されているわけですから、今局長がおっしゃったような、音声を文字に変換する、そういう技術も、いろいろな側面からの検討はされてきたということ…", "…とがあります。それは、まず、今のリレーサービス、現状は、やはり文字に変換するとかいうことに、要するに通訳に時間がかかります。ですから、利用者…", "…す。そして、もう一点は今後の話ですが、今、谷脇局長からも、自動の文字変換技術というのは相当進んでいるということで、技術開発には取り組んでいく…", "…から、障害者施策としてのみでなく、やはりこれからは、日本語を外国語に変換する、こういう技術も当然ながら視野に入っているわけですから、そういっ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01820200526/219", "sentence": []}]}]}]