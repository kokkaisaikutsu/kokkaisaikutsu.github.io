[{"date": "2020-06-02", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/27", "sentence": ["…国でございますので、是非現場の御努力に期待をしたいと思います。次に、アジア各国等との社会保障協定に向けた取組についてお伺いします。近年、中国…", "…等で外国人の現地社会保障制度の加入の義務化が進んでいます。背景には、アジア各国の経済発展が進んで、社会保障制度とその財政基盤が強化されてきた…", "…るようにというような指摘があると聞いております。他方、現在、我が国がアジア各国との社会保障協定を結んでいる現状は、二〇〇五年の韓国、二〇一六…", "…国にとどまっていると承知をしています。昨今、日系企業の多くが進出するアジアでございますから、その社会保障協定の締結というのはやっぱり急務であ…", "…の社会保障協定の締結というのはやっぱり急務であると思います。今後このアジア諸国に向けた締結の方向性、推進状況についてお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X01520200602/39", "sentence": []}]}]}]