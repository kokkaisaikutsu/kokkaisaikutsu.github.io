[{"date": "2020-05-15", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/174", "sentence": ["…決めた特別定額給付金、これはマイナンバーを使ってマイナポータルでの電子申請が行える仕様となっていますが、マイナンバーカードをつくろうとする人…", "…私は本末転倒だということを思っています。また、マイナポータルによる電子申請が始まった二〇一七年十一月から二〇二〇年三月現在まで、連絡先入力画…", "…年十一月から二〇二〇年三月現在まで、連絡先入力画面のアクセス件数と電子申請が受け付けられた件数を比較して離脱率を計算すると、その率が極めて高…", "…ードを使ってマイナポータルで、給付金じゃなくてもいいです、何かしらの電子申請をされた経験はありますか。エピソードなどがあれば教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/176", "sentence": ["…進めていくということが私は重要だということを思っています。そして、電子申請においては、総務省の個人向け給付金と経産省の企業向け給付金では大き…", "…トフォンで難解なアプリの操作をしないと申請ができないため、不便で、電子申請が完了した率は極めて低い状態にある。しかも、マイナンバーカードリー…", "…だきますが、学生支援給付金を支給すると決定した際には、文部科学省も電子申請を行うとすれば、私はマイナンバーカードやマイナポータルに固執をする…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/178", "sentence": ["…時代に、コロナ禍の状況の中では全く即していないかなと思いますのと、電子申請はできるようにした方がいい。今大臣からもるる御答弁をいただきました…", "…ります。一応確認なんですが、今の話を聞いていると、マイナンバーカードを活用した電子申請は現時点では検討されていないという理解で大丈夫ですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/180", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/182", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/184", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/186", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/188", "sentence": []}]}]}, {"date": "2020-05-20", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/20", "sentence": ["…重要なんですけれども、マイナンバーカードを使ってマイナポータルでの電子申請を行える仕様となっており、この結果、マイナンバーカードをつくろうと…", "…間に人を密集、密接させては本末転倒です。また、マイナポータルによる電子申請が始まった二〇一七年十一月から二〇二〇年三月現在までの、資料を配付…", "…料を配付させていただいておりますが、連絡先入力画面のアクセス件数と電子申請を受け付けられた件数を比較して、離脱率を計算をしますと、その率は極…", "…を使って、このマイナポータルで、給付金でなくてもいいです、何かしらの電子申請をされた経験はありますか。エピソードなどがあれば教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/23", "sentence": ["…ません、委員長。給付金の申請でなくても結構です。マイナポータルを使って何かしらの電子申請をされたことがお三方はございますか。教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X01220200520/43", "sentence": []}]}]}]