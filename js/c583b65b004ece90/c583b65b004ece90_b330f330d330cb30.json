[{"date": "2021-04-16", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/10", "sentence": ["…家庭系食品ロスが二百八十四万トンという、これは、一般消費者の方々がコンビニとかスーパーで買物をする、それを例えば冷蔵庫で保管するわけですが、…", "…る期限であるのが賞味期限だと。だから、消費期限は、日にちを決めたらコンビニか何かで廃棄するわけですね。でも、賞味期限というのは、おいしく食べ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/12", "sentence": ["…すいことなので、よろしくお願いしたいと思います。次に、スーパーとかコンビニに、消費期限が切れたもの、これが廃棄になるわけですね。今はポイント…", "…を妥当性を持って、余り厳しくしちゃうと早めに期限が来て、スーパー、コンビニで廃棄せざるを得ない。買う消費者もある程度余裕がないと、今日までだ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/27", "sentence": []}]}]}]