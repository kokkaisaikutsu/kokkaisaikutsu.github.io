[{"date": "2021-04-16", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/12", "sentence": ["…ら、おおむね五日以内を超すと危ないことを意味する期限だと。この期限を設定しているのは、当然これは主に食品製造者ですね。食品製造者が期限を当然…", "…わけですが、これも、調査によると、食品製造者が余りにこの係数を厳しく設定しているところもあって、まだ食べられる期限であっても、短いので廃棄さ…", "…の方々を対象にやはり食品ロス削減に協力してほしい。だから、消費期限の設定の在り方というのを妥当性を持って、余り厳しくしちゃうと早めに期限が来…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/27", "sentence": []}]}]}]