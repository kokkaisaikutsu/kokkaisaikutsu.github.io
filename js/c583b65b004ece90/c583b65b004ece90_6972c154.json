[{"date": "2021-04-16", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/16", "sentence": ["…対応していただきたいと思います。それで、実は、法律で、国等による環境物品等の調達の推進等に関する法律、いわゆるグリーン購入法、これがございま…", "…法を踏まえて、環境省として、グリーン購入の中身を見ると、もうちょっと物品の中でそういったものを支援する、金額があるから、入札制度、いろいろあ…", "…もあるわけですから、法律的な、あるものですから、まずは環境省として、物品の調達を、そういったものを応援するというような視点で購入していただき…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00520210416/27", "sentence": []}]}]}]