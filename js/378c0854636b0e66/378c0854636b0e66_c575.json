[{"date": "2020-03-26", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/122", "sentence": ["○谷合正明君公明党の谷合でございます。家畜伝染病予防法の質問に入る前に、私も、新型コロナウイルス感染症対応について伺いたいと思います。特に、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/130", "sentence": ["○谷合正明君是非よろしくお願いしたいと思います。それでは、家畜伝染病予防法について質問したいと思います。まず、今国会の冒頭、議員立法で予防的…", "…います。まず、今国会の冒頭、議員立法で予防的殺処分の対象となる家畜伝染病にＡＳＦを追加をさせていただいたところであります。改めて、このＡＳＦ…", "…で、このＣＳＦは対象とならないことの説明を伺いたいと思います。監視伝染病いろいろある中で、口蹄疫なんかは既にもう予防的殺処分の対象となってい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/140", "sentence": ["…いるところではあるんですが、例えば、ＣＳＦ、ＡＳＦ、口蹄疫等の家畜伝染病の予防、蔓延防止のために、飼養衛生管理の指導あるいは確認等、獣医師の…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/150", "sentence": ["…たいと思います。改めまして、家伝法の改正を受けまして、国内での家畜伝染病の蔓延防止、あるいは海外からの侵入阻止に向けて万全の措置をとっていた…", "…います。同時に、先ほどの質問とも関連するんですけれども、やはり家畜伝染病も、人の伝染病と同様に、一国のみならず、国内のみならず、諸外国、もう…", "…、先ほどの質問とも関連するんですけれども、やはり家畜伝染病も、人の伝染病と同様に、一国のみならず、国内のみならず、諸外国、もう世界中との連携…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/152", "sentence":