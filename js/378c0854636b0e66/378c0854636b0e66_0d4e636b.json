[{"date": "2020-04-14", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/113", "sentence": ["…てこられたということだと思います。そうした中、一昨年、精液や受精卵を不正に中国に持ち出そうとした事件が起きました。一生懸命育種改良した和牛の…", "…ります。そこで、この度の和牛二法案であります。特に家畜遺伝資源に係る不正競争の防止に関する法律におきましては、和牛の遺伝資源の知的財産的な価…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/115", "sentence": ["…いろいろとやり取りされました。これ大事なことは、今回新法を作ったと、不正競争防止法、平成三十年のこの仕組みを参考にしたということなんですけれ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/117", "sentence": ["…らも話がありました抑止力という話なんですけれども、この契約違反による不正競争が生じたときに実効性のある救済措置がとられていることが重要であり…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/129", "sentence": []}]}]}]