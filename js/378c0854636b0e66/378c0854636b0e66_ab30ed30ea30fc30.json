[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/169", "sentence": ["…。それでは、食料自給率についてお伺いしたいと思います。食料自給率のカロリーベース目標は、この度、前回と同様に四五％ということになりました。様…", "…回と同様に四五％ということになりました。様々、この食料自給率の特にカロリーベースにつきましては、その達成については難しいという指摘もある中で…", "…組の検証というものはどういうものだったんでしょうか。さらに、今回、カロリーベースあるいは金額ベース、そして飼料自給率、そして食料国産率、この…", "…ース、そして飼料自給率、そして食料国産率、この食料国産率はそれぞれカロリーベース、金額ベースにそれぞれに該当していくということなんですけれど…", "…ということなんですけれども、いろいろな指標が出てきておりますけれども、カロリーベースというものが基本であるという理解でよろしいのでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/173", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/175", "sentence": []}]}]}]