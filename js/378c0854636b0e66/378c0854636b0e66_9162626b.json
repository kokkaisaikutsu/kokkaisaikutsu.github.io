[{"date": "2020-04-14", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/113", "sentence": ["…牛の遺伝資源の知的財産的な価値を守るという考え方で海外流出を阻止する抑止力を大幅に高めるものと理解しております。まず、確認させていただきます…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/117", "sentence": ["…わば新しい仕組みであるということであります。このような手法による輸出抑止であれば、自由貿易に関する国際条約とも調和するという形で、和牛のよう…", "…が可能になると考えられます。しかし、先ほど政務官からも話がありました抑止力という話なんですけれども、この契約違反による不正競争が生じたときに…", "…要でありまして、悪質なものには刑事罰との御説明でしたけれども、罰則が抑止力として十分なのでしょうか。この点についてお答えいただきたいと思いま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X01020200414/129", "sentence": []}]}]}]