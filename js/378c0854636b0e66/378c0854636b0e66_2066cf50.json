[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/159", "sentence": ["…ウンサー等がですね。ただ一方、テレビ報道でそういう呼びかけているその映像自体は、スーパーの商品棚、空の商品棚を映像に、背景にして流しているわ…", "…そういう呼びかけているその映像自体は、スーパーの商品棚、空の商品棚を映像に、背景にして流しているわけですね。これは逆効果ではないだろうかと私…", "…引というものを作っているんです。昔ですと、自殺があると多分その遺書を映像で流しているときもあったんです。ただ、それは自殺を誘引するということ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/161", "sentence": ["…というのでびっくりしましたけど、ただ、工場の倉庫にいっぱい積んである映像が流れたときにやっぱり安心感が増えてきたということもありますので、よ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/173", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/175", "sentence": []}]}]}]