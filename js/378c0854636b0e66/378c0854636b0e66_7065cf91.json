[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/159", "sentence": ["…触れていただきました。私、今、配付しておりませんけど、手元に米の販売数量ですとか小売価格の資料を持っているんですけれども、二月末に、実は政府…", "…、二月末に、実は政府が一斉休校の発表をしたときに、あのときに米の販売数量が一気に伸びたわけですね。その発表の前の週は七百トン余りの販売数量だ…", "…売数量が一気に伸びたわけですね。その発表の前の週は七百トン余りの販売数量だったのが、その発表のあった週の一週間は一気に引き上がって、千トンぐ…", "…十分、供給力が十分あるということでこういう動きにつながりました。販売数量が一気に伸びるこの状況の中で、当然これ価格も釣られて上がっているんで…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/173", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/175", "sentence": []}]}]}]