[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/159", "sentence": ["…きたいというふうに思っております。その中で、今回、情報伝達におけるメディアの役割というのは大きいなというふうに思っております。例えばテレビ報…", "…ふうに思います。例えば、自殺報道に関するものは、ＷＨＯが自殺予防のメディアの関係者のための手引というものを作っているんです。昔ですと、自殺が…", "…のまだ知見が集められていないということはあると思うんですけれども、メディアも当然そんなあおる意図もないんです。ですから、情報提供元の農林水産…", "…情報提供元の農林水産省と、今回の報道の自由にも十分留意しながらも、メディア側とともにリスクコミュニケーションの向上に努めていくべきではないか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/173", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/175", "sentence": []}]}]}]