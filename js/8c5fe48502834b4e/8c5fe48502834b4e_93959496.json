[{"date": "2021-12-20", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/65", "sentence": ["…に対して重症化リスクが高いという方たち三千百万人を対象としまして接種間隔を前倒しするということは今、堀内大臣から答弁のあったとおりです。具体…", "…、医療従事者等や重症化リスクの高い高齢者施設入所者などについては接種間隔を二か月前倒しして六か月間に短縮する、それから、来年二月以降にその他…", "…に短縮する、それから、来年二月以降にその他の一般高齢者については接種間隔を一か月前倒しして七か月に短縮することといたしております。現状で全国…", "…して七か月に短縮することといたしております。現状で全国民を対象に接種間隔の前倒しを行うことは、ワクチンの確保あるいは体制等を考えまして難しい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00320211220/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X0