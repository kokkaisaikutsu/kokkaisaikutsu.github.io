[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/117", "sentence": ["○大門実紀史君大門です。最先端の技術やイノベーションが今後の金融サービスを変化、変化して対応しなきゃいけないというのは必要なことでありますし…", "…惧を抱いております。既にありましたので簡潔に質問しますけれども、金融サービス仲介業が、今まで顧客保護の制度でもあった、仕組みでもあった所属制…", "…仕組みをなくす代わりに、そういう新たな仲介業者が扱うことができる金融サービスはその代わり限定いたしますということで、具体的には、高度な説明を…", "…り限定いたしますということで、具体的には、高度な説明を必要とする金融サービスを政令で指定して、それ以外を扱えるようにする。つまり、簡単な説明…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/155", "sentence": ["…史君反対の討論を行います。最先端技術の進歩に対応した利用者本位の金融サービスは重要です。しかし、本改正案には投資被害や多重債務を増大させる懸…", "…被害や多重債務を増大させる懸念があります。新たな仲介業者が扱える金融サービスに上場株、投資信託などがありますが、現行の所属制の下でも多くのト…", "…えれば、被害が増えることはあっても減ることはあり得ません。また、金融サービス仲介業に貸金業を加えることも多重債務問題を再燃させる懸念がありま…", "…題を再燃させる懸念があります。そして何より、本改正案には、新しい金融サービスの提供ばかりが急がれ、ターゲティングやスコアリングなどデジタル社…"]}]}]}, {"date": "2021-03-23", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/195", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/201", "sentence": ["…をやっていくというようなことも書かれております。何といいますか、金融サービスを利用する側の投資家目線といいますか、先ほど申し上げましたような…"]}