[{"date": "2021-03-23", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/189", "sentence": ["…たいんですけれど、その背景にあります投資の促進とか投資優先とか、まあ貯蓄から投資へというのもありましたが、こういう考え方があって金融の税制と…", "…にお聞きしたいんですけれども、なぜ若者に金融庁が投資を勧めるのかと。貯蓄から投資へというのがあります。これは政府の大方針ですけれども、私たち…", "…府の大方針ですけれども、私たちは必ずしもいいとは思っておりませんが、貯蓄から投資という場合だと、貯蓄を持っているのはやっぱり高齢者が多いわけ…", "…ちは必ずしもいいとは思っておりませんが、貯蓄から投資という場合だと、貯蓄を持っているのはやっぱり高齢者が多いわけですよね。貯蓄から投資へとい…", "…いう場合だと、貯蓄を持っているのはやっぱり高齢者が多いわけですよね。貯蓄から投資へということとは別なんですよね、若者は貯蓄少ないですから。そ…", "…多いわけですよね。貯蓄から投資へということとは別なんですよね、若者は貯蓄少ないですから。そうすると、なぜ若者に勧めるのかと、金融庁がですね。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/195", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X0052021