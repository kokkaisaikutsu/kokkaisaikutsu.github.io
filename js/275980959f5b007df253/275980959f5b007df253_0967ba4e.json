[{"date": "2020-11-24", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/142", "sentence": ["…ていると。その中で問題になってきているのは、当然、店舗がなくなると、有人店舗がなくなるとお年寄りがまず、高齢者が困るというのがあります。特に…", "…ます。ただ、それだけではなくて、地域で頑張っている中小企業にとっても有人店舗がなくなるということは大変な打撃でありまして、融資にも関わるんで…", "…て、鳥取だけじゃなくて、全国各地で同じことが起きております。金融庁も有人の店舗が近い距離にあることの有効性、有用性は認めてこられたわけであり…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00320201124/148", "sentence": []}]}]}]