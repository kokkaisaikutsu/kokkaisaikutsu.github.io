[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/121", "sentence": ["…わけですよね。広告もいろいろありますけど、金融商品の勧誘となりますと適合性の原則というのが掛かります。つまり、顧客の経済状況とか知識、経験に…", "…ない商品を売っちゃいけない、提供しちゃいけないというのが金融における適合性の原則ですよね。勧誘となると、そういう原則、縛りが掛かるわけですよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/155", "sentence": []}]}]}]