[{"date": "2021-03-23", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/195", "sentence": ["○大門実紀史君金融庁の具体的にやっていらっしゃる出張教育については後で取り上げますけれど、まず、資料配りましたので、今どうなっているかなんで…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/201", "sentence": ["…とになって戸惑いが広がっているので、金融庁が、先ほどもありましたが、出張授業、あるいは教材を作ると。先生を対象にした投資イベントなどをやって…", "…料は、金融庁の取組という資料でございまして、ここに先ほどお話があった出張授業と、金融庁としては出張授業、教育庁、教育委員会への訪問、先生方へ…", "…料でございまして、ここに先ほどお話があった出張授業と、金融庁としては出張授業、教育庁、教育委員会への訪問、先生方へのサポート、教員向け研修を…", "…問、先生方へのサポート、教員向け研修をやるというようなことが書かれております。この出張授業ですけれども、一体何を教えに行かれるんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/223", "sentence": []}]}, {"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "rema