[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/231", "sentence": ["…思います。大体、近畿財務局の人が、赤木さんが亡くなられたらすぐ、もう本省の指示だと思うんですけど、遺書はありませんでしたかというふうに来ると…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/233", "sentence": ["…もあるんで、きちっと、この赤木さんが今回の手記に書かれているように、本省の指示でいろいろやらされたという、そのことも「クローズアップ現代」の…", "…も「クローズアップ現代」の中で触れられていたんで、太田さんに対して、本省がそういう改ざんの指示をどういうふうにやったのかということをきちっと…", "…はないかと言ったときに、太田さんが、議事録に残っておりますけれども、本省理財局がどう具体的に主導したかということをまさに今調べておりますと、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/235", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/237", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/239", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/241", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/243", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/245", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/247", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/249", "sentence": []}]}]}, {"date": "2020-03-19", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/128", "sentence": ["…当然認識されていたことですし、赤木さんがいらっしゃった近畿財務局は、本省主導で資料として提示しないと