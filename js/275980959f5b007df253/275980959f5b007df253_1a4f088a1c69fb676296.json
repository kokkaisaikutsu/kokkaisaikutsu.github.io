[{"date": "2020-03-19", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/128", "sentence": ["…すね。それが法律相談記録です。これが、実は二〇一七年の四月と六月の会計検査院の実地検査において、提出してくれと会計検査院から求められながら、…", "…〇一七年の四月と六月の会計検査院の実地検査において、提出してくれと会計検査院から求められながら、具体的な説明も文書も提出しなかったということ…", "…がら、具体的な説明も文書も提出しなかったということだったんですね。会計検査院の報告書が公表されるその後の、半年後の二〇一七年の十一月二十二日…", "…が公表されるその後の、半年後の二〇一七年の十一月二十二日の前日に、会計検査院にどういうわけか前日に提出されたわけであります。この事実そのもの…", "…されておりますけれども、その法律相談記録については、検査の過程で、会計検査院の検査の過程でその記録があることに気付く状態には至らなかったと、…", "…室長でしたかね、あのときは、あと課長補佐さん等々が派遣されて、その会計検査院の検査会場に同席して、そして、近畿財務局からの説明を本省幹部が補…", "…が補足する形で対応したと、こういうことです。しかも、その際の本省の会計検査院への対応の基本姿勢は三点ありますと明確に書かれておりましたが、こ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/146", "sentence": []}]}, {"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/107", "sentence": []}, {"ur