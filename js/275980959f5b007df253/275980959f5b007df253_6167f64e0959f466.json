[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/124", "sentence": ["…も、金融庁として、金融機関に柔軟な対応を求めると、そして金融機関が条件変更などに応じるかどうかウオッチングして、それをまた公表するということ…", "…こと。そして、従来は、この円滑化法そのものの仕組みなんですけれど、条件変更しても、その相手先が経営健全化計画を出せば不良債権にはみなしません…", "…も。大事なことは運用でございまして、その個別の各金融機関が相手先に条件変更をする、そのときに、金融庁からは経営健全化計画を取れということは求…", "…経営健全化計画を取れということは求められていないけれども、独自に、条件変更するけど、後で返せるのかということで、返済計画といいますかね、計画…", "…。その点でいいますと、今大事なことは、緊急事態ですので、できるだけ条件変更に応じてほしいというメッセージが一番大事だと思うんですよね。その点…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/142", "sentence": []}]}]}, {"date": "2020-03-27", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X00920200327/62", "sentence": ["…に引き下げさせるべきです。金融機関も、既存の借入金について、再度の条件変更や返済猶予、場合によっては一部返済免除に応じるべきです。政府は、個…"]}]}, {"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00820200327/4", "sentence": []}]}]}, {"date": "2020-04-01", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/279", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/281", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00120200401/283", "sentence": []}, {"url": "https://kok