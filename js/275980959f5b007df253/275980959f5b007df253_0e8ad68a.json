[{"date": "2020-03-27", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X00920200327/62", "sentence": ["…日本共産党の大門実紀史です。会派を代表して、所得税法等改正案に反対の討論を行います。討論に入る前に、新型コロナに関する経済対策について、何点…", "…実紀史です。会派を代表して、所得税法等改正案に反対の討論を行います。討論に入る前に、新型コロナに関する経済対策について、何点かに絞って政府に…", "…案をまとめ、多国籍企業に税金を払わせ、コロナ対策などの財源に充てるべきです。この点での日本政府の一層の努力を求め、討論を終わります。（拍手）"]}]}, {"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00820200327/4", "sentence": ["○大門実紀史君本改正案に反対の討論を行います。反対する最大の理由は、現下の経済情勢が求める税制改正に逆行するものだからです。消費税の増税に新…"]}]}]}, {"date": "2020-05-14", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/101", "sentence": ["○大門実紀史君反対の討論を行います。その理由は、特定投資業務が、主に巨額の内部留保を蓄積している大企業が自力で行える分野まで、呼び水、リスク…", "…は、コロナ危機に対応した投融資、特に中小企業に重点を置いた政策金融に財源を集中することであります。このことを強く求め、反対討論といたします。"]}]}]}, {"date": "2020-05-22", "meeting": [{"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/157", "sentence": ["○大門実紀史君本法案に反対の討論を行います。まず申し上げたいのは、質疑でも指摘したように、住民の個人情報を丸ごと管理しサービスを提供する社会…", "…という落ち着いた国民的議論と、プライバシー保護の世界の流れを視野に入れた中長期的な企業戦略です。以上のことを指摘して、反対討論といたします。"]}]}]}, {"date": "2020-05-27", "meeti