[{"date": "2020-07-22", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/63", "sentence": ["…文部科学省初等中等教育局児童生徒課と国土交通省観光庁参事官の名前で事務連絡が出ていますね。それで、修学旅行このキャンペーン使ってくださいねと…", "…、東京都に関わることで除外の修学旅行が出てくるということについて、事務連絡あるいはどこかに文書で明記をされているものが出ているんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/65", "sentence": ["…た。ＱアンドＡが出ているのを私は知っています。しかし、ちゃんとした事務連絡、責任者の名前が入っている事務連絡がないとすれば問題じゃないですか…", "…ドＡが出ているのを私は知っています。しかし、ちゃんとした事務連絡、責任者の名前が入っている事務連絡がないとすれば問題じゃないですか、政務官。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00120200722/73", "sentence": []}]}]}]