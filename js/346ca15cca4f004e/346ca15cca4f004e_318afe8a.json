[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/24", "sentence": ["…いただきたいと思うんですが、私の問題意識は、オンライン教育で著作物を許諾なしで利用することができるのかどうかという質問に対してはどういう整理…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/26", "sentence": ["…なかなか難しいところがあって、今のお話をいただいたところでも、何だ、許諾なしで全くフリーで問題なく全てのことがコンテンツを使うことができるの…", "…今のお話を聞くと、来年からは著作権に対する補償料を一定支払わなければ許諾なしで使うことはできないということが実際には起こってくるわけですよね…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/34", "sentence": ["…うということについては全く意識をしなくていいと、著作権の支払あるいは許諾を得なきゃいけないというような、そんな意識を持たなくていいということ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00920200604/46", "sentence": []}]}]}]