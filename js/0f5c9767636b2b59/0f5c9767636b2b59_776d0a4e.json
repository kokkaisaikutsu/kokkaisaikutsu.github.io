[{"date": "2020-06-03", "meeting": [{"meeting_name": "参議院 国際経済・外交に関する調査会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114305X00420200603/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114305X00420200603/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114305X00420200603/90", "sentence": ["…に大きな影響が及びました。改めて、我が国の貿易量の九九・六％を占める海上輸送の安全確保と、我が国の食料、エネルギー、工業製品等の自給率を高め…", "…産物の人工養殖の論議ができればと思います。また、新たなテーマとして、海上貿易を支える船舶に関連して、一つとして、国内における造船産業の維持と…"]}]}]}, {"date": "2021-06-03", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/118", "sentence": ["…かと私は考えます。その理由を幾つか申し述べます。陸上養殖については、海上養殖するための稚魚の育成などは陸上で養殖されております。近年、海水魚…", "…労働基準法の適用除外にする理由が見当たらないと私は考えます。そして、海上養殖では、天候に左右され、しけや台風のとき等は海上に出られないことも…", "…考えます。そして、海上養殖では、天候に左右され、しけや台風のとき等は海上に出られないこともありますが、そのようなときは受注数に応じて加工場近…", "…対応している、こういう状況であります。そして、もう一つですけれども、海上養殖は主に湾内での作業であって、多少の悪天候でも一定の作業ができます…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01520210603/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X0152021