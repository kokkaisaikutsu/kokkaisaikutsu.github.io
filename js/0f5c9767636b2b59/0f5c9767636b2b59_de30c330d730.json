[{"date": "2020-11-24", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/114", "sentence": ["…の避難誘導に役立つのが、町の消防団が昨年三月までに災害時住民支え合いマップを完成させていたことが大きな要因だと、このように言われております。…", "…プを完成させていたことが大きな要因だと、このように言われております。マップは、体の不自由な高齢者や認知症高齢者、車がなくて避難できない人がい…", "…いとして提供されず、消防団員が全町内を回って、四千三百世帯を訪問してマップを完成させたと聞いております。町は、明確に拒否している人を除き、要…", "…このような条例を制定している自治体の数を教えてもらいたいということと、また、消防団のマップ作成の取組と課題があればお聞きをしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00320201124/126", "sentence": []}]}]}]