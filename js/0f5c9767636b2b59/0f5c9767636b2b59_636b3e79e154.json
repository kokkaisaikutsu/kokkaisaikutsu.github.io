[{"date": "2020-11-26", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/169", "sentence": ["…、資料二を用意をいたしました。これは日本郵便からいただいた社員数及び正社員登用の合格者の推移であります。また、事前レクでお話を聞いたときに、…", "…社員数と時間外勤務時間がどう変化していくと想定をしているのか、二つ目には、今後の正社員登用計画、どういう計画をお持ちか、お聞きをいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/171", "sentence": ["○小林正夫君確かにこの資料を見ると、二〇一四年度から年度ごとにこの正社員への登用の合格者の推移の数字がここに書かれております。今お話しのとお…", "…す。今お話しのとおり、おおむね三千名程度、最近では三千名を超える方が正社員に登用をされていますけれども、これは頭数があるんでしょうか。要は、…", "…となんですが、年度の合格者の定数というのは決まっているんですか。要は、合格されればみんな正社員になれるという仕組みになっているんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314601X00420201126/173", "sentence": ["○小林正夫君確かに非正規で働いている方は、正社員じゃなくていいと、自分の都合のいい時間帯に働きたいという方もいらっしゃるから、今の非正規の方…", "…に働きたいという方もいらっしゃるから、今の非正規の方がみんながみんな正社員になりたいと思っていることは私はないと思います。この辺の