[{"date": "2020-11-18", "meeting": [{"meeting_name": "衆議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/207", "sentence": ["○吉田委員じゃ、大臣、やれると確信をされているということでいいですか。確信を聞きたいですね、ぜひ一国民として。確信していますか、大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/209", "sentence": ["○吉田委員大臣、それは当たり前ですよね。確信していると言うぐらいオペレーションをしっかりやらないと難しいと思いますよ。だって、どんな準備をし…", "…備をしても、多分ほころびは出ますよ。その中で、大臣がこれなら大丈夫と確信できるぐらいのを整えないと、ほころびは絶対出ると思います。最善を尽く…", "…くすじゃなくて、やはり、しっかりと全国民にあまねく行き渡らせることを確信するようなリーダーシップをとってください。では、日本国内のワクチン開…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/229", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/233", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X00520201118/235", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304260X0