[{"date": "2020-04-15", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/114", "sentence": ["…ておいた方がいいと思います。もう一点、私が今後気になっていることで、透析患者さんなんですよね。これも質問というより警鐘を鳴らさせていただきた…", "…ですが、コロナ陽性になったら、まず、これは感染リスクもすごいですね、透析って、週三回、三密みたいなところでやりますから。そして、重症ないしは…", "…て、重症ないしは重篤になったときに、隔離をしながら治療をして、かつ、透析まで回すということは、一般の急性期を受け入れている病院でも、動線とか…", "…難をきわめる。数百床、千床ぐらいの本当に地域の中核中の中核病院でも、透析患者さんが重症ないしはＥＣＭＯを回すような重篤になった場合というのは…", "…らいしか受け入れること、動線上できない可能性が極めて高いと思います。透析患者さん、持病がたくさん、もう本当に、ある意味、持病の塊みたいな方も…", "…ですけれども、人が極めて重要になってくる局面かなと私は思いますので。まず、そのこともそうですが、透析患者さん、副大臣、これは大丈夫ですかね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104889X00720200415/118", "sentence": []}]}]}]