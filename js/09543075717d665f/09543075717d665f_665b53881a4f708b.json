[{"date": "2020-11-13", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/12", "sentence": ["…で、私も純粋に、一時期、学問の世界で生きておりました。今回のやはり学術会議の任命拒否、ゆゆしき事態と考えております。私が心配しているのは、例…", "…エンス社、もう官房長官よく御存じだと思いますが、日本の新首相は日本学術会議との闘争を選んだという記事が掲載されています。学問の自由の侵害であ…", "…学術的な自治が脅かされていることを指摘されています。そこで、現状の学術会議の問題点の認識について伺いたいんですが、菅総理は、先月二十九日の衆…", "…識について伺いたいんですが、菅総理は、先月二十九日の衆参本会議で、学術会議の会員構成が旧帝大など一部の大学に偏っているなどと繰り返されました…", "…然あります。当たり前じゃないかと思うんです、偏りがあることは。日本学術会議法第十一条によると、学術会議はすぐれた研究又は業績がある会員をもっ…", "…かと思うんです、偏りがあることは。日本学術会議法第十一条によると、学術会議はすぐれた研究又は業績がある会員をもって組織するとされていますので…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/22", "sentence": ["…、研究に対して国家からの自由を定めたわけであります。しかし、今回の学術会議の問題、このような我が国の苦い経験に逆行するおそれがあると考えます…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/24", "sentence": ["…たいのは、この九州の生体解剖事件等々の過去の反省を踏まえて、今回の学術会議の問題をどうお考えになるか、学問の自由というものをどうお考えになる…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304889X00320201113/38", "sentence": []}, {"url": "ht