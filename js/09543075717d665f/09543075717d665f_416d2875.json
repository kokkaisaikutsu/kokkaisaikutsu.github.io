[{"date": "2021-04-09", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/56", "sentence": ["…）委員今、大西委員はすごくこの面に関して見識が深いんですが、委託費の流用をやめたりとか、あと、本当にこれも実際よく聞く話ですが、七五％と、さ…", "…五％と、さっき平均を言いましたが、五〇％以下のところもあるわけであって、委託費の流用を認めないようなルールづくりが必要じゃないですか、大臣。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/60", "sentence": ["…ことはやはりあるわけです。大臣、例えば東京都の監査では、委託費の不正流用や、園から本部に移された資金について、私的流用を含む不適切支出が指摘…", "…監査では、委託費の不正流用や、園から本部に移された資金について、私的流用を含む不適切支出が指摘されていますね。こういった問題は多く指摘されて…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404889X01720210409/86", "sentence": []}]}]}]