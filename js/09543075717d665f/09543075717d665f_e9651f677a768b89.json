[{"date": "2021-04-21", "meeting": [{"meeting_name": "衆議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/213", "sentence": ["…し直してほしいです。じゃ、もっと大臣、行きますよ。政府は、予防とか早期発見、早期治療の重要性というのはずっと訴えてきていますよね、健康日本と…", "…り参考にした部分が多いですが、予防は保険診療じゃないです。しかし、早期発見、早期治療、そして予防というのはこれは極めて有効で、多くの国民の命…", "…根本的に、概念として、受診控えを起こさせるということは、早期治療、早期発見ということを政府は諦めたということなんですか。そして、早期発見、早…", "…療、早期発見ということを政府は諦めたということなんですか。そして、早期発見、早期治療よりも医療費の圧縮を優先したという考えでよろしいですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/215", "sentence": ["…ね、国民には、残念ながら。駄目ですよ、それは。一番、本当に、多分、早期発見、早期治療、特に、がん、悪性腫瘍等々で必要な世代にこれは直撃します…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/229", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01420210421/233", "sentence": []}]}]}]