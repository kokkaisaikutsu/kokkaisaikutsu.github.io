[{"date": "2021-05-10", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/204", "sentence": ["…にもかかわらず、なぜこんなに掛かるのか。三回目、やはりここはもう少し縮減の努力をしていただかないと、これトータルとして単純計算しますと、一世…", "…人の皆さんにも聞きましたけれども、何か積算がはっきりしない。できるだけ縮減の努力をしていただきたいと思いますけれども、もう一度お願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/206", "sentence": ["…さにこれマイナンバーを使えば、こういったシステムなんかももっともっと縮減できると思いますし、迅速に必要な方に給付できると思いますけれども、こ…", "…駄とはっきり言ってもあれですけれども、一見無駄にも見えるこの事務費の縮減効果がどのぐらいあるのか、その辺どのように見ていらっしゃるでしょうか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/208", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/210", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/212", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/214", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01820210510/217", "sentence": []}]}]}]