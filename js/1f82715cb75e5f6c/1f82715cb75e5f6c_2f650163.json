[{"date": "2020-11-17", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/147", "sentence": ["…せていただきました。アメリカについては、世界、今、ＷＴＯ等の中で価格支持から所得補償へと言われていますけれども、実はアメリカ、価格支持も所得…", "…で価格支持から所得補償へと言われていますけれども、実はアメリカ、価格支持も所得補償もいまだにやっているという状況ですね。つまり、この一番左側…", "…う状況ですね。つまり、この一番左側、青く書いてありますけれども、価格支持融資制度、これは、ローンレートといういわゆる融資単価より市場価格が下…", "…いけないなと思っていますし、ＥＵも同様です。ＥＵにつきましても、価格支持から直接支払へと言われていますけれども、やはり最低価格保証というもの…", "…われていますけれども、やはり最低価格保証というものがまだあると。価格支持と所得補償両方が、直接支払は両方が組み合わされているという、こんな状…", "…アメリカの農業政策というのは、これ、競争促進的である一方で極めて価格支持的要素が強いと思いますけれども、大臣、このアメリカの農業政策、どのよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/174", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/179", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/181", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/183", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/185", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/187", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00220201117/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X0022020