[{"date": "2020-06-02", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/26", "sentence": ["…ろ、福岡と韓国というのは実は東京よりも近い距離にあるんですけれども、郵便物が非常に、肌感覚ですが、二倍、三倍の時間が掛かっている。その際に、…", "…務めている福岡の方に対しても現物でサイン、署名のそういうリクエストの郵便物が届くことになっているんですが、相当遅れて冷や冷やしたと。簡単に判…", "…のですとか署名がどうのこうのと言いますが、なかなか国際間ではそういう郵便物の若干の遅れも企業にとっては命取りになりかねないという状況でござい…", "…き続き監督をよろしくお願いをいたします。なお、今日は、質問の関係で、郵便に関係する国交省、それから経済産業省の参考人の方も来ていらっしゃって…", "…から経済産業省の参考人の方も来ていらっしゃっていますので、是非、その郵便物の遅れやそれから送金が滞るおそれのある県、これもしっかりと連携を図…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/51", "sentence": []}]}]}]