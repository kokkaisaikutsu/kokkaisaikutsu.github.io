[{"date": "2020-06-02", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/41", "sentence": ["…いたしますのは、第二次補正予算で創設をされる予定になっております農林漁業者の経営継続補助金、これは持続化給付金と併用して受給が可能でしょうか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/43", "sentence": ["○古賀之士君ありがとうございます。是非、持続化給付金と今回の農林漁業者の経営持続補助金、併用できるということですので、確認をいただきました。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/51", "sentence": []}]}]}]