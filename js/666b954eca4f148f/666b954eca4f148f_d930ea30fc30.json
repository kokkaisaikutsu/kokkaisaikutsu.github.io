[{"date": "2020-03-18", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/12", "sentence": ["…いわゆるカーゴ便というのももちろんあるんですけれども、特にアジア圏はベリー便といいまして、要するに、航空の、飛行機のおなかで基本的には運んで…", "…かで基本的には運んできますので、旅客便が飛ばないということはいわゆるベリー便が飛ばないということ、おなかだけもないということになりまして、こ…", "…けれども、さまざまなものに影響が出ています。そういう意味で、いわゆるベリー便と言われる、言ってみれば、ＡＮＡだとギャラクシーフライトみたいな…", "…に非常に大きな悪影響があるということでありまして、やはりこれは、このベリー便と言われるものを、ある程度国がそういった運航のサポートをしっかり…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00320200318/20", "sentence": []}]}]}]