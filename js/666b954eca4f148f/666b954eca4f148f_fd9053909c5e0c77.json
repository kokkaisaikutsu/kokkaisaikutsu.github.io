[{"date": "2020-05-12", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/19", "sentence": ["…ですけれども、ことしの五月の七日に、総務省の自動車税制企画室から各都道府県及び市町村の税務担当者に、徴税の猶予とか分納とか、そういったような…", "…しっかりと周知をされないといけないと思うんです。自動車税というのは都道府県税、軽自動車税は市町村税ですけれども、全部をもちろん見たわけじゃあ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01520200512/27", "sentence": []}]}]}, {"date": "2021-04-08", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405254X01920210408/26", "sentence": ["…ります。このことから、平成三十年度の国保制度改革により、財政運営を都道府県単位化するとともに、財政支援の強化が図られており、市町村における法…", "…一程度に減少したと承知しています。今後、法定外繰入れの更なる解消や都道府県内の保険料統一といった国民健康保険制度に残された課題についてどのよ…"]}]}]}]