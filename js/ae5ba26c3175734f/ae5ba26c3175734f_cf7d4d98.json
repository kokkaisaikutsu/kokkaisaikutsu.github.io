[{"date": "2020-03-06", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X00620200306/10", "sentence": ["…千三百三十円の助成を企業に行うものです。まず、この助成措置によって、総額幾らの財源が必要になると見込んでいるのでしょうか。一般会計及び労働保…", "…でいるのでしょうか。一般会計及び労働保険特会に関して、それぞれ見込み総額をお答えください。また、その財源はどこから調達するのでしょうか。総理…"]}]}]}, {"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/21", "sentence": ["○宮沢由佳君この送料、一つ一つは少ないかもしれませんけれど、総額になると結構な額に……（発言する者あり）"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/23", "sentence": ["○宮沢由佳君はい。送料が総額になるとかなりの額になるかと思いますので、予算についてしっかり考えていただきたいというふうに思いますが。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/51", "sentence": []}, {"url": "ht