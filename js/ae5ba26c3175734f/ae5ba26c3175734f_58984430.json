[{"date": "2021-04-06", "meeting": [{"meeting_name": "参議院 経済産業委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/36", "sentence": ["○宮沢由佳君石炭火力発電の輸出支援、新規案件に関して政府金融機関による低利融資をやめるとの報道がありました。この御説明をお願いできますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/46", "sentence": ["○宮沢由佳君地元の声も聞いていくということで、是非よろしくお願いいたします。では、再生可能エネルギーに話を戻しますが、地域の特性を生かす再生…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/48", "sentence": ["…地産地消という御発言がございましたけれども、地域で必要な電力は可能な限り地域で供給することに対するお考えを確認いたします。お願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/50", "sentence": ["○宮沢由佳君よろしくお願いいたします。関連して、ソーラーパネルと風力発電所に関して伺います。ソーラーパネル設置に関して環境アセスを行うことに…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/54", "sentence": ["○宮沢由佳君なぜそのキロワットになったのかというところが伺いたかったんですが、もう一度お願いできますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/58", "sentence": ["…お聞きします。四万キロワット未満若しくは三万キロワット未満の発電所建設予定地で貴重な生物が見付かった場合の対処について、御説明お願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/60", "sentence": ["…態について、子供たちに是非触れて、そして興味を持ってもらいたいという願いがあるんですけれども、こういったやっぱりきれいな沢とそして豊かな森林…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/68", "sentence": ["…うか。子供たちが自然の中で学び、遊べる環境を維持しながらカーボンニュートラルを達成すべきと考えますけれども、大臣の御所見をお願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/70", "sentence": ["…世界各国の施策と比較して、全く功を奏していないか相当遅れていると考えます。この点、真摯に反省すべきと思いますが、大臣の御所見をお願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414080X00220210406/85", "sentence": []}]}]}]