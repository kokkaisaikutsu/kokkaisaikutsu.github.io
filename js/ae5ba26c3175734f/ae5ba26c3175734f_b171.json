[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/27", "sentence": ["…ただきたいというふうに思います。次の質問ですけれども、順番を変えて、豚熱について伺いたいと思います。まず、豚熱の現状について教えてください。", "…ただきたいというふうに思います。次の質問ですけれども、順番を変えて、豚熱について伺いたいと思います。まず、豚熱の現状について教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/31", "sentence": ["○宮沢由佳君ありがとうございます。是非よろしくお願いします。豚熱ですけれども、終息のめどは立っているのでしょうか。大臣、お答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/33", "sentence": ["○宮沢由佳君昨日、アフリカ豚熱に関する訪日中国人へのアンケートの報道がありましたが、大臣は御存じですか。御存じでしたら、どのような感想を持た…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/35", "sentence": ["○宮沢由佳君アフリカ豚熱に対して、水際で多くの方々が尽力いただいていることには心より感謝と敬意を表したいと思いますが、その上で、アンケート結…", "…掛けて対応しなければならないと思いますが、いかがでしょうか。アフリカ豚熱に関する水際対策の現状と、アンケート結果を踏まえて更に踏み込んだ今後…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00420200318/51", "sentence": []}, {"ur