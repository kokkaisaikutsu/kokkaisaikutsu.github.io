[{"date": "2020-05-08", "meeting": [{"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/62", "sentence": ["…言葉には程遠い。また、地方が主役となる地方創生の実現、また地方移住の裾野を拡大する、ＳＤＧｓ未来都市、本当に耳当たりのいい言葉がいっぱい並ん…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/70", "sentence": ["…四年、達成していただきたいと思います。次に、所信において、地方移住の裾野を拡大するとおっしゃっています。地方移住の現状をどのように捉えていら…", "…は、移住者の特徴はリタイアされた方々や子育て中の方々が多いようです。裾野を拡大とは、具体的にどの世代の移住をもっと増やそうとしていらっしゃる…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00320200508/76", "sentence": ["…あります。大臣は、厚生労働省が具体的な病院名を公表した公的な病院の再編検討について、地方移