[{"date": "2020-04-27", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X01420200427/24", "sentence": ["…に伴う休業・自粛要請は補償とセットであり、補償なくして休業なしです。収入減に対する補償はいまだ微々たるものです。政府は、事業者やフリーランス…", "…予も必要です。外出、休業要請とそれに連鎖する経済縮小と消費減少による収入ゼロ状態が続いています。今回の一律十万と中小・小規模事業者への持続化…", "…めるべきです。共同会派として予算の組替えを要求します。また、我々は、収入が減った事業者にとり大きな支出項目である家賃の支払を猶予する家賃猶予…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115254X01420200427/26", "sentence": []}]}]}, {"date": "2020-06-11", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/464", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/466", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/468", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/470", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/473", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/475", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/477", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/479", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/481", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/483", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/485", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/487", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/489", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/491", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/493", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/495", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/497", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/1201