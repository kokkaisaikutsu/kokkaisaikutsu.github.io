[{"date": "2020-02-20", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/6", "sentence": ["…てこの税制を優先適用するという考え方が必要ではないかというふうに思います。地方創生の観点から５Ｇを捉える総務省の考え方を伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/12", "sentence": ["…いうふうに思います。泉佐野市の過剰な返礼品が問題になり、泉佐野市は、総務省がふるさと納税制度から市を除外したことを不服として訴訟まで起こしま…", "…ます。そこで伺いたいんですが、ふるさと納税を今後維持していく場合に、総務省の運用指導という形ではなく、制度としてモラルハザードを起こさせない…", "…としてモラルハザードを起こさせないような仕組みを考えていく必要があるのではないかというふうに思いますが、総務省はどのようにお考えでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/14", "sentence": ["…定的な考え方は古いのではないか、そんなふうに思えて仕方がありません。総務省も発想を柔軟にしていただく必要があるのではないか。今回の一連の騒動…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/18", "sentence": ["…を育てる必要があるというふうに思います。地域の景観をよりよくするための固定資産税制のあり方について、総務省の考え方をお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/24", "sentence": []}]}]}, {"date": "2020-11-12", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304601X00220201112/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304601X00220201112/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304601X00220201112/9", "sentence": ["…て大都市制度のあり方について政府の内部でも検討を期待する政令指定都市側の意見もあると承知しておりますが、総務省の考え方を伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304601X00220201112/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304601X00220201112/14", "sentence": []}, {"url": "https://