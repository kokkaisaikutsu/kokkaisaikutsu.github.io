[{"date": "2020-02-20", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/10", "sentence": ["…が、私は、この両者の制度の差異の最大のものは、個人のふるさと納税には返礼品が許される、そして企業版のふるさと納税にはそれがないということ、つ…", "…ティブの差異に活用の差が出ているというふうに思います。なぜ、個人では返礼品など寄附者への利益供与が認められ、後者ではそれが禁止されているのか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/12", "sentence": ["…、これは微妙なところではないかというふうに思います。泉佐野市の過剰な返礼品が問題になり、泉佐野市は、総務省がふるさと納税制度から市を除外した…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/14", "sentence": ["…あくまでも納税ですから、受け取った自治体は寄附だという理解ではなく、返礼品を出さないと気が済まないという気持ちにはならないという理屈でござい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X00520200220/24", "sentence": []}]}]}]