[{"date": "2021-04-02", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/6", "sentence": ["…されている、本当に皆さん感謝しておられます。今回の法改正の中で、地域主体の協議会を設ける枠組みが設定されております。こうした枠組みというのは…", "…設置されていくことを大いに期待したいと思いますが、環境省として、地域主体の協議会の活用とそれを全国展開するためにどんな対応を考えているのか、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/12", "sentence": ["…いう現状を踏まえつつ、一体、登山道整備の法的位置づけは何なのか、責任主体はどこなのかということが改めて問われていると思います。登山道整備につ…", "…、責任主体はどこなのかということが改めて問われていると思います。登山道整備についての自然公園法上の責任主体を伺わせていただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X00420210402/25", "sentence": []}]}]}]