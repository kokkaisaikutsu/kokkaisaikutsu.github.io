[{"date": "2021-03-30", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/19", "sentence": ["…院に入院できる、又は入院が必要、病院まで入院が必要ない方々に関して、自宅療養でコロナ患者さんが療養していただいている方もたくさんいるわけです…", "…ＳＯＳを出したときにどういう仕組みでその方々の療養しているところに、自宅なりホテルなりに私はやっぱり行っていただきたいということがすごくあり…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/21", "sentence": ["…は、委託事業として緊急包括支援金を活用させていただきまして、そういう自宅とかホテルで療養している方々に対して対応できるようになっておるんです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00520210330/27", "sentence": []}]}]}]