[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/107", "sentence": ["○高瀬弘美君ありがとうございます。今局長の方から御指摘がありました運動不足、ストレス、遊び場所がないこと、まさにこういうことが保護者の皆様の…", "…中で上がってきました声で一番大きかった困り事は、今おっしゃった子供の運動不足でございました。二番目が子供のストレス、そして三番目が学習の遅れ…", "…遊び場がないこととなっておりました。この一番の困り事であります子供の運動不足に関しては、特に校庭を開放していない学校が多くあるというふうに言…", "…ういうふうに書いてありました。児童生徒の健康維持のために屋外で適度な運動をしたり散歩をしたりすること等について妨げるものではなく、感染リスク…", "…乱を招き、内容も少し変わったと認識をしておりますが、文科省の学校の校庭開放、子供の運動不足についての認識、どのように変わりましたでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00320200318/131", "sentence": []}]}]}]