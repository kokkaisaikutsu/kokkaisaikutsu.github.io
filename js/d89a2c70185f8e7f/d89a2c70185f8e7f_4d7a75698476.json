[{"date": "2020-04-07", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/136", "sentence": ["…、文化観光に関する拠点機能の強化が不可欠であることから、博物館のうち積極的な取組を行う施設を文化観光拠点施設とし、これを中核として地方自治体…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/146", "sentence": ["…言いますけれども、この登録に向けて、県、市、地元の方々が協力しながら積極的に推進しているところでございます。こうした民俗文化財が全国的にまだ…", "…にまだまだ多くありますことから、専門家の協力も得ながら、国としてより積極的に調査をしていただきたいと思いますが、政府の見解、教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115104X00520200407/156", "sentence": []}]}]}]