[{"date": "2020-03-06", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/153", "sentence": ["…の週刊文春において、記事が出てしまいました。「茂木外相安倍会見当日にゴルフしていた」ということで、二月二十九日午後六時から、小中学校の休校要…", "…ポーツイベントの中止、延期を含む首相会見が行われたときに、友人三名とゴルフをしていたとされています。各国との情報交換あるいは連携強化の責任者…", "…。各国との情報交換あるいは連携強化の責任者である外務大臣が、この日にゴルフをするとはというニュアンスの記事ですけれども、取材に対して、ゴルフ…", "…にゴルフをするとはというニュアンスの記事ですけれども、取材に対して、ゴルフに行ったという事実もまだお認めになっていないようなので、その確認。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/155", "sentence": ["○森山（浩）委員済みません、ゴルフをしたということについてのお答えがないということですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/162", "sentence": ["…会議をサボって地元の行事に行っていたという話ではありませんので、私、ゴルフをされていたこと自体はそんなに悪い話ではないのではないかなと思って…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/174", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/176", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/178", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/180", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/182", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/184", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/186", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00220200306/188", "sentence": []}]}]}]