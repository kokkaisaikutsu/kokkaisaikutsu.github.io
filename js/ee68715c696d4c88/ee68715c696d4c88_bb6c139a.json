[{"date": "2020-05-20", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/30", "sentence": ["…森山（浩）委員実は、厚生労働省さんとお話をさせていただいて、国内での治験というのが六月末をめどにしているというふうにお聞きをしています。これ…", "…聞きをしています。これは、こうやって供与したときに、六月末に合わせて治験というような形にすれば、これは日本にとっても反射的な利益をいただける…", "…的な利益をいただけるような形になったんじゃないかなと思いますが、共同治験ではなくて臨床試験というような形であったと。この臨床試験については、…", "…験というような形であったと。この臨床試験については、六月末というのは治験の方では期限があるわけですけれども、期限については決められております…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00820200520/55", "sentence": []}]}]}]