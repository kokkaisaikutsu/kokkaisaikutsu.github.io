[{"date": "2020-11-19", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/35", "sentence": ["…もさまざまな懸念や問題点について御議論をいただいたと思います。例えば資源管理、沿岸漁場の利用等について御指摘があったと聞いておりますが、これ…", "…行ってきたところでもあります。例えば、法案審議の際に議論となりました資源管理につきましては、現行のＴＡＣ対象魚種につきましてＭＳＹベースの資…", "…源管理につきましては、現行のＴＡＣ対象魚種につきましてＭＳＹベースの資源評価を実施をしております。また、本年九月には資源管理ロードマップを決…", "…ましてＭＳＹベースの資源評価を実施をしております。また、本年九月には資源管理ロードマップを決定、公表しまして、科学的な資源調査、評価の充実、…", "…また、本年九月には資源管理ロードマップを決定、公表しまして、科学的な資源調査、評価の充実、またＴＡＣによる管理の推進など、新たな資源管理シス…", "…科学的な資源調査、評価の充実、またＴＡＣによる管理の推進など、新たな資源管理システムの構築のために道筋を示したところであります。そのほか、申…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00620201119/85", "sentenc