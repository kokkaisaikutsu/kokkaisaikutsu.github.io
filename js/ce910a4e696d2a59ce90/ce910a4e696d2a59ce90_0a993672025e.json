[{"date": "2021-04-14", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/31", "sentence": ["○野上国務大臣まず、養父市についてでありますが、養父市が中山間地域という大変厳しい条件の中で地域農業の振興に取り組んでおられることは高く評価…", "○野上国務大臣まず、養父市についてでありますが、養父市が中山間地域という大変厳しい条件の中で地域農業の振興に取り組んでおられることは高く評価…", "…業の振興に取り組んでおられることは高く評価したいと思います。一方で、養父市に適用されている特例につきましては様々な意見があるものと承知をして…", "…業して、その所有する農地は農業利用されていないという現状にあります。養父市によれば、今後も複数の企業が本特例措置を活用する可能性もあるという…", "…例措置の期限を二年延長する国家戦略特区法の改正法案が国会に提出されておりまして、引き続き、養父市の取組を応援してまいりたいと考えております。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405007X00620210414/142", "sentence": []}]}]}]