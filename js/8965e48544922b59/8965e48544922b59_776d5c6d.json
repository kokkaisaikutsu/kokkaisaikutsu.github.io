[{"date": "2021-06-01", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/125", "sentence": ["○斉藤（鉄）委員分かりました。次に、法改正では、自然海浜が対象の保全地区にいわゆる再生された藻場も指定できるようになっております。藻場、干潟…", "…きるようになっております。藻場、干潟等が再生、創出された区域等も自然海浜保全地区に指定することができるということでございます。私は大変いいこ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/127", "sentence": ["…、ありがとうございました。おっしゃるとおり、本当に心が癒やされる自然海浜を拡充していかなきゃいけないと思います。数値目標また達成目標をつくる…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/131", "sentence": []}]}]}]