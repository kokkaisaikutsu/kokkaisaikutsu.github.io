[{"date": "2021-02-22", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/64", "sentence": ["…思いますので、しっかり対応をお願いしたいと思います。次に、核軍縮、核廃絶についてお伺いしたいと思います。核兵器禁止条約が発効して一か月がたち…", "…、これが延長するということが決まりました。このように、今、核軍縮、核廃絶に向けて世界の機運が変わってきている、このように思います。今重要なの…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/68", "sentence": ["…核兵器のない世界の実現に向けて議論をしていくべきではないか、このように思います。菅総理の核兵器廃絶に向けての御決意をお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01520210222/77", "sentence": []}]}]}]