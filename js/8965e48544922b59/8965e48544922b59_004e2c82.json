[{"date": "2021-05-28", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/92", "sentence": ["…ついて質問をさせていただきます。ちょっと古いんですが、二〇一八年に、一般社団法人全国清涼飲料連合会が自動販売機の横に置かれているリサイクルボ…", "…されました。まず、環境省にお伺いしますが、リサイクルボックス内に捨てられた、いわゆる一般廃棄物の処理責任者は誰ということになるんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/94", "sentence": ["…お答えは自販機を運営している事業者の責任だということなんですが、その一般社団法人の方はそう認識していませんで、こういう問題を認識してほしいと…", "…販機事業者の責任範囲はリサイクルボックス内の空容器までだ、そのほかの一般廃棄物の処分は、やはり、廃掃法に書いてあるとおり、地方自治体、市町村…", "…思います。それから、コンビニエンスストアの回収ボックスも、危険物等や一般廃棄物が捨てられるということで、店内に回収ボックスを入れるようになっ…", "…る。こういうことが重なって、結果的に自動販売機のリサイクルボックスの一般廃棄物が増えてきた、こういうことでございます。まず、認識の違いを認識…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01220210528/107", "sentence": []}]}]}, {"date": "2021-06-01", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/119", "sentence": ["…戸内海の温度上昇なんですが、これは小野局長にお伺いしますが、いわゆる一般海洋への地球温暖化の影響と、こういう内海、瀬戸内海への影響は違うのか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/131", "sentence