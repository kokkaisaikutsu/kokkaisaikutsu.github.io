[{"date": "2021-06-01", "meeting": [{"meeting_name": "衆議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/127", "sentence": ["…はある意味で瀬戸内海に特有だと思っていまして、瀬戸内海を囲む山々から流れ出る川、多分、その川が洪水を起こしたときに岩と岩がぶつかって小さな砂…", "…水を起こしたときに岩と岩がぶつかって小さな砂ができる。ふだんの静かな流れのときにはとてもそんな砂はできないでしょうが、何万年かかったか分かり…", "…トル、十数メートルにもなっていたそうでございます。外海ではそれが潮の流れで流されていきますから、たまるということはないんだそうですけれども。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404006X01320210601/131", "sentence": []}]}]}]