[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/250", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/252", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/254", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/256", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/258", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/260", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/262", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/264", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/266", "sentence": ["…ありましたので、引用させていただきます。まず第一報は、朝日新聞による国有地が不当に廉売された疑いがあるという記事でした。不動産鑑定で九億五千…", "…近畿財務局へは家宅捜索を行わないまま不起訴処分を決めてしまいました。国有地売却についても、会計検査院から八億円値引きは十分な根拠を確認できな…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/268", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/270", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/272", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/274", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/276", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/278", "sentence": ["…りますと、国は、二〇一七年六月、売買契約時の特約に基づいて学園側から国有地を買い戻し、特約で定めた学園の原状回復義務を根拠に、校舎を解体して…", "…めていると聞いております。校舎の取壊しには費用が掛かるため、学園側は国有地と建物を一体で売却するよう国に要望しており、二年以上結論が出ない状…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/280", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/282", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/284", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/286", "sentence": ["…ます。ただ、個人的には、小学校という公共性の高い土地の使用について、国有の土地一億三千四百万円というものは、私は妥当だと考えております。つま…", "…地一億三千四百万円というものは、私は妥当だと考えております。つまり、国有の土地の価格というのは使用用途によって変化してもよいと思っております…", "…すように、このように値段というものは弾力性があってしかるべきだと思います。この森友問題で、国有の土地価格について財務省の見解をお聞きします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/288", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/290", "sentence": []}]}]}]