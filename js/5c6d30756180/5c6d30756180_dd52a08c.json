[{"date": "2020-05-22", "meeting": [{"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/137", "sentence": ["…反対だ。毎回がちゃぶ台返しの連続で、良く言えばエキサイティングな真剣勝負だ。なぜそうなるかというと、会議の中身が基本的に会議委員と役所の対決…", "…から、会議での議論はいつもガチンコ討議だ。予定調和とは正反対で、真剣勝負を繰り返しているわけだ。以上、引用を終わります。このように、国家戦略…", "…内閣府の方にお聞きします。現在でも、この国家戦略特区ワーキンググループはガチンコ討議、真剣勝負がなされておりますでしょうか、見解を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/139", "sentence": ["…常に興味深いと思います。ここでさらに、質問というか提案です。この真剣勝負である会議の様子を録画、撮影した上で、公開してみてはいかがでしょうか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/153", "sentence": []}]}]}]