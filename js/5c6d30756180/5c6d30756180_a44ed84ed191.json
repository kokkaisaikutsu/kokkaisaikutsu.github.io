[{"date": "2020-03-19", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/159", "sentence": ["…取り上げてみたいと思って話題にさせてもらいました。次に、国立大学運営交付金についてのお話をさせていただきます。昨年十一月七日の参議院財政金融…", "…させてもらいます。少し研究者の声を紹介させてもらいます。国立大学運営交付金は若手の研究者の安定したポストの数に直結しますので、若手研究者には…", "…える必要があると思います。そこで、主計局にお聞きします。国立大学運営交付金は、最近では下げ止まっていますので、その点については頑張っていると…", "…ます。ただ、今後これを上げていく方針があるのかどうか、また、この運営交付金以外での支援方法を組み合わせて研究者支援を検討しているのかどうか、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00520200319/171", "sentence": []}]}, {"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00220200319/118", "sentence": []}]}, {"meeting_name": "参議院 東日本大震災復興特別委員会", "remarks": [{"url": "http