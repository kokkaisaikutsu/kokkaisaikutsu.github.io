[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/128", "sentence": ["…的に苦しくなって、住宅ローンの月々の返済が苦しくなる、場合によっては延滞する世帯も出てくるのではないかと想像します。こういった情勢なので致し…", "…。こういった情勢なので致し方ないという考えがある一方で、住宅ローンの延滞をすることでその後の状況が急激に悪化する可能性があると言われておりま…", "…る可能性があると言われております。住宅ローンに限らず、ローンの返済を延滞することによって様々なまずい状況に陥ると考えられるわけですが、特に住…", "…よって様々なまずい状況に陥ると考えられるわけですが、特に住宅ローンの延滞による悪影響として代表と思われることを二つ挙げさせていただきます。一…", "…一つは、住宅ローンの特徴である低く抑えられている優遇金利というものが延滞することで取消しとなって、金利が急激にアップするということ。二つ目は…", "…ることで取消しとなって、金利が急激にアップするということ。二つ目は、延滞情報が個人信用情報に記録され、その結果、新たなローン審査が通らなくな…", "…ませんが、新型コロナウイルス感染症の影響で大変な状況とはいえ、住宅ローンの延滞をするとこのようなまずい状況になる可能性はありますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/130", "sentence": ["○浜田聡君ありがとうございました。こんな状況とはいえ、住宅ローンの延滞は優遇金利に関しては維持されるということだったんですけど、延滞は避ける…", "…ーンの延滞は優遇金利に関しては維持されるということだったんですけど、延滞は避けるべきであると考えますし、そういう世帯が増えないようになればい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/153", "sentence": []}]}]}, {"date": "2021-05-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/129", "sentence": ["…すけど、滞った場合には、本来の受信料の支払額より高い額として、例えば延滞利息、あるいは割増金払うということが、放送法施行規則第二十三条であっ…", "…送受信規約第十二条などで定められております。ただ、ＮＨＫはこういった延滞利息、割増金については裁判以外は請求していないと我々承知しております…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/135", "sentence": []}]}]}]