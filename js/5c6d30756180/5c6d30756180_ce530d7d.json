[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/134", "sentence": ["…ていただきます。日本年金機構は、以前、委託業者を使って戸別訪問、債権収納業務をさせていたと承知しています。今回、配付資料として日本年金機構ウ…", "…た。これによると、平成二十九年七月十三日以降、委託業者の訪問員による収納業務を中止していることから現金をお預かりすることはありませんと書いて…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/138", "sentence": ["…、日本年金機構は、平成二十九年七月十三日以降、委託業者の訪問員による収納業務を中止しております。その背景として、その前日、七月十二日に訪問員…", "…。日本年金機構は、この訪問員の逮捕事案の翌日に委託業者の訪問員による収納業務の中止措置を講じ、民間委託業者の立入検査の実施もしていると承知し…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/160", "sentence": []}]}]}]