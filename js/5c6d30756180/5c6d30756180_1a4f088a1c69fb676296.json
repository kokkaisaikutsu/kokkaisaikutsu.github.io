[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/250", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/252", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/254", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/256", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/258", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/260", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/262", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/264", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/266", "sentence": ["…行わないまま不起訴処分を決めてしまいました。国有地売却についても、会計検査院から八億円値引きは十分な根拠を確認できないとの指摘を受けながらも…", "…りません。財務省は、国権の最高機関たる国会や憲法上の独立機関である会計検査院、さらには最強の捜査機関と目される大阪地検特捜部にまで改ざんされ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/268", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/270", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/272", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/274", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/276", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/278", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/280", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/282", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/284", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/286", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/288", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/290", "sentence": []}]}]}, {"date": "2021-05-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/129", "sentence": ["…ございます。今回、ＮＨＫがその受信料を徴収する場合の問題について、会計検査院にお伺いしたいと思います。本来払うべき者がＮＨＫ受信料支払滞った…", "…しそれが事実である場合は、公平負担の原則からは問題があると考えるわけですが、会計検査院としてこの件に関する見解を教えていただきたく思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/131", "sentence": ["…すが、その受信料が高いと指摘されているのも問題の一つだと思います。会計検査院の方には今回我々の問題意識を共有していただきたく思いまして、質問…", "…共有していただきたく思いまして、質問させていただきました。数年前に会計検査院がＮＨＫに対して調査した際に、その報告書には様々なＮＨＫの問題が…", "…、ＮＨＫが弁護士法七十二条違反に関する裁判など敗訴した際など、再度会計検査院の調査が必要な機会もあると思います。そういった際には、是非とも会…", "…査院の調査が必要な機会もあると思います。そういった際には、是非とも会計検査院の方で多くの問題を抱えるＮＨＫを徹底的な調査していただくよう、よ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/135", "sentence": []}]}]}]