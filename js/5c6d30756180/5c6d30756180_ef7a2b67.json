[{"date": "2020-05-22", "meeting": [{"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/145", "sentence": ["…変わりまして、情報セキュリティーと業務効率向上に関して、ネットワーク端末利用時のログイン方法に関して総務省と厚生労働省の方に質問させていただ…", "…、総務省に確認というか、質問です。企業、組織でネットワークに接続した端末を使う際、現在もパスワードの定期変更は推奨されていないという認識でよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/147", "sentence": ["…聞きします。御参考までに、総務省内で職員の方がネットワークに接続した端末を使う際のシステムはどのようになっているか、教えてもらえますでしょう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/149", "sentence": ["…と思います。最近ですと、生体認証や顔認証もありますし、スマートフォン端末などを利用しての二段階認証などもあります。施設ごとに積極的に導入を進…", "…省の方にお聞きします。厚生労働省内で職員の方がネットワークに接続した端末を使う際のシステムはどのようになっていますか、教えてもらえますでしょ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/151", "sentence": ["…由があります。それは、全国の病院で使われている電子カルテサービスで、端末にログインする際にいまだにパスワードの定期変更を要求されるところがあ…", "…あるからです。幾つかの病院の状況を聞いてみますと、いまだに電子カルテ端末にログインする際のパスワードの定期変更が要求されております。先ほど御…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115328X00620200522/153", "sentence": []}]}]}, {"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/132", "sentence": ["…わりまして、情報セキュリティーや業務効率向上等に関して、ネットワーク端末利用時のログイン方法に関して引き続き金融庁の方に質問させていただきま…", "…そこで、金融庁にお聞きします。金融庁内で職員がネットワークに接続した端末を使う際のシステムはどのようになっているか、教えてもらえますでしょう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/153", "sentence": []}]}]}]