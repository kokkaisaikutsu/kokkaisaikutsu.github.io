[{"date": "2021-03-23", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/229", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/233", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/235", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/237", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/239", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/241", "sentence": ["…させていただきたいと思います。中国においては、人々が多くの種類の野生動物を食べる習慣があります。他の国では食べないような食べ物を、動物を食べ…", "…の野生動物を食べる習慣があります。他の国では食べないような食べ物を、動物を食べていたり、また、その管理状況も十分ではないと指摘されております…", "…の習慣がすぐに変わることは予想しにくいと考えますと、今後も中国発祥の動物由来の感染症、発生する可能性があると思うんですが、これについて厚生労…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/243", "sentence": ["…りません。先ほど申し上げたＳＡＲＳのときを振り返りますと、中国は野生動物の食肉に関して見直しと禁止を世界に約束したのに、結果的に何も禁止がで…", "…止ができておらず、現在に至るのではないかと思います。今後も、中国内の動物由来の感染症の発症が続くことに関して警戒を訴えていきたいと思います。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/245", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/247", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/249", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/251", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/253", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/255", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/257", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00520210323/259", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00