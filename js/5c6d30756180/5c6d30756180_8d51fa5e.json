[{"date": "2020-05-14", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/93", "sentence": ["…いただいて、次の質問に移ります。次に、森友学園の民事再生法による経営再建について法務省にお聞きします。数年前の話になりますが、森友学園は、小…", "…ＨＫから国民を守る党の党首立花孝志が、先般、八千四百万円を森友学園の再建のために寄附しております。しかし、この計画の管財人である疋田淳弁護士…", "…の受取を拒否していると聞いております。これでは、民事再生法による経営再建に支障を来すことになります。そこで、法務省にお聞きします。必ずしも今…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01220200514/99", "sentence": []}]}]}]