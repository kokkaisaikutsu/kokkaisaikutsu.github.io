[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/142", "sentence": ["…イトの記載を見ると、次のような記述があります。租税原則は結局、公平、中立、簡素の三つに集約することができますとあります。そこで、財務省にお聞…", "…今回紹介したのは内閣府の資料でありますが、財務省としても、この租税原則、公平、中立、簡素を重視していますでしょうか。見解をお聞かせください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/144", "sentence": ["…うございます。引き続き、この内閣府の資料を見ますと、この原則、公平、中立、簡素について更に記述があります。この三つ、「「公平・中立・簡素」は…", "…則、公平、中立、簡素について更に記述があります。この三つ、「「公平・中立・簡素」は、常にすべてが同時に満たされるものではなく、一つの原則を重…", "…オフの関係に立つ場合もあります。」と書いてありまして、つまり、公平、中立、簡素、三つが全て満たすというのは難しいこともあるとのことです。昨年…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/153", "sentence": []}]}]}, {"date": "2021-03-22", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X00420210322/261", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00420210322/263", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X00420210322/265", "sentence": ["…ただきます。内閣府のウエブサイトに、租税原則の記載があります。公平、中立、簡素の三つに集約することができると書かれております。ここでの記述を…", "…きると書かれております。ここでの記述を紹介させていただきます。公平、中立、簡素は、常に全てが同時に満たされるものではなく