[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/132", "sentence": ["…と、規制を強める、逆に規制を緩和するなどがあると思われますが、特に規制緩和について菅政権には期待をしています。今回、配付資料として、総務省行…", "…権への期待を込めまして、共有させていただきました。経済成長のための規制緩和について、海外に目を向けると、興味深い事例があります。例えばアメリ…", "…載させていただきました。このように、経済産業省そして総務省、恐らく規制緩和を進めたいという意思があるからこそ、このような資料を作って公表して…", "…るのだと思います。そこで、政府にお聞きします。政府として、今後更に規制緩和を進めていくことで、例えばアメリカのような二対一ルール、カナダのよ…", "…、例えばアメリカのような二対一ルール、カナダのようなワン・フォー・ワン・ルールなど、規制緩和のルール導入を検討する方針はありますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00420201201/160", "sentence": []}]}]}, {"date": "2021-05-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414370X01120210518/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414370X0