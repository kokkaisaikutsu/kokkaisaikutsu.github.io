[{"date": "2020-10-07", "meeting": [{"meeting_name": "衆議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/20", "sentence": ["…を受けた独立の法人とすることが望ましい」と書いてあります。一方、この改革に関して、平成十五年に、今後十年以内に新たなあり方を検討するための体…", "…いますけれども、この独立する云々かんぬんの話が今どうなっているのか、その改革方針がどうなっているのか、これを最後にお伺いをしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120204889X00220201007/22", "sentence": []}]}]}]