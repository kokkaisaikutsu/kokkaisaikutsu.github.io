[{"date": "2022-02-01", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/2", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/5", "sentence": ["○薗浦委員長以上で大臣の所信聴取は終わりました。この際、岡本財務副大臣、大家財務副大臣、黄川田内閣府副大臣、藤原財務大臣政務官、高村財務大臣…", "…大臣政務官、高村財務大臣政務官及び宗清内閣府大臣政務官から、それぞれ発言を求められておりますので、順次これを許します。財務副大臣岡本三成君。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120804376X00120220201/17", "sentence": []}]}]}]