[{"date": "2020-08-26", "meeting": [{"meeting_name": "参議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/42", "sentence": ["…られています。災害義援金については、平成二十三年以降の大規模災害時に差押えを禁止する法律が制定されてきています。これまでの災害義援金差押禁止…", "…二十三年以降の大規模災害時に差押えを禁止する法律が制定されてきています。これまでの災害義援金差押禁止法について、法律名のみ内閣府に伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/46", "sentence": ["…まで七つが特定非常災害に指定をされてきているわけで、その災害義援金を差押えすることを禁止する法律自体は、平成二十三年以降しかありませんので、…", "…で、今まで四本できています。では、今内閣府から答弁があった四本の災害義援金差押禁止法は内閣提出法律案か議員立法かを参議院議事部長に伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/48", "sentence": ["…平成二十三年東日本大震災以降の特定非常災害については、全て災害義援金差押禁止法が制定されています。令和二年七月豪雨も先般特定非常災害に指定さ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/56", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/58", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/60", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114339X00220200826/70", "sent