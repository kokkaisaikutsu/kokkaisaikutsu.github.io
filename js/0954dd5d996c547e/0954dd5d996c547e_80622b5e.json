[{"date": "2020-03-31", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/70", "sentence": ["○吉川沙織君では、この常時同時配信について違う観点から、今度は技師長に伺いたいと思います。令和二年度においては、同時配信は地上放送のみ、一日…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/72", "sentence": ["…、二十四時間実施となった場合、４Ｋ、８Ｋ、想定されていないということでしたので、これは想定すべきものと考えますが、技師長、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/74", "sentence": ["…できる環境の整備にもＮＨＫは責任を負うのではないでしょうか。常時同時配信による通信網の整備に対する認識を技師長に伺います。なければ結構です。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/1