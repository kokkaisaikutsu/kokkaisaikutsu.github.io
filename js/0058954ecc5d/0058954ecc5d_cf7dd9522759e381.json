[{"date": "2020-03-31", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/23", "sentence": ["…ございます。是非とも取組を進めていただければと期待を申し上げます。総務大臣にもお伺いをしたいと思います。先ほど説明のございました総務大臣意見…", "…す。総務大臣にもお伺いをしたいと思います。先ほど説明のございました総務大臣意見の中にも、情報公開を一層推進することにより、運営の透明性の向上…", "…営の透明性の向上を図り、自ら説明責任を適切に果たしていくことという総務大臣意見をＮＨＫに対して述べられておられます。こういった人件費を含めた…", "…務大臣意見をＮＨＫに対して述べられておられます。こういった人件費を含めた説明責任の重要性について、総務大臣としての御見解をお聞かせください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/25", "sentence": []}]}]}, {"date": "2021-05-11", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/20", "sentence": ["…、そのためにはセキュリティー確保をしっかりとしていくことが重要だと思いますが、その主軸たる総務大臣の御決意をお聞かせいただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X01320210511/22", "sentence":