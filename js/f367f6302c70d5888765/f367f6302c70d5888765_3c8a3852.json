[{"date": "2020-03-31", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/229", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/231", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/233", "sentence": ["…よ。じゃ、その一千億円を何に使っているのかといったならば、毎年、有価証券を買っているわけですよね。毎年、大体これは五百億から七百億円規模の有…", "…買っているわけですよね。毎年、大体これは五百億から七百億円規模の有価証券を買っているわけです。これ、毎年積み上がっている有価証券の平成三十年…", "…円規模の有価証券を買っているわけです。これ、毎年積み上がっている有価証券の平成三十年度末の帳簿価格は五千七百二十九億円ということで、巨額の資…", "…運用しています。この集めたお金を事業に投資するということではなくて、証券で運用しているばかりか、その証券も実質的にはこれはほぼ現金に等しいよ…", "…事業に投資するということではなくて、証券で運用しているばかりか、その証券も実質的にはこれはほぼ現金に等しいような債券ばかりであります。ですか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/235", "sentence": ["…巨額のものかということはよく御存じだというふうに思います。それを有価証券にしていると、安定的だからということ、それはそのとおりなんでしょう。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/237", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/239", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X01020200331/271", "sentence": []}]}]}, {"date": "2021-06-04", "meeting": [{"meeting_name": "参議院 地方創生及び消費者問題に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415328X01320210604/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01320210604/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01320210604/90", "sentence": ["…方法に関する同様の例は何かあるのかということをお伺いしたところ、日本証券業協会の高齢顧客への勧誘による販売に係るガイドラインの例を御紹介いた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01320210604/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01320210604/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415328X01320210604/