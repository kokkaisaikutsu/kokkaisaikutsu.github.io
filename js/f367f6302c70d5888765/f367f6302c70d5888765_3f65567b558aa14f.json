[{"date": "2021-03-23", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/120", "sentence": ["…君非常に力強いお言葉をありがとうございます。今、総務大臣から規制の政策評価のお話が出ました。私は、この規制改革を進めていくために何が必要かな…", "…ために何が必要かなというふうに考えたときに、この総務省のやっている政策評価が極めて重要な事業ではないかというふうに考えるに至りました。改めて…", "…っている政策評価が極めて重要な事業ではないかというふうに考えるに至りました。改めて、この規制の政策評価の目的についてお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/122", "sentence": ["…から、この規制をしっかりとチェックするシステムが必要で、それにこの政策評価というのは資する制度なんではないかというふうに考えるんです。その上…", "…なんではないかというふうに考えるんです。その上で、じゃ、この規制の政策評価がきちんと機能しているのかどうかということを問いたいと思います。こ…", "…と機能しているのかどうかということを問いたいと思います。この規制の政策評価の事前評価に関しては平成十九年から、事後評価に関しては平成二十九年…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/128", "sentence": ["…れ非常に少ないんですね。この件に関しては、平成二十七年の三月九日、政策評価・独立行政法人評価委員会が取りまとめた提言においても、費用や便益の…", "…、金銭価値化が不十分と指摘がされています。また、平成二十九年三月の政策評価審議会においても、これまでの規制の事前評価では、事前評価書に記載さ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00620210323/130", "sentence"