[{"date": "2020-02-04", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/15", "sentence": ["…野国務大臣米軍と共有するのはあくまでも一般的な情報交換でございまして、その情報だけをベースに米軍が武力を行使するということは想定できません。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/17", "sentence": ["…日一回程度のやりとりということになろうかと思いますので、何かその情報をもとに米軍が武力を行使するということにはならないというふうに思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/19", "sentence": ["…ＨＦの直接のやりとりというのはあると思いますが、その情報だけで米軍が武力行使ができるというものではないと思います。自衛隊が収集しますのは、活…", "…航行の安全に影響を及ぼすような情報を集めるわけでございますので、それだけをベースに米軍が何か武力行使をするというのは想定できないと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/571", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/573", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/575", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/579", "sentence": []}]}]}, {"date": "2020-04-07", "meeting": [{"meeting_name": "衆議院 安全保障委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103815X00420200407/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00420200407/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00420200407/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00420200407/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00420200407/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103815X00420200407/23", "s