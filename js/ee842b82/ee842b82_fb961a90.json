[{"date": "2020-06-11", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/21", "sentence": ["…ここ電話ないんですよ、事務所に。で、事務所に行ったら、人いないんですよ。電通に取材したら、答えないって言うんですよ。これ、適切な対応ですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/39", "sentence": ["○蓮舫君電通に約二億で規格認証の実態調査を委託、これが成果物です。成果物はその年度末に報告されたんですが、三月から電通はこのおもてなし認証機…", "…、これが成果物です。成果物はその年度末に報告されたんですが、三月から電通はこのおもてなし認証機関のどういう要件を満たしたら公募に有利になるか…", "…を全部知っていたんですね。それを受けて、五月の十六日の公募の初日に、電通社員だった平川、協議会の現業務執行理事と、パソナ、トランスコスモスの…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/49", "