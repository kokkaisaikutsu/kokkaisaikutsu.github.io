ce": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/157", "sentence": ["○蓮舫君慎重な検討、是非お願いしたいと思います。次に、総理、コロナ感染症対策の専門家会議、これ議事録はなぜ公開しないんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/166", "sentence": ["…大臣、先ほど西村さんが言ったような歴史的緊急事態の、ガイドラインで、専門家会議は政策を決定しないから残さないでいいというのは筋が通らないんじ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/173", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/175", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/177", "sentence": ["○蓮舫君そうすると、そのコロナ感染症対策本部の決定に至るその経緯は、専門家会議は含まれますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/181", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/183", "sentence": ["○蓮舫君総理、専門家会議の議事録公開しないで、歴史的に今後検証可能だとお考えですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/185", "sentence": ["○蓮舫君専門家会議の話をしています。今総理も言われて、第一回目の会議で議事録は残さないというような了解を取ったと言って、官房長官も会見で何度…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/187", "sentence": ["…論されて残しているのか残されていないのか、だから全部出してくれと言っているんですよ。この専門家会議の議事録の作成、公開は誰が決めるんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/189", "sentence": ["○蓮舫君詳細に残されている。第一回目、九十二分の掛かった専門家会議の議事録、加藤厚労大臣と総理の挨拶を除いたら、専門家会議の発言、一枚半です…", "…回目、九十二分の掛かった専門家会議の議事録、加藤厚労大臣と総理の挨拶を除いたら、専門家会議の発言、一枚半ですよ、九十二分が。これ詳細ですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/191", "sentence": ["○蓮舫君対策本部で専門家会議の開催を決めました。それによると、専門家会議の運営に関する事項その他必要な事項は誰が決めるとあります。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/193", "sentence": ["○蓮舫君二月十四日、感染症対策本部で決めた新型コロナウイルス感染症対策専門家会議の開催について、誰が必要な事項を決めると決めていますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/195", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/199", "sentence": []}]}]}, {"date": "2021-01-27", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X00120210127/421", "sentence": []}, {"url": "