[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第三分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/289", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/291", "sentence": ["○高村分科員ありがとうございます。本当に、外務省としても日本政府としても、しっかりとした対応をしていただいているんだと思います。ただ、なかな…", "…、本当に残念だと思います。続きまして、新型コロナウイルス感染症への日本政府の対応について、外務省としてどのような形で効果的に対外発信している…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/293", "sentence": ["…つか出てきているような報道も聞いております。そのような国に対して、日本政府として今後どのように対応していかれるのか、このことについて教えてく…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/295", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/297", "sentence": ["…とに、今後、日本が主導して新たな国際的なルール作成に取り組んでいく意思が日本政府にあるかどうか、この辺について教えていただければと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/299", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/301", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/303", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/305", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/307", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/309", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/311", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/313", "sentence": []}]}]}]