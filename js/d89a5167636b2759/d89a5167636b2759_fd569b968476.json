[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第三分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/289", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/291", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/293", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/295", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/297", "sentence": ["…ズ船です。本来日本には責任がないとの話もありますが、今後、このような国際的なクルーズ船の取扱いに関する、感染症が起きたときですね、ルールをつ…", "…船の取扱いに関する、感染症が起きたときですね、ルールをつくっていく、国際的なルールをつくっていく必要があると考えますが、今回の日本の経験をも…", "…ると考えますが、今回の日本の経験をもとに、今後、日本が主導して新たな国際的なルール作成に取り組んでいく意思が日本政府にあるかどうか、この辺に…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/299", "sentence": ["○高村分科員大臣、ありがとうございます。こういった国際的なルールがないことによって乗客の皆さんが本当に不利益をこうむることがないように、ぜひ…", "…皆さんが本当に不利益をこうむることがないように、ぜひ、日本が率先して国際的なルールをつくっていく、こういった提言をしていただければと思います…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/301", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/303", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/305", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/307", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/309", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/311", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/313", "sentence": []}]}]}]