[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第三分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/289", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/291", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/293", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/295", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/297", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/299", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/301", "sentence": ["…もと、二〇一九年八月のＴＩＣＡＤ７において、安倍総理が対アフリカ民間投資の拡大について表明しました。これを実現するための外務省の取組について…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/303", "sentence": ["…の人口がどんどん減っていくと言われている中で、やはりアフリカに対する投資というのは非常に大切だと思います。情けは人のためならず、しっかりと今…", "…非常に大切だと思います。情けは人のためならず、しっかりと今アフリカに投資することが将来日本に返ってくる、こういった思いで、ぜひ、我々だけがい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/305", "sentence": ["…ように思います。続きまして、ＴＩＣＡＤ７では、民間企業のアフリカへの投資促進が大きなテーマの一つでありました。本年一月、サブサハラ地域では、…", "…。本年一月、サブサハラ地域では、ＴＩＣＡＤ７後、初めてコートジボワールとの間で投資協定が署名されました。同協定の意義について教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/307", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/309", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/311", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105268X00120200225/313", "sentence": []}]}]}]