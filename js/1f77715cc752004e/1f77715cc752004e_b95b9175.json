[{"date": "2020-03-24", "meeting": [{"meeting_name": "参議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/29", "sentence": ["…一人入っていますけど、あとは財務省と近畿財務局と国土交通省。そして、容疑、捜査をされた容疑というのは六つ挙がっています。これほど多くの告発が…", "…ど、あとは財務省と近畿財務局と国土交通省。そして、容疑、捜査をされた容疑というのは六つ挙がっています。これほど多くの告発が出されていたという…", "…の交渉記録等を毀棄、隠蔽し、決裁文書の記載の一部を削除、改変したこの容疑、これについても不起訴、嫌疑なし又は嫌疑不十分。そして、虚偽有印公文…", "…データの顕出を妨げ、刑事事件に関する証拠を隠滅するなどした、こうした容疑ですね、これについても嫌疑不十分、嫌疑なし、不起訴ということなんです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115206X00320200324/38", "sentence": []}]}]}]