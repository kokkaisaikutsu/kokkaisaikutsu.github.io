[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/103", "sentence": ["…ていくことが求められるんじゃないかというふうに思うわけですね。先ほど電子化のこの四月からのお話もちょっと御答弁をいただいたんですが、これ、本…", "…でも約八億円ということなんですよね。先ほど、四月からの免税販売手続が電子化されるというお話をしていただきました。現在、これ消費税免税を受ける…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/107", "sentence": ["○高木かおり君この電子化されることによって、一歩もちろん前進だと思います。同じ人が何度も購入をしているような場合ですとか、そういったことは今…", "…今まででしたら紙を何枚もめくってチェックをしなければならない。それが電子化されるということで、良いことだとは思うんですけれども、現在のところ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00520200318/119", "sentence": []}]}]}]