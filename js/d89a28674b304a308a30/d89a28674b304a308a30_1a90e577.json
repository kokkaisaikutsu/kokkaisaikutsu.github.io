[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/111", "sentence": ["…も大変重要なのではないかなと思うんですね。先日、私、ＣＯＣＯＡで陽性通知が来たという方にお話を聞いたら、無料でＰＣＲ検査を受けられるというの…", "…無料でＰＣＲ検査を受けられるというのも最初の画面には出てこないので、通知が来た段階では、そういうことも知らなかったりですとか、それで、ＣＯＣ…", "…ので、やはり、もし無症状感染者の方がいても、自分が症状が出なければ、通知が来てもそのままいろいろなところも移動して、なかなか自宅待機というと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/115", "sentence": []}]}]}]