[{"date": "2021-08-19", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/77", "sentence": ["…急にやっていただきたいというふうに思います。そして、もう一つ、抗体カクテル療法についてです。入院患者に加えて、自宅や宿泊施設療養者にも対象を…", "…ないという状態だと思うんですが、この軽症者の方々に対してもこの抗体カクテル療法、大変これは国民の皆様も期待をしていると思うんです。これを、入…", "…ことは、入院しているということは重症化しているということです。このカクテル療法は軽症者の方、七日間以内と言われているかと思いますが、その間に…", "…とには、こういった自宅で又は外来で、そういったところででもこの抗体カクテル療法というものが使えるように是非していっていただきたいと思うわけな…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414889X00320210819/87", "sentence": []}]}]}]