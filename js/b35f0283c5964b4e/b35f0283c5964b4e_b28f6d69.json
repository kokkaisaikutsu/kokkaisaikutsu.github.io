[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/136", "sentence": ["…査につきましては、オランダにも実は行ってまいりました。オランダは園芸農業が極めて盛んな国で、花でありますとかトマト、パプリカとか、こういった…", "…おります。そこで視察したハウス栽培でありますが、本当に極めてスマート農業というか画期的でありました。室温でありますとか水のリサイクル、あるい…", "…面でのリサイクルをしっかり取り組んでいるということで、まさにスマート農業を実践していたなという印象であります。訪れたトマト農家、トマト栽培会…", "…いて、税制も含めて総務省でお取組をいただいておりますけれども、これは農業だけではなくて、交通であるとか建設現場、あるいは教育の場で、いろんな…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/140", "sentence": []}]}]}, {"date": "2021-03-04", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/14", "sentence": ["…て５Ｇシステムを構築するいわゆるローカル５Ｇサービスの導入によって、農業、建設、医療など幅広い分野で地域や企業のニーズに合わせたきめ細かな５…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/16", "sentence": ["…、収穫などの省力化を行い、トマトなどを輸出産業化する最先端のスマート農業を展開し、我が国の農家に対しても技術指導を行っていました。我が国でも…", "…導を行っていました。我が国でも、つくばにある農研機構においてスマート農業の研究や実証実験を行い、着実に実績を上げつつありますが、実用化につい…", "…行い、着実に実績を上げつつありますが、実用化についてはオランダなどの農業先進国からは後れを取っています。少子高齢化の進展に伴い長期的に労働力…", "…収穫量を引き上げるとともに、農作業の効率化、省力化を行う上でスマート農業は不可欠です。とりわけローカル５Ｇの技術は我が国の農業のスマート化に…", "…う上でスマート農業は不可欠です。とりわけローカル５Ｇの技術は我が国の農業のスマート化にとって切り札とも言えるものであり、世界的にもまたこれか…", "…。我が国が世界をリードするチャンスも大いにあるのではないかと考えます。そこで、スマート農業の推進について野上農林大臣の御所見をお尋ねします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/36", "sentence": []}]}]}]