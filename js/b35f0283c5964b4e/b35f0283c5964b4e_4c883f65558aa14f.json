[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/18", "sentence": ["…どうもありがとうございました。少し質問の順番をずらしまして、続いて行政評価についてお伺いしたいと思います。資料三、お付けしましたので御覧いた…", "…ただきたいと思います。これ、先週総務省から発表された平成三十年度の行政評価プログラムに基づく遺品整理サービスについての調査結果ということでご…", "…の谷間を埋める形で消費者庁というのも発足したわけであります。今回、行政評価ということでこういったサービスについて調査されるということでありま…", "…いろんな面でのサービスについて、省庁間の縦割りを排除していく上でも行政評価の役割は極めて重要だというふうに思っております。その上で、例えば消…", "…連携して、こういったサービスについての対応をしっかり深めて、一層の行政評価機能を高めていくこと、これ重要じゃないかというふうに思っております…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/20", "sentence": ["…ということでありますけれども、まず一次的に、行政の中、政府の中での行政評価、行政監視についてしっかりと取り組んでいただきたいと思います。残り…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/134", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/136", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114601X00520200318/140", "sentence": []}]}]}]