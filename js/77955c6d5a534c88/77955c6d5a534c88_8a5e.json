[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/26", "sentence": ["…は、二〇一八年十二月四日の推進会議だったでしょうか、第十四回、カジノの床面積の上限を三％とするということでありますから、いわゆる面積で考えれ…", "…いう指摘もあるかもしれませんけれども、それでは、この僅か三％のカジノの床面積でいえばこれだけの部分にしかすぎないものが、外国人旅行客の招聘あ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/28", "sentence": ["○長浜博行君そのＭＩＣＥの部分は除いて、ＩＲの床面積三％ということから考えると、このＩＲを想定をしたときの旅行客数とあるいは経済効果は、三％…", "…ことから考えると、このＩＲを想定をしたときの旅行客数とあるいは経済効果は、三％、床面積比率よりは大きいと考えますか、全体の中に占める割合は。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00820200402/34", "sentence": []}]}]}]