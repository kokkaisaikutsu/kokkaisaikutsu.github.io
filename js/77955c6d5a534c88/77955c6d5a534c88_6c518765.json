[{"date": "2020-06-15", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/116", "sentence": ["…残していくことは大変重要であります。三段階で書いてありますが、普通の公文書管理ということも大変重要でありますが、それより二段階進んで、今回の…", "…対策というのはとても大事な意義を持っているというところでございます。公文書管理担当大臣にお聞きするつもりはありませんけれども、今回の行政文書…", "…インにおいて、個別の事態が歴史的緊急事態に該当するか否かについては、公文書管理を担当する大臣が閣議等の場で了解を得て判断するということで、か…", "…るかということに関しては、極めて狭い概念ではなくて、広く捉えてそれを公文書という形で残していっていただきたいというふうに思いますが、事務担当…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/118", "sentence": ["○長浜博行君ここまでの議論を聞かれて、総理、公文書に対するお考えはいろいろあると思いますが、いかがですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00720200615/124", "sentence": []}]}]}]