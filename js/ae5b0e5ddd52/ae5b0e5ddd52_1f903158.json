[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/148", "sentence": ["…川、吉田川、千曲川、それから氾濫危険情報が出た六河川で住民向けの緊急速報メールが配信できなかったということでございます。指定河川洪水予報は河…", "…予報を出すことができなかったとされているところであります。また、緊急速報メールは、河川事務所が上級庁である地方整備局の決裁を受けて配信する手…", "…りますけれども、手続の煩雑さが課題と言われております。洪水予報や緊急速報メールは住民の避難行動にもつながる重要な情報でございます。国交省の検…", "…ムでは、今回の事態を踏まえて、決壊、越水の確認と洪水予報の発表、緊急速報メールによる河川情報提供について検証を行っておりますけれども、どのよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/164", "sentence": []}]}]}]