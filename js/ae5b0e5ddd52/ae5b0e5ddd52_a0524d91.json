[{"date": "2020-05-18", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/131", "sentence": ["…告をいたしました。この中で、検査院は、スクールソーシャルワーカー重点加配の実績について、平成二十七年度は目標人数六百人に対し七十五人、二十八…", "…その原因も分析をしているところであります。また、検査院は、実際に重点加配を実施した地方公共団体におきましては、支援が必要な子供に一層関与でき…", "…きましては、支援が必要な子供に一層関与できるようになったというような加配の効果も指摘しているところでございます。そこで、伺います。文科省は、…", "…は、今回の会計検査院の報告を踏まえ、スクールソーシャルワーカーの重点加配が進まない原因をどのように認識しているのでしょうか、また今後どのよう…", "…ャルワーカーの重点加配が進まない原因をどのように認識しているのでしょうか、また今後どのように加配を進めていくのでしょうか、お伺いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/151", "sentence": []}]}]}]