[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/150", "sentence": ["…催期間前後に、関東を事業エリアとする二十六の鉄道事業者が期間限定で訪日外国人向けのＩＣ企画乗車券、ＴＯＫＹＯＳＵＰＰＯＲＴＥＲＳＰＡＳＳを設…", "…鉄道が乗り降り自由になるものであり、首都圏の複雑な鉄道網に不慣れな訪日外国人がスムーズに鉄道移動できるようにする価値ある企画だというふうに思…", "…るようにする価値ある企画だというふうに思います。この企画の進捗状況や、訪日外国人への周知をどのように行っていくのか、まず伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/164", "sentence": []}]}]}]