[{"date": "2020-05-18", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/141", "sentence": ["…君ありがとうございました。次に、二つ目の課題として、副次的な籍による交流ということについて伺いたいと思っています。現在、幾つかの地方公共団体…", "…住地の小中学校に副次的な籍を持って、学校行事や学習活動への参加などの交流を通して地域とのつながりの維持、継続を図る取組が行われているところで…", "…されておりました。文科省は、各自治体におけるこの副籍制度の実施状況や交流の具体的な内容などについて把握していますでしょうか、ちょっと御答弁を…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/143", "sentence": ["…ます。ただ、もう一方で、本当に、話を伺いますと、この副次的な籍による交流というのは保護者の頑張りによって成り立っているというふうなことでござ…", "…も、今ほど答弁ございましたとおり、文科省としてはこの副次的な籍による交流というのは大変意義があるというふうに御答弁をいただきました。実際のと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00520200518/151", "sentence": []}]}]}]