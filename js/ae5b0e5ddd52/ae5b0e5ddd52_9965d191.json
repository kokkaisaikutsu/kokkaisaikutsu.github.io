[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/142", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/152", "sentence": ["…というふうにございます。この大会のレガシーの一つといたしまして、鉄道料金の割引を受けられる障害者向けに、首都圏の鉄道で利用できるＩＣカードの…", "…思っております。先ほど朝日委員からも同様の御指摘がございました。鉄道料金の割引対象となる障害者や付添いの家族等にとりましては、鉄道事業者の路…", "…現在の仕組みは非常に不便であり、手続の煩雑さから、割引を受けずに正規料金を支払って乗車しているということもあるというふうにはお伺いをしている…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X00320200310/164", "sentence": []}]}]}]