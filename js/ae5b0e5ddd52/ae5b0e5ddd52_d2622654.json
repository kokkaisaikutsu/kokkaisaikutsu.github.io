[{"date": "2020-05-12", "meeting": [{"meeting_name": "参議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/59", "sentence": ["…これはＤＰＩ日本会議が昨年十月に行った利用実態調査、街頭に出て実際に拒否されることがあったかどうかということを調べた調査の結果でございますけ…", "…の結果でございますけれども、やはり二七％にこのＵＤタクシーによる乗車拒否があったということでございます。そういった意味では、今回、ソフト基準…", "…うことはいいことであるというふうに思いますけれども、その一方で、乗車拒否をなくすには、やはり研修をしっかりと行って、運転手の方が、ドライバー…", "…にわたって指導等を行ってきているわけですけれども、ただ、こういう乗車拒否がなくならないということは、やっぱりそれが、研修ということがなかなか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114319X01120200512/72", "sentence": []}]}]}]