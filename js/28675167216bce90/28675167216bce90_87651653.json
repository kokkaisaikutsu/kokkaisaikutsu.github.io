[{"date": "2020-05-12", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X01220200512/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01220200512/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01220200512/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01220200512/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01220200512/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01220200512/17", "sentence": ["…ってこれは当然だと思っております。しかし、我が国日本は、もともと木の文化が長い歴史の中で育まれてきたのもまた事実であり、木造住宅のよさ、こう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01220200512/19", "sentence": ["…ていかなくてはならないというふうに思っております。現在、ユネスコ無形文化遺産登録に向けて、伝統建築工匠の技、木造建造物を受け継ぐための伝統技…", "…した建築物に活用される植物性資材等の維持、確保などが重要であると思います。そこで、この文科省、文化庁の取組、支援策についてお伺いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01220200512/21", "sentence": []}]}]}]