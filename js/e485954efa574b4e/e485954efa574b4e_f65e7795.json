[{"date": "2020-11-17", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314260X00220201117/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00220201117/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00220201117/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00220201117/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00220201117/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00220201117/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00220201117/139", "sentence": ["…ン税制、今年度末で時限措置になるんですね。今、多分、厚生労働省はその延長を図ることを想定されていると思うんですけれども、私は是非想定、延長を…", "…の延長を図ることを想定されていると思うんですけれども、私は是非想定、延長を図っていただいて、できることならその適用範囲が、ノンスイッチＯＴＣ…", "…ションの推進を挙げられました。セルフメディケーションの推進策、あるいは税制の延長、適用範囲の拡大について、厚生労働省のお考えをお伺いしたい。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314260X00220201117/141", "sentence": []}]}]}]