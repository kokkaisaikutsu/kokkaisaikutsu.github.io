[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/121", "sentence": ["…んですよね、目指したのは。基本法が目指す望ましい農業構造というのは、効率的かつ安定的な農業経営を育成する、これは規模拡大する農業経営だと思う…", "…そういうふうに言い方を変えてきているのかということでいうと、やっぱり効率的、安定的な農業経営だけでは農業は維持できないんじゃないかと、生産基…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/123", "sentence": ["…も言いますけど。じゃ、所得は確保できるのかというのが次に来る問題で、効率的、安定的な農業経営は、他産業従事者と遜色のない水準の生涯所得を確保…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/134", "sentence": []}]}]}]