[{"date": "2020-03-25", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/430", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/432", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/434", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/436", "sentence": ["…、目下の最大の課題として雇用の維持ということを挙げています。雇用調整助成金は、北海道の場合は、緊急特定地域ということで助成率が五分の四という…", "…いる状況で、緊急宣言解除ということで、だからといって、四月に入ったら助成金を、この助成率を三分の二に戻すなんというのはあり得ないと思うんです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/438", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/440", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/442", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/444", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/446", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/448", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/450", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/452", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/454", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/456", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/458", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/460", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/462", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/464", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/466", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01420200325/468", "sentence": []}]}]}, {"date": "2020-06-12", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp