[{"date": "2020-03-26", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/180", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/182", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/184", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/186", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/188", "sentence": ["…べきだというふうに思うんですね。それで、獣医師の不足は、これワクチン接種にも影響を与えると思うんです。法定伝染病のワクチン接種は、民間の獣医…", "…、これワクチン接種にも影響を与えると思うんです。法定伝染病のワクチン接種は、民間の獣医師さんはできないですよね。それで、家畜保健所の獣医師に…", "…は、民間の獣医師さんはできないですよね。それで、家畜保健所の獣医師に接種を依頼するときにも、これ対応できないということになる。体制が不足して…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/190", "sentence": ["○紙智子君昨年、ワクチンの接種が始まったときに、これ、依頼してもすぐにワクチンが接種できなかったという事態もありました。ですから、防疫体制を…", "…年、ワクチンの接種が始まったときに、これ、依頼してもすぐにワクチンが接種できなかったという事態もありました。ですから、防疫体制を強化していた…", "…ただきたいということを求めておきたいと思います。それから、ワクチンの接種費用についてお聞きするんですが、都道府県によって農家負担が異なってい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/192", "sentence": ["…を講じるとなっています。少なくとも、やはりこの法定伝染病のワクチンの接種料は都道府県で差が出ることのないように、やっぱり一律の支援をするよう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/194", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/204", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/206", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/208", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/210", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00620200326/212", "