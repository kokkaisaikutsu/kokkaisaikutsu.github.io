[{"date": "2020-06-12", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115254X02420200612/5", "sentence": ["…。私たちが補正予算に反対する理由は、予算の三分の一を占める十兆円もの予備費が計上されているという一点からです。日本国憲法八十三条は、「国の財…", "…の指摘を受け、十兆円のうち五兆円について大まかな内訳を示しましたが、予備費であることに変わりはありません。残る五兆円は具体的な使途を決めずに…", "…に提出することこそ財政の民主主義です。しかも、重大なのは、この巨額の予備費が、安倍政権が通常国会を延長せず臨時国会も開かないことを可能にして…"]}]}]}, {"date": "2021-03-24", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/347", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/349", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/351", "sentence": ["○紙智子君今いろいろお話しされたんですけど、予備費で三度目、これを決められたんですか、支援策。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/353", "sentence": ["○紙智子君更に昨日予備費でその支援策を出したということは、要するに、更に深刻になっているという認識なんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/355", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/357", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/359", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/361", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/363", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/365", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/367", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/369", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/371", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/373", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/375", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/377", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X01520210324/379", "sentence": []}, {"url": "https://