[{"date": "2020-11-26", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/97", "sentence": ["…。それで、農研機構は、民間と耐病性品種、つまり病気に強い品種などの共同研究を進めています。民間と共同研究しても、これ種苗代を安く抑えることと…", "…病性品種、つまり病気に強い品種などの共同研究を進めています。民間と共同研究しても、これ種苗代を安く抑えることというのはできるんだろうかと思う…", "…知見を民間事業者に提供するように求めているわけですよ。言わば野菜の共同研究は米や麦、大豆の先取りになるんじゃないかと。米でも、今、業務用米の…", "…んじゃないかと。米でも、今、業務用米の種というのは公的機関と民間の共同研究が進んでいるといいます。民間への知見の開放、規制緩和が進みますと、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/182", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/184", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/186", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00420201126/193", "sentence": []}]}]}]