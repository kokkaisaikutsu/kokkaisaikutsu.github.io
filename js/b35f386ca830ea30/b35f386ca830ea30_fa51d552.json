[{"date": "2021-06-08", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/36", "sentence": ["…の八月にこの砂川市の郊外でヒグマの目撃情報がありまして、警察と市から出動要請を受けた地元猟友会の二名のハンターが現場に駆け付けまして、警察官…", "…うことがあったので、北海道では、砂川に限らず、熊が出たときに猟友会に出動を要請すると銃を持たないで猟友会の方が集まるとか、あるいはお願いして…", "…と銃を持たないで猟友会の方が集まるとか、あるいはお願いしてもなかなか出動してもらえないとか、消極的にならざるを得ないという状況でありました。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/40", "sentence": ["…なければいけないと思いますし、特に猟友会、ハンターの皆さんが安心して出動してその駆除をするための行動を行えるということを考えても、これ徹底し…", "…いと思います。令和二年の通知で非常に有り難いなと思ったのは、これまで出動要請を受けて見回りをしている中で、突然熊が現れたり襲ってきたときに、…", "…いということで、これに関しては、住宅街に現れた熊を駆除するためには、出動要請を受けたハンターは、緊急避難の措置又は警職法第四条第一項に基づく…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01520210608/44", "sentence": []}]}]}]