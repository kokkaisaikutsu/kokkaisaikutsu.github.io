[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/34", "sentence": ["…。実は、高齢者の方々が買物したときに、牛乳飲みたいなと思っても、五百ミリのパックとか一リットルのパックって結構重たいんですよ。特に私の母なん…", "…たいんだけど重くて持てないというんですね。だから、逆に、給食用の二百ミリリットルのパックを開けてしまって加工に回さずに、そのまんま、例えばレ…", "…加工に回さずに、そのまんま、例えばレジの横に氷を置いて、その上に二百ミリリットルのパックを並べたら、レジでお金を払うときに、あっ、牛乳、二百…", "…リットルのパックを並べたら、レジでお金を払うときに、あっ、牛乳、二百ミリリットルだったら飲み切れる、あっ、給食、牛乳余っているから応援しなき…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/38", "sentence": []}]}]}, {"date": "2021-03-16", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00220210316/23", "sentence": ["…指示を解除するということでありますが、一つ目が被曝放射線量が年間二十ミリシーベルト以下であること、二つ目が土地を活用する自治体などが放射線量…", "…いんですね。しかも、これまでもずっと議論されてきましたけれども、二十ミリシーベルト、これで健康への影響は本当に生じないのかということでありま…", "…であります。放射線防護の長期目標は、個人が受ける追加被曝線量が年間一ミリシーベルト以下になることとしています。年間二十ミリシーベルト以下であ…", "…加被曝線量が年間一ミリシーベルト以下になることとしています。年間二十ミリシーベルト以下であれば子供たちが遊んでも大丈夫ということなのかという…"]}, {"url