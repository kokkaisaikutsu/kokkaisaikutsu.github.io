[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/105", "sentence": ["…たいと思うんですが、今日はコサージュを配っていただきましたので、この花卉についてお話をさせていただきたいと思いますが、この資料には、三月二日…", "…比で十八円安というふうになっておりますが、昨日、実は北海道の岩見沢の花卉生産者の方々とお話をさせていただきました。結婚式のキャンセルが相次い…", "…うようなことになれば、経営への影響は相当に大きいということなんです。花卉の農家の方々って、これまで災害に遭っても、その時期だけのことなので自…", "…保険に関しても、入っておられる方もおりますけれども、入っておられない花卉農家の方もたくさんいるんですよ。そこでお伺いしたいんですけれども、花…", "…られない花卉農家の方もたくさんいるんですよ。そこでお伺いしたいんですけれども、花卉生産者の収入保険への加入状況、今どうなっているでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/107", "sentence": ["…、いざというときのための備えということで、是非とも、この収入保険への花卉農家の加入の促進、働きかけをしていただきたいということをお願い申し上…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/127", "sentence": []}]}]}]