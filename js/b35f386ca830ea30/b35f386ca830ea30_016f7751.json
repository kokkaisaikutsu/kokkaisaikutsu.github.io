[{"date": "2021-06-03", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/20", "sentence": ["…ろん漁業者というか水産業から、陸からだけではなくて、漁業者が使用する漁具からということが指摘されています。我が国で製造、利用されているプラス…", "…ているプラスチック類、年間約一千万トンのうち、漁網、ロープ、ブイ等の漁具として製造されるのは年間およそ二万トン前後と推計されているということ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/22", "sentence": ["…系海洋プラスチックごみ削減対策七百万とか、それからリサイクルしやすい漁具の検討、これクラレなんかもいろいろと研究をしているようでございますけ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01420210603/156", "sentence": ["…境汚染を包括的に解決するため、国際的な連携強化に取り組むこと。十三、漁具及び農業用の器具等に係る使用済プラスチック使用製品による環境汚染を防…", "…、これらの環境への流出状況を把握し、その流出量の削減及び回収のため、漁具マーキングや報告体制の整備など必要な措置を行うとともに、自然循環する…"]}]}]}]