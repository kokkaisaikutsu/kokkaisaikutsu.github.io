[{"date": "2020-04-14", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/33", "sentence": ["○福田（昭）委員立国社の福田昭夫でございます。本日は、地域公共交通の活性化及び再生に関する法律等の一部を改正する法律案の審議の時間であります…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/35", "sentence": ["…、ぜひ予算額を全部教えてほしいと思います。まず、マスタープラン、地域公共交通計画を作成するための作成費の助成金があります、それから地域旅客サ…", "…続事業があります、さらには貨客運送効率化事業があります、さらに、地域公共交通利便増進事業、新モビリティーサービス事業、こうしたものがあります…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/37", "sentence": ["…房提出のようでありますが、こうしたものを含めると、国交省が今回、地域公共交通をいかに充実させようかという、その意思はよくわかります。そこで、…", "…総務省と連携をして、普通交付税の基準財政需要額、個別算定経費に、地域公共交通行政費のような項目を設けることを検討してほしいと思いますが、大臣…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/52", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00820200414/58", "sentence": []}]}]}]