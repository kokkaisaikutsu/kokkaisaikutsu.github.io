[{"date": "2021-02-12", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/284", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/286", "sentence": ["…書を読んだようですけれども、共済組合、マンション管理組合、町内会などと、農産品の販売直売所や農村そばレストランなどとの違いは分かりますよね。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/288", "sentence": ["…っと理解が深まらないんですよね。それはやはり、今大臣のように、地元のそばレストランとかそういうところで食べたことがない、現場力がないというこ…", "…基準なんですよね。ですから、その後ろを見ていただきますと、私の地元のそば組合の規約です。これは二ページあります。その後ろ、資料の三ですけれど…", "…ろ、資料の三ですけれども、これは税務署への電子申告書の写しです。このそば組合は平成八年に設立していますから、もう今年で二十五年になります。こ…", "…何と書いてあるか。「その他の製造業」と書いてあります。そして、「手打そば製造販売」と書いてあります。まさに事業をやっているんですよ。ですから…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/290", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/292", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/294", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/296", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/298", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/300", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/302", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/304", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X00920210212/306", "sentence": []}]}]}]