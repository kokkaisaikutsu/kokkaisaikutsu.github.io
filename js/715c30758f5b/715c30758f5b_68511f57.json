[{"date": "2020-03-03", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/141", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/143", "sentence": ["…中国ではいまだに日本は湖北省と浙江省と二つに絞られている。でも、中国全土に拡大している。なぜ中国全土にその入国制限を掛けないのか、この辺がよ…", "…と浙江省と二つに絞られている。でも、中国全土に拡大している。なぜ中国全土にその入国制限を掛けないのか、この辺がよく分かりません。韓国も全部広…", "…がっていますね。今後、そういうところについてやはりきちっと入国制限を全土に掛けるということを今からでも決断してほしいんですけれども、その点に…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/145", "sentence": ["…はなるべく早くやってもらいたい。それは、やっぱり日本と韓国だけが中国全土じゃないんですね。やっぱり、台湾、米国、シンガポール、オーストラリア…", "…っぱり、台湾、米国、シンガポール、オーストラリア、ロシア、みんな中国全土からの入国制限をしているわけです。なぜ日本がしないの。しないから、今…", "…ということを気にしておりまして、そういうことを考えると、速やかに中国全土へのこの適用と、入国禁止の適用を求めたいと、こう考えております。そも…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/155", "sentence": ["…育を行った。小泉総理の靖国参拝や日本の常任理事国入りに反対して、中国全土で反日デモや日本企業に対する破壊行為を行った。二〇一〇年には尖閣諸島…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/161", "s