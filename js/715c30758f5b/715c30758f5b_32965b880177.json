[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/12", "sentence": ["…も。杉並の区議会では、令和元年十一月十九日に、ちゃんとデータとして、防衛省の要請に応じて紙やデータで送るべきだという主張に対して、区側の答弁…", "…当時の石田総務大臣は、提出方法は、自衛隊法又は同施行令の、基づいて、防衛省と各自治体で決められるもので、住民基本台帳法上は明文の規定がないの…", "…各自治体で決められるもので、住民基本台帳法上は明文の規定がないので、防衛省の要求に対して出していただいても問題ないと総務大臣がお答えになって…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/16", "sentence": ["…になるので、総務省としては、この住民基本台帳法上は、自衛隊法で請求を防衛省がした場合は、何ら問題がないと、だって大臣だって答えているわけだか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/41", "sentence": []}]}]}]