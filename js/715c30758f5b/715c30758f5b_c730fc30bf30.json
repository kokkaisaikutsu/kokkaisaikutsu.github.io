[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/12", "sentence": ["…うんですけれども。杉並の区議会では、令和元年十一月十九日に、ちゃんとデータとして、防衛省の要請に応じて紙やデータで送るべきだという主張に対し…", "…和元年十一月十九日に、ちゃんとデータとして、防衛省の要請に応じて紙やデータで送るべきだという主張に対して、区側の答弁が、区では、毎年度、自衛…", "…なる年齢の方だけを抽出した専用閲覧台帳を作成して閲覧に供しています、データの提供については、住民基本台帳法では、国等の事務の遂行に当たって必…", "…律を根拠にして名簿等の提供はできないとの見解が出されていることから、データを提供することは難しいと。住民基本台帳法に基づいてやるとデータの提…", "…から、データを提供することは難しいと。住民基本台帳法に基づいてやるとデータの提供はできないと、法律はそのようになっているんですけれども、何か…", "…見ればですね、自治体の方の姿勢で、これが、書き写しなさいというのと、データ提供する。その辺が、やはり私は、都合のいいときに住民基本台帳法を出…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120113950X00420200318/41", "sentence": []}]}]}]