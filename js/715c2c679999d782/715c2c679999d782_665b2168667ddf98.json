[{"date": "2020-03-26", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/156", "sentence": ["…と思っております。文科省からも来ていただきました。今般の学校休校で学校給食が中止となりまして、三月十日に文科省はこの間の学校給食費について保…", "…の学校休校で学校給食が中止となりまして、三月十日に文科省はこの間の学校給食費について保護者の負担とならないように返還等を行うよう地方自治体に…", "…請する事務連を出していらっしゃいます。生活保護世帯におきましては、学校給食費は既に納付した分が戻ってきても返還を求めない、休校中の学校給食を…", "…、学校給食費は既に納付した分が戻ってきても返還を求めない、休校中の学校給食を支給していない場合は追加支給するということが厚生労働省から通知さ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/158", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/160", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X00620200326/168", "sentence": []}]}]}]