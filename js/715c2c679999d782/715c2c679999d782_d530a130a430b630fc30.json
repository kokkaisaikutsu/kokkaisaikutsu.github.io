[{"date": "2021-12-17", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/55", "sentence": ["…、自治体の皆さん方、心配されているんですね。是非ともここは、総理、ファイザーの方にもお電話されたと伺っておりますけれども、ここはしっかり国が…", "…り国が責任を持ってやっていただきたいと思います。実際、もうとにかくファイザーを多く支給してほしいと、もう全部ファイザーにしてもらいたいと、そ…", "…ます。実際、もうとにかくファイザーを多く支給してほしいと、もう全部ファイザーにしてもらいたいと、そのような自治体から多くのお声いただいていま…", "…声いただいています。ただ、今、明確になっている来年三月末までのこのファイザー約二千万回分とまたモデルナ約一千七百万回分、合計三千七百万回分の…", "…七百万回分、合計三千七百万回分のワクチンが配送されて、自治体ごとにファイザーとこのモデルナが六対四という形になると。他方で、一回目、二回目フ…", "…ザーとこのモデルナが六対四という形になると。他方で、一回目、二回目ファイザー打った方とそしてモデルナ打った人の割合というのは九対一なんですね…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120715261X00220211217/81", "sentence