[{"date": "2020-06-01", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/80", "sentence": ["…の検討を求めておきたいと思います。次に、新型コロナ対策の専門家会議の議事録が作成されていない問題について伺います。行政文書の管理に関するガイ…", "…がなかろうが、専門的知識を有する者等を構成員とする懇談会などの会合は議事録をつくることになっております。そして、加藤大臣も、三月の予算委員会…", "…おります。そして、加藤大臣も、三月の予算委員会で、一回目から三回目は議事概要になるが、四回目以降は速記を入れて一言一句残すと答弁されておりま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/84", "sentence": ["…ンでは、別表一の文書はつくることになっている。審議会等文書というのは議事録をつくるということになっているわけですね。「専門的知識を有する者等…", "…そこから教訓を得るために、政府があらゆる記録を克明に残すのは当然で、議事録はその最も基本となる資料ですと。いいことをおっしゃっているじゃない…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/98", "sentence": []}]}]}]