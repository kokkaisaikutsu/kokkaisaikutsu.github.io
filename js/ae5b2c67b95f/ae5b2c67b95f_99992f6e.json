[{"date": "2020-06-01", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/86", "sentence": ["…めずに、ぜひ公開するということを決めていただきたいと思います。次に、香港への国家安全法の導入について伺います。中国の全人代が、反政府的な動き…", "…て伺います。中国の全人代が、反政府的な動きを取り締まる国家安全法を、香港政府を通さず、直接導入することを決めました。一国二制度を有名無実化す…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/88", "sentence": ["…うメッセージは伝わったと。抗議すべきなんじゃないですか。一国二制度や香港の高度な自治、あるいは、言論、集会、結社の自由は、英中共同声明にも明…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00420200601/98", "sentence": []}]}]}]