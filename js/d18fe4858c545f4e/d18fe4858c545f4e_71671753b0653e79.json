[{"date": "2021-02-15", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/174", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/176", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/178", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/180", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/182", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/184", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/186", "sentence": ["…部が会食を重ねていたことが問題となっています。総理、総務省にとって東北新社は利害関係者なんでしょうか。総理、総理に……（発言する者あり）分か…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/188", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/190", "sentence": ["○近藤（和）委員以前は総務大臣をされたこと、ありますよね。そして、東北新社がどのような事業を行っているか、このことについて、総理、総理の御知…", "…事業を行っているか、このことについて、総理、総理の御知識、教えてください。東北新社がどのような会社だったかということを総理に伺いたいんです。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/195", "sentence": ["○近藤（和）委員それでは、改めて質問いたします。東北新社がどのような事業を行っているか、御存じでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/197", "sentence": ["…和）委員総務大臣を経験された方としては、なかなか寂しい答弁ですね。東北新社の定款では、「放送法に基づく基幹放送事業及び一般放送事業」、そして…", "…なんですね。改めて伺いますが、今の私の話を聞きまして、総務省とこの東北新社は利害関係者であるかどうかということを、総理、お答えください。総理…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120405261X01020210215/209", "sentence": []}, {