[{"date": "2020-03-05", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/10", "sentence": ["…安なんです。そして、今、例えば、農林水産省さんとしてホームページ、ツイッター、すごく頑張っていらっしゃると思います。ただし、想像していただけ…", "…像していただければと思いますが、現場の方々がホームページを見るか、ツイッターを眺めているか、チェックをするかということを考えれば、何らかの形…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/14", "sentence": ["…います。実は、今質問させていただいたことは、もう既にホームページやツイッターで出ているんですよね。ただ、改めてこの委員会で質問させていただく…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X00320200305/26", "sentence": []}]}]}]