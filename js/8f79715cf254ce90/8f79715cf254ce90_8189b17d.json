[{"date": "2020-03-04", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/241", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/243", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/245", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/247", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/253", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/255", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/257", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/259", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/263", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/265", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/267", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/269", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/271", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/273", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/275", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/277", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/279", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/281", "sentence": ["…れが特措法です。加藤厚労大臣、お伺いします。新型インフルエンザ患者入院医療機関整備事業実施要綱というのがありますが、加藤大臣、御存じですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/283", "sentence": ["○福山哲郎君二月の十八日、この整備実施要綱が改正されたのは、大臣、御存じですか。知らないなら知らないで結構です。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/285", "sentence": ["○福山哲郎君総理、ちゃんと聞いておいてください。これ、実施要綱なんですが、二月十八日に厚労省は実施要綱を改定しています。これ、右が現行で左が…", "…ておいてください。これ、実施要綱なんですが、二月十八日に厚労省は実施要綱を改定しています。これ、右が現行で左が改正後なんですけど、小さい字で…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/287", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/291", "sentence": ["○福山哲郎君これ、大臣、この実施要綱は、新型インフルエンザ特別措置法の行動計画に基づく実施要綱です。これ、コロナ読み込んでいますね。大臣、ど…", "…君これ、大臣、この実施要綱は、新型インフルエンザ特別措置法の行動計画に基づく実施要綱です。これ、コロナ読み込んでいますね。大臣、どうですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/293", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/296", "sentence": ["○福山哲郎君じゃ、この実施要綱の根拠法は何ですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/299", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/301", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/303", "sentence": ["…山哲郎君新型インフルエンザ対策措置法に基づいて行動計画ができて、実施要綱ができている。ここに書いてあるじゃないか、行動計画においてと書いてあ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/308", "sentence": ["○福山哲郎君予算じゃなくて、実施要綱の名称を正式に言ってください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/310", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/312", "sentence": ["○福山哲郎君何の法律を根拠にその予算が実施される要綱なんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/316", "sentence": []}]}]}]