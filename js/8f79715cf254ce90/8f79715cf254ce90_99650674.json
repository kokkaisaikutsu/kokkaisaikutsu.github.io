[{"date": "2020-03-04", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/241", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/243", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/245", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/247", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/253", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/255", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/257", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/259", "sentence": ["…です。一人五千円ずつ会費を払うわけです。その人は五千円分で、ちゃんと料理とか皆さん取って、飲物も飲んでおられるわけです。じゃ、どういう形で、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/263", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/265", "sentence": ["…す。十八時から二十時、二時間で通常料金四百五十万です。これは、ただ、料理をたくさん出せば当然割引きがあります。ただし、総理は施設料も含めてと…", "…鶴の間の二時間の料金が三分の一だったとしても、百五十万です。さっき、百三十六万八千円です、もう残りは。ということは、料理は無料ですか、総理。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/267", "sentence": ["○福山哲郎君これ、二時間の正規の料理、料金なので立食も着席も変わりません。部屋代ですから、全く施設利用料は変わりません。お答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/269", "sentence": ["○福山哲郎君立食と着席は、着席の方が料理代が高いので、逆に言うと部屋代は安くなるんです。立食の方が高いんです、食事代が低いから。だけど、どっ…", "…二時間で。例えば、さっき私が言ったように、三分の一になったとしたって料理代ただですよ。例えば五分の一になったって、料理代幾らになりますか。幾…", "…の一になったとしたって料理代ただですよ。例えば五分の一になったって、料理代幾らになりますか。幾らですか、料理代。千円で料理出すんですか、総理…", "…よ。例えば五分の一になったって、料理代幾らになりますか。幾らですか、料理代。千円で料理出すんですか、総理、八百人分。これ、ちゃんと説明しても…", "…の一になったって、料理代幾らになりますか。幾らですか、料理代。千円で料理出すんですか、総理、八百人分。これ、ちゃんと説明してもらわなきゃ、総…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/271", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/273", "sentence": ["…務所に対する、悪いけど、寄附行為です。そうでしょう。その四百五十万が料理がたくさんだからディスカウントするというのは、それは商売だからありま…", "…それは商売だからあります。そんなことは私は理解していますが、それでも料理はただ同然です。それもオータニからの寄附行為になります。もし、その寄…", "…為です。どっちかです。総理、説明してください。これ、どう考えても説明できない。こんな安く、だって料理が提供されるわけがない。お答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/275", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/277", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/279", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/281", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/283", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/285", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/287", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/291", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/293", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/296", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/299", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/301", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/303", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/308", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/310", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/312", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00620200304/316", "sentence": []}]}]}, {"date": "2020-11-25", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00320201125/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/1203152