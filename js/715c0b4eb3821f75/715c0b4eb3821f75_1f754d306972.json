[{"date": "2021-04-08", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/131", "sentence": ["…然海岸でなぜこんなに水の透明度が違うのだろう。その理由は人工干潟には生き物がいないことであると。自然海岸の方は、カキが岩や石にくっついていて…", "…ャコの巣穴もびっしりとある。ゴカイの仲間もいろいろ見付かる。いかにも生き物のにぎわいのあるいわゆる多様性の高い海岸である。人工干潟の砂はきれ…", "…はきれいだが、およそ死の世界に近い。アサリやカキやアナジャコのように生き物は海水を濾して水中の餌を食べている。そのような動物がいないため、人…", "…ですけれどもね。人工で造った、埋立て、人工で造成した干潟にはなかなか生き物はすまないのではないか、で、海が濁っているよというこの報告なんです…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/139", "sentence": []}]}]}]