[{"date": "2021-04-15", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/81", "sentence": ["…けて、更なる二酸化炭素排出削減を実現する見通しをもって、同火力発電所の休廃止、稼働抑制などの措置を計画的に実行することとの記述がありました。…", "…火力発電所を建設するのなら、ＣＯ２排出削減を実現するために古い発電所の休廃止、稼働抑制を計画的に実行する必要があるという、私は最低限だが真っ…", "…業の用に供する設備を一つしか持っていないため、今の時点から低効率火力の休廃止、稼働抑制を明示的にプッシュするのは、電力事業をやめろと求めてし…", "…こんな筋の通らない意見に対して環境省は一言も反論せずに、同火力発電所の休廃止、稼働抑制などの措置をとしていた部分を削除しました。これ黙って落…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00620210415/94", "sentence": []}]}]}]