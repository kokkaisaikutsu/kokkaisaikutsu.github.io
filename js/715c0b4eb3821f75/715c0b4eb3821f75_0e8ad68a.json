[{"date": "2020-05-28", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00620200528/145", "sentence": ["…産党を代表して、我が党提出の修正案には賛成、政府提出の原案には反対の討論を行います。二〇一八年の石綿による中皮腫や肺がんの死亡者数は四千六百…", "…したが、協議が調わず実現に至らなかったことは残念です。充実した委員会審議ができるよう、引き続き努力することを表明して、反対討論を終わります。"]}]}]}, {"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315104X00520201201/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315104X00520201201/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315104X00520201201/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315104X00520201201/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315104X00520201201/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315104X00520201201/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315104X00520201201/35", "sentence": ["…独立行政法人日本スポーツ振興センター法の一部を改正する法律案に反対の討論を行います。反対する第一の理由は、スポーツ振興投票の対象競技にバスケ…", "…振興財源のくじへの依存を強めるものです。国が責任を持って国費でスポーツ予算を確保、増額するのが本来の道筋であると申し上げ、討論を終わります。"]}]}]}]