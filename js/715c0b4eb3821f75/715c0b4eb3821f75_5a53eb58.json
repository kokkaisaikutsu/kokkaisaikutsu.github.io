[{"date": "2021-06-01", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X01320210601/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01320210601/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01320210601/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01320210601/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01320210601/152", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01320210601/154", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01320210601/156", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X01320210601/158", "sentence": ["…ということが言われております。それから、資料八に、福岡工業大学永淵修博士が、これ大分県のくじゅう連山の樹氷を採取してみたところ、その中に七十…", "…の大きさのものが一リットル中五千から一万個見付かったというんですね。博士は、確実にこれは吸い込んでいると、北京などから飛んでくるのではないか…"]}]}]}]