[{"date": "2020-05-21", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/75", "sentence": ["…大臣、こうした流れに依拠して国として気候非常事態を宣言してはどうでしょうか。そのためにイニシアチブを小泉環境大臣が発揮してはどうでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00520200521/77", "sentence": ["…国内でもそういう流れが、機運が醸成されつつあるんですから、そのときを捉えて環境大臣としてのイニシアチブの発揮を強く求めて、質問を終わります。"]}]}]}, {"date": "2021-05-07", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X02020210507/23", "sentence": ["…六月の首脳会議までに石炭火力の具体的な廃止計画を示し、主導的な役割を発揮するよう要請しました。このままではＣＯ２排出削減目標を達成できないと…"]}]}]}]