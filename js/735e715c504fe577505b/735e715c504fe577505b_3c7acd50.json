[{"date": "2020-03-24", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/138", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/140", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/142", "sentence": ["…上げられてやっと達成できる非常に野心的な目標に思えます。もちろん、再稼働するには、原子力規制委員会の審査を通ってかつ安全性が証明されて、さら…", "…ってかつ安全性が証明されて、さらには地元の御理解をいただいてからの再稼働になるというふうに認識はしておりますけれども、経産省として、この原子…", "…として、この原子力二〇％から二二％を達成するために今後十年間でどのくらいのペースで再稼働を進めていくおつもりなのか、その辺、教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/144", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/146", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/148", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/152", "sentence": []}]}]}]