[{"date": "2021-04-08", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/157", "sentence": ["…すから、以前も国交委員会でこの問題取り上げたことがあって、そのときは水産庁の方から、基本的には静岡県や浜松市などの浜名湖沿岸自治体が中心とな…", "…の浜名湖沿岸自治体が中心となって進めていくべき問題なんですけれども、水産庁からも、地域の実情に応じた、例えば覆砂などの底質改善ですとか、食害…", "…、浜名湖のアサリの資源回復につながることがないのかと、現状分かっていること、それから考えられることがあれば、水産庁にお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/161", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/163", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/165", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00520210408/169", "sentence": []}]}]}]