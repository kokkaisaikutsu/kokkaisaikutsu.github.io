[{"date": "2020-05-13", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/72", "sentence": ["…りまた続けていただければというふうに思います。続きまして、今度は国際航空貨物について質問をしていきたいというふうに思います。私の地元の中部国…", "…の国際旅客便が激減していることに伴って、旅客便の貨物室を活用した国際航空貨物輸送に今限られているというふうに聞いております。それで、まずは、…", "…貨物に限られているこの現状についてお答えをいただきたいと同時に、国際航空貨物輸送の需要に応えるため国土交通省としてどのような対策を行っている…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/74", "sentence": ["…とが国民の生活の安心、安全になりますので、引き続き、このあたりの国際航空貨物についてもぜひしっかり対応していただければというふうに思います。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/88", "sentence": []}]}]}]