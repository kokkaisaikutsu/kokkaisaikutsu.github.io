[{"date": "2020-05-13", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/70", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/72", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/74", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/82", "sentence": ["○根本（幸）委員ありがとうございました。続きまして、今度はテナントの賃料支援についてお伺いをしたいというふうに思います。新型コロナの感染拡大…", "…したいというふうに思います。新型コロナの感染拡大により経営難に陥って賃料が払えないテナントへの支援について、先日、自民党と公明党で新たな支援…", "…、国土交通省として、新型コロナウイルス感染症の影響を受けたテナントの賃料支払いに関しどのように対応していくのか、お伺いしたいというふうに思い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/84", "sentence": ["○根本（幸）委員ありがとうございます。テナントの賃料、またしっかりこれはやっていきたいというふうに思っているところであります。道路事業であり…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01120200513/88", "sentence": []}]}]}]