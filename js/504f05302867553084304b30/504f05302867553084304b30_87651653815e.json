[{"date": "2021-05-25", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/54", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/56", "sentence": ["○佐々木さやか君その上で、ちょっと具体的なところについて文化庁に伺いたいと思います。今もありました特定絶版等資料というものはどういうものなの…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/58", "sentence": ["…することが確定している場合に除外されないとするのは不合理ではないかと、こうした点について文化庁はどのように考えているのか聞きたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/60", "sentence": ["…成り済まし、また虚偽情報による登録の懸念、こういったことにも万全に対応していくことが必要ではないでしょうか。この点、文化庁、いかがでしょう。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/64", "sentence": ["…利益を不当に害することとなる場合の具体的な解釈、運用につきましては、文化庁の下で幅広い関係者によってガイドラインを作成し、これに基づくものと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X01420210525/70", "sentence": []}]}]}]