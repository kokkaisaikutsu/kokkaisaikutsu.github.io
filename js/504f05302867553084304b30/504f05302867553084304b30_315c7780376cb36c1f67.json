[{"date": "2021-03-30", "meeting": [{"meeting_name": "参議院 文教科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/91", "sentence": ["…いうことで諦めて地元に帰った友達もいました。ですので、このいわゆる就職氷河期世代の、教師になりたかったと、そういう人たちに教壇に立っていただ…", "…立っていただくというのは私もいいアイデアかなというふうに思います。就職氷河期世代の教職に関するリカレントプログラム事業、これを推進していると…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/93", "sentence": ["○佐々木さやか君ありがとうございました。この就職氷河期世代で、免許を持っているけれども採用されていないという方々は約百万人いらっしゃるという…", "…ういったことも含めて引き続き取り組んでいただきたいと思います。この就職氷河期世代の皆さんというのは三十代後半、四十代という方が多いと思います…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415104X00720210330/101", "sentence": []}]}]}]