[{"date": "2021-03-04", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/92", "sentence": ["…十八歳、十九歳について、引き続き成人とは異なる健全育成、矯正のための手続を設けるべきと主張してまいりました。少年の可塑性といいますのは、少年…", "…歳について今回どのような改正がなされるのか、引き続き家裁全件送致がされ、審判手続も行われると、このようにした趣旨について法務大臣に伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/94", "sentence": ["…も詳しく調査をし、どのような処分がその少年の更生に必要かという観点で手続がなされます。単に刑罰を科すだけよりも、丁寧な手続を取ることで若年者…", "…必要かという観点で手続がなされます。単に刑罰を科すだけよりも、丁寧な手続を取ることで若年者の再犯を防止し、新たな被害者を生まないということで…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/108", "sentence": []}]}]}]