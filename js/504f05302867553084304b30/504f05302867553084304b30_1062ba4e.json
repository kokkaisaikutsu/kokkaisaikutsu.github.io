[{"date": "2021-03-04", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/92", "sentence": ["…お伺いをいたします。少年法の改正案が閣議決定されました。民法の十八歳成人が来年四月からスタートをするということを念頭に、十八歳、十九歳の少年…", "…。公明党は、少年の可塑性の観点から、十八歳、十九歳について、引き続き成人とは異なる健全育成、矯正のための手続を設けるべきと主張してまいりまし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/94", "sentence": ["…てあってはならないというふうに思います。行政としては十八歳、十九歳は成人であっても若年であり、社会として見守り育てるべき存在ということを前提…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415261X00420210304/108", "sentence": []}]}]}]