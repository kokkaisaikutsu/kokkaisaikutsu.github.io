[{"date": "2021-03-22", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/26", "sentence": ["…。残念ながら、衆議院の環境委員会でも、今言われたとおり、悩んでおると、壁は経産省というような表現を使って、なかなか、いつも経産省の壁にぶつか…", "…でおると、壁は経産省というような表現を使って、なかなか、いつも経産省の壁にぶつかり、環境省の関与の在り方、いつも悩んでいると、こういう答弁を…", "…言ったけれども、言っているけれども、そこ止まりになっている。何とかその壁を突破しなかったらならぬと。我々は応援しますよ、応援しますよ。石炭火…", "…した割には理解していない、さっきの表現を取れば全然理解していない。この壁を取っ払うのは、私は小泉さんしかいないと思っているんですよ。是非、二…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/50", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414006X00320210322/52", "sentence": []}]}]}]