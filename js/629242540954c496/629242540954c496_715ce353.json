[{"date": "2020-03-24", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/25", "sentence": ["…っとと思いましたけれども、参議院の本会議、一月二十四日、公明党さんの山口代表はこういうふうに述べております。本気で地球温暖化防止に取り組み、…", "…発電について新増設を認めない大胆な政策に取り組むときですと。ここまで山口代表は述べております。これに対して、さっき言ったように安倍総理の答弁…", "…か革新的電池の研究開発、送電線の運用ルールの見通しなどを言って、この山口代表の石炭火力発電所の新増設を認めないことには何の答弁もしておらない…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/41", "sentence": []}]}]}]