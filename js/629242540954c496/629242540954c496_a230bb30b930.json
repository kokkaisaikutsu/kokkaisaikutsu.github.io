[{"date": "2020-03-24", "meeting": [{"meeting_name": "参議院 環境委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/35", "sentence": ["○鉢呂吉雄君環境省としての環境アセスにしか関わることができないという点で分かりますが、しかしやっぱり、環境大臣としていわゆる環境外交の最前線…", "…ると、これが必要だと思うんですね。ですから、今、新設については厳しいアセスメントで、場合によっては経産大臣にこの対応をしていくということであ…", "…導という表現です、やめていく指導をしていると、新規のものについては、アセスの協議が来たときにはむしろ中止を中身とする指導をしたいと、こういう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114006X00420200324/41", "sentence": []}]}]}]