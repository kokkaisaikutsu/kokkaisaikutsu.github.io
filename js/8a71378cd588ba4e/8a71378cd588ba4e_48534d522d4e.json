[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/173", "sentence": ["…続税等の納税猶予についてちょっとお尋ねをしてみたいと思っております。午前中の質疑でも、納税猶予、一か月間、今、古賀先生のお話にもありましたけ…", "…で税務署に相談をしていただいて猶予をとの相談をしてほしいというふうに午前中の質疑にもありまして、広報もしっかりとしてほしいという併せての質問…", "…わっていない部分が大きいんじゃないかなというふうに思っておりまして、午前中も広報、どんな手段で広報しているのかということを御答弁ございました…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/175", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/177", "sentence": ["…、是非、所得税の減税考えていただきたいなというふうに思っております。午前中の答弁も聞いていて、なかなかいい答弁いただけないの分かっております…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/179", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/181", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/183", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/186", "sentence": []}]}]}]