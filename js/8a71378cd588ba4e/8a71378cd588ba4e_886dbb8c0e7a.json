[{"date": "2020-03-18", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/167", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/169", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/171", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/173", "sentence": ["…次の質問も、新型コロナウイルス感染症の経済被害に関連しての、所得税、消費税、そして相続税等の納税猶予についてちょっとお尋ねをしてみたいと思っ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/175", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/177", "sentence": ["…えてもう一度させていただきたいなというふうに思っております。そして、消費税も、私はゼロとは言いません。私は昨年の選挙で据置きを言っていました…", "…んけど世間では余り評判の良くない軽減税率もなくなるので、二％の減税、消費税の減税ぐらいやらないといけない状況ではないのかなというふうに思って…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/179", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/181", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/183", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00420200318/186", "sentence": []}]}]}]