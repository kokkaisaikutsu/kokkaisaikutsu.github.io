[{"date": "2020-04-02", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/13", "sentence": ["…しれないけれども、これは継続性を持たなければ農家の方々は政策、政権を信用しないということで、その八万円は継続をさせていただきました。これまで…", "…なんですよ。本当にこれで十年間やるというような確信がなければ、私は多くの関係の方々は信用しないというふうに思いますけれども、どうでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/15", "sentence": ["…んでしたが、やはりその辺の継続性というものをきちんとしないと、やはり信用できないのではないかというような感じをいまだに持っている人たちが農家…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00820200402/19", "sentence": []}]}]}]