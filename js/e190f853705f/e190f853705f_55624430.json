[{"date": "2020-11-24", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/36", "sentence": ["…てで、一階建ては販売支援融資というような形になります。二階建てに不足払いというのと、それから収入ナラシというふうな形になっていて、以前は五年…", "…以前は五年間の農業法が始まるときに農場は選択をして、収入ナラシか不足払いかどちらかを選択する。ところが、トランプさんのときになって、毎年選び…", "…変農場の方々はハッピーな感じになりました。しかも、この間、市場と不足払いのところの数字が高値で安定をしておりましたので、幅が少なくなっていた…", "…。トランプさん、これを見て、上に一五％引き上げました。ですから、不足払いの方を選択する人たちにとっては、ちょっと見えないかもしれません、Ｖ字…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315007X00320201124/42", "sentence": []}]}]}]