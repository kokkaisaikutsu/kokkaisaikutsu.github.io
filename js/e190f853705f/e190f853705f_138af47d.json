[{"date": "2021-03-25", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/24", "sentence": ["…わけにはいかないんだと。それは一定程度、熟練まではいかないけれども、訓練を施した上でないとそういうことには無理なんじゃないかという話がありま…", "…し、先ほど言ったように、民間は無理なんですよ。その場所に就けるまでに訓練をするような期間はとても面倒見てあげることはできない。国がそれをきち…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/26", "sentence": ["…った形でもってやっているところが多いのですよ。ですから、先ほどのその訓練の期間も、一年間のうちで訓練で半年以上使ってなんということになったら…", "…ろが多いのですよ。ですから、先ほどのその訓練の期間も、一年間のうちで訓練で半年以上使ってなんということになったら、これはもう研修、実習という…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120415007X00520210325/34", "sentence": []}]}]}]