[{"date": "2020-03-09", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/12", "sentence": ["…に似たものになっております。アメリカの場合には、各州政府に極めて強い権限を持たしめて、そして、警察権だけではない、州兵を始めた軍隊の指揮系統…", "…兵を始めた軍隊の指揮系統もこの知事の下に統率されるような形で、強力な権限がその中で供与されることになっています。特に緊急事態宣言を出されます…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/14", "sentence": ["…がって、人権を含めて個人の私権、これを制約する、そしてその極めて強い権限を政府に委ねるということは、我が国の民主主義の下において、私は極めて…", "…ンをしていくことになります。ただ、この感染研の方の調査研究者には職務権限がないんですよ。ですから、常にその調査を実施しようとするときには保健…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/24", "sentence": []}]}]}, {"date": "2021-01-21", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X00220210121/8", "sentence": ["…染症予防法等を改正する際に、個人の権利と自由、そして感染抑制のための権限強化と経済支援をどのように均衡させて高い実効性を確保していくお考えで…"]}]}]}]