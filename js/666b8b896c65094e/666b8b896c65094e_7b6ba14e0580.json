[{"date": "2020-03-09", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/6", "sentence": ["…翻って見たときに、我が国における罹患者の数、そして特に亡くなった方、死亡者数というのは極端に少なかったんです。世界の多くの国々がびっくり仰天…", "…くり仰天しまして、何で日本だけこんな感染症が蔓延したときにこのように死亡者数を少なく抑えることができたのかということを調べた結果、これはまさ…", "…こうした感染症が拡大したときにも、そこが底力を発揮してしっかりとその死亡者数等を抑え込むことができるんだという点で非常に高い評価を我が国は得…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/24", "sentence": []}]}]}]