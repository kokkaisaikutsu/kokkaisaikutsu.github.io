[{"date": "2020-03-09", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/14", "sentence": ["…上で、しかし、この特措法というものは、極めて強く私権、すなわち個人の権利を抑制するものであります。したがって、人権を含めて個人の私権、これを…", "…した後には、こうしたオペレーションを実施するときには、是非その個人の権利、私権の制限ということについては慎重に実際のオペレーションを実施して…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/24", "sentence": []}]}]}, {"date": "2021-01-21", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X00220210121/8", "sentence": ["…性のある法的措置が必要です。我が国の民主主義の下において、常に個人の権利や自由を抑制することには慎重であるべきですが、感染状況に応じた対策を…", "…ばなりません。そこで、特措法及び感染症予防法等を改正する際に、個人の権利と自由、そして感染抑制のための権限強化と経済支援をどのように均衡させ…"]}]}]}]