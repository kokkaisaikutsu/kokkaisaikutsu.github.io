[{"date": "2020-03-09", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/14", "sentence": ["…する、そしてその極めて強い権限を政府に委ねるということは、我が国の民主主義の下において、私は極めて常に慎重でなければならないというふうに思い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/24", "sentence": []}]}]}, {"date": "2021-01-21", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X00220210121/8", "sentence": ["…実に対処するためにも、より実効性のある法的措置が必要です。我が国の民主主義の下において、常に個人の権利や自由を抑制することには慎重であるべき…", "…し、一時占拠するという前代未聞の事態は、日米同盟の根幹である自由と民主主義という価値を揺るがす衝撃的な出来事でした。現地時間で昨日、バイデン…", "…の再構築を進め、国際的なデジタル覇権をめぐる熾烈な競争分野、自由と民主主義と法の支配に基づく通商貿易分野、さらに、防災、環境、保健といった地…", "…に突入しました。今や時代状況は一変し、台頭する中国に対して、自由と民主主義、そして法の支配に基づく王道を歩むのか、軍事力の増強に励み、力で現…"]}]}]}]