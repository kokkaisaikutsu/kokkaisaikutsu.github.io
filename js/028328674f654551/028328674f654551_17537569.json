[{"date": "2020-05-22", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/34", "sentence": ["○茂木国務大臣北極は大切だと思っております。北極をめぐっては、地球温暖化によります環境変化に対する懸念が存在する一方、海氷状況の変化に伴いま…", "○茂木国務大臣北極は大切だと思っております。北極をめぐっては、地球温暖化によります環境変化に対する懸念が存在する一方、海氷状況の変化に伴いま…", "…ります環境変化に対する懸念が存在する一方、海氷状況の変化に伴いまして北極海航路の活用や資源開発といった経済活動が活発化しておりまして、安全保…", "…発といった経済活動が活発化しておりまして、安全保障の観点からも各国の北極に対する関心は高まりつつあります。我が国としては、北極の生態系や先住…", "…点からも各国の北極に対する関心は高まりつつあります。我が国としては、北極の生態系や先住民の生活を尊重しつつ、北極における持続可能な経済活動を…", "…つあります。我が国としては、北極の生態系や先住民の生活を尊重しつつ、北極における持続可能な経済活動を追求すべきと考えておりまして、御指摘のあ…", "…ける持続可能な経済活動を追求すべきと考えておりまして、御指摘のあった北極評議会を始めとする多国間の枠組みにおける取組や関係国との対話を通じて…", "…議会を始めとする多国間の枠組みにおける取組や関係国との対話を通じて、北極における活動に関して法の支配に基づく自由で開かれた秩序が確保されるよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120103968X00920200522/106", "sentence": []}, {"ur