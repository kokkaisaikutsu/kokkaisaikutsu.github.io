[{"date": "2021-03-23", "meeting": [{"meeting_name": "参議院 東日本大震災復興特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414858X00320210323/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00320210323/132", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00320210323/134", "sentence": ["…しまったということであります。最後に、大臣に御質問いたします。福島の県民所得が二〇一五年度以降低下を続け、最新の数字では、二〇一八年度が対前…", "…数字では、二〇一八年度が対前年比でマイナスに沈んでいます。もう本当に福島県民取り残された感がこれでもうよく分かりますよ。この理由は何ですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00320210323/137", "sentence": []}]}]}, {"date": "2021-04-09", "meeting": [{"meeting_name": "参議院 東日本大震災復興特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/190", "sentence": ["○渡辺喜美君みんなの党、渡辺喜美でございます。前回、福島県民所得が二〇一五年以来低下をし続けて、そして二〇一八年度、前年対比でマイナスになっ…", "…すよ、十年前は二百二万人いたのが、この十年間で二十万人も減っちゃったんですね。それは県民所得減るに決まっていますよ。大臣、どうお考えですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/192", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/194", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/204", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414858X00420210409/207", "sentence": []}]}]}]