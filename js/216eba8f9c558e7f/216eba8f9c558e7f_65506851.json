[{"date": "2020-06-02", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/101", "sentence": ["…、今回は国が国の責任において債務免除をやる。これ、長期的に考えれば、健全な企業が突然売上げ九割減とか、幾らでも今あるわけですよね。じゃ、無担…", "…か。免除益というのが出てきますよね。ですから、そうすると、昔のように健全な企業に戻って繰越欠損金が解消されれば、税金だって取れるじゃありませ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/103", "sentence": ["…らでは遅いということなんですよ。倒産法制は整備をした。それから、金融健全化法から始まって、再生法とか、今の金融機能強化法、こういうものを発動…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01420200602/107", "sentence": []}]}]}]