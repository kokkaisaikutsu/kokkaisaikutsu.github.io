[{"date": "2020-11-19", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/101", "sentence": ["…省来ていますかね。厚労省発表の数字を見て驚きましたね。令和二年五月の妊娠届出数、何と前年同月の一七・一％減、六月、五・四％減、七月、一〇・九…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/103", "sentence": ["…夫か、そう思っているからやっぱり減るんですよ、こういうのがね。仮に、妊娠届というのは十一週以下が大半ですよね、九三％ぐらい。で、例えば、日本…", "…めでた給付金なんか出したら中絶費用になるなどという意見もありますが、妊娠届を出すということは覚悟を持って母子手帳をもらいに行くんですよ。覚悟…", "…うのが認められているという現状であります。仮におめでた給付金を毎月、妊娠届出したら十万円配ったって、八か月として、八、八、六十四だから、六千…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314370X00220201119/113", "sentence": []}]}]}]