[{"date": "2020-06-03", "meeting": [{"meeting_name": "参議院 東日本大震災復興特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/118", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/124", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/126", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/128", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/130", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/132", "sentence": ["…けれども、次なる震災は分からなかった。そこで、四百年に一回やっている首都機能移転、こういうことをやろうじゃないかという審議会の答申ができた。…", "…きた。十の候補地のうち半分は東日本だ。東日本復興の総仕上げとして、この首都機能移転、国会等移転、やろうじゃないかと大臣言われたらどうですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114858X00720200603/136", "sentence": []}]}]}]