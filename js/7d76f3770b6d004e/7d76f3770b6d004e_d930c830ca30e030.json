[{"date": "2021-04-20", "meeting": [{"meeting_name": "衆議院 地方創生に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/85", "sentence": ["…りで、技能実習生の方が来られています。コロナが始まって、昨年から、ベトナム、ミャンマーの方々、私の地元、この二国が多いものですから、特に絞っ…", "…ころも出てきているわけです。ところが、情報が余りにも少ない。最新のベトナムへの帰国、そしてミャンマーへの帰国、どのようにすればよろしいでしょ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/89", "sentence": ["○白石委員それらのこと、今、国会で、これは議事録として残る。でも、ベトナム人、ミャンマー人の方々にどう伝えるかということなんです。先ほど外務…", "…国の便に乗れるのか、チケットはどこで買うのか、こういった情報をどのようにベトナム人、ミャンマー人に届けているのか、そこを確認させてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404773X00520210420/95", "sentence": []}]}]}]