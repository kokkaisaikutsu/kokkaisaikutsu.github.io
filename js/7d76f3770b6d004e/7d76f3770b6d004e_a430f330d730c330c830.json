[{"date": "2021-05-07", "meeting": [{"meeting_name": "衆議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/21", "sentence": ["…が発生したら、医療従事者と同等の優先順位でもって、まずＶ―ＳＹＳにインプットしないといけないですね。介護施設が病院の系列であったり連携医療機…", "…んあるわけです。ですから、そういったときには保健所長がＶ―ＳＹＳにインプットして、多分、二十人、三十人だと思うんですけれどもインプットして、…", "…ＳＹＳにインプットして、多分、二十人、三十人だと思うんですけれどもインプットして、そして接種ができるようにし、そして加えて、予約している時間…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/23", "sentence": ["…を考えたら、クラスターが発生したら、緊急避難的に、まずＶ―ＳＹＳにインプットしてもらって、そしてさらには割り込みをする、この二つですね、その…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/25", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/27", "sentence": ["○白石委員それは、医療従事者のＶ―ＳＹＳへのインプットというのは四月にはもう終わっていますよね。でも、今から内定が決まっていく人たちを医療従…", "…従事者として扱うには、またもう一回医療従事者としてのＶ―ＳＹＳへのインプット等が必要になるんじゃないですか。そこは、そこまで考えていらっしゃ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/29", "sentence": ["○白石委員確認ですけれども、Ｖ―ＳＹＳは、後から追加的に医療従事者のインプットもできるような仕組みになっているんですね。なっているんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404260X01720210507/51", "sentence": []}]}]}]