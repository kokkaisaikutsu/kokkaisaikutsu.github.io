[{"date": "2020-05-20", "meeting": [{"meeting_name": "衆議院 地方創生に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/71", "sentence": ["…それをもっていわゆるスティグマがつくんじゃないかと。実際、公共事業の入札だとか、契約には納税証明書又はそれにかわるものを持ってきてくださいと…", "…料の中の年金保険料の猶予許可通知書、こういったものをもらって、これを入札とかあるいは公共事業体との契約には持ってきてくださいと言われたりする…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/73", "sentence": ["…弱い立場ですから、猶予ということでまた後々不利な扱いを受けて、結局は入札とかに参加できなくなるんじゃないか、こういうふうに考えてしまいます。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/77", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/81", "sentence": []}]}]}]