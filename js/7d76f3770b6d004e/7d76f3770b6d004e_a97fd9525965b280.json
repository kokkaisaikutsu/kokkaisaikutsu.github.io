[{"date": "2020-05-13", "meeting": [{"meeting_name": "衆議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/103", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/111", "sentence": ["…いします。それともう一つ、九月入学を全体で考える場合は、今、六歳で義務教育、六歳になって初めて来る四月で義務教育になっていて、それがまた五カ…", "…体で考える場合は、今、六歳で義務教育、六歳になって初めて来る四月で義務教育になっていて、それがまた五カ月おくれるということで、今の世界の潮流…", "…月おくれるということで、今の世界の潮流であるとか、やはり子供は早く義務教育にして学校に入れて勉強させる、あるいはネグレクトなどの家庭の問題も…", "…トなどの家庭の問題もそれによって随分解消するということを考えたら、義務教育の年齢はおくらせない方がいいと思うんです。それで、今、文科省として…", "…はおくらせない方がいいと思うんです。それで、今、文科省として、ほかの国の義務教育の就学年齢というのは何歳と状況を把握されていますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/113", "sentence": ["○白石委員それで、副大臣、今政府で九月入学を検討する際に、ぜひ、義務教育を五カ月おくらせたままにするんじゃなくて一段早める、五歳にするという…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01220200513/1