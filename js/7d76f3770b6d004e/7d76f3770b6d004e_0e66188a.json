[{"date": "2020-05-20", "meeting": [{"meeting_name": "衆議院 地方創生に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/73", "sentence": ["…示ししたように、コロナの特例によって猶予を受けたということがちゃんと明記されるということを、一般の人にもわかるようにしていただきたい。事業者…", "…あって、猶予された場合の許可通知書等にはコロナ特例としてというふうに明記されるということを、わかるようにしていただきたい。これがないと、やは…", "…札とかに参加できなくなるんじゃないか、こういうふうに考えてしまいます。こういったものを明記していただきたいんですけれども、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/77", "sentence": ["…方はわかりようがない。だから、一般社団法人もオーケーのところはここに明記していただいて、一つのところでだめでも、よく見てみたら、自分も行ける…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/79", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104773X00820200520/81", "sentence": []}]}]}]