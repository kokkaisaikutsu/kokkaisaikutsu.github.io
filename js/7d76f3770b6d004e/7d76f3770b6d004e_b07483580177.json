[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第七分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/192", "sentence": ["…が基礎研究、次に経産省が来て、ここが製造で、一番川下、出口のところで環境省というところです。今までは、環境省が主にここに国の支援としてやって…", "…が製造で、一番川下、出口のところで環境省というところです。今までは、環境省が主にここに国の支援としてやってきたわけですね。金額も多いです。ど…", "…。どんなものに使われるか、それが安全なのかどうかということで、特に、環境省ですから、地球温暖化にどう資するのかというところを中心に国は研究開…", "…対して、今年度については三十億円、一方、経産省は八億円ということで、環境省が多いんですね。これはもう相当研究も進んできて、これはいける、安全…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/194", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/196", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/198", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/200", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/202", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/204", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/206", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/208", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/210", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105271X00120200225/212", "sentence": []}]}]}]