[{"date": "2020-04-24", "meeting": [{"meeting_name": "衆議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/112", "sentence": ["…なったら、厚生年金の加入者の方から抗議が来るかもしれません。今は、国庫負担というのが基礎年金の二分の一、年間十三兆円程度負担しております。こ…", "…ですけれども、ワンタイムで、調整期間を基礎年金についてもっと短くするように、国庫負担金を一時金として国民年金財政に入れたらいかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/116", "sentence": ["…から、やはり、この問題を解決するのは、ワンタイムでいいから、外から国庫負担金を入れる。私があらあら計算して、大体四、五兆ぐらいじゃないかなと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/118", "sentence": ["…覚的な、極めて限定的じゃなくて、計算していただけませんかね。さきの国庫負担一時金で、基礎年金が報酬比例と同じ調整期間になるための金額と、最後…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/120", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/122", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104260X01020200424/125", "sentence": []}]}]}]