[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/28", "sentence": ["○宮崎雅夫君ありがとうございます。私のモットーは、土地改良は未来への礎ということでございます。まさしく新しい農業の形であるスマート農業の礎を…", "…の礎ということでございます。まさしく新しい農業の形であるスマート農業の礎を土地改良で築いていっていただきたいというふうに期待をしております。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115007X00320200310/36", "sentence": []}]}]}]