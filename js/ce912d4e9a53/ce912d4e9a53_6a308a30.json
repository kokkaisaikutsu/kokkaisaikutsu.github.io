[{"date": "2020-11-12", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120305007X00320201112/150", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00320201112/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00320201112/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00320201112/157", "sentence": ["…ということでありますと。その中で、改めて確認をしますが、許諾料が五万なり六万発生するから現在の登録品種の自家増殖分を一般品種にかえるとかいう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120305007X00320201112/159", "sentence": ["…る一％ですから、全体の約〇・〇一％が今回の許諾料のコストということになります。その上で、一般品種か登録品種かを選択するのは生産者の自由ですか…"]}]}]}]