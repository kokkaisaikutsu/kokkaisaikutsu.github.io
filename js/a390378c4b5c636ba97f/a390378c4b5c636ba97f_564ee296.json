[{"date": "2021-03-30", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/112", "sentence": ["…っとよく分からない答弁がありましたけれども、実はＮＨＫ予算と決算には乖離が生じております。例えば、資料を見ていただけたらお分かりかと思います…", "…二百二十億円の黒字となっているわけです。予算と決算には二百五十億円の乖離が生じているわけでありまして、こうした傾向は今回限りでなくて、以前か…", "…ればならないわけでありますけれども、結果としてこのような予算と決算の乖離が生じ続けている現状について、大臣と会長に見解を伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/262", "sentence": []}]}]}]