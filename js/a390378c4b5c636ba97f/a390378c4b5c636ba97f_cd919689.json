[{"date": "2021-03-30", "meeting": [{"meeting_name": "参議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/106", "sentence": ["…あります。また、これについては新聞協会等は、ＮＨＫは報道や教養などを重視した公共放送としてふさわしい番組比率を自ら規定することも検討すべきと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/108", "sentence": ["…度から令和元年度までの三年度分が審議されていない状況にあります。決算重視と言われている参議院においては、これもやはり放っておけない問題であり…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/110", "sentence": ["…ますけれども、これも衆議院で質問をされたと同じなんですけれども、決算重視というのは民間人として当然であるというふうに答弁されておりました。Ｎ…", "…民間人として当然であるというふうに答弁されておりました。ＮＨＫは決算重視の体制となっているかについて、まず会長の御認識を伺うとともに、ＮＨＫ…", "…いて、まず会長の御認識を伺うとともに、ＮＨＫの効率的かつ適正な運営に当たってどのように決算を重視していくのか、会長にお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/117", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414601X00920210330/262", "sentence": []}]}]}]