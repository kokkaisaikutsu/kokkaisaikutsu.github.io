[{"date": "2020-05-13", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/174", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/176", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/178", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/180", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/182", "sentence": ["…ろを解消することにも是非取り組み続けていただきたいと思います。次に、保育現場への予算執行について質問させていただきます。昨年、会計検査院が保…", "…育現場への予算執行について質問させていただきます。昨年、会計検査院が保育士の処遇改善等加算による賃金改善状況について検査した結果、平成二十八…", "…金改善状況について検査した結果、平成二十八、二十九年の二か年の間に、保育所等において七億一千九百五十万円が職員の賃金改善に充てられていない状…", "…どう図られたのか。自治体に対する周知、指導監督を強化する等して確実に保育士の皆様に届くようにしていただきたい。是非これについて御答弁いただき…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/184", "sentence": ["○三浦信祐君是非今後ともよろしくお願いします。全国の保育現場では、新型コロナウイルス感染症拡大防止のために保育所の受入れ人数の抑制が図られ、…", "…します。全国の保育現場では、新型コロナウイルス感染症拡大防止のために保育所の受入れ人数の抑制が図られ、保育士の休業がなされております。その休…", "…ロナウイルス感染症拡大防止のために保育所の受入れ人数の抑制が図られ、保育士の休業がなされております。その休業について有休取得にて行われている…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/186", "sentence": ["○三浦信祐君明確に答えていただきました。府省が連携して、保育の現場に対して、改めてこのような強制的な有給休暇がなされる事案が生じないよう、保…", "…して、改めてこのような強制的な有給休暇がなされる事案が生じないよう、保育士の給与が削減されたりするようなことがないよう徹底して取り組んでいた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/188", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/190", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114103X00420200513/192", "sentence": []}]}]