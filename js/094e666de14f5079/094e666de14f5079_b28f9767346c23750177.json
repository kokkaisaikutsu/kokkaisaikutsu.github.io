[{"date": "2020-12-03", "meeting": [{"meeting_name": "参議院 外交防衛委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/111", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/113", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/115", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/117", "sentence": ["…対策によって全品目での国内生産量が維持されると平成二十九年十二月に農林水産省が試算を公表しております。大切なことは、減少見込みをカバーできる…", "…る影響を回避するためにも、日ＥＵ・ＥＰＡと同様に、引き続いて国内対策を進めていただきたいと考えております。対応について農林水産省に伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/119", "sentence": ["…けれども、農産品分野での不利益等について、実際、締結後の実態、現状はどのようになっておりますのでしょうか。所見も含めて農林水産省に伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/123", "sentence": ["…の上で、本締結後、本邦農林水産品の輸出促進についての具体的ターゲットと具体的な取組はどのようになっているのでしょうか。農林水産省に伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120313950X00620201203/135", "sentence": []}]}]}]