[{"date": "2020-05-15", "meeting": [{"meeting_name": "衆議院 文部科学委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/47", "sentence": ["…けれども、三月の二十四日に来春から採用される中学校教科書の検定結果が公表されました。これを受けての新聞報道を見て、ちょっと驚いた点が幾つかあ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/49", "sentence": ["…いうことは、学術的な見地から検定意見が付されなかったということなんですけれども、検定意見書というのは、念のために、これは公表されるんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/55", "sentence": ["…定基準に照らして不適切な箇所について意見書を作成する、意見書案をまずは作成するわけですけれども、では、この意見書案そのものは公表されますか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/57", "sentence": ["○牧委員それはどこで公表されるんですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/59", "sentence": ["…。意見書案もホームページで、意見書じゃなくて意見書案もホームページで公表されるということですので、それを見ていなかった私が悪いのかもしれませ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105124X00720200515/75", "sentence": []}]}]}]