[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/512", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/514", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/516", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/518", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/520", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/522", "sentence": ["…まってしまったところであったんですが、一車線、これをあけていただいて緊急車両を通していただいて、これが実際に命をつなぐ道路であったということ…", "…を見据えて、地域の自治体である坂町の小屋浦に救急車が通ることができる緊急退出路を設置してほしい、そういった地元の声もあるところでございます。…", "…聞くところでもございます。道路の狭い既存の道路を広くする、あるいは、緊急時には迂回路として機能して、また平常時は一般の生活にも使用できる側道…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/524", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/526", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/528", "sentence": []}]}]}]