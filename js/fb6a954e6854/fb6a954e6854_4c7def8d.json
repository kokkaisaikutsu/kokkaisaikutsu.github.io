[{"date": "2020-02-21", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/82", "sentence": ["…号の船内での事務に携わっているというお話でしたので、そうすると、通勤経路、どうだったのかというのが心配になります。これは、まず厚生労働省の職…", "…たので、そうすると、通勤経路、どうだったのかというのが心配になります。これは、まず厚生労働省の職員の方、どういう通勤経路だったんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/84", "sentence": ["…ですが、東京の方の自宅には戻っていないということですが、これは、通勤経路は、そうすると徒歩で通勤をされていたということなんでしょうか、それと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/86", "sentence": ["○櫻井委員じゃ、その厚生労働省の職員の方の通勤経路は確認していただくということで。あともう一人、内閣官房の方は、先ほどの答弁ではどちらにお住…", "…住まいかという答弁がなかったように聞こえたんですけれども、こちらはどちらにお住まいなのか、また、その通勤経路も教えていただけますでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/92", "sentence": ["…る業務としてはしていないというふうに思います。そうしますと、どういう経路で感染されたのかというところがちょっとまたわからなくなってくるわけで…", "…経路で感染されたのかというところがちょっとまたわからなくなってくるわけですけれども、これはどういう経路で、この方々、感染されたんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/107", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/109", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/111", "sentence": []}, 