[{"date": "2020-03-10", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/10", "sentence": ["…テナ埠頭へのアクセス、これを改善していくことが重要な取組だと考えますが、このお取組について、国土交通省の方から御説明をよろしくお願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/14", "sentence": ["…も荷物を集めてくるべきではないのかというふうにも思うんですが、この点についての営業活動の取組、国土交通省から御説明よろしくお願いいたします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00820200310/16", "sentence": ["○櫻井委員先ほど麻生大臣からも国土交通省に対するエールもございましたので、ぜひ政府一丸となって取組を進めていただきますようお願い申し上げまし…"]}]}]}]