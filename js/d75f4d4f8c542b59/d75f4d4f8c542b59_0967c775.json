[{"date": "2020-06-10", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/57", "sentence": ["…を訴えました。その要点を抜き書きいたしました。ちょっと読み上げます。有症者に対して受動的に検査を行うのではなく、発想を転換し、適切に検査対象…", "…行い、先手を打って感染拡大を防止する。もう一点。ごく軽症も含む全ての有症者や全ての接触者への速やかな検査を行うとともに、症状の有無にかかわら…", "…ます。この緊急提言の考え方というのは、これまでのような強い症状が出た有症者に対して受動的な検査を行うのではなくて、発想を転換して、無症状者も…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/59", "sentence": ["…言すべきだ、実行すべきだというふうに言っております。これまでのような有症者に絞る検査では、結局、経路不明者がふえて感染経路が追えなくなって、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X02720200610/77", "sentence": []}]}]}]