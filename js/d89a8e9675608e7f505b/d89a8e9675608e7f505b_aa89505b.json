[{"date": "2020-03-09", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/42", "sentence": ["…初めて妊娠期からの支援が盛り込まれました。今後、各地に、困難を抱える親子が守られ、自立へと歩める環境が醸成されるものと期待しております。若年…", "…のと期待しております。若年妊婦等の母子保護事業の展開を含め、困難を抱える親子を孤立させないための政府の取組方針について、総理にお伺いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/50", "sentence": []}]}]}]