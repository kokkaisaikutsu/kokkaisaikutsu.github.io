[{"date": "2020-03-09", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/31", "sentence": ["…るメッセージを学校から発信する、こうした取組なども、できることはいろいろあるのではないかなと思います。文科省としての対応方針をお伺いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/33", "sentence": ["…年は台風の被害で小学校教員認定資格試験の二次試験が中止となりました。文科省の迅速な救済措置によって、最終的には二百四十八名が合格なさいました…", "…春から、きっと学校現場で御活躍いただけるものと期待しています。自民党文科部会としては、昨今の大規模災害の発生状況を踏まえれば、公益を担う貴重…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/37", "sentence": ["…にも既に着手いただいております。日本ならではの革新的技術が世界に先駆けて輩出されるよう頑張ってほしいと思います。文科省の支援方針を伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/46", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/48", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00920200309/50", "sentence": []}]}]}]