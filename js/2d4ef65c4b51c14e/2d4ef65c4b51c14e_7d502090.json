[{"date": "2020-05-22", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/34", "sentence": ["…同社が契約期間を当初の三十五年から二十五年に変更したことなどを契約の偽造と機構は指摘したとされています。これに対して、新日本通産側は、偽造で…", "…の偽造と機構は指摘したとされています。これに対して、新日本通産側は、偽造ではなく、軽微な契約変更だと主張していて、このような提訴内容になって…", "…いたように、機構側の違反はなかったということですが、新日本側の、いわゆるこの訴訟の内容に書いてある偽造された契約書は何件あったんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X01420200522/40", "sentence": []}]}]}]