[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/5", "sentence": ["…類を除き、ほかの茨城県産の農林水産物と食品は輸入停止になっています。菅家副大臣の福島も栃木も同じだと思います。韓国、米国は一部輸入停止、特に…", "…ます。時間の関係で一例しか申し上げませんが、復興はまだ道半ばです。これからの復興をどう進めていくのか、菅家副大臣にお尋ねをしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/7", "sentence": ["○岡田広君菅家副大臣からいろいろ答弁をいただきました。菅家副大臣は会津若松の市長もされておりますから、現場を一番知る副大臣として是非様々な課…", "○岡田広君菅家副大臣からいろいろ答弁をいただきました。菅家副大臣は会津若松の市長もされておりますから、現場を一番知る副大臣として是非様々な課…", "…ボット大国でもありますので、これを是非成功させていただきたいと思います。菅家副大臣は御退席いただいて結構です。委員長、よろしくお願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114889X00320200310/28", "sentence": []}]}]}]