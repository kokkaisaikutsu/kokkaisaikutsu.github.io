[{"date": "2020-04-10", "meeting": [{"meeting_name": "衆議院 国土交通委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/31", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/39", "sentence": ["○田所委員次に、インフラの老朽化に対する安全確保についてお伺いをいたします。我が国では、高度経済成長期に多くのインフラが整備されましたが、そ…", "…は、高度経済成長期に多くのインフラが整備されましたが、それらが一斉に老朽化しているわけであります。建設後五十年以上経過する施設の割合が急増し…", "…す。人災を招いてはならないというふうに思っております。そういう中で、老朽化対策と長寿命化を怠ることは、安全性が損なわれるだけではなくて、より…", "…てしまいます。安全性の確保とコスト縮減のためにも、計画的なインフラの老朽化、長寿命化対策が必要と考えられますけれども、どのように進めようとし…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104319X00720200410/45", "sentence": []}]}]}]