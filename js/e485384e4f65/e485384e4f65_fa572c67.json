[{"date": "2020-11-17", "meeting": [{"meeting_name": "衆議院 災害対策特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/10", "sentence": ["…が、災害復旧の考え方でございます。災害復旧の考え方は原状回復、これが基本になっているんですが、改良復旧、局地激甚、本激についての説明をお願い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/12", "sentence": ["○藤丸委員ここが問題でありまして、原状回復しかだめなんですよ、基本は。つまり、原状回復までは三分の二出るんです。三分の二、原状回復は。みんな…", "…則原状回復と、原状復旧というふうに書いてあるものですから、原状回復が基本ということになって、ここは三分の二になるんですけれども、改良復旧にな…", "…。私は、ここで言いたいのは、原則、再度災害防止という観点も考えれば、基本、災害復旧事業は、改良復旧というか、改良復旧というとどんなことでもす…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120304339X00320201117/24", "sentence": []}]}]}]