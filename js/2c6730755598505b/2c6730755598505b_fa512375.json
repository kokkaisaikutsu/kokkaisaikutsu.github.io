[{"date": "2020-05-19", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/12", "sentence": ["…できるようになります。さらに、健康保険に加入されるなら、疾病手当金や出産手当金を受け取ることができるようになりますので、重要な改正と考えます…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/24", "sentence": []}]}]}, {"date": "2021-04-08", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/147", "sentence": ["…。そこで、就業率と退職率について質問をさせていただきたいと思います。出産は、女性にとりましては、喜びと育みを経験する、人生における一つの大き…", "…とも伺います。仕事と家庭の両立は女性にとって最大の関心事だと思いますが、出産後の女性の継続就業率と退職率はどのようなものかを教えてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/149", "sentence": ["…加しているものの、半数は退職しているということだと思いますが、妊娠や出産を機に退職した理由についての調査結果があれば、その概要を教えてくださ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/151", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/159", "sentence": ["…ただきます。今回の法改正において、雇用環境の整備の義務付けや、妊娠、出産の申出をした労働者に対して育児休業制度の周知