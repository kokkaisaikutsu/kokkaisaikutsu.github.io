[{"date": "2020-05-19", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/12", "sentence": ["…選択をゆがめられたり不公正を生じることがないようにするために、短時間労働者に対する年金等の保障を厚くする観点から、被用者保険の適用拡大が進め…", "…られております。二〇一六年十月、従業員数が五百人超の企業で働く短時間労働者について被用者保険の適用拡大がなされました。さらに、今回の改正でよ…", "…者保険の適用拡大がなされました。さらに、今回の改正でより多くの短時間労働者が被用者保険に加入することとなれば、将来受け取る年金が増えることに…", "…整した人より労働時間を延ばした人の方が多く、実際に適用を受けた短時間労働者の収入は増加傾向であったと聞いております。そこで、お伺いいたします…", "…ったと聞いております。そこで、お伺いいたします。適用拡大に伴う短時間労働者の就業調整についてどのように見通しているか、また就業調整にどのよう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114260X01220200519/24", "sentence": []}]}]}, {"date": "2021-04-08", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/149", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/151", "sentence": ["…とができるという、そういう前向きなお気持ちも伺っておりますので、是非労働者の福祉の増進に資するように今回の法改正をつなげていっていただきたい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/153", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X00720210408/157", "