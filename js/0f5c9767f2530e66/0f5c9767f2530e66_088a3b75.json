[{"date": "2020-05-22", "meeting": [{"meeting_name": "衆議院 決算行政監視委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104127X00320200522/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00320200522/6", "sentence": ["…、国家公務員の人員の件ですね。これは、人員の毎年見直しというのが五年計画で出ていますけれども、大体、なめると、毎年二％ずつ人員を自動的に減ら…", "…ますが、その人員増の状況と、そして、今後もこのコロナ対応で人員が必要になると思われますので、その計画についてお答えをいただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00320200522/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00320200522/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00320200522/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00320200522/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104127X00320200522/16", "sentence": []}]}]}]