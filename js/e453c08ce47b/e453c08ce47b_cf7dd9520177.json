[{"date": "2020-03-19", "meeting": [{"meeting_name": "衆議院 総務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104601X01120200319/29", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01120200319/31", "sentence": ["…だきたいと思います。ちなみに、総務大臣はどうなんだろうということで、総務省のホームページを確認させていただきました。きょうも、この委員会が始…", "…も嫌だろうなというぐらい近い距離で映像が撮られておりまして、それだけ総務省も情報公開、発信に努めている。このこともしっかりＮＨＫも参考にして…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01120200319/33", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01120200319/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104601X01120200319/37", "sentence": []}]}]}]