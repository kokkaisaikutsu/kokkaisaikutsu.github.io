[{"date": "2020-03-03", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/183", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/185", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/187", "sentence": ["…の特措法には、例えば、地域の医療施設だけでは対応し切れない場合、建築基準法の適用除外にすることでいち早く新たな医療施設を造れるようにする、あ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/195", "sentence": ["…いています。ＰＣＲの保険収載は喜ばしいことではあるが、適正かつ厳格な基準なしには検査の乱発となり、第一線の医療現場は大混乱に陥る、医師の総合…", "…しては、政府に対する第二次提言の中で、検査を医師が必要と認める場合の基準を明確化、統一化することを求めております。ＰＣＲ検査の保険適用によっ…", "…と考えますが、いかがでしょうか。また、検査を医師が必要と認める場合の基準についてどのように明確化、統一化していくのか、お聞きしたいと思います…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/205", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/209", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/211", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/217", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/1201152