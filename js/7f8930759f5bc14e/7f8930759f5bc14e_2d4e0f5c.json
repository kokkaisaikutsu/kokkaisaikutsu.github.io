[{"date": "2020-03-03", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/183", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/185", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/187", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/189", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/191", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/193", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/195", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/197", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/199", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/201", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/203", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/205", "sentence": ["○西田実仁君我が党は、この政府に対する提言におきまして、中小・小規模事業者の資金繰り支援についても要請をしてまいりました。ホテルや旅館など観…", "…繰り支援についても要請をしてまいりました。ホテルや旅館など観光関連の中小・小規模事業者にとどまらず、中国からの輸入の停滞などにより多大な影響…", "…者にとどまらず、中国からの輸入の停滞などにより多大な影響を受けている中小企業からも窮状を伺っております。今週には、経済対策についても新たな提…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/207", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/209", "sentence": ["○西田実仁君中小・小規模事業者の資金繰り支援についてお聞きしたいと思います。中小・小規模事業者の皆さんからは、二週間程度我慢すればいいのであ…", "…仁君中小・小規模事業者の資金繰り支援についてお聞きしたいと思います。中小・小規模事業者の皆さんからは、二週間程度我慢すればいいのであれば我慢…", "…ばたばた倒れてしまうとの悲鳴がもう既にたくさん上がってきております。中小・小規模事業者に対してもこれまでにない思い切った施策が必要と考えます…", "…、総理の決意をお聞きしたいと思います。また、総理はさきの会見において中小企業からの直接の声を聞くと言われました。具体的にどのようなことをお考…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/211", "sentence": ["○西田実仁君その中で、例えば中小・小規模事業者の場合、無担保無保証のいわゆるマル経融資、小規模事業者経営改善資金により運転資金を調達している…", "…ざいます。マル経融資には、昨年の台風十九号など自然災害により被災した中小企業に対して特別の融資枠、すなわち災害マル経というのがございますが、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/213", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/215", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/217", "sentence": ["○西田実仁君是非、今、中小・小規模事業者の方々、既に資金繰りに窮しておりまして、商店街のこうした補助金の返還等は求めない方向で検討いただきた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/219", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/221", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/223", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/225", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/227", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/229", "sentence": []}]}]}]