[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第四分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/143", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/145", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/147", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/149", "sentence": ["…れども、この政府の見解の次のところに書いているのは、これから先、ロードマップを策定する段階に入るんですが、重点大型研究計画に選ばれなかったと…", "…る段階に入るんですが、重点大型研究計画に選ばれなかったとしても、ロードマップに載るための審査の対象にはなるというふうに書かれております。ただ…", "…き計画ではないからだということだったわけなんですが、果たしてこのロードマップで復活する可能性はあるのかどうか、ここをぜひお聞かせいただければ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/151", "sentence": ["…のかなというふうに見ております。こうした予算規模の大きさ、これがロードマップに掲載される上で支障となる可能性はあるのかないのか、ここもお答え…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/153", "sentence": ["○階分科員それでは、このロードマップに最終的に仮に掲載されなかった場合、これはもうＩＬＣは絶対に予算はつけられないということになるのか、すな…", "…ＩＬＣは絶対に予算はつけられないということになるのか、すなわち、ロードマップへの掲載の有無が予算化に直結するのかどうか、ここもお聞かせいただ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/155", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/157", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/159", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/162", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/164", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/166", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/168", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/170", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/172", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/174", "sentence": []}]}]}]