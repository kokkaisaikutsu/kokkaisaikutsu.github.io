[{"date": "2020-04-10", "meeting": [{"meeting_name": "衆議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/49", "sentence": ["○階委員大臣、恥ずかしくないですか。いつもそうやって論点ブロックみたいな紙を読み上げて、昔の司法試験の受験生みたいなことをやって。それがだめ…", "…司法試験よりも今の方がいいんだなんて言われるわけですよ。そんな論点ブロックを見ないで、自分の言葉で、端的に、わかりやすく。さっき私が冒頭に言…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/51", "sentence": ["…どういう諸情勢の変化があったか、自分の言葉で答えてくださいよ。論点ブロックを見るような、昔の司法試験受験生のようなことをやっていたら、いつま…", "…司法試験受験生のようなことをやっていたら、いつまでたっても国民の信頼は得られませんよ。答えてください。また論点ブロックを見ないでくださいよ。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/75", "