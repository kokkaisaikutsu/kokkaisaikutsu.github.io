[{"date": "2020-02-21", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/274", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/276", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/278", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/280", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/282", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/284", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/286", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/288", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/290", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/292", "sentence": ["…ことを言っていますね。これが国会監視を受ける日銀総裁の言うべきことですか。独善的に過ぎるんじゃないですか。撤回して謝罪すべきではないですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/294", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/296", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/298", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/300", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/302", "sentence": ["…いるとか、そういうようなことを誹謗中傷のように言われたわけですけれども、この発言は適切だったと思いますか。撤回して謝罪する意思はないですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/304", "sentence": ["○階委員撤回して謝罪するつもりはないというお答えということで理解していいですか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/306", "sentence": ["…ませんし、全く説得力がないですよ。でも、あえてこの場で撤回もしない、謝罪もしないということであれば、それはそれで、そういう人だということで受…", "…ことであれば、それはそれで、そういう人だということで受けとめますけれども、撤回も謝罪もしないという結論でいいですか。そこだけお答えください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X00420200221/308", "sentence": ["…、全く私たちの言うことには耳も傾けず、そして誹謗中傷しておいて撤回も謝罪もしないということでは、到底、日銀総裁として職責を果たしているという…"]}, {"url": "https: