[{"date": "2020-04-10", "meeting": [{"meeting_name": "衆議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/45", "sentence": ["…検察官が「準司法官」として、以上のような地位と職責を持ち、特殊な検察体制を構成して居る点から見れば、検察官は公務員法では一応「一般職」に含ま…", "…ます。こうしたことからすると、検察官については一般の公務員と同様の定年制の適用があるといったようなことをこの国会でるる繰り広げられて、解釈変…", "…それから、昭和五十六年の国公法改正法時に設けられた国家公務員の勤務延長制度は検察官には適用されないという政府見解もあったということ、そういっ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/69", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/71", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/73", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200