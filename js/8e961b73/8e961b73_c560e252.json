[{"date": "2020-04-10", "meeting": [{"meeting_name": "衆議院 法務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/37", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/47", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/49", "sentence": ["…のはやめてください。その上で、過去の今の点に関する国会の答弁では、諸情勢の変化とかそこから生じる新たな要請というものがあったから法解釈の変更…", "…から法解釈の変更はなし得るんだということも言われています。そうした諸情勢の変化は、この短い期間にあったとは到底思えないんですね。もしあったと…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/51", "sentence": ["…とになるわけですよ。もしそうでないというんだったら、この間どういう諸情勢の変化があったか、自分の言葉で答えてくださいよ。論点ブロックを見るよ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/53", "sentence": ["○階委員まず、昭和五十六年から情勢が変化した、それはそれで認めますけれども、だったらなぜ、十月末の最初に案をまとめた段階で、それを考えて今回…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/55", "sentence": ["○階委員個別の人事について聞いていませんよ。それだけ情勢の変化があるんだったら、黒川さん以外にも勤務延長が出てきて当然じゃないですか。しかも…", "…延長はされないわけじゃないですか。全く必要がなかったこの解釈変更、諸情勢の変化というのも後からつくり出しただけであって、本当に諸情勢の変化と…", "…変更、諸情勢の変化というのも後からつくり出しただけであって、本当に諸情勢の変化ということがあるんだったら、長い間かけて十月末まで検討したわけ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/61", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/63", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/65", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/67", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105206X00820200410/69", "sentence": []}, {"url"