[{"date": "2020-02-04", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/431", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/433", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/437", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/442", "sentence": ["…いただきたいので、総理、聞いておいてください。三大都市圏を見ますと、東京圏、これは埼玉、千葉、東京、神奈川でありますが、十四万八千七百八十三…", "…は一万五千十七人の転出増なんですね。つまりは、三大都市圏であっても、東京圏しか転入増でなくて、大阪圏も名古屋圏もいわゆる転出増になっている。…", "…でなくて、大阪圏も名古屋圏もいわゆる転出増になっている。そして、この東京圏への転入超過は一九九六年から二十四年間連続であり、そして、転入数の…", "…て、どういう目標を立てられたかというと、二〇二〇年の時点で、地方から東京圏に転入した人と転出した人を均衡させると言っているんですね、目標を。…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/446", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/448", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/452", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/456", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/458", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/460", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/462", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/466", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/470", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/472", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/475", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/477", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/479", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/481", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00620200204/483", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/12010