[{"date": "2020-02-17", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/389", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/391", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/393", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/395", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/397", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/399", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/401", "sentence": ["…ら、政府に伺いたいと思います。もう一つの大きな制約というのは、巨額の委託手数料なんですね。この低金利、融資ができないなどの制約、高い配当性向…", "…どの制約、高い配当性向のほかに、ゆうちょ銀行には、日本郵便への巨額の委託手数料というハンディがあります。年間手数料は約六千億円。まあ、昨年四…", "…から一〇％ぐらい減っていますね。つまりは、三分の一ぐらいをこの郵便の委託料に払わなきゃいけない構造になっているわけですね。しかも、これは日本…", "…ています。これについての是非は、時間がないので問いません。現在、この委託手数料、さっきの配当と同じで、ゆうちょ銀行の経営状況に関係なく、直営…", "…用価値、ゆうちょからしてですね、日本郵便の利用価値という観点からこの委託手数料というものを算出するということに、二〇二一年度以降変えるべきじ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/403", "sentence": ["…い、そういうハンディがある。そして、経営状況に関係なく高い配当性向と委託手数料を余儀なくされている。これで、ほかの金融機関と公平な競争が可能…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/405", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/407", "sentence": ["…いったって、これだけ競争条件が違えば無理ですよ。高い配当性向、そして委託料、そして貸付けができない、そして、日本郵政の株が二分の一を下回らな…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/409", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/411", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/413", "sentence": []}]}]}, {"date": "2021-04-20", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120404376X01220210420/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404376X01220210420/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120404376X01220210420/123", "s