[{"date": "2020-02-17", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/389", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/391", "sentence": ["…日本郵政が一〇〇％株式を保有するということ。そして、ゆうちょ銀行、かんぽ生命というものにつきましては、これは将来的には全部株をいわゆる上場す…", "…になっておりますが、今は日本郵政が、ゆうちょ銀行については八九％、かんぽ生命については六四・五％持っている、こういうことであります。さて、今…", "…については六四・五％持っている、こういうことであります。さて、今、かんぽ生命の話で、いろいろな不正取引、不正な販売があったということで問題に…", "…停止を金融庁からなされているということでありますが、きょう、私は、かんぽ生命の問題ではなくて、ゆうちょの抱える問題について少し、まず、前半は…", "…い折れ線グラフは日経平均であります。そして、緑がゆうちょ銀行、青がかんぽ生命ということでございまして、きょう取り上げるゆうちょ銀行というのは…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/393", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/395", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/397", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/399", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/401", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/403", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/405", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/407", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/409", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/411", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01220200217/413", "sentence": []}]}]}]