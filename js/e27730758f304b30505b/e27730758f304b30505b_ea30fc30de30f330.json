[{"date": "2020-05-11", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/89", "sentence": ["…てくださいといっても、十分な財源がなければできないという状況です。リーマン・ショックのときにもこの助成金出していただきましたけど、リーマンの…", "…。リーマン・ショックのときにもこの助成金出していただきましたけど、リーマンのときは地域活性化の公共投資金が一・三兆円上増しされています。二・…", "…三兆円上増しされています。二・三兆付いているんですね。でも、今回、リーマン・ショック超えると言われているのに、たった一兆でほんまに足りますか…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/91", "sentence": ["…八十二万人増えると言われています。一％失業率が上がるごとに、過去のリーマンのときの統計を見れば、何と千八百人自殺者が出るという統計までありま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/93", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/95", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/97", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/99", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01920200511/104", "sentence": []}]}]}]