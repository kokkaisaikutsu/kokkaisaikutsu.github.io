[{"date": "2020-05-28", "meeting": [{"meeting_name": "衆議院 憲法審査会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/1", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/3", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/5", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/14", "sentence": ["…、委員各位による討議に入ります。発言を希望される委員は、お手元にあるネームプレートをお立ていただき、会長の指名を受けた後、御発言いただきたい…", "…指名を受けた後、御発言いただきたいと思います。発言が終わりましたら、ネームプレートは戻していただくようにお願いをいたします。発言は自席から着…", "…ましては、終了時間一分前及び終了時にブザーを鳴らしてお知らせをいたします。それでは、発言を希望される委員は、ネームプレートをお立てください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104183X00120200528/31", "sentence": []}]}]}]