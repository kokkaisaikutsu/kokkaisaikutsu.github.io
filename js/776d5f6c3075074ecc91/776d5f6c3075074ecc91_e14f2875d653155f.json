[{"date": "2020-05-27", "meeting": [{"meeting_name": "衆議院 財務金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/22", "sentence": ["…額保険はさっき無理だということがありましたけれども、あと、証券業での信用取引、あるいは非上場の株式、非上場企業の社債、これはどうでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/26", "sentence": ["○海江田委員それから、今の、証券で信用取引は無理でしょうというお話がありましたけれども、この後で触れますけれども、それからさっきもちょっと出…", "…う一つは、結局、貸金で借りて、そして今度は例えば株なら株を買うと、信用取引とそんなに違わなくなってしまうわけですよ。信用取引は、もちろん証拠…", "…なら株を買うと、信用取引とそんなに違わなくなってしまうわけですよ。信用取引は、もちろん証拠金というのを出して、価格が下がれば追い証、追加証拠…", "…するのは考えていませんよというのはちょっと安易じゃないか、しかも、信用取引などと矛盾するのではないだろうかと思いますけれども、いかがでしょう…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/38", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/40", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/42", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/44", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120104376X01720200527/46", "sentence": []}]}]}]