[{"date": "2021-04-07", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/129", "sentence": ["○平木大作君続いて、復興庁の事業についてお伺いをしていきたいと思います。今日、平沢大臣に御出席をいただいております。震災から十年がたったとい…", "…こういう視点も忘れてはいけないんじゃないかというふうに思っています。復興庁として、先日、東日本大震災復興の教訓・ノウハウ集というのを公表いた…", "…得られた教訓、一体どのようなものであったのか。また、これ、今年度から復興庁内に復興知見班というのが創設をされております。この創設の意義と併せ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/135", "sentence": ["…認識をしております。改めて、この関連死を防ぐ上で重要とされるこの避難生活の環境改善、どう取り組んできたのか、復興庁にお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/139", "sentence": []}]}]}]