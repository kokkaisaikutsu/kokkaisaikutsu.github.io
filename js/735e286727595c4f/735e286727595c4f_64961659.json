[{"date": "2020-12-01", "meeting": [{"meeting_name": "参議院 内閣委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/82", "sentence": ["…れは、現在、大阪市、そして札幌市、三週間このキャンペーンから地域的に除外をするということになったわけでありますが、そして、今御説明もいただき…", "…てきたというわけでありますから、そういう中で、なかなかこの一部地域を除外するということの整合性ってどう取ったらいいのかという。特に現地で、ホ…", "…やってもかというやるせない思いもお伺いするわけでありまして、この地域除外の趣旨ということについて改めて御確認をさせていただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120314889X00520201201/96", "sentence": []}]}]}]