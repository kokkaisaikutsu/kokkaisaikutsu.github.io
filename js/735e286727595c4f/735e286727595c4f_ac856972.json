[{"date": "2021-04-07", "meeting": [{"meeting_name": "参議院 決算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/125", "sentence": ["…かなというふうに自分なりに考えてみまして、例えば令和元年における不正薬物の押収量というのがありまして、これ史上初めて三トンを超えております。…", "…伺いするのと、あわせて、これやはり人の往来とか物の往来と違って、不正薬物というのはもう全部基本は止めなきゃいけないというものだというふうに思…", "…本は止めなきゃいけないというものだというふうに思っております。ここの不正薬物の摘発に向けた方針、併せてお示しをいただけたらと思っております。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/127", "sentence": ["…とどめておきたいと思いますが。税関の様々な仕事の中で、例えばこの不正薬物の押収、十分の一も占めていることもないだろうというふうに思っています…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/129", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/135", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414103X00220210407/139", "sentence": []}]}]}]