[{"date": "2020-11-18", "meeting": [{"meeting_name": "衆議院 外務委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/119", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/125", "sentence": ["…あるというふうに考えております。農林省としては、引き続き、日・ＥＵ・ＥＰＡを含む経済連携協定が及ぼす国内牛肉生産への影響をしっかり注視してま…", "…ミルク及びクリームは、そのほとんどが脱脂粉乳でありまして、日・ＥＵ・ＥＰＡ発効後、ＥＵからの輸入額はわずかに増加をしておりますけれども、これ…", "…て、輸入量は減少しております。他方、バターにつきましては、日・ＥＵ・ＥＰＡ発効後、ＥＵからの輸入量は増加しておりますけれども、これは、国内で…", "…で、国家貿易によりまして輸入したことによるものであります。日・ＥＵ・ＥＰＡにおきまして、脱脂粉乳及びバターについては、国家貿易制度を維持する…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/127", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/133", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/137", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/139", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120303968X00320201118/141", "sentence": []}]}]}]