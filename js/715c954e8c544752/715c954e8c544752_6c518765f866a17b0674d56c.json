[{"date": "2020-02-10", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/361", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/363", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/365", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/368", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/370", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/372", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/374", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/376", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/378", "sentence": ["…が、そもそもわからないんです。このような、もともとあった本物の公文書を今回のように白塗りにすることは公文書管理法に反しますか、反しませんか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/380", "sentence": ["…から。国会法とか言っていません。白塗りにしてその文書を他に出すことは公文書管理法に反しませんか、反しますか、どっちですかと聞いているんです。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/382", "sentence": ["…ら、私たちはわからないんですよ。国民もわからないんですよ。それは公文書管理法に反するんじゃないんですか。反しないんだったら、お答えいただきた…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/384", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/386", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/390", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/394", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/396", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/398", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/400", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/404", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01020200210/406", "sentence": ["○山井委員だから、処分もしているわけでしょう。公文書管理法の趣旨に反しているからじゃないん