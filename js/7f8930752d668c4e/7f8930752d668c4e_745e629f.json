[{"date": "2020-05-27", "meeting": [{"meeting_name": "衆議院 農林水産委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/16", "sentence": ["…っかり守っていただきたいと思います。本法律では、森林組合等は、理事の年齢及び性別に著しい偏りが生じないように配慮しなければならないという規定…", "…という規定が追加されることになっておりますが、現在、森林組合の理事の年齢構成は、六十一歳から七十歳が最も多く、全体の約五〇％、次いで七十一歳…", "…まな事情があることは理解をしておりますが、今回の法改正により、理事の年齢及び性別に著しい偏りが生じないように配慮しなければならないとすること…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105007X01420200527/20", "sentence": []}]}]}]