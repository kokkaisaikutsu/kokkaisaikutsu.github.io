[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/530", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/532", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/534", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/536", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/538", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/540", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/542", "sentence": ["…ひともよろしくお願いしたいと思います。次に、のと里山海道の四車線化、能越自動車道の整備促進について、私の地元の道路でありますが、質問をさせて…", "…。当初は片側一車線の二車線の自動車専用道路でございましたが、現在は、追越し区間などの整備を重ね、四車線区間が延長しておりますが、中能登地域か…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/544", "sentence": ["…ます。引き続き、御支援、また、御協力をお願いしたいと思います。また、能越自動車道の整備促進については、能登半島地域における高速交通ネットワー…", "…り、緊急時における命をつなぐ道路としても早期の整備を期待しておりますが、その能越自動車道のことについても国交省にあわせて伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/546", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/548", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/550", "sentence": []}]}]}]