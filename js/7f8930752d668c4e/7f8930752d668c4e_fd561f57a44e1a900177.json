[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/530", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/532", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/534", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/536", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/538", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/540", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/542", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/544", "sentence": ["…り、緊急時における命をつなぐ道路としても早期の整備を期待しておりますが、その能越自動車道のことについても国交省にあわせて伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/546", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/548", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/550", "sentence": []}]}]}, {"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第八分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/530", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/532", "sentence": ["…にも、港湾の整備は非常に重要なことだと考えております。金沢港、七尾港、輪島港の整備について国土交通省にお伺いをさせていただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/534", "sentence": ["…昨年の豪雪により大きな被害が発生した国道八号の被害状況、それを踏まえた冬期の道路交通確保のための対策について国土交通省に伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/536", "sentence": ["…雪作業の担い手の育成についても大変重要なことだと考えておりますが、国土交通省として今後どのように対策をしていくのか、お伺いをさせていただきま…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/538", "sentence": ["…らないと思っております。地域地域に合わせた対策についても、あわせて国土交通省としてどのように考えているのか、お伺いをさせていただきたいと思い…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/540", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/542", "sentence": ["…ののと里山海道の片側一車線の自動車専用道路については早期の複線化が望ましいと考えておりますが、国土交通省としての考え方を伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/544", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/546", "sentence": ["…な決まりがあることは承知をしておりますが、国として、こういった貴重な資源の保護に対しての考え方や対策について国土交通省に伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/548", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105273X00120200225/550", "sentence": []}]}]}]