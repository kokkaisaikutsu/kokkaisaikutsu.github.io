[{"date": "2021-04-22", "meeting": [{"meeting_name": "参議院 厚生労働委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/11", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/17", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/19", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/21", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/23", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/25", "sentence": ["…療機関における勤務医の名ばかり管理職と管理監督者について伺います。労働基準法四十一条二号では、管理監督者に該当すれば、労働基準法上の労働時間…", "…いて伺います。労働基準法四十一条二号では、管理監督者に該当すれば、労働基準法上の労働時間、休息、休日に関する規定が適用が除外されます。本法律…", "…たな時間外上限規制を導入するとしていますが、病院勤務医についても、労働基準法上の管理監督者に当たる場合は時間外労働の上限規制は適用除外になる…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/27", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/29", "sentence": ["○川田龍平君こうした医療法上の監督者、労働基準法とは別に、医療法では医療機関には管理者が置かれており、例えば医療法第十五条では、勤務する医師…", "…療法上の管理職、管理者というのは一般的にどういうポジションの方を指すのでしょうか。また、労働基準法上の管理監督者との違いについても伺います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/31", "sentence": ["○川田龍平君この医療機関では、一般的な役職である管理職、労働基準法の管理監督者に加えて、医療法上の管理者と、似たような言葉が存在します。一般…", "…えて、医療法上の管理者と、似たような言葉が存在します。一般企業でも労働基準法上の管理監督者を考慮した管理職の職務設定がされることは希有であり…", "…た待遇となることが多いと聞いています。医療機関において、勤務医が、労働基準法上の労働者としての実態を備えているにもかかわらず、曖昧な管理職で…", "…態を備えているにもかかわらず、曖昧な管理職であるという外形をもって労働基準法上の管理監督者として違法に時間外・休日労働をするなどの事例が生じ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/33", "sentence": ["…の検討にとっても非常に重要な役割を果たしたわけですが、この調査には労働基準法上の管理監督者に当たる医師は含まれているんでしょうか。含まれてい…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/35", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/37", "sentence": ["…保措置を講ずるよう医療機関の管理者に義務付け等することが考えられ、労働基準法上の管理監督者に当たるような者も当該措置の対象と想定されるとあり…", "…会や、その後の医師の働き方改革の推進に関する検討会では、どの程度、労働基準法上の監督者に当たる場合の勤務状況や対応についてどの程度議論された…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/39", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/41", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/43", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/45", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/47", "sentence": ["…令を行うこととされています。一方で、医師の時間外労働規制については労働基準法で定められるものであり、三六協定違反状況などは医療法第二十五条第…", "…労働基準監督署の対応は相談ベースとされており、労働者が、労働者側が労働基準法違反となる事実とその根拠となるしっかりとした証拠を準備しなければ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/49", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/51", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/53", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/55", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/57", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/59", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/62", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/64", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/66", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/68", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414260X01120210422/70", "sentence": []}]}]}]