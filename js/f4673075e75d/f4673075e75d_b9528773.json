[{"date": "2021-05-12", "meeting": [{"meeting_name": "参議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120415254X02120210512/43", "sentence": ["…団体の役割に関する規定が、国民の利便性の向上並びに行政運営の簡素化、効率化及び透明性の向上を挙げるにとどまっていました。これでは合理化のみが…", "…添付書類の省略等による手続の簡素化、行政機関等における登録等の処理の効率化、登録情報の正確性の確保、最新化、マイナポータルを活用した資格証明…", "…が欠如しているあかしだと言っても過言ではありません。行政の情報管理を効率化し、給付と負担の適切な関係に資するマイナンバー制度の趣旨からすれば…", "…徹底した改革を推進する役割こそ果たすべきです。そして、行政の現場で非効率となっている業務プロセスや不合理な制度、慣行などを利用者視点から徹底…", "…明らかにしたことです。行政のデジタル化を進めれば、行政業務の簡素化、効率化を実現するだけではなく、その手続コストが削減され、民間の活力を引き…"]}]}, {"meeting_name": "参議院 政治倫理の確立及び選挙制度に関する特別委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/81", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/91", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/105", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120414578X00220210512/150", "sentence": []}]}]}]