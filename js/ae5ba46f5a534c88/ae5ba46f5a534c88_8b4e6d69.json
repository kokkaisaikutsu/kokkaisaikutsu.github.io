[{"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第四分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/354", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/356", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/358", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/360", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/362", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/364", "sentence": ["…ての外国人に対する日本語教育の推進、これは九億五千五百万円とありますけれども、この事業についてまずは簡潔に説明をしていただきたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/366", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/368", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/370", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/372", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/374", "sentence": ["…は平成二十六年度までだったというふうに聞いたんですけれども、さっきの事業が大人対象であるならば、今度、これは子供対象の教室だというふうに私も…", "…れは子供対象の教室だというふうに私も記憶しているんですが、大変重要な事業であろうと思います。地元の人もやはりこれに対しては期待しているところ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/376", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/378", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/380", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/382", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/384", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/386", "sentence": ["…的な活用の推進ですね。山車等の修復を行っている地域文化財総合活用推進事業、これはすごく人気なんですよ、すごく人気。いい事業だなと思うんですが…", "…文化財総合活用推進事業、これはすごく人気なんですよ、すごく人気。いい事業だなと思うんですが、来年度予算と、公募、締切り、それから審査の状況、…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/388", "sentence": ["…員この予算の主要事項の中に、古典に親しむという文言があります。ソフト事業にもこれは使えるのかなと今思っているんですね。地元においても、橘逸勢…", "…のは静岡県の袋井市じゃないかという、それをきちんと記録に残そうという事業もあるんですが、これが使えないのかなというような話も今聞いております…", "…かなというような話も今聞いておりますし、申請しようという動きがあります。ソフト事業については、これはどのような態度で臨んでいくんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/390", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/392", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/394", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105270X00120200225/396", "sentence": []}]}]}]