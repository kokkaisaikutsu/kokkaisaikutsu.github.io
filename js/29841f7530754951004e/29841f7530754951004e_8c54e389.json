[{"date": "2020-03-17", "meeting": [{"meeting_name": "衆議院 本会議", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105254X01020200317/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105254X01020200317/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105254X01020200317/19", "sentence": []}]}, {"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X01220200317/121", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01220200317/123", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01220200317/125", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01220200317/448", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01220200317/470", "sentence": ["…的には、中立かつ公正な立場の仲介委員が当事者双方の意見を丁寧に伺い、和解案を提示するなどして、当事者の合意による紛争解決を図る仕組みとなって…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01220200317/490", "sentence": ["…まいります。ＡＤＲセンター発足当初は、損害賠償に関する民事裁判などの和解事例において清算条項が付いているケースが多いことから、各仲介委員によ…", "…来の請求権などが消滅しないことが明らかになるような条項を作成することとした結果として、清算条項を付した和解成立件数が減少したと考えられます。"]}]}]}]