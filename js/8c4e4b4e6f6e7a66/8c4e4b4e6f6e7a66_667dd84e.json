[{"date": "2020-11-05", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/691", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/693", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/695", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/697", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/699", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/702", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/704", "sentence": ["○二之湯智君次に、定額特別給付金、いわゆる十万円に、国民にひとしく配付された件についてお伺いしたいと思います。第一次補正、第二次補正の効果を…", "…仕組みで迅速かつ的確に家計への支援を行うということで十万円を皆さんに給付されたんですが、やや抽象的な表現で、どうすればいいんだということで、…", "…て、まあこれはかなり迅速に、約二か月ぐらいで多くの、もう全ての国民に給付されたことは私は高く評価したいんですが。さて、この十万円の使い方です…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/706", "sentence": ["○二之湯智君続きまして、持続化給付金の給付の方策について質問したいと思うんです。今回、余りにもこの手続に多くの費用が掛かり過ぎたんだと、こう…", "○二之湯智君続きまして、持続化給付金の給付の方策について質問したいと思うんです。今回、余りにもこの手続に多くの費用が掛かり過ぎたんだと、こう…", "…るべきではないかと、こういう意見を聞くわけでございまして、今回のこの給付の方法について、どういう点が足らなかったのか、どういう点を反省すべき…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/708", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/710", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/712", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/714", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/716", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/718", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/720", "sentence": []}]}]}]