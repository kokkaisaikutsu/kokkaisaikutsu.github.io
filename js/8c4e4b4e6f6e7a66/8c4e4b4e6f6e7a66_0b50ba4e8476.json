[{"date": "2020-11-05", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/691", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/693", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/695", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/697", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/699", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/702", "sentence": ["…生いたしまして、就任式の前に安倍総理はトランプ大統領を訪ねて、そして個人的な信頼関係を築かれたわけでございます。古くは、安倍総理と、また、い…", "…います。古くは、安倍総理と、また、いや、中曽根総理とレーガン大統領の個人的な関係。やはり、国際政治において首脳同士のいわゆる個人的な信頼関係…", "…ガン大統領の個人的な関係。やはり、国際政治において首脳同士のいわゆる個人的な信頼関係を構築するということは非常に両国の友好親善にとって重要で…", "…も、これから、どちらになられるにしても、どうやってこのアメリカの首脳との個人的な関係を築かれるのか、その点についてお伺いをしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/704", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/706", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/708", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/710", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/712", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/714", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/716", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/718", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120315261X00120201105/720", "sentence": []}]}]}]