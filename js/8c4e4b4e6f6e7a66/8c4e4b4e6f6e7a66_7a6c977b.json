[{"date": "2020-03-03", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/83", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/85", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/87", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/89", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/96", "sentence": ["…ていただきたいと、このように要望をいたしておきます。続きまして、この決算の本予算への反映について御質問をいたします。民間企業では予算よりも決…", "…算の本予算への反映について御質問をいたします。民間企業では予算よりも決算内容が大きく注目されます。決算はその企業の投資行動や事業計画に反映さ…", "…問をいたします。民間企業では予算よりも決算内容が大きく注目されます。決算はその企業の投資行動や事業計画に反映され、また、株価や会社の格付にも…", "…ます。国においても、予算について先に審議する衆議院に対して、参議院は決算の院として決算審議の充実に力を入れてまいりました。そのかいあって、年…", "…ても、予算について先に審議する衆議院に対して、参議院は決算の院として決算審議の充実に力を入れてまいりました。そのかいあって、年々決算の重要性…", "…院として決算審議の充実に力を入れてまいりました。そのかいあって、年々決算の重要性への認識も深まり、また決算を起点とする、計画、プラン、実行、…", "…まいりました。そのかいあって、年々決算の重要性への認識も深まり、また決算を起点とする、計画、プラン、実行、ドゥー、チェック、評価、アクション…", "…吾君着席〕そこで、ＰＤＣＡサイクルのＣ、つまりチェック、評価に当たる決算審議等をどのように令和二年度予算案に反映させているのか、その点を財務…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/108", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/110", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/112", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/114", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/116", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X00520200303/120", "sentence":