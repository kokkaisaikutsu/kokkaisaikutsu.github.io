[{"date": "2020-03-23", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/16", "sentence": ["…米国、豪州、台湾、シンガポール、香港など、中国の周辺国が中国からの入国制限を掛けている中、日本は経済的メリットなどから中国人を受け入れ、その…", "…らの入国禁止措置をとりました。総理、現在、ホットゾーンの欧州からの入国制限は発表されましたが、もう一つのホットゾーンのアメリカからの入国制限…", "…入国制限は発表されましたが、もう一つのホットゾーンのアメリカからの入国制限はまだです。日本を少しでもコールドにするために、早急に米国からの入…", "…らの入国制限はまだです。日本を少しでもコールドにするために、早急に米国からの入国制限を掛けるべきだと思いますが、総理の御見解をお願いします。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X01320200323/30", "sentence": []}]}]}]