[{"date": "2020-06-04", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/76", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/78", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/82", "sentence": ["…っていただいたように、「サービスを通じて把握した利用者の資金ニーズや資産状況を基に、利用可能な融資の紹介や、個人のライフプランに適した金融サ…", "…すが、金融庁では、この人生百年時代を見据えて、いわゆる貯蓄から例えば資産形成へといった大きな政策目標もあると思いますけれども、そういった意味…", "…に対して、金融庁が推進しているつみたてＮＩＳＡであるとか、そういった資産形成に資するような商品の紹介とか比較等を通して資産形成の必要性という…", "…るとか、そういった資産形成に資するような商品の紹介とか比較等を通して資産形成の必要性というものがある意味理解しやすくなるのではないかなという…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/86", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/88", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/90", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X01520200604/96", "sentence": []}]}]}]