[{"date": "2020-06-11", "meeting": [{"meeting_name": "参議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/596", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/598", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/600", "sentence": ["…んですけれども、国がしっかりと支援をしていく、責任を持ってやっていくということが大事だと思いますので、この点、厚労大臣に伺いたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/602", "sentence": ["…いうのは効率がよくないというふうな専門家の意見もございます。そもそも厚労省は陰性証明、陰性証明書というのは認めておりません。そこで、総理に伺…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/604", "sentence": ["…中、全ての妊産婦の方が安心して出産し、子育てができるよう国として支援をすべきだと考えますけれども、厚生労働大臣、御所見を賜りたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/606", "sentence": ["…インフルエンザの備えということも専門家会議等で議題の一つとして取り上げていただきたいというふうに思いますが、加藤厚労大臣、いかがでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/608", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/610", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/612", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120115261X02120200611/614", "sentence": []}]}]}]