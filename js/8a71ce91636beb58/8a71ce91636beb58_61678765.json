[{"date": "2020-03-10", "meeting": [{"meeting_name": "参議院 財政金融委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/80", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/82", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/84", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/86", "sentence": ["…す。この五十八条の中に金銭債務の支払猶予というふうにあるわけですが、ここについて、五十八条のこの条文について御説明をいただければと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/88", "sentence": ["…るということになるわけです。今は国会が開いている状態であります。国会が開いているときにはこの条文はどのように解釈すればよろしいんでしょうか。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/90", "sentence": ["○熊野正士君なので、国会が開会中にはどうするかということは条文からは読めないということが結論なのかもしれませんが、午前中の大塚先生の議論も聞…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/92", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/94", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/96", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/98", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/100", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/102", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/104", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/106", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120114370X00320200310/108", "sentence": []}]}]}]