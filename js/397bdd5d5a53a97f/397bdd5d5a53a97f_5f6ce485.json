[{"date": "2020-02-07", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/14", "sentence": ["○笹川委員それでは、続きまして、豚熱対策について江藤大臣にお伺いをさせていただきます。先月、家畜伝染病予防法改正案につきましては、もう本当に…", "…いたというふうに思っております。そこで、改めて、この成立を受けて、今後の展開について江藤大臣の御所見をお伺いをさせていただければと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/16", "sentence": ["…問題に対処していくことが肝要かというふうに思いますので、引き続いて、江藤大臣にはリーダーシップを発揮していただいて対処していただきたいという…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/18", "sentence": ["…くという声があったんですよね。そのことをぜひ受けとめていただきたいというふうに思います。改めて、ちょっと江藤大臣、御所見を聞かせてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/22", "sentence": ["…なめになるというふうに思いますので、よろしくお願いいたします。また、江藤大臣、ぜひまた、国交省もそうですけれども、やはり実動部隊をどう確保し…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/26", "sentence": ["…にも、さまざまな技術を取り入れながら、積極的にイノシシの駆除を展開をしていただければと思います。それでは、江藤大臣、ありがとうございました。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/38", "sentence": []}]}]}]