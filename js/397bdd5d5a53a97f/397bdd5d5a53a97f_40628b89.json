[{"date": "2020-02-07", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/4", "sentence": ["…て、厚労省としてどのように現在の状況について分析を行っているのか、御所見をお伺いをいたしたいというふうに思いますが、これは国民の皆さんにとっ…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/6", "sentence": ["…県と市町村、まさに国、三位一体となっての対応が地域住民から求められているというふうに思いますので、御所見をお伺いしたいというふうに思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/10", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/14", "sentence": ["…いたというふうに思っております。そこで、改めて、この成立を受けて、今後の展開について江藤大臣の御所見をお伺いをさせていただければと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/18", "sentence": ["…くという声があったんですよね。そのことをぜひ受けとめていただきたいというふうに思います。改めて、ちょっと江藤大臣、御所見を聞かせてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/20", "sentence": ["…ゃならない、非常に難しい立場でありますが、ぜひそれはやはり検討していかなきゃならないと思いますが、大臣の御所見をぜひお伺いしたいと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/24", "sentence": ["…力の余地があるというふうに思っております。今回も大きな予算を計上しているわけでありますので、改めて、ちょっと大臣、御所見を伺わせてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/28", "sentence": ["…ないと、やはり河川の改修というのは下からやっていきますからね。だから、そういう意味では、この利根川の治水計画についての御所見をお伺いしたい。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/34", "sentence": ["…そのことがブルー・オーシャン・ビジョンの原動力になるというふうに思っておりますので、大臣、改めてこの御所見をお聞かせいただければと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/36", "sentence": ["…の技術が実は一丁目一番地で、一番これから求められているというふうに思っておりますので、その辺の大臣の御所見をお聞かせいただければと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/38", "sentence": []}]}]}, {"date": "2020-02-18", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/418", "sentence": ["…れましては、いわゆる熊本の経済を支える大きな柱である観光業について、どのような形での御所見をお持ちなのか、お聞かせをいただければと思います。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/420", "sentence": ["…ーの位置づけということは、私も余り気にはしていなかったので申しわけなかったんですけれども、この辺についてももう少し御所見を聞かせてください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/422", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/424", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/426", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/428", "sentence": ["…留資格を速やかに変更して就職できるようにというような改正もしたわけなんですけれども、その点について何か御所見がありましたらお聞かせください。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X01320200218/430", "sentence": []}]}]}, {"date": "2020-02-25", "meeting": [{"meeting_name": "衆議院 予算委員会第六分科会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/7", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/9", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/11", "sentence": ["…。最初が肝心だから。だから、そこら辺のところで、この支援事業の継続性についてどういう見解を持っているのか、ちょっと教えてください、御所見を。"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/13", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/15", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/75", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/101", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/131", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105274X00120200225/195", "sentence": []}, {"url": "htt