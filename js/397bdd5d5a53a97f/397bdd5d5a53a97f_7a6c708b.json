[{"date": "2020-02-07", "meeting": [{"meeting_name": "衆議院 予算委員会", "remarks": [{"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/4", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/6", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/8", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/10", "sentence": ["…お願いします。実は、先日、私の手元に、全国都道府県議会の議長会からの決議が来ております。その中で、さまざま重要な視点が決議内容の中にあります…", "…議会の議長会からの決議が来ております。その中で、さまざま重要な視点が決議内容の中にあります。とにかく、やはり簡易検査キット、これについて速や…", "…実は県議会にいたんですが、請願だ何だというのは、とりあえず、県議会で決議して送っても、実は国からはナシのつぶてなんですよね。一応受け取りまし…", "…したというだけの話なんですよ。ただ、事案が事案なので、やはりこういう決議に対してどうやって打ち返していくのかということもちょっとお考えをいた…", "…だと思いますので、せっかくですので、こういう議長会から丁寧な形の中で決議案が出た以上は、これに対してどう打ち返していくのかということもぜひ御…"]}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/12", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/14", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/16", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/18", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/20", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/22", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/24", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/26", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/28", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/30", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/32", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/34", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/36", "sentence": []}, {"url": "https://kokkai.ndl.go.jp/txt/120105261X00920200207/38", "sentence": []}]}]}]